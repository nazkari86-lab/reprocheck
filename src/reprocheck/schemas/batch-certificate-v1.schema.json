{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocheck.local/schemas/batch-certificate-v1.schema.json",
  "title": "ReproCheck batch certificate",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "created_at",
    "status",
    "manifest",
    "experiments",
    "certificate_sha256"
  ],
  "properties": {
    "schema_version": { "const": "reprocheck.batch.v1" },
    "tool_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "needs_review"] },
    "manifest": { "$ref": "#/$defs/artifact" },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experiment" }
    },
    "certificate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["filename", "sha256", "size_bytes"],
      "properties": {
        "filename": { "type": "string", "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": ["id", "status", "certificate", "certificate_sha256", "findings"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
        "status": { "enum": ["passed", "needs_review"] },
        "certificate": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.audit\\.json$" },
        "certificate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocheck.local/schemas/ml-corpus-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "created_at", "repositories"],
  "properties": {
    "schema_version": {"const": "reprocheck.ml-corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id", "owner_id", "commit_sha", "source_url", "retrieved_at",
        "license", "domain", "language", "lineage_id", "is_fork", "artifacts"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "owner_id": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "license": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "lineage_id": {"type": "string", "minLength": 1},
        "is_fork": {"type": "boolean"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "role", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "role": {
          "enum": ["report", "metrics", "predictions", "detection", "manifest", "other"]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}

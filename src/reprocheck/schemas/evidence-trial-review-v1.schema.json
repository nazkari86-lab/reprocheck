{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reviewer_id", "independent", "packet_sha256", "reviews"],
  "properties": {
    "schema_version": {"const": "reprocheck.evidence-trial-review.v1"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "status", "rationale", "evidence_refs"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "status": {"enum": ["supported", "contradicted", "not_verifiable"]}, "rationale": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
  }
}

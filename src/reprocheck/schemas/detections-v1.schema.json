{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocheck.local/schemas/detections-v1.schema.json",
  "title": "ReproCheck detection evidence",
  "type": "object",
  "required": ["images"],
  "properties": {
    "schema": { "type": "string" },
    "scope": { "type": "string" },
    "evaluation": {
      "type": "object",
      "properties": {
        "ap_method": {
          "enum": ["coco_101_mean", "ultralytics_101_trapezoid"]
        },
        "matching_method": {
          "enum": ["confidence_greedy", "ultralytics_iou_greedy"]
        }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ground_truth", "predictions"],
        "properties": {
          "id": { "type": ["string", "number"] },
          "ground_truth": {
            "type": "array",
            "items": { "$ref": "#/$defs/groundTruth" }
          },
          "predictions": {
            "type": "array",
            "items": { "$ref": "#/$defs/prediction" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "groundTruth": {
      "type": "object",
      "required": ["class_id", "bbox"],
      "properties": {
        "class_id": { "type": ["string", "number"] },
        "bbox": { "$ref": "#/$defs/bbox" }
      },
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "required": ["class_id", "bbox", "confidence"],
      "properties": {
        "class_id": { "type": ["string", "number"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

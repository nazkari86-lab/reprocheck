{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "config_sha256", "completed_event_ids", "frame_count", "candidate_count", "independent_owner_count", "owner_cap", "frames", "candidates", "response_descriptors", "candidate_manifest_sha256"],
  "properties": {
    "schema_version": {"const": "reprocheck.evidence-trial-candidates.v1"},
    "status": {"const": "acquired_unreviewed"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^search-[0-9]{2}$"}},
    "frame_count": {"type": "integer", "minimum": 0},
    "candidate_count": {"type": "integer", "minimum": 0},
    "independent_owner_count": {"type": "integer", "minimum": 0},
    "owner_cap": {"const": 1},
    "frames": {"type": "array", "items": {"type": "object"}},
    "response_descriptors": {"type": "array", "items": {"type": "object"}},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "frame", "owner", "repository", "default_branch", "path", "commit", "blob_sha", "indexed_blob_sha", "immutable_url", "api_url", "source_file", "source_sha256", "source_bytes", "selection_digest"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^candidate-[0-9]{3}$"},
          "frame": {"type": "string", "pattern": "^search-[0-9]{2}$"},
          "owner": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "minLength": 3},
          "default_branch": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "indexed_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "immutable_url": {"type": "string", "pattern": "^https://"},
          "api_url": {"type": "string", "pattern": "^https://"},
          "source_file": {"type": "string", "pattern": "^sources/candidate-[0-9]{3}\\.txt$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_bytes": {"type": "integer", "minimum": 1},
          "selection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}

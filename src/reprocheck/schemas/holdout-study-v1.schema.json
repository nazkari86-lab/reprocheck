{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprocheck.local/schemas/holdout-study-v1.schema.json",
  "title": "ReproCheck preregistered holdout study v1",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "evaluator",
    "protocol",
    "corpus",
    "summary",
    "by_repository",
    "by_metric",
    "cases"
  ],
  "properties": {
    "schema": { "const": "reprocheck.preregistered-holdout-study.v1" },
    "phase": { "const": "preregistered_zero_shot" },
    "evaluator": { "$ref": "#/$defs/evaluator" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "corpus": { "$ref": "#/$defs/corpus" },
    "summary": { "$ref": "#/$defs/summary" },
    "by_repository": { "$ref": "#/$defs/groupedAggregates" },
    "by_metric": { "$ref": "#/$defs/groupedAggregates" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "interval": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/rate" }, { "$ref": "#/$defs/rate" }],
      "minItems": 2,
      "maxItems": 2
    },
    "evaluator": {
      "type": "object",
      "required": ["version", "filename", "sha256", "installed_archive_hash"],
      "properties": {
        "version": { "const": "0.6.0" },
        "filename": { "const": "reprocheck-0.6.0-py3-none-any.whl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "installed_archive_hash": { "type": "string", "pattern": "^sha256=[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "prediction_scope",
        "metric_scope",
        "matching",
        "absolute_tolerance",
        "output_overwrite_forbidden"
      ],
      "properties": {
        "prediction_scope": { "const": "Markdown and HTML table claims only" },
        "metric_scope": {
          "const": ["ap", "ap50", "ap75"]
        },
        "matching": { "const": "multiset metric and value matching" },
        "absolute_tolerance": { "const": 1e-9 },
        "output_overwrite_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": [
        "artifacts",
        "claim_bearing_artifacts",
        "annotated_claims",
        "repositories",
        "repository_commits",
        "preregistration_sha256",
        "source_manifest_sha256",
        "annotations_sha256",
        "annotation_lock_sha256"
      ],
      "properties": {
        "artifacts": { "const": 25 },
        "claim_bearing_artifacts": { "const": 15 },
        "annotated_claims": { "const": 313 },
        "repositories": { "const": 4 },
        "repository_commits": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 4,
          "additionalProperties": { "$ref": "#/$defs/commit" }
        },
        "preregistration_sha256": { "$ref": "#/$defs/sha256" },
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "annotations_sha256": { "$ref": "#/$defs/sha256" },
        "annotation_lock_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": [
        "tp",
        "fp",
        "fn",
        "precision",
        "precision_wilson_95",
        "recall",
        "recall_wilson_95",
        "artifact_exact_rate"
      ],
      "properties": {
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/rate" },
        "precision_wilson_95": { "$ref": "#/$defs/interval" },
        "recall": { "$ref": "#/$defs/rate" },
        "recall_wilson_95": { "$ref": "#/$defs/interval" },
        "artifact_exact_rate": { "$ref": "#/$defs/rate" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "tp",
        "fp",
        "fn",
        "precision",
        "precision_wilson_95",
        "recall",
        "recall_wilson_95",
        "artifact_exact_rate",
        "claim_artifact_exact_rate"
      ],
      "properties": {
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "precision": { "$ref": "#/$defs/rate" },
        "precision_wilson_95": { "$ref": "#/$defs/interval" },
        "recall": { "$ref": "#/$defs/rate" },
        "recall_wilson_95": { "$ref": "#/$defs/interval" },
        "artifact_exact_rate": { "$ref": "#/$defs/rate" },
        "claim_artifact_exact_rate": { "$ref": "#/$defs/rate" }
      },
      "additionalProperties": false
    },
    "groupedAggregates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/aggregate" }
    },
    "case": {
      "type": "object",
      "required": [
        "repository",
        "local_path",
        "expected_claims",
        "extracted_scoped_claims",
        "tp",
        "fp",
        "fn",
        "exact"
      ],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1 },
        "expected_claims": { "type": "integer", "minimum": 0 },
        "extracted_scoped_claims": { "type": "integer", "minimum": 0 },
        "tp": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "exact": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}

14a296f368d8430bbb548fd851779946587708f"},{"sha":"24348517b7aec72901dba786ff010b2f4c24105e","filename":"data_random/height_distribution.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/pranav-85/UWB-Node-Selection/blob/014a296f368d8430bbb548fd851779946587708f/data_random%2Fheight_distribution.png","raw_url":"https://github.com/pranav-85/UWB-Node-Selection/raw/014a296f368d8430bbb548fd851779946587708f/data_random%2Fheight_distribution.png","contents_url":"https://api.github.com/repos/pranav-85/UWB-Node-Selection/contents/data_random%2Fheight_distribution.png?ref=014a296f368d8430bbb548fd851779946587708f"},{"sha":"cbc1109d771148118a913857e1756704171957ec","filename":"data_random/plot_envs.py","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/pranav-85/UWB-Node-Selection/blob/014a296f368d8430bbb548fd851779946587708f/data_random%2Fplot_envs.py","raw_url":"https://github.com/pranav-85/UWB-Node-Selection/raw/014a296f368d8430bbb548fd851779946587708f/data_random%2Fplot_envs.py","contents_url":"https://api.github.com/repos/pranav-85/UWB-Node-Selection/contents/data_random%2Fplot_envs.py?ref=014a296f368d8430bbb548fd851779946587708f","patch":"@@ -0,0 +1,53 @@\n+import json\n+import numpy as np\n+import matplotlib.pyplot as plt\n+from scipy.stats import norm, shapiro\n+\n+# Load your JSON file\n+with open(\"env_configs.json\", \"r\") as f:\n+    data = json.load(f)\n+\n+# Extract width and height\n+widths = [env[\"grid_width\"] for env in data]\n+heights = [env[\"grid_height\"] for env in data]\n+\n+# ---------- SCATTER PLOT ----------\n+plt.figure(figsize=(6, 6))\n+plt.scatter(widths, heights)\n+plt.xlabel(\"Grid Width\")\n+plt.ylabel(\"Grid Height\")\n+plt.title(\"Environment Dimensions Scatter\")\n+plt.grid()\n+\n+plt.savefig(\"env_scatter.png\", dpi=300, bbox_inches=\"tight\")  # SAVE\n+plt.show()\n+\n+# ---------- HISTOGRAM + NORMAL FIT (WIDTH) ----------\n+plt.figure(figsize=(6, 4))\n+plt.hist(widths, bins=10, density=True)\n+\n+mu, std = np.mean(widths), np.std(widths)\n+x = np.linspace(min(widths), max(widths), 100)\n+plt.plot(x, norm.pdf(x, mu, std))\n+\n+plt.title(\"Width Distribution with Normal Fit\")\n+plt.xlabel(\"Width\")\n+plt.ylabel(\"Density\")\n+\n+plt.savefig(\"width_distribution.png\", dpi=300, bbox_inches=\"tight\")  # SAVE\n+plt.show()\n+\n+# ---------- HISTOGRAM + NORMAL FIT (HEIGHT) ----------\n+plt.figure(figsize=(6, 4))\n+plt.hist(heights, bins=10, density=True)\n+\n+mu, std = np.mean(heights), np.std(heights)\n+x = np.linspace(min(heights), max(heights), 100)\n+plt.plot(x, norm.pdf(x, mu, std))\n+\n+plt.title(\"Height Distribution with Normal Fit\")\n+plt.xlabel(\"Height\")\n+plt.ylabel(\"Density\")\n+\n+plt.savefig(\"height_distribution.png\", dpi=300, bbox_inches=\"tight\")  # SAVE\n+plt.show()\n\\ No newline at end of file"},{"sha":"14502e95d3a355a327580dfdd351f47c03707536","filename":"data_random/test_configs.json","status":"added","additions":502,"deletions":0,"changes":502,"blob_url":"https://github.com/pranav-85/UWB-Node-Selection/blob/014a296f368d8430bbb548fd851779946587708f/data_random%2Ftest_configs.json","raw_url":"https://github.com/pranav-85/UWB-Node-Selection/raw/014a296f368d8430bbb548fd851779946587708f/data_random%2Ftest_configs.json","contents_url":"https://api.github.com/repos/pranav-85/UWB-Node-Selection/contents/data_random%2Ftest_configs.json?ref=014a296f368d8430bbb548fd851779946587708f","patch":"@@ -0,0 +1,502 @@\n+[\n+  {\n+    \"env_id\": 40,\n+    \"seed\": 40,\n+    \"grid_width\": 24,\n+    \"grid_height\": 28,\n+    \"num_beacons\": 6,\n+    \"beacon_positions\": [\n+      [\n+        20.3131,\n+        1.828\n+      ],\n+      [\n+        7.2134,\n+        26.0066\n+      ],\n+      [\n+        15.615,\n+        4.3377\n+      ],\n+      [\n+        8.6646,\n+        23.8735\n+      ],\n+      [\n+        10.6968,\n+        1.7444\n+      ],\n+      [\n+        20.716,\n+        4.3767\n+      ]\n+    ]
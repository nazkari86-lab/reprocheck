     \"frac_gt1\": 0.14476644170967315,\n+      \"frac_gt2\": 0.05226941908164615,\n+      \"n\": 7557\n+    }\n+  },\n+  \"paired_per_event\": {\n+    \"frac_events_affected_gt_unaffected\": 0.624,\n+    \"mean_gap_sigma\": 1.5548585977861658,\n+    \"n_events\": 250\n+  },\n+  \"tail_concentration\": {\n+    \"total_affected_cells_z_gt2\": 216,\n+    \"top3_machines_share\": 0.3611111111111111,\n+    \"top6_machines_share\": 0.5555555555555556,\n+    \"per_machine\": [\n+      {\n+        \"machine_id\": 11,\n+        \"machine_name\": \"machine-2-4\",\n+        \"n_affected_cells\": 83,\n+        \"n_tail_z_gt2\": 36,\n+        \"mean_affected_z\": 9.44217771148107\n+      },\n+      {\n+        \"machine_id\": 12,\n+        \"machine_name\": \"machine-2-5\",\n+        \"n_affected_cells\": 85,\n+        \"n_tail_z_gt2\": 23,\n+        \"mean_affected_z\": 1.8948245571597535\n+      },\n+      {\n+        \"machine_id\": 14,\n+        \"machine_name\": \"machine-2-7\",\n+        \"n_affected_cells\": 80,\n+        \"n_tail_z_gt2\": 19,\n+        \"mean_affected_z\": 1.1765526890289038\n+      },\n+      {\n+        \"machine_id\": 5,\n+        \"machine_name\": \"machine-1-6\",\n+        \"n_affected_cells\": 246,\n+        \"n_tail_z_gt2\": 15,\n+        \"mean_affected_z\": 0.1845844571182421\n+      },\n+      {\n+        \"machine_id\": 10,\n+        \"machine_name\": \"machine-2-3\",\n+        \"n_affected_cells\": 75,\n+        \"n_tail_z_gt2\": 15,\n+        \"mean_affected_z\": 0.7477392260109385\n+      },\n+      {\n+        \"machine_id\": 8,\n+        \"machine_name\": \"machine-2-1\",\n+        \"n_affected_cells\": 88,\n+        \"n_tail_z_gt2\": 12,\n+        \"mean_affected_z\": 0.3294166310436346\n+      },\n+      {\n+        \"machine_id\": 15,\n+        \"machine_name\": \"machine-2-8\",\n+        \"n_affected_cells\": 34,\n+        \"n_tail_z_gt2\": 10,\n+        \"mean_affected_z\": 0.13880176995606983\n+      },\n+      {\n+        \"machine_id\": 3,\n+        \"machine_name\": \"machine-1-4\",\n+        \"n_affected_cells\": 93,\n+        \"n_tail_z_gt2\": 8,\n+        \"mean_affected_z\": 0.28147289901971817\n+      },\n+      {\n+        \"machine_id\": 25,\n+        \"machine_name\": \"machine-3-7\",\n+        \"n_affected_cells\": 65,\n+        \"n_tail_z_gt2\": 8,\n+        \"mean_affected_z\": 0.32924456549808384\n+      },\n+      {\n+        \"machine_id\": 1,\n+        \"machine_name\": \"machine-1-2\",\n+        \"n_affected_cells\": 66,\n+        \"n_tail_z_gt2\": 7,\n+        \"mean_affected_z\": 0.696692222785769\n+      },\n+      {\n+        \"machine_id\": 9,\n+        \"machine_name\": \"machine-2-2\",\n+        \"n_affected_cells\": 58,\n+        \"n_tail_z_gt2\": 7,\n+        \"mean_affected_z\": 0.12981795095678034\n+      },\n+      {\n+        \"machine_id\": 2,\n+        \"machine_name\": \"machine-1-3\",\n+        \"n_affected_cells\": 78,\n+        \"n_tail_z_gt2\": 6,\n+        \"mean_affected_z\": -0.1363925612412202\n+      },\n+      {\n+        \"machine_id\": 6,\n+        \"machine_name\": \"machine-1-7\",\n+        \"n_affected_cells\": 128,\n+        \"n_tail_z_gt2\": 6,\n+        \"mean_affected_z\": 0.13059482573498826\n+      },\n+      {\n+        \"machine_id\": 23,\n+        \"machine_name\": \"machine-3-5\",\n+        \"n_affected_cells\": 40,\n+        \"n_tail_z_gt2\": 6,\n+        \"mean_affected_z\": 0.5614796607289463\n+      },\n+      {\n+        \"machine_id\": 7,\n+        \"machine_name\": \"machine-1-8\",\n+        \"n_affected_cells\": 64,\n+        \"n_tail_z_gt2\": 5,\n+        \"mean_affected_z\": -0.03979855010402389\n+      },\n+      {\n+        \"machine_id\": 22,\n+        \"machine_name\": \"machine-3-4\",\n+        \"n_affected_cells\": 30,\n+        \"n_tail_z_gt2\": 5,\n+        \"mean_affected_z\": 0.7286689562102159\n+      },\n+      {\n+        \"machine_id\": 0,\n+        \"machine_name\": \"machine-1-1\",\n+        \"n_affected_cel
      \"auroc_raw_mean\": 0.48190608278249925,\n+      \"auroc_raw_max\": 0.20322828139754484,\n+      \"auroc_robust_mean\": 0.34388770853005973,\n+      \"auroc_robust_max\": 0.35266662732137233,\n+      \"auroc_best_variate_oracle\": 0.9125475285171103\n+    }\n+  ]\n+}\n\\ No newline at end of file"},{"sha":"613317557f72c481053bbb03a6b71ef670ce7773","filename":"toto/results/auroc/swat_aggregation_comparison.json","status":"added","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/XVmecha/Toto-4-AD/blob/041e3b97698918256b20e69d775580a96e53129c/toto%2Fresults%2Fauroc%2Fswat_aggregation_comparison.json","raw_url":"https://github.com/XVmecha/Toto-4-AD/raw/041e3b97698918256b20e69d775580a96e53129c/toto%2Fresults%2Fauroc%2Fswat_aggregation_comparison.json","contents_url":"https://api.github.com/repos/XVmecha/Toto-4-AD/contents/toto%2Fresults%2Fauroc%2Fswat_aggregation_comparison.json?ref=041e3b97698918256b20e69d775580a96e53129c","patch":"@@ -0,0 +1,16 @@\n+{\n+  \"dataset\": \"swat\",\n+  \"context_length\": 512,\n+  \"fit_stride\": 32,\n+  \"detect_stride\": 8,\n+  \"n_samples\": 5559,\n+  \"n_anomaly\": 669,\n+  \"auroc\": {\n+    \"raw_mean\": 0.8323258166967761,\n+    \"raw_max\": 0.7938531092097902,\n+    \"zscore_meanstd_mean\": 0.7786724990141866,\n+    \"zscore_meanstd_max\": 0.7373725702372983,\n+    \"robust_median_iqr_mean\": 0.7828709944641606,\n+    \"robust_median_iqr_max\": 0.7373725702372983\n+  }\n+}\n\\ No newline at end of file"},{"sha":"d8b3db768d4c55122b63d19ed2262078e9b049b6","filename":"verify_scorer.py","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/XVmecha/Toto-4-AD/blob/041e3b97698918256b20e69d775580a96e53129c/verify_scorer.py","raw_url":"https://github.com/XVmecha/Toto-4-AD/raw/041e3b97698918256b20e69d775580a96e53129c/verify_scorer.py","contents_url":"https://api.github.com/repos/XVmecha/Toto-4-AD/contents/verify_scorer.py?ref=041e3b97698918256b20e69d775580a96e53129c","patch":"@@ -0,0 +1,34 @@\n+\"\"\"Spot-check: does the cached streaming NLL match a fresh single-window forward pass\n+at the timesteps we assume (t = 512 + i*detect_stride)?\"\"\"\n+import os\n+os.environ['PYTORCH_ENABLE_MPS_FALLBACK'] = '1'\n+import numpy as np, torch\n+from toto.model.toto import Toto\n+from toto.model.util import get_device\n+from toto.anomaly_detection.scoring import NLLScorer\n+from toto.data.util.dataset import MaskedTimeseries\n+\n+CTX, DET = 512, 8\n+cache = np.load('toto/results/scores/smd_nll_test_stride8.npy')   # (28,38,2896)\n+series = torch.load('toto/data/preprocessed_smd_1x/smd_test.pt', weights_only=False)['series']\n+device = get_device()\n+toto = Toto.from_pretrained('Datadog/toto-open-base-1.0'); toto.to(device); toto.eval()\n+scorer = NLLScorer(toto.model, context_length=CTX)\n+series = series.to(device)\n+B, V, T = series.shape\n+\n+for i in [0, 100, 1000, 2895]:\n+    t = CTX + i * DET\n+    ctx = series[:, :, t - CTX:t]\n+    inputs = MaskedTimeseries(\n+        series=ctx,\n+        padding_mask=torch.ones_like(ctx, dtype=torch.bool),\n+        id_mask=torch.zeros_like(ctx),\n+        timestamp_seconds=torch.zeros_like(ctx),\n+        time_interval_seconds=torch.ones(V, device=device).unsqueeze(0).expand(B, -1),\n+    )\n+    fresh = scorer.compute_nll(inputs, series[:, :, t]).detach().cpu().numpy()  # (28,38)\n+    cached = cache[:, :, i]\n+    diff = np.abs(fresh - cached)\n+    print(f\"i={i:>4} t={t:>5}  max|fresh-cached|={diff.max():.3e}  \"\n+          f\"mean|.|={diff.mean():.3e}  cached[0,:3]={cached[0,:3].round(3)}\")"}]}
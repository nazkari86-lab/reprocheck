st-filename\": \"tomli-2.4.1-py3-none-any.whl\"\n-        },\n-        {\n-          \"type\": \"file\",\n-          \"url\": \"https://files.pythonhosted.org/packages/df/b2/87e62e8c3e2f4b32e5fe99e0b86d576da1312593b39f47d8ceef365e95ed/packaging-26.2-py3-none-any.whl\",\n-          \"sha256\": \"5fc45236b9446107ff2415ce77c807cee2862cb6fac22b8a73826d0693b0980e\",\n-          \"dest\": \"pip-sources\",\n-          \"dest-filename\": \"packaging-26.2-py3-none-any.whl\"\n-        },\n-        {\n-          \"type\": \"file\",\n-          \"url\": \"https://files.pythonhosted.org/packages/12/bb/f622a8a5e64d46ca83020a761877c0ead19140903c9aaf1431f3c531fdf6/evdev-1.7.1.tar.gz\",\n-          \"sha256\": \"0c72c370bda29d857e188d931019c32651a9c1ea977c08c8d939b1ced1637fde\",\n-          \"dest\": \"pip-sources\",\n-          \"dest-filename\": \"evdev-1.7.1.tar.gz\"\n-        }\n-      ]\n-    },\n-    {\n-      \"name\": \"sniptext\",\n-      \"buildsystem\": \"simple\",\n-      \"build-commands\": [\n-        \"pip3 install --prefix=/app --no-deps --no-build-isolation .\",\n-        \"install -Dm644 flatpak/io.github.dkorbelainen.SnipText.desktop /app/share/applications/io.github.dkorbelainen.SnipText.desktop\",\n-        \"install -Dm644 flatpak/io.github.dkorbelainen.SnipText.svg /app/share/icons/hicolor/scalable/apps/io.github.dkorbelainen.SnipText.svg\",\n-        \"install -Dm644 flatpak/io.github.dkorbelainen.SnipText.metainfo.xml /app/share/metainfo/io.github.dkorbelainen.SnipText.metainfo.xml\",\n-        \"install -Dm644 man/sniptext.1 /app/share/man/man1/sniptext.1\"\n-      ],\n-      \"sources\": [\n-        {\n-          \"type\": \"git\",\n-          \"url\": \"https://github.com/dkorbelainen/sniptext.git\",\n-          \"commit\": \"e06b9529fc517a445a32af5fba26589b449c7c29\"\n-        }\n-      ]\n-    }\n-  ]\n-}"},{"sha":"04be296a18d62fa205587252406e134ab57634d9","filename":"flatpak/io.github.dkorbelainen.SnipText.metainfo.xml","status":"removed","additions":0,"deletions":56,"changes":56,"blob_url":"https://github.com/dkorbelainen/sniptext/blob/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.metainfo.xml","raw_url":"https://github.com/dkorbelainen/sniptext/raw/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.metainfo.xml","contents_url":"https://api.github.com/repos/dkorbelainen/sniptext/contents/flatpak%2Fio.github.dkorbelainen.SnipText.metainfo.xml?ref=db87bd39ca4143090c3c91a4170bac054abc1056","patch":"@@ -1,56 +0,0 @@\n-<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n-<component type=\"desktop-application\">\n-  <id>io.github.dkorbelainen.SnipText</id>\n-  <name>SnipText</name>\n-  <summary>Screen capture OCR tool</summary>\n-  <metadata_license>MIT</metadata_license>\n-  <project_license>MIT</project_license>\n-\n-  <description>\n-    <p>\n-      SnipText is a lightweight screen capture and OCR tool for Linux. Trigger a hotkey,\n-      select a region, and the recognized text is instantly copied to your clipboard.\n-    </p>\n-    <p>Features:</p>\n-    <ul>\n-      <li>Region selection with slurp (Wayland) or similar tools</li>\n-      <li>Tesseract OCR with ensemble recognition</li>\n-      <li>Configurable hotkeys</li>\n-      <li>Optional scikit-learn confidence calibration</li>\n-      <li>Wayland and X11 support</li>\n-    </ul>\n-  </description>\n-\n-  <launchable type=\"desktop-id\">io.github.dkorbelainen.SnipText.desktop</launchable>\n-\n-  <url type=\"homepage\">https://github.com/dkorbelainen/sniptext</url>\n-  <url type=\"bugtracker\">https://github.com/dkorbelainen/sniptext/issues</url>\n-\n-  <developer id=\"io.github.dkorbelainen\">\n-    <name>dkorbelainen</name>\n-  </developer>\n-\n-  <content_rating type=\"oars-1.1\"/>\n-\n-  <releases>\n-    <release version=\"0.4.0\" date=\"2025-06-07\">\n-      <description>\n-        <p>Confidence calibration with per-engine scikit-learn models.</p>\n-      </description>\n-    </release>\n-  </releases>\n-\n-  <categories>\n-    <category>Utility</category>\n-    <category>Graphics</category>\n-  </categories>\n-\n-  <keywords>\n-    <keyword>ocr</keyword>\n-    <keyword>screenshot</keyword>\n-    <keyword>text</keyword>\n-    <keyword>capture</keyword>\n-    <keyword>tesseract</keyword>\n-    <keyword>wayland</keyword>\n-  </keywords>\n-</component>"},{"sha":"be461854b839882592917fcb39eb75d1df14c756","filename":"flatpak/io.github.dkorbelainen.SnipText.svg","status":"removed","additions":0,"deletions":12,"changes":12,"blob_url":"https://github.com/dkorbelainen/sniptext/blob/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.svg","raw_url":"https://github.com/dkorbelainen/sniptext/raw/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.svg","contents_url":"https://api.github.com/repos/dkorbelainen/sniptext/contents/flatpak%2Fio.github.dkorbelainen.SnipText.svg?ref=db87bd39ca4143090c3c91a4170bac054abc1056","patch":"@@ -1,12 +0,0 @@\n-<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n-<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\" width=\"128\" height=\"128\">\n-  <rect width=\"128\" height=\"128\" rx=\"22\" fill=\"#1e1e2e\"/>\n-  <rect x=\"16\" y=\"16\" width=\"96\" height=\"70\" rx=\"8\" fill=\"#313244\" stroke=\"#89b4fa\" stroke-width=\"2\"/>\n-  <rect x=\"28\" y=\"28\" width=\"72\" height=\"8\" rx=\"4\" fill=\"#cdd6f4\"/>\n-  <rect x=\"28\" y=\"44\" width=\"56\" height=\"6\" rx=\"3\" fill=\"#a6adc8\"/>\n-  <rect x=\"28\" y=\"56\" width=\"64\" height=\"6\" rx=\"3\" fill=\"#a6adc8\"/>\n-  <rect x=\"16\" y=\"96\" width=\"96\" height=\"20\" rx=\"6\" fill=\"#89b4fa\"/>\n-  <text x=\"64\" y=\"111\" text-anchor=\"middle\" font-family=\"monospace\" font-size=\"11\" font-weight=\"bold\" fill=\"#1e1e2e\">OCR</text>\n-  <circle cx=\"96\" cy=\"51\" r=\"14\" fill=\"none\" stroke=\"#a6e3a1\" stroke-width=\"3\"/>\n-  <line x1=\"106\" y1=\"61\" x2=\"115\" y2=\"70\" stroke=\"#a6e3a1\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n-</svg>"}]}
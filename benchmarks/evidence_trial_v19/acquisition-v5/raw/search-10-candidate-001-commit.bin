ory (separate repo)\n aur-sniptext-aur/\n \n-# Flatpak build artifacts\n-.flatpak-builder/\n-build-flatpak-dir/\n-flatpak/build-dir/\n-\n # Python\n __pycache__/\n *.py[cod]"},{"sha":"79e1bd48b4f897c11dca609f55ca6a4079a6b8c2","filename":"flatpak/build-flatpak.sh","status":"removed","additions":0,"deletions":19,"changes":19,"blob_url":"https://github.com/dkorbelainen/sniptext/blob/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fbuild-flatpak.sh","raw_url":"https://github.com/dkorbelainen/sniptext/raw/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fbuild-flatpak.sh","contents_url":"https://api.github.com/repos/dkorbelainen/sniptext/contents/flatpak%2Fbuild-flatpak.sh?ref=db87bd39ca4143090c3c91a4170bac054abc1056","patch":"@@ -1,19 +0,0 @@\n-#!/bin/bash\n-# Build and install SnipText as a Flatpak\n-\n-set -e\n-\n-SCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n-MANIFEST=\"$SCRIPT_DIR/io.github.dkorbelainen.SnipText.json\"\n-APP_ID=\"io.github.dkorbelainen.SnipText\"\n-\n-if [ ! -f \"$MANIFEST\" ]; then\n-    echo \"Error: $MANIFEST not found.\"\n-    exit 1\n-fi\n-\n-echo \"Building SnipText Flatpak...\"\n-flatpak-builder --user --install --force-clean build-dir \"$MANIFEST\"\n-\n-echo \"✓ SnipText installed as Flatpak\"\n-echo \"Launch with: flatpak run $APP_ID\""},{"sha":"05aeb81cf4fcc4b59a8c8477658252236e7cde25","filename":"flatpak/io.github.dkorbelainen.SnipText.desktop","status":"removed","additions":0,"deletions":11,"changes":11,"blob_url":"https://github.com/dkorbelainen/sniptext/blob/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.desktop","raw_url":"https://github.com/dkorbelainen/sniptext/raw/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.desktop","contents_url":"https://api.github.com/repos/dkorbelainen/sniptext/contents/flatpak%2Fio.github.dkorbelainen.SnipText.desktop?ref=db87bd39ca4143090c3c91a4170bac054abc1056","patch":"@@ -1,11 +0,0 @@\n-[Desktop Entry]\n-Name=SnipText\n-Comment=Screen capture OCR tool\n-Exec=sniptext --capture-now\n-Icon=io.github.dkorbelainen.SnipText\n-Terminal=false\n-Type=Application\n-Categories=Utility;Graphics;TextTools;\n-Keywords=ocr;screenshot;capture;text;recognition;\n-X-Flatseal-Dbus-System=\n-X-Flatseal-Dbus-Session="},{"sha":"d4cfd04faaedc580e0eef43f8977d6bbbc78bc7c","filename":"flatpak/io.github.dkorbelainen.SnipText.json","status":"removed","additions":0,"deletions":264,"changes":264,"blob_url":"https://github.com/dkorbelainen/sniptext/blob/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.json","raw_url":"https://github.com/dkorbelainen/sniptext/raw/db87bd39ca4143090c3c91a4170bac054abc1056/flatpak%2Fio.github.dkorbelainen.SnipText.json","contents_url":"https://api.github.com/repos/dkorbelainen/sniptext/contents/flatpak%2Fio.github.dkorbelainen.SnipText.json?ref=db87bd39ca4143090c3c91a4170bac054abc1056","patch":"@@ -1,264 +0,0 @@\n-{\n-  \"app-id\": \"io.github.dkorbelainen.SnipText\",\n-  \"runtime\": \"org.freedesktop.Platform\",\n-  \"runtime-version\": \"23.08\",\n-  \"sdk\": \"org.freedesktop.Sdk\",\n-  \"command\": \"sniptext\",\n-  \"finish-args\": [\n-    \"--share=ipc\",\n-    \"--socket=wayland\",\n-    \"--socket=fallback-x11\",\n-    \"--device=dri\",\n-    \"--env=TESSDATA_PREFIX=/app/share/tessdata\"\n-  ],\n-  \"modules\": [\n-    {\n-      \"name\": \"leptonica\",\n-      \"buildsystem\": \"cmake-ninja\",\n-      \"builddir\": true,\n-      \"config-opts\": [\n-        \"-DCMAKE_INSTALL_PREFIX=/app\",\n-        \"-DBUILD_SHARED_LIBS=ON\"\n-      ],\n-      \"sources\": [\n-        {\n-          \"type\": \"archive\",\n-          \"url\": \"https://github.com/DanBloomberg/leptonica/releases/download/1.84.1/leptonica-1.84.1.tar.gz\",\n-          \"sha256\": \"2b3e1254b1cca381e77c819b59ca99774ff43530209b9aeb511e1d46588a64f6\"\n-        }\n-      ]\n-    },\n-    {\n-      \"name\": \"tesseract\",\n-      \"buildsystem\": \"cmake-ninja\",\n-      \"builddir\
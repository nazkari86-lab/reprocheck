eGroupContext);\n+\n+  return (\n+    <ToggleGroupPrimitive.Item\n+      ref={ref}\n+      className={cn(\n+        toggleVariants({\n+          variant: context.variant || variant,\n+          size: context.size || size,\n+        }),\n+        className,\n+      )}\n+      {...props}\n+    >\n+      {children}\n+    </ToggleGroupPrimitive.Item>\n+  );\n+});\n+\n+ToggleGroupItem.displayName = ToggleGroupPrimitive.Item.displayName;\n+\n+export { ToggleGroup, ToggleGroupItem };"},{"sha":"9d146b6a1051516735339895093cbcbcfeb9a3e8","filename":"extractions/shovs-agent-harness/frontend/src/components/ui/toggle.tsx","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftoggle.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftoggle.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftoggle.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,42 @@\n+import * as React from \"react\";\n+import * as TogglePrimitive from \"@radix-ui/react-toggle\";\n+import { cva, type VariantProps } from \"class-variance-authority\";\n+\n+import { cn } from \"@/lib/utils\";\n+\n+const toggleVariants = cva(\n+  \"inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium cursor-pointer transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 disabled:cursor-not-allowed data-[state=on]:bg-accent data-[state=on]:text-accent-foreground [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0\",\n+  {\n+    variants: {\n+      variant: {\n+        default: \"bg-transparent\",\n+        outline:\n+          \"border border-input bg-transparent shadow-sm hover:bg-accent hover:text-accent-foreground\",\n+      },\n+      size: {\n+        default: \"h-9 px-2 min-w-9\",\n+        sm: \"h-8 px-1.5 min-w-8\",\n+        lg: \"h-10 px-2.5 min-w-10\",\n+      },\n+    },\n+    defaultVariants: {\n+      variant: \"default\",\n+      size: \"default\",\n+    },\n+  },\n+);\n+\n+const Toggle = React.forwardRef<\n+  React.ElementRef<typeof TogglePrimitive.Root>,\n+  React.ComponentPropsWithoutRef<typeof TogglePrimitive.Root> & VariantProps<typeof toggleVariants>\n+>(({ className, variant, size, ...props }, ref) => (\n+  <TogglePrimitive.Root\n+    ref={ref}\n+    className={cn(toggleVariants({ variant, size, className }))}\n+    {...props}\n+  />\n+));\n+\n+Toggle.displayName = TogglePrimitive.Root.displayName;\n+\n+export { Toggle, toggleVariants };"},{"sha":"07e55fafdcf32ee9a57164a07c89422e61c6ac2e","filename":"extractions/shovs-agent-harness/frontend/src/components/ui/tooltip.tsx","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftooltip.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftooltip.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fcomponents%2Fui%2Ftooltip.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,32 @@\n+\"use client\";\n+\n+import * as React from \"react\";\n+import * as TooltipPrimitive from \"@radix-ui/react-tooltip\";\n+\n+import { cn } from \"@/lib/utils\";\n+\n+const TooltipProvider = TooltipPrimitive.Provider;\n+\n+const Tooltip = TooltipPrimitive.Root;\n+\n+const TooltipTrigger = TooltipPrimitive.Trigger;\n+\n+const TooltipContent = React.forwardRef<\n+  React.ElementRef<typeof TooltipPrimitive.Content>,\n+  React.ComponentPropsWithoutRef<typeof TooltipPrimitive.Content>\n+>(({ className, sideOffset = 4, ...props }, ref) => (\n+  <TooltipPrimitive.Portal>\n+    <TooltipPrimitive.Content\n+      ref={ref}\n+      sideOffset={sideOffset}\n+      className={cn(\n+        \"z-50 overflow-hidden rounded-md bg-primary px-3 py-1.5 text-xs text-primary-foreground animate-in fade-in-0 zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 origin-(--radix-tooltip-content-transform-origin)\",\n+        className,\n+      )}\n+      {...props}\n+    />\n+  </TooltipPrimitive.Portal>\n+));\n+TooltipContent.displayName = TooltipPrimitive.Content.displayName;\n+\n+export { Tooltip, TooltipTrigger, TooltipContent, TooltipProvider };"},{"sha":"502fd323934501eab408a396a9ae4a07c0ae3560","filename":"extractions/shovs-agent-harness/frontend/src/hooks/use-mobile.tsx","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fhooks%2Fuse-mobile.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fhooks%2Fuse-mobile.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fhooks%2Fuse-mobile.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,19 @@\n+import * as React from \"react\";\n+\n+const MOBILE_BREAKPOINT = 768;\n+\n+export function useIsMobile() {\n+  const [isMobile, setIsMobile] = React.useState<boolean | undefined>(undefined);\n+\n+  React.useEffect(() => {\n+    const mql = window.matchMedia(`(max-width: ${MOBILE_BREAKPOINT - 1}px)`);\n+    const onChange = () => {\n+      setIsMobile(window.innerWidth < MOBILE_BREAKPOINT);\n+    };\n+    mql.addEventListener(\"change\", onChange);\n+    setIsMobile(window.innerWidth < MOBILE_BREAKPOINT);\n+    return () => mql.removeEventListener(\"change\", onChange);\n+  }, []);\n+\n+  return !!isMobile;\n+}"},{"sha":"171c9b5800c5b17efc0598eae4c760b3778021e6","filename":"extractions/shovs-agent-harness/frontend/src/lib/error-capture.ts","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-capture.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-capture.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-capture.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,27 @@\n+// Captures the original Error out-of-band so server.ts can recover the stack\n+// when h3 has already swallowed the throw into a generic 500 Response.\n+\n+let lastCapturedError: { error: unknown; at: number } | undefined;\n+const TTL_MS = 5_000;\n+\n+function record(error: unknown) {\n+  lastCapturedError = { error, at: Date.now() };\n+}\n+\n+if (typeof globalThis.addEventListener === \"function\") {\n+  globalThis.addEventListener(\"error\", (event) => record((event as ErrorEvent).error ?? event));\n+  globalThis.addEventListener(\"unhandledrejection\", (event) =>\n+    record((event as PromiseRejectionEvent).reason),\n+  );\n+}\n+\n+export function consumeLastCapturedError(): unknown {\n+  if (!lastCapturedError) return undefined;\n+  if (Date.now() - lastCapturedError.at > TTL_MS) {\n+    lastCapturedError = undefined;\n+    return undefined;\n+  }\n+  const { error } = lastCapturedError;\n+  lastCapturedError = undefined;\n+  return error;\n+}"},{"sha":"725235ce7bdf496daf2d870148978939f4f40a9b","filename":"extractions/shovs-agent-harness/frontend/src/lib/error-page.ts","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-page.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-page.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Ferror-page.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,30 @@\n+export function renderErrorPage(): string {\n+  return `<!doctype html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"utf-8\" />\n+    <title>This page didn't load</title>\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n+    <style>\n+      body { font: 15px/1.5 system-ui, -apple-system, sans-serif; background: #fafafa; color: #111; display: grid; place-items: center; min-height: 100vh; margin: 0; padding: 1.5rem; }\n+      .card { max-width: 28rem; width: 100%; text-align: center; padding: 2rem; }\n+      h1 { font-size: 1.25rem; margin: 0 0 0.5rem; }\n+      p { color: #4b5563; margin: 0 0 1.5rem; }\n+      .actions { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }\n+      a, button { padding: 0.5rem 1rem; border-radius: 0.375rem; font: inherit; cursor: pointer; text-decoration: none; border: 1px solid transparent; }\n+      .primary { background: #111; color: #fff; }\n+      .secondary { background: #fff; color: #111; border-color: #d1d5db; }\n+    </style>\n+  </head>\n+  <body>\n+    <div class=\"card\">\n+      <h1>This page didn't load</h1>\n+      <p>Something went wrong on our end. You can try refreshing or head back home.</p>\n+      <div class=\"actions\">\n+        <button class=\"primary\" onclick=\"location.reload()\">Try again</button>\n+        <a class=\"secondary\" href=\"/\">Go home</a>\n+      </div>\n+    </div>\n+  </body>\n+</html>`;\n+}"},{"sha":"15f0cadfa01dfe3aef831b8c4b0d7b1d9472a39f","filename":"extractions/shovs-agent-harness/frontend/src/lib/harness-client.ts","status":"added","additions":199,"deletions":0,"changes":199,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-client.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-client.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-client.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,199 @@\n+import { getBaseUrl } from \"./harness-config\";\n+\n+export interface DraftRequest {\n+  objective: string;\n+}\n+\n+export interface Manifest {\n+  name?: string;\n+  version?: string;\n+  tool_mode?: string;\n+  adapters?: Record<string, unknown>;\n+  [k: string]: unknown;\n+}\n+\n+export interface RunSummary {\n+  run_id: string;\n+  status?: string;\n+  objective?: string;\n+  created_at?: string;\n+  [k: string]: unknown;\n+}\n+\n+export interface RunRecord {\n+  run_id: string;\n+  status?: string;\n+  objective?: string;\n+  workflow?: Record<string, unknown>;\n+  result?: unknown;\n+  entities?: unknown;\n+  evidence?: unknown[];\n+  events?: unknown[];\n+  eval?: unknown;\n+  trace_ids?: string[];\n+  event_count?: number;\n+  result_ready?: boolean;\n+  [k: string]: unknown;\n+}\n+\n+export interface WorkflowSpec {\n+  workflow_id: string;\n+  label?: string;\n+  objective?: string;\n+  policy?: string;\n+  tools?: string[];\n+  nodes?: Record<string, unknown>[];\n+  edges?: Record<string, unknown>[];\n+  runtime?: Record<string, unknown>;\n+  status?: string;\n+  updated_at?: string;\n+  [k: string]: unknown;\n+}\n+\n+export interface RunEvent {\n+  id?: string;\n+  run_id?: string;\n+  phase?: string;\n+  status?: string;\n+  summary?: string;\n+  data?: Record<string, unknown>;\n+  created_at?: string;\n+  ts?: string;\n+  type?: string;\n+  [k: string]: unknown;\n+}\n+\n+export interface Fact {\n+  id?: string;\n+  fact_id: string;\n+  subject?: string;\n+  predicate?: string;\n+  object?: unknown;\n+  status?: string;\n+  created_at?: string;\n+  voided_at?: string | null;\n+  [k: string]: unknown;\n+}\n+\n+export interface ChatTurn {\n+  turn_id: string;\n+  session_id: string;\n+  role: \"user\" | \"assistant\" | string;\n+  content: string;\n+  run_id?: string;\n+  summary?: string;\n+  created_at?: string;\n+  [k: string]: unknown;\n+}\n+\n+export interface JobStatus {\n+  max_workers: number;\n+  active_jobs: number;\n+  capacity_available: number;\n+  jobs: Record<string, unknown>[];\n+}\n+\n+async function req<T>(path: string, init?: RequestInit): Promise<T> {\n+  const url = `${getBaseUrl()}${path}`;\n+  const res = await fetch(url, {\n+    ...init,\n+    headers: {\n+      \"Content-Type\": \"application/json\",\n+      ...(init?.headers || {}),\n+    },\n+  });\n+  if (!res.ok) {\n+    const text = await res.text().catch(() => \"\");\n+    throw new Error(`${res.status} ${res.statusText}: ${text || path}`);\n+  }\n+  if (res.status === 204) return undefined as T;\n+  const ct = res.headers.get(\"content-type\") || \"\";\n+  if (ct.includes(\"application/json\")) return (await res.json()) as T;\n+  return (await res.text()) as unknown as T;\n+}\n+\n+export function normalizeRuns(data: RunSummary[] | { runs?: RunSummary[] } | undefined): RunSummary[] {\n+  if (!data) return [];\n+  return Array.isArray(data) ? data : data.runs || [];\n+}\n+\n+export function normalizeEvents(data: RunEvent[] | { events?: RunEvent[] } | undefined): RunEvent[] {\n+  if (!data) return [];\n+  return Array.isArray(data) ? data : data.events || [];\n+}\n+\n+export function normalizeFacts(data: Fact[] | { facts?: Fact[] } | undefined): Fact[] {\n+  const facts = !data ? [] : Array.isArray(data) ? data : data.facts || [];\n+  return facts.map((fact) => ({\n+    ...fact,\n+    fact_id: fact.fact_id || fact.id || \"\",\n+  }));\n+}\n+\n+export const harness = {\n+  health: () => req<{ status?: string; ok?: boolean }>(\"/health\"),\n+  manifest: () => req<Manifest>(\"/api/manifest\"),\n+  tools: () => req<unknown>(\"/api/tools\"),\n+  jobs: () => req<JobStatus>(\"/api/jobs\"),\n+  listSessions: () => req<{ sessions: Record<string, unknown>[] }>(\"/api/chat/sessions\"),\n+  listChat: (sessionId: string, limit = 80) =>\n+    req<{ session_id: string; turns: ChatTurn[]; compact: Record<string, unknown>[] }>(\n+      `/api/chat/${encodeURIComponent(sessionId)}?limit=${limit}`,\n+    ),\n+  listRuns: () => req<RunSummary[] | { runs: RunSummary[] }>(\"/api/runs\"),\n+  listWorkflows: () => req<{ workflows: WorkflowSpec[] }>(\"/api/workflows\"),\n+  createWorkflow: (body: Record<string, unknown>) =>\n+    req<{ workflow: WorkflowSpec }>(\"/api/workflows\", { method: \"POST\", body: JSON.stringify(body) }),\n+  getWorkflow: (id: string) => req<{ workflow: WorkflowSpec }>(`/api/workflows/${id}`),\n+  runWorkflow: (id: string, body: Record<string, unknown>) =>\n+    req<RunRecord>(`/api/workflows/${id}/run`, { method: \"POST\", body: JSON.stringify(body) }),\n+  startWorkflow: (id: string, body: Record<string, unknown>) =>\n+    req<RunRecord>(`/api/workflows/${id}/run_async`, { method: \"POST\", body: JSON.stringify(body) }),\n+  draft: (body: DraftRequest) =>\n+    req<unknown>(\"/api/workflows/draft\", { method: \"POST\", body: JSON.stringify(body) }),\n+  createRun: (body: { objective: string; [k: string]: unknown }) =>\n+    req<RunRecord>(\"/api/runs\", { method: \"POST\", body: JSON.stringify(body) }),\n+  startRun: (body: { objective: string; [k: string]: unknown }) =>\n+    req<RunRecord>(\"/api/runs/async\", { method: \"POST\", body: JSON.stringify(body) }),\n+  getRun: (id: string) => req<RunRecord>(`/api/runs/${id}`),\n+  getResult: (id: string) => req<unknown>(`/api/runs/${id}/result`),\n+  getContext: (id: string) => req<unknown>(`/api/runs/${id}/context`),\n+  getEvidence: (id: string) => req<unknown>(`/api/runs/${id}/evidence`),\n+  getEventsOnce: (id: string) => req<RunEvent[] | { events: RunEvent[] }>(`/api/runs/${id}/events`),\n+  understand: (body: { objective: string }) =>\n+    req<unknown>(\"/api/runtime/understand\", { method: \"POST\", body: JSON.stringify(body) }),\n+  continueRun: (id: string, body: Record<string, unknown> = {}) =>\n+    req<RunRecord>(`/api/runs/${id}/continue`, { method: \"POST\", body: JSON.stringify(body) }),\n+  interruptRun: (id: string, body: Record<string, unknown> = {}) =>\n+    req<RunRecord>(`/api/runs/${id}/interrupt`, { method: \"POST\", body: JSON.stringify(body) }),\n+  compare: (body: Record<string, unknown>) =>\n+    req<unknown>(\"/api/compare\", { method: \"POST\", body: JSON.stringify(body) }),\n+  listMemory: () => req<Fact[] | { facts: Fact[] }>(\"/api/memory\"),\n+  addMemory: (body: Record<string, unknown>) =>\n+    req<Fact>(\"/api/memory\", { method: \"POST\", body: JSON.stringify(body) }),\n+  voidMemory: (factId: string, body: Record<string, unknown> = {}) =>\n+    req<Fact>(`/api/memory/${factId}/void`, { method: \"POST\", body: JSON.stringify(body) }),\n+};\n+\n+/**\n+ * Open an SSE stream for a run. Falls back gracefully — caller can `.close()`.\n+ * If the backend returns a JSON array instead of text/event-stream, use\n+ * `harness.getEventsOnce` to poll.\n+ */\n+export function openRunEvents(\n+  runId: string,\n+  onEvent: (ev: RunEvent) => void,\n+  onError?: (e: Event) => void,\n+): EventSource {\n+  const url = `${getBaseUrl()}/api/runs/${runId}/events`;\n+  const es = new EventSource(url);\n+  es.onmessage = (m) => {\n+    try {\n+      onEvent(JSON.parse(m.data));\n+    } catch {\n+      onEvent({ type: \"raw\", data: m.data } as RunEvent);\n+    }\n+  };\n+  if (onError) es.onerror = onError;\n+  return es;\n+}"},{"sha":"099ec450409005f76d71fb4e2e168d66c4a18b42","filename":"extractions/shovs-agent-harness/frontend/src/lib/harness-config.ts","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-config.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-config.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Fharness-config.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,23 @@\n+const DEFAULT_BASE = \"http://127.0.0.1:8095\";\n+const BASE_KEY = \"shovs.harness.baseUrl\";\n+const MODE_KEY = \"shovs.harness.mode\";\n+\n+export type Mode = \"consumer\" | \"researcher\" | \"operator\" | \"builder\";\n+\n+export function getBaseUrl(): string {\n+  if (typeof window === \"undefined\") return DEFAULT_BASE;\n+  return window.localStorage.getItem(BASE_KEY) || DEFAULT_BASE;\n+}\n+\n+export function setBaseUrl(url: string) {\n+  window.localStorage.setItem(BASE_KEY, url.replace(/\\/$/, \"\"));\n+}\n+\n+export function getMode(): Mode {\n+  if (typeof window === \"undefined\") return \"consumer\";\n+  return (window.localStorage.getItem(MODE_KEY) as Mode) || \"consumer\";\n+}\n+\n+export function setMode(mode: Mode) {\n+  window.localStorage.setItem(MODE_KEY, mode);\n+}"},{"sha":"d1f9b1b009111538a2a65a79edf1f85a4f3424f1","filename":"extractions/shovs-agent-harness/frontend/src/lib/lovable-error-reporting.ts","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Flovable-error-reporting.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Flovable-error-reporting.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Flovable-error-reporting.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,36 @@\n+type LovableErrorOptions = {\n+  mechanism?: \"manual\" | \"onerror\" | \"unhandledrejection\" | \"react_error_boundary\";\n+  handled?: boolean;\n+  severity?: \"error\" | \"warning\" | \"info\";\n+};\n+\n+type LovableEvents = {\n+  captureException?: (\n+    error: unknown,\n+    context?: Record<string, unknown>,\n+    options?: LovableErrorOptions,\n+  ) => void;\n+};\n+\n+declare global {\n+  interface Window {\n+    __lovableEvents?: LovableEvents;\n+  }\n+}\n+\n+export function reportLovableError(error: unknown, context: Record<string, unknown> = {}) {\n+  if (typeof window === \"undefined\") return;\n+  window.__lovableEvents?.captureException?.(\n+    error,\n+    {\n+      source: \"react_error_boundary\",\n+      route: window.location.pathname,\n+      ...context,\n+    },\n+    {\n+      mechanism: \"react_error_boundary\",\n+      handled: false,\n+      severity: \"error\",\n+    },\n+  );\n+}"},{"sha":"a5ef193506d07d0459fec4f187af08283094d7c8","filename":"extractions/shovs-agent-harness/frontend/src/lib/utils.ts","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Futils.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Futils.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Flib%2Futils.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,6 @@\n+import { clsx, type ClassValue } from \"clsx\";\n+import { twMerge } from \"tailwind-merge\";\n+\n+export function cn(...inputs: ClassValue[]) {\n+  return twMerge(clsx(inputs));\n+}"},{"sha":"20a48e518017c38f1c0973f6e6bb4bed9d8d49a5","filename":"extractions/shovs-agent-harness/frontend/src/routeTree.gen.ts","status":"added","additions":69,"deletions":0,"changes":69,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2FrouteTree.gen.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2FrouteTree.gen.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2FrouteTree.gen.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,69 @@\n+/* eslint-disable */\n+\n+// @ts-nocheck\n+\n+// noinspection JSUnusedGlobalSymbols\n+\n+// This file was automatically generated by TanStack Router.\n+// You should NOT make any changes in this file as it will be overwritten.\n+// Additionally, you should also exclude this file from your linter and/or formatter to prevent it from being checked or modified.\n+\n+import { Route as rootRouteImport } from './routes/__root'\n+import { Route as IndexRouteImport } from './routes/index'\n+\n+const IndexRoute = IndexRouteImport.update({\n+  id: '/',\n+  path: '/',\n+  getParentRoute: () => rootRouteImport,\n+} as any)\n+\n+export interface FileRoutesByFullPath {\n+  '/': typeof IndexRoute\n+}\n+export interface FileRoutesByTo {\n+  '/': typeof IndexRoute\n+}\n+export interface FileRoutesById {\n+  __root__: typeof rootRouteImport\n+  '/': typeof IndexRoute\n+}\n+export interface FileRouteTypes {\n+  fileRoutesByFullPath: FileRoutesByFullPath\n+  fullPaths: '/'\n+  fileRoutesByTo: FileRoutesByTo\n+  to: '/'\n+  id: '__root__' | '/'\n+  fileRoutesById: FileRoutesById\n+}\n+export interface RootRouteChildren {\n+  IndexRoute: typeof IndexRoute\n+}\n+\n+declare module '@tanstack/react-router' {\n+  interface FileRoutesByPath {\n+    '/': {\n+      id: '/'\n+      path: '/'\n+      fullPath: '/'\n+      preLoaderRoute: typeof IndexRouteImport\n+      parentRoute: typeof rootRouteImport\n+    }\n+  }\n+}\n+\n+const rootRouteChildren: RootRouteChildren = {\n+  IndexRoute: IndexRoute,\n+}\n+export const routeTree = rootRouteImport\n+  ._addFileChildren(rootRouteChildren)\n+  ._addFileTypes<FileRouteTypes>()\n+\n+import type { getRouter } from './router.tsx'\n+import type { startInstance } from './start.ts'\n+declare module '@tanstack/react-start' {\n+  interface Register {\n+    ssr: true\n+    router: Awaited<ReturnType<typeof getRouter>>\n+    config: Awaited<ReturnType<typeof startInstance.getOptions>>\n+  }\n+}"},{"sha":"3423d598036579e62f42faec438f868b4bb0bb17","filename":"extractions/shovs-agent-harness/frontend/src/router.tsx","status":"added","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Frouter.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Frouter.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Frouter.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,16 @@\n+import { QueryClient } from \"@tanstack/react-query\";\n+import { createRouter } from \"@tanstack/react-router\";\n+import { routeTree } from \"./routeTree.gen\";\n+\n+export const getRouter = () => {\n+  const queryClient = new QueryClient();\n+\n+  const router = createRouter({\n+    routeTree,\n+    context: { queryClient },\n+    scrollRestoration: true,\n+    defaultPreloadStaleTime: 0,\n+  });\n+\n+  return router;\n+};"},{"sha":"441a4e8235d1432e015c8f7a0bf045b031c565ad","filename":"extractions/shovs-agent-harness/frontend/src/routes/README.md","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2FREADME.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2FREADME.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2FREADME.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,21 @@\n+# Routes\n+\n+TanStack Start uses **file-based routing**. Every `.tsx` file in this directory\n+defines a route. Do **not** create `src/pages/`, `src/routes/_app/index.tsx`, or\n+`app/layout.tsx` — those are Next.js / Remix conventions. The only root layout\n+is `src/routes/__root.tsx`.\n+\n+## Conventions\n+\n+| File | URL |\n+| --- | --- |\n+| `index.tsx` | `/` |\n+| `about.tsx` | `/about` |\n+| `users/index.tsx` | `/users` |\n+| `users/$id.tsx` | `/users/:id` (dynamic — bare `$`, no curly braces) |\n+| `posts/{-$category}.tsx` | `/posts/:category?` (optional segment) |\n+| `files/$.tsx` | `/files/*` (splat — read via `_splat` param, never `*`) |\n+| `_layout.tsx` | layout route (renders children via `<Outlet />`) |\n+| `__root.tsx` | app shell — wraps every page; preserve `<Outlet />` |\n+\n+`routeTree.gen.ts` is auto-generated. Don't edit it by hand."},{"sha":"3c4984b9af0602cebbf2eb5614833b537579a8d0","filename":"extractions/shovs-agent-harness/frontend/src/routes/__root.tsx","status":"added","additions":134,"deletions":0,"changes":134,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2F__root.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2F__root.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2F__root.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,134 @@\n+import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\n+import {\n+  Outlet,\n+  Link,\n+  createRootRouteWithContext,\n+  useRouter,\n+  HeadContent,\n+  Scripts,\n+} from \"@tanstack/react-router\";\n+import { useEffect, type ReactNode } from \"react\";\n+\n+import appCss from \"../styles.css?url\";\n+import { reportLovableError } from \"../lib/lovable-error-reporting\";\n+import { Toaster } from \"@/components/ui/sonner\";\n+\n+function NotFoundComponent() {\n+  return (\n+    <div className=\"flex min-h-screen items-center justify-center bg-background px-4\">\n+      <div className=\"max-w-md text-center\">\n+        <h1 className=\"text-7xl font-bold text-foreground\">404</h1>\n+        <h2 className=\"mt-4 text-xl font-semibold text-foreground\">Page not found</h2>\n+        <p className=\"mt-2 text-sm text-muted-foreground\">\n+          The page you're looking for doesn't exist or has been moved.\n+        </p>\n+        <div className=\"mt-6\">\n+          <Link\n+            to=\"/\"\n+            className=\"inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n+          >\n+            Go home\n+          </Link>\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function ErrorComponent({ error, reset }: { error: Error; reset: () => void }) {\n+  console.error(error);\n+  const router = useRouter();\n+  useEffect(() => {\n+    reportLovableError(error, { boundary: \"tanstack_root_error_component\" });\n+  }, [error]);\n+\n+  return (\n+    <div className=\"flex min-h-screen items-center justify-center bg-background px-4\">\n+      <div className=\"max-w-md text-center\">\n+        <h1 className=\"text-xl font-semibold tracking-tight text-foreground\">\n+          This page didn't load\n+        </h1>\n+        <p className=\"mt-2 text-sm text-muted-foreground\">\n+          Something went wrong on our end. You can try refreshing or head back home.\n+        </p>\n+        <div className=\"mt-6 flex flex-wrap justify-center gap-2\">\n+          <button\n+            onClick={() => {\n+              router.invalidate();\n+              reset();\n+            }}\n+            className=\"inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n+          >\n+            Try again\n+          </button>\n+          <a\n+            href=\"/\"\n+            className=\"inline-flex items-center justify-center rounded-md border border-input bg-background px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent\"\n+          >\n+            Go home\n+          </a>\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+export const Route = createRootRouteWithContext<{ queryClient: QueryClient }>()({\n+  head: () => ({\n+    meta: [\n+      { charSet: \"utf-8\" },\n+      { name: \"viewport\", content: \"width=device-width, initial-scale=1\" },\n+      { title: \"Shovs Harness — Runtime\" },\n+      {\n+        name: \"description\",\n+        content:\n+          \"Product surface for the Shovs agent harness. Draft a request, watch the run, inspect evidence and memory.\",\n+      },\n+      { property: \"og:title\", content: \"Shovs Harness — Runtime\" },\n+      {\n+        property: \"og:description\",\n+        content:\n+          \"Product surface for the Shovs agent harness. Draft a request, watch the run, inspect evidence and memory.\",\n+      },\n+      { property: \"og:type\", content: \"website\" },\n+      { name: \"twitter:card\", content: \"summary_large_image\" },\n+    ],\n+    links: [\n+      {\n+        rel: \"stylesheet\",\n+        href: appCss,\n+      },\n+      { rel: \"icon\", href: \"/favicon.ico\", type: \"image/x-icon\" },\n+    ],\n+  }),\n+  shellComponent: RootShell,\n+  component: RootComponent,\n+  notFoundComponent: NotFoundComponent,\n+  errorComponent: ErrorComponent,\n+});\n+\n+function RootShell({ children }: { children: ReactNode }) {\n+  return (\n+    <html lang=\"en\">\n+      <head>\n+        <HeadContent />\n+      </head>\n+      <body>\n+        {children}\n+        <Scripts />\n+      </body>\n+    </html>\n+  );\n+}\n+\n+function RootComponent() {\n+  const { queryClient } = Route.useRouteContext();\n+\n+  return (\n+    <QueryClientProvider client={queryClient}>\n+      {/* Required: nested routes render here. Removing <Outlet /> breaks all child routes. */}\n+      <Outlet />\n+      <Toaster />\n+    </QueryClientProvider>\n+  );\n+}"},{"sha":"964bcb092b6b2cb675475a648bd91fd750d5cda4","filename":"extractions/shovs-agent-harness/frontend/src/routes/index.tsx","status":"added","additions":1575,"deletions":0,"changes":1575,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2Findex.tsx","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2Findex.tsx","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Froutes%2Findex.tsx?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,1575 @@\n+import { createFileRoute } from \"@tanstack/react-router\";\n+import { useEffect, useMemo, useRef, useState } from \"react\";\n+import { useMutation, useQuery, useQueryClient } from \"@tanstack/react-query\";\n+import {\n+  AlertCircle,\n+  ArrowUp,\n+  Brain,\n+  CheckCircle2,\n+  ChevronRight,\n+  Circle,\n+  Database,\n+  Layers,\n+  Loader2,\n+  MessageSquareText,\n+  Network,\n+  Play,\n+  RefreshCw,\n+  Settings2,\n+  Sparkles,\n+  Square,\n+  Wrench,\n+  Zap,\n+} from \"lucide-react\";\n+\n+import { Button } from \"@/components/ui/button\";\n+import { Textarea } from \"@/components/ui/textarea\";\n+import { Input } from \"@/components/ui/input\";\n+import {\n+  Sheet,\n+  SheetContent,\n+  SheetDescription,\n+  SheetHeader,\n+  SheetTitle,\n+  SheetTrigger,\n+} from \"@/components/ui/sheet\";\n+import { ScrollArea } from \"@/components/ui/scroll-area\";\n+import { Tabs, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n+import { cn } from \"@/lib/utils\";\n+import { toast } from \"sonner\";\n+\n+import {\n+  harness,\n+  normalizeEvents,\n+  normalizeFacts,\n+  normalizeRuns,\n+  openRunEvents,\n+  type Fact,\n+  type RunEvent,\n+  type RunRecord,\n+  type RunSummary,\n+  type WorkflowSpec,\n+} from \"@/lib/harness-client\";\n+import {\n+  getBaseUrl,\n+  getMode,\n+  setBaseUrl,\n+  setMode,\n+  type Mode,\n+} from \"@/lib/harness-config\";\n+\n+export const Route = createFileRoute(\"/\")({\n+  component: HarnessApp,\n+});\n+\n+/* ---------- Types ---------- */\n+\n+type Turn = {\n+  runId: string;\n+  objective: string;\n+  startedAt: number;\n+};\n+\n+type Reveal = \"none\" | \"workflows\" | \"inspect\" | \"memory\";\n+\n+function createSessionId(): string {\n+  const cryptoId = globalThis.crypto?.randomUUID?.();\n+  return cryptoId ? `sess_${cryptoId.slice(0, 13)}` : `sess_${Date.now().toString(36)}`;\n+}\n+\n+function getStoredSessionId(): string {\n+  if (typeof window === \"undefined\") return \"default\";\n+  const existing = window.localStorage.getItem(\"shovs-agent-harness-session\");\n+  if (existing) return existing;\n+  const next = createSessionId();\n+  window.localStorage.setItem(\"shovs-agent-harness-session\", next);\n+  return next;\n+}\n+\n+/* ---------- Shell ---------- */\n+\n+function HarnessApp() {\n+  const [mode, setModeState] = useState<Mode>(\"consumer\");\n+  const [baseUrl, setBaseUrlState] = useState<string>(\"\");\n+  const [sessionId, setSessionId] = useState<string>(\"default\");\n+  const [turns, setTurns] = useState<Turn[]>([]);\n+  const [composerValue, setComposerValue] = useState(\"\");\n+  const [reveal, setReveal] = useState<Reveal>(\"none\");\n+  const scrollerRef = useRef<HTMLDivElement>(null);\n+\n+  useEffect(() => {\n+    setModeState(getMode());\n+    setBaseUrlState(getBaseUrl());\n+    setSessionId(getStoredSessionId());\n+  }, []);\n+\n+  const health = useQuery({\n+    queryKey: [\"health\", baseUrl],\n+    queryFn: harness.health,\n+    refetchInterval: 15000,\n+    retry: false,\n+    enabled: baseUrl.length > 0,\n+  });\n+\n+  const manifest = useQuery({\n+    queryKey: [\"manifest\", baseUrl],\n+    queryFn: harness.manifest,\n+    retry: false,\n+    enabled: baseUrl.length > 0,\n+  });\n+\n+  const jobs = useQuery({\n+    queryKey: [\"jobs\", baseUrl],\n+    queryFn: harness.jobs,\n+    refetchInterval: 2500,\n+    retry: false,\n+    enabled: baseUrl.length > 0,\n+  });\n+\n+  const addTurn = (t: Turn) => {\n+    setTurns((prev) => [...prev, t]);\n+    requestAnimationFrame(() => {\n+      scrollerRef.current?.scrollTo({\n+        top: scrollerRef.current.scrollHeight,\n+        behavior: \"smooth\",\n+      });\n+    });\n+  };\n+\n+  const clear = () => {\n+    const next = createSessionId();\n+    window.localStorage.setItem(\"shovs-agent-harness-session\", next);\n+    setSessionId(next);\n+    setTurns([]);\n+  };\n+\n+  const online = health.data ? true : health.isError ? false : null;\n+\n+  return (\n+    <div className=\"h-screen w-full flex flex-col bg-background text-foreground overflow-hidden\">\n+      {/* Top bar */}\n+      <header className=\"hairline border-b bg-surface-1/60 backdrop-blur\">\n+        <div className=\"mx-auto max-w-6xl px-4 h-12 flex items-center gap-3\">\n+          <div className=\"flex items-center gap-2\">\n+            <div className=\"h-6 w-6 rounded-md bg-foreground text-background grid place-items-center\">\n+              <Zap className=\"h-3.5 w-3.5\" />\n+            </div>\n+            <span className=\"text-[13px] font-medium tracking-tight\">\n+              Shovs Harness\n+            </span>\n+          </div>\n+\n+          <div className=\"flex items-center gap-2 pl-2 ml-1 border-l hairline\">\n+            <StatusOrb ok={online} />\n+            <span className=\"text-[11px] text-muted-foreground font-mono\">\n+              {baseUrl || \"no backend\"}\n+            </span>\n+            {manifest.data?.tool_mode ? (\n+              <Chip>{String(manifest.data.tool_mode)}</Chip>\n+            ) : null}\n+            {jobs.data ? (\n+              <Chip>\n+                {jobs.data.active_jobs}/{jobs.data.max_workers} jobs\n+              </Chip>\n+            ) : null}\n+          </div>\n+\n+          <div className=\"ml-auto flex items-center gap-2\">\n+            <Tabs\n+              value={mode}\n+              onValueChange={(v) => {\n+                const m = v as Mode;\n+                setModeState(m);\n+                setMode(m);\n+              }}\n+            >\n+              <TabsList className=\"h-7 bg-muted/60 p-0.5\">\n+                <TabsTrigger value=\"consumer\" className=\"text-[11px] px-2.5 h-6\">\n+                  Chat\n+                </TabsTrigger>\n+                <TabsTrigger value=\"researcher\" className=\"text-[11px] px-2.5 h-6\">\n+                  Trace\n+                </TabsTrigger>\n+                <TabsTrigger value=\"operator\" className=\"text-[11px] px-2.5 h-6\">\n+                  Operator\n+                </TabsTrigger>\n+                <TabsTrigger value=\"builder\" className=\"text-[11px] px-2.5 h-6\">\n+                  Builder\n+                </TabsTrigger>\n+              </TabsList>\n+            </Tabs>\n+            <SettingsSheet\n+              baseUrl={baseUrl}\n+              onSave={(u) => {\n+                setBaseUrl(u);\n+                setBaseUrlState(u);\n+              }}\n+            />\n+          </div>\n+        </div>\n+      </header>\n+\n+      {/* Body */}\n+      <div className=\"flex-1 min-h-0 mx-auto max-w-6xl w-full px-4 py-4\">\n+          <CapabilityRail\n+            reveal={reveal}\n+            onReveal={(next) => setReveal((current) => (current === next ? \"none\" : next))}\n+            onClear={clear}\n+            latestRunId={turns.at(-1)?.runId || \"\"}\n+            sessionId={sessionId}\n+          />\n+        <div\n+          className={cn(\n+            \"grid gap-4 min-h-0 h-[calc(100vh-7.5rem)]\",\n+            reveal === \"none\" ? \"grid-cols-1\" : \"grid-cols-1 lg:grid-cols-[minmax(0,1fr)_360px]\",\n+          )}\n+        >\n+          {/* Thread + composer */}\n+          <section className=\"flex flex-col min-h-0 relative\">\n+          <div\n+            ref={scrollerRef}\n+            className=\"flex-1 min-h-0 overflow-y-auto pr-1 pb-40\"\n+          >\n+            {turns.length === 0 ? (\n+              <EmptyState onPickPrompt={setComposerValue} />\n+            ) : (\n+              <div className=\"flex flex-col gap-6 pt-2\">\n+                {turns.map((t) => (\n+                  <TurnView key={t.runId} turn={t} mode={mode} />\n+                ))}\n+              </div>\n+            )}\n+          </div>\n+\n+          {/* Sticky composer */}\n+          <div className=\"absolute left-0 right-0 bottom-0 pt-6 pb-4 bg-gradient-to-t from-background via-background to-transparent\">\n+              <Composer\n+                value={composerValue}\n+                onValueChange={setComposerValue}\n+                onSubmit={addTurn}\n+                online={online !== false}\n+                sessionId={sessionId}\n+              />\n+          </div>\n+          </section>\n+          {reveal !== \"none\" && (\n+            <RevealPanel\n+              reveal={reveal}\n+              onClose={() => setReveal(\"none\")}\n+              onRun={addTurn}\n+              activeRunId={turns.at(-1)?.runId || \"\"}\n+              mode={mode}\n+              sessionId={sessionId}\n+            />\n+          )}\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+/* ---------- Empty state ---------- */\n+\n+function EmptyState({ onPickPrompt }: { onPickPrompt: (prompt: string) => void }) {\n+  const samples = [\n+    \"Create an agent workflow that compares product prices across stores\",\n+    \"Diagnose checkout timeouts in the last 24h\",\n+    \"Top 3 stocks today with 3 sources each\",\n+  ];\n+  return (\n+    <div className=\"h-full flex flex-col items-center justify-center text-center gap-6 py-16\">\n+      <div className=\"h-10 w-10 rounded-xl bg-surface-2 hairline border grid place-items-center\">\n+        <Sparkles className=\"h-5 w-5 text-text-accent\" />\n+      </div>\n+      <div>\n+        <h1 className=\"text-lg font-medium tracking-tight\">\n+          What should the harness do?\n+        </h1>\n+        <p className=\"text-sm text-muted-foreground mt-1\">\n+          Ask a question or hand it an objective. It plans, calls tools, and\n+          returns linked evidence.\n+        </p>\n+      </div>\n+      <div className=\"flex flex-wrap gap-2 justify-center max-w-lg\">\n+        {samples.map((s) => (\n+          <button\n+            key={s}\n+            onClick={() => {\n+              onPickPrompt(s);\n+              requestAnimationFrame(() => {\n+                document.getElementById(\"composer-input\")?.focus();\n+              });\n+            }}\n+            className=\"text-[12px] px-3 py-1.5 rounded-full hairline border bg-surface-2 hover:bg-muted transition-colors text-muted-foreground hover:text-foreground\"\n+          >\n+            {s}\n+          </button>\n+        ))}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function CapabilityRail({\n+  reveal,\n+  onReveal,\n+  onClear,\n+  latestRunId,\n+  sessionId,\n+}: {\n+  reveal: Reveal;\n+  onReveal: (next: Reveal) => void;\n+  onClear: () => void;\n+  latestRunId: string;\n+  sessionId: string;\n+}) {\n+  return (\n+    <div className=\"mb-3 flex items-center gap-2 overflow-x-auto pb-1\">\n+      <button\n+        onClick={onClear}\n+        className=\"h-8 px-3 rounded-full hairline border bg-surface-2 text-[12px] text-muted-foreground hover:text-foreground hover:bg-muted transition-colors inline-flex items-center gap-1.5 shrink-0\"\n+      >\n+        <RefreshCw className=\"h-3.5 w-3.5\" />\n+        New\n+      </button>\n+      <RevealButton\n+        active={reveal === \"workflows\"}\n+        onClick={() => onReveal(\"workflows\")}\n+        icon={<Network className=\"h-3.5 w-3.5\" />}\n+        label=\"Workflows\"\n+      />\n+      <RevealButton\n+        active={reveal === \"inspect\"}\n+        onClick={() => onReveal(\"inspect\")}\n+        icon={<Database className=\"h-3.5 w-3.5\" />}\n+        label={latestRunId ? \"Inspect\" : \"Runs\"}\n+      />\n+      <RevealButton\n+        active={reveal === \"memory\"}\n+        onClick={() => onReveal(\"memory\")}\n+        icon={<Brain className=\"h-3.5 w-3.5\" />}\n+        label=\"Memory\"\n+      />\n+      <div className=\"ml-auto hidden sm:flex items-center gap-2 text-[11px] text-muted-foreground\">\n+        <Sparkles className=\"h-3.5 w-3.5 text-text-accent\" />\n+        <span className=\"font-mono\">{sessionId.slice(0, 18)}</span>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function RevealButton({\n+  active,\n+  onClick,\n+  icon,\n+  label,\n+}: {\n+  active: boolean;\n+  onClick: () => void;\n+  icon: React.ReactNode;\n+  label: string;\n+}) {\n+  return (\n+    <button\n+      onClick={onClick}\n+      className={cn(\n+        \"h-8 px-3 rounded-full hairline border text-[12px] transition-colors inline-flex items-center gap-1.5 shrink-0\",\n+        active\n+          ? \"bg-foreground text-background border-transparent\"\n+          : \"bg-surface-2 text-muted-foreground hover:text-foreground hover:bg-muted\",\n+      )}\n+    >\n+      {icon}\n+      {label}\n+    </button>\n+  );\n+}\n+\n+function RevealPanel({\n+  reveal,\n+  onClose,\n+  onRun,\n+  activeRunId,\n+  mode,\n+  sessionId,\n+}: {\n+  reveal: Reveal;\n+  onClose: () => void;\n+  onRun: (t: Turn) => void;\n+  activeRunId: string;\n+  mode: Mode;\n+  sessionId: string;\n+}) {\n+  return (\n+    <aside className=\"fade-up min-h-0 overflow-hidden rounded-2xl hairline border bg-surface-2 flex flex-col\">\n+      <div className=\"h-11 px-4 border-b hairline flex items-center gap-2\">\n+        <span className=\"text-[12px] font-medium\">\n+          {reveal === \"workflows\" ? \"Workflow mesh\" : reveal === \"memory\" ? \"Memory\" : \"Run inspector\"}\n+        </span>\n+        <button\n+          onClick={onClose}\n+          className=\"ml-auto text-[11px] text-muted-foreground hover:text-foreground\"\n+        >\n+          Close\n+        </button>\n+      </div>\n+      <ScrollArea className=\"min-h-0 flex-1\">\n+        <div className=\"p-3\">\n+          {reveal === \"workflows\" ? (\n+            <WorkflowReveal onRun={onRun} sessionId={sessionId} />\n+          ) : reveal === \"memory\" ? (\n+            <MemoryPanel />\n+          ) : (\n+            <InspectReveal runId={activeRunId} mode={mode} sessionId={sessionId} />\n+          )}\n+        </div>\n+      </ScrollArea>\n+    </aside>\n+  );\n+}\n+\n+function WorkflowReveal({ onRun, sessionId }: { onRun: (t: Turn) => void; sessionId: string }) {\n+  const qc = useQueryClient();\n+  const [selectedId, setSelectedId] = useState(\"\");\n+  const [runObjective, setRunObjective] = useState(\"\");\n+  const workflows = useQuery({\n+    queryKey: [\"workflows\"],\n+    queryFn: harness.listWorkflows,\n+    refetchInterval: 4000,\n+  });\n+  const tools = useQuery({\n+    queryKey: [\"tools\"],\n+    queryFn: harness.tools,\n+    refetchInterval: 15000,\n+  });\n+  const run = useMutation({\n+    mutationFn: (workflow: WorkflowSpec) =>\n+      harness.startWorkflow(workflow.workflow_id, {\n+        objective: runObjective.trim() || workflow.objective || \"\",\n+        session_id: sessionId,\n+      }),\n+    onSuccess: (record) => {\n+      onRun({\n+        runId: record.run_id,\n+        objective: record.objective || \"Workflow run\",\n+        startedAt: Date.now(),\n+      });\n+      setRunObjective(\"\");\n+      qc.invalidateQueries({ queryKey: [\"runs\"] });\n+    },\n+    onError: (e: Error) => toast.error(e.message),\n+  });\n+  const items = workflows.data?.workflows || [];\n+  const selected = items.find((item) => item.workflow_id === selectedId) || items[0];\n+  const manifestTools = ((tools.data as { tools?: unknown[] } | undefined)?.tools || []) as {\n+    name?: string;\n+    category?: string;\n+  }[];\n+\n+  if (!workflows.isLoading && items.length === 0) {\n+    return (\n+      <div className=\"flex flex-col gap-3\">\n+        <div className=\"rounded-xl bg-surface-1 hairline border p-3\">\n+          <div className=\"text-[13px] font-medium\">No workflows yet</div>\n+          <p className=\"mt-1 text-[12px] text-muted-foreground leading-relaxed\">\n+            Create them from chat. Example: “Create an agent workflow that gathers top movers stocks and news.”\n+          </p>\n+        </div>\n+        <ToolCapsule tools={manifestTools} />\n+      </div>\n+    );\n+  }\n+\n+  return (\n+    <div className=\"flex flex-col gap-3\">\n+      <div className=\"grid gap-1.5\">\n+        {items.map((workflow) => (\n+          <button\n+            key={workflow.workflow_id}\n+            onClick={() => setSelectedId(workflow.workflow_id)}\n+            className={cn(\n+              \"text-left rounded-xl hairline border px-3 py-2 bg-surface-1 hover:bg-muted transition-colors\",\n+              selected?.workflow_id === workflow.workflow_id && \"border-text-accent bg-bg-accent/40\",\n+            )}\n+          >\n+            <div className=\"flex items-center gap-2\">\n+              <Network className=\"h-3.5 w-3.5 text-text-accent shrink-0\" />\n+              <div className=\"min-w-0\">\n+                <div className=\"truncate text-[13px] font-medium\">\n+                  {workflow.label || workflow.workflow_id}\n+                </div>\n+                <div className=\"truncate font-mono text-[10.5px] text-muted-foreground\">\n+                  {workflow.policy || \"policy\"} · {(workflow.tools || []).slice(0, 3).join(\", \")}\n+                </div>\n+              </div>\n+            </div>\n+          </button>\n+        ))}\n+      </div>\n+      {selected && (\n+        <div className=\"rounded-xl hairline border bg-surface-1 p-3 flex flex-col gap-2\">\n+          <div className=\"text-[11px] uppercase tracking-wider text-muted-foreground\">\n+            Run selected workflow\n+          </div>\n+          <Textarea\n+            value={runObjective}\n+            onChange={(e) => setRunObjective(e.target.value)}\n+            className=\"min-h-[72px] text-[12px] resize-none bg-surface-2\"\n+            placeholder={selected.objective || \"Optional run objective override\"}\n+          />\n+          <Button\n+            size=\"sm\"\n+            className=\"h-8\"\n+            onClick={() => run.mutate(selected)}\n+            disabled={run.isPending}\n+          >\n+            {run.isPending ? <Loader2 className=\"h-3.5 w-3.5 animate-spin\" /> : <Play className=\"h-3.5 w-3.5\" />}\n+            Run workflow\n+          </Button>\n+          <RawBlock data={selected} label=\"Workflow contract\" />\n+        </div>\n+      )}\n+      <ToolCapsule tools={manifestTools} />\n+    </div>\n+  );\n+}\n+\n+function ToolCapsule({ tools }: { tools: { name?: string; category?: string }[] }) {\n+  const grouped = tools.slice(0, 24);\n+  return (\n+    <div className=\"rounded-xl hairline border bg-surface-1 p-3\">\n+      <div className=\"text-[11px] uppercase tracking-wider text-muted-foreground mb-2\">\n+        Runtime tools\n+      </div>\n+      <div className=\"flex flex-wrap gap-1.5\">\n+        {grouped.length === 0 ? (\n+          <span className=\"text-[12px] text-muted-foreground\">Tool manifest not loaded.</span>\n+        ) : (\n+          grouped.map((tool) => (\n+            <span\n+              key={tool.name}\n+              className=\"rounded-full bg-surface-2 hairline border px-2 py-1 text-[10.5px] font-mono text-muted-foreground\"\n+              title={tool.category}\n+            >\n+              {tool.name}\n+            </span>\n+          ))\n+        )}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function InspectReveal({ runId, mode, sessionId }: { runId: string; mode: Mode; sessionId: string }) {\n+  const runs = useQuery({\n+    queryKey: [\"runs\"],\n+    queryFn: harness.listRuns,\n+    refetchInterval: 3000,\n+  });\n+  const run = useQuery({\n+    queryKey: [\"run\", runId, \"inspect\"],\n+    queryFn: () => harness.getRun(runId),\n+    enabled: Boolean(runId),\n+    refetchInterval: 1500,\n+  });\n+  const items = normalizeRuns(runs.data as RunSummary[] | { runs: RunSummary[] } | undefined);\n+  const chat = useQuery({\n+    queryKey: [\"chat\", sessionId],\n+    queryFn: () => harness.listChat(sessionId, 12),\n+    refetchInterval: 3000,\n+  });\n+  return (\n+    <div className=\"flex flex-col gap-3\">\n+      {runId && run.data ? (\n+        <>\n+          <ContextPacket runId={runId} run={run.data} />\n+          <ActivityStream\n+            events={normalizeEvents(run.data.events as RunEvent[] | undefined)}\n+            isRunning={![\"completed\", \"blocked\", \"failed\", \"error\", \"interrupted\"].includes(run.data.status || \"\")}\n+          />\n+          {mode === \"operator\" && <RawBlock data={run.data} />}\n+        </>\n+      ) : (\n+        <div className=\"text-[12px] text-muted-foreground\">No active run selected.</div>\n+      )}\n+      <div className=\"rounded-xl hairline border bg-surface-1 p-3\">\n+        <div className=\"text-[11px] uppercase tracking-wider text-muted-foreground mb-2\">\n+          Session memory\n+        </div>\n+        <div className=\"flex flex-col gap-1\">\n+          {(chat.data?.compact || []).slice(-6).map((item, index) => (\n+            <div key={index} className=\"rounded-md bg-surface-2 hairline border px-2 py-1.5\">\n+              <div className=\"text-[10px] uppercase text-muted-foreground\">\n+                {String(item.role || \"turn\")}\n+              </div>\n+              <div className=\"text-[11.5px] leading-relaxed\">{String(item.summary || \"\")}</div>\n+            </div>\n+          ))}\n+          {!chat.data?.compact?.length && (\n+            <div className=\"text-[12px] text-muted-foreground\">No stored turns yet.</div>\n+          )}\n+        </div>\n+      </div>\n+      <div className=\"rounded-xl hairline border bg-surface-1 p-3\">\n+        <div className=\"text-[11px] uppercase tracking-wider text-muted-foreground mb-2\">\n+          Recent runs\n+        </div>\n+        <div className=\"flex flex-col gap-1\">\n+          {items.slice(0, 12).map((item) => (\n+            <div key={item.run_id} className=\"rounded-md bg-surface-2 hairline border px-2 py-1.5\">\n+              <div className=\"flex items-center gap-1.5\">\n+                <RunStatus status={item.status || \"pending\"} />\n+                <span className=\"font-mono text-[10.5px] text-muted-foreground\">\n+                  {item.run_id.slice(0, 10)}\n+                </span>\n+                <span className=\"ml-auto text-[10px] text-muted-foreground\">{item.status}</span>\n+              </div>\n+              <div className=\"mt-0.5 truncate text-[11.5px]\">{item.objective}</div>\n+            </div>\n+          ))}\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function StatusOrb({ ok }: { ok: boolean | null }) {\n+  const color =\n+    ok === true\n+      ? \"bg-text-success\"\n+      : ok === false\n+        ? \"bg-text-danger\"\n+        : \"bg-muted-foreground\";\n+  return (\n+    <span\n+      className={cn(\n+        \"inline-block h-2 w-2 rounded-full\",\n+        color,\n+        ok === null && \"orb-pulse\",\n+      )}\n+    />\n+  );\n+}\n+\n+function Chip({ children }: { children: React.ReactNode }) {\n+  return (\n+    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-bg-accent text-text-accent font-mono\">\n+      {children}\n+    </span>\n+  );\n+}\n+\n+/* ---------- Composer ---------- */\n+\n+function Composer({\n+  value,\n+  onValueChange,\n+  onSubmit,\n+  online,\n+  sessionId,\n+}: {\n+  value: string;\n+  onValueChange: (value: string) => void;\n+  onSubmit: (t: Turn) => void;\n+  online: boolean;\n+  sessionId: string;\n+}) {\n+  const qc = useQueryClient();\n+  const taRef = useRef<HTMLTextAreaElement>(null);\n+\n+  const create = useMutation({\n+    mutationFn: (obj: string) => harness.startRun({ objective: obj, session_id: sessionId }),\n+    onSuccess: (run, obj) => {\n+      onSubmit({ runId: run.run_id, objective: obj, startedAt: Date.now() });\n+      onValueChange(\"\");\n+      qc.invalidateQueries({ queryKey: [\"runs\"] });\n+      requestAnimationFrame(() => taRef.current?.focus());\n+    },\n+    onError: (e: Error) => toast.error(e.message),\n+  });\n+\n+  const submit = () => {\n+    const v = value.trim();\n+    if (!v || create.isPending) return;\n+    create.mutate(v);\n+  };\n+\n+  return (\n+    <div className=\"mx-auto max-w-3xl w-full\">\n+      <div className=\"hairline border rounded-2xl bg-surface-2 shadow-[0_1px_0_rgba(0,0,0,0.02),0_20px_60px_-30px_rgba(0,0,0,0.15)] overflow-hidden\">\n+        <Textarea\n+          id=\"composer-input\"\n+          ref={taRef}\n+          value={value}\n+          onChange={(e) => onValueChange(e.target.value)}\n+          placeholder={\n+            online\n+              ? \"Ask the harness anything…\"\n+              : \"Backend unreachable — check settings.\"\n+          }\n+          className=\"min-h-[64px] max-h-64 border-0 shadow-none focus-visible:ring-0 resize-none text-[14px] px-4 py-3 bg-transparent\"\n+          onKeyDown={(e) => {\n+            if ((e.metaKey || e.ctrlKey) && e.key === \"Enter\") submit();\n+            if (\n+              e.key === \"Enter\" &&\n+              !e.shiftKey &&\n+              !e.nativeEvent.isComposing\n+            ) {\n+              e.preventDefault();\n+              submit();\n+            }\n+          }}\n+        />\n+        <div className=\"flex items-center gap-2 px-3 py-2 border-t hairline\">\n+          <div className=\"flex items-center gap-1.5 text-[11px] text-muted-foreground\">\n+            <kbd className=\"px-1.5 py-0.5 rounded bg-muted font-mono text-[10px]\">\n+              ⏎\n+            </kbd>\n+            <span>send</span>\n+            <span className=\"mx-1\">·</span>\n+            <kbd className=\"px-1.5 py-0.5 rounded bg-muted font-mono text-[10px]\">\n+              ⇧⏎\n+            </kbd>\n+            <span>newline</span>\n+          </div>\n+          <div className=\"ml-auto flex items-center gap-2\">\n+            <Button\n+              size=\"sm\"\n+              onClick={submit}\n+              disabled={!value.trim() || create.isPending}\n+              className=\"h-8 gap-1.5 rounded-lg\"\n+            >\n+              {create.isPending ? (\n+                <Loader2 className=\"h-3.5 w-3.5 animate-spin\" />\n+              ) : (\n+                <ArrowUp className=\"h-3.5 w-3.5\" />\n+              )}\n+              Run\n+            </Button>\n+          </div>\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+/* ---------- Turn (user prompt + agent run) ---------- */\n+\n+function TurnView({ turn, mode }: { turn: Turn; mode: Mode }) {\n+  return (\n+    <div className=\"fade-up max-w-3xl w-full mx-auto flex flex-col gap-3\">\n+      {/* User bubble */}\n+      <div className=\"flex justify-end\">\n+        <div className=\"max-w-[85%] rounded-2xl bg-foreground text-background px-3.5 py-2 text-[13.5px] whitespace-pre-wrap\">\n+          {turn.objective}\n+        </div>\n+      </div>\n+      {/* Agent surface */}\n+      <AgentSurface runId={turn.runId} mode={mode} />\n+    </div>\n+  );\n+}\n+\n+/* ---------- Agent surface ---------- */\n+\n+function AgentSurface({ runId, mode }: { runId: string; mode: Mode }) {\n+  const [events, setEvents] = useState<RunEvent[]>([]);\n+  const [directive, setDirective] = useState(\"\");\n+  const esRef = useRef<EventSource | null>(null);\n+  const qc = useQueryClient();\n+\n+  const run = useQuery({\n+    queryKey: [\"run\", runId],\n+    queryFn: () => harness.getRun(runId),\n+    refetchInterval: (q) => {\n+      const s = (q.state.data as RunRecord | undefined)?.status;\n+      return s && [\"completed\", \"blocked\", \"failed\", \"error\", \"interrupted\"].includes(s)\n+        ? false\n+        : 900;\n+    },\n+  });\n+\n+  useEffect(() => {\n+    setEvents([]);\n+    let cancelled = false;\n+    try {\n+      const es = openRunEvents(\n+        runId,\n+        (ev) => setEvents((p) => [...p, ev]),\n+        () => {\n+          es.close();\n+          esRef.current = null;\n+          harness\n+            .getEventsOnce(runId)\n+            .then((payload) => {\n+              if (!cancelled) setEvents(normalizeEvents(payload));\n+            })\n+            .catch(() => undefined);\n+        },\n+      );\n+      esRef.current = es;\n+    } catch {\n+      harness\n+        .getEventsOnce(runId)\n+        .then((payload) => {\n+          if (!cancelled) setEvents(normalizeEvents(payload));\n+        })\n+        .catch(() => undefined);\n+    }\n+    return () => {\n+      cancelled = true;\n+      esRef.current?.close();\n+      esRef.current = null;\n+    };\n+  }, [runId]);\n+\n+  useEffect(() => {\n+    const runEvents = normalizeEvents(\n+      run.data?.events as RunEvent[] | { events?: RunEvent[] } | undefined,\n+    );\n+    if (runEvents.length) setEvents(runEvents);\n+  }, [run.data?.events]);\n+\n+  const status = run.data?.status ?? \"pending\";\n+  const isRunning = ![\"completed\", \"blocked\", \"failed\", \"error\", \"interrupted\"].includes(status);\n+\n+  const interrupt = useMutation({\n+    mutationFn: () => harness.interruptRun(runId, { reason: directive || \"user requested interrupt\" }),\n+    onSuccess: () => {\n+      run.refetch();\n+      qc.invalidateQueries({ queryKey: [\"runs\"] });\n+      toast.success(\"Run interrupted\");\n+    },\n+    onError: (e: Error) => toast.error(e.message),\n+  });\n+\n+  const continueRun = useMutation({\n+    mutationFn: () => harness.continueRun(runId, { directive }),\n+    onSuccess: (record) => {\n+      setDirective(\"\");\n+      qc.invalidateQueries({ queryKey: [\"runs\"] });\n+      toast.success(`Continued as ${record.run_id.slice(0, 8)}`);\n+    },\n+    onError: (e: Error) => toast.error(e.message),\n+  });\n+\n+  return (\n+    <div className=\"hairline border rounded-2xl bg-surface-2 overflow-hidden\">\n+      {/* Header */}\n+      <div className=\"flex items-center gap-2 px-4 py-2.5 border-b hairline\">\n+        <RunStatus status={status} />\n+        <span className=\"text-[11px] font-mono text-muted-foreground\">\n+          {runId.slice(0, 12)}\n+        </span>\n+        <span className=\"ml-auto flex items-center gap-1.5\">\n+          <Chip>{status}</Chip>\n+          <button\n+            onClick={() => run.refetch()}\n+            className=\"text-muted-foreground hover:text-foreground p-1 rounded\"\n+            aria-label=\"refresh\"\n+          >\n+            <RefreshCw className=\"h-3.5 w-3.5\" />\n+          </button>\n+        </span>\n+      </div>\n+\n+      {mode !== \"consumer\" && (\n+        <div className=\"px-4 py-2 border-b hairline flex flex-col sm:flex-row gap-2\">\n+          <Input\n+            value={directive}\n+            onChange={(e) => setDirective(e.target.value)}\n+            className=\"h-8 text-[12px]\"\n+            placeholder=\"optional directive for interrupt/continue\"\n+          />\n+          <div className=\"flex gap-2\">\n+            <Button\n+              size=\"sm\"\n+              variant=\"secondary\"\n+              className=\"h-8\"\n+              onClick={() => interrupt.mutate()}\n+              disabled={interrupt.isPending || status === \"completed\"}\n+            >\n+              Interrupt\n+            </Button>\n+            <Button\n+              size=\"sm\"\n+              className=\"h-8\"\n+              onClick={() => continueRun.mutate()}\n+              disabled={continueRun.isPending}\n+            >\n+              Continue\n+            </Button>\n+          </div>\n+        </div>\n+      )}\n+\n+      {/* Phase timeline */}\n+      <div className=\"px-4 pt-3\">\n+        <PhaseTimeline events={events} status={status} />\n+      </div>\n+\n+      {/* Body */}\n+      <div className=\"px-4 py-4 flex flex-col gap-4\">\n+        {/* Runtime activity */}\n+        <ActivityStream events={events} isRunning={isRunning} />\n+\n+        {/* Answer */}\n+        <AnswerBlock run={run.data} isRunning={isRunning} />\n+\n+        {/* Researcher + operator extras */}\n+        {mode !== \"consumer\" && (\n+          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n+            <ContextPacket runId={runId} run={run.data} />\n+            <MemoryGraph runId={runId} />\n+          </div>\n+        )}\n+\n+        {mode === \"operator\" && <RawBlock data={run.data} />}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function RunStatus({ status }: { status: string }) {\n+  if (status === \"completed\")\n+    return <CheckCircle2 className=\"h-4 w-4 text-text-success\" />;\n+  if ([\"failed\", \"error\", \"blocked\", \"interrupted\"].includes(status))\n+    return <AlertCircle className=\"h-4 w-4 text-text-danger\" />;\n+  if (status === \"pending\")\n+    return <Circle className=\"h-4 w-4 text-muted-foreground\" />;\n+  return <Loader2 className=\"h-4 w-4 animate-spin text-text-accent\" />;\n+}\n+\n+/* ---------- Phase timeline ---------- */\n+\n+const PHASES = [\"plan\", \"act\", \"observe\", \"verify\", \"memory\"] as const;\n+type Phase = (typeof PHASES)[number];\n+\n+function classifyPhase(ev: RunEvent): Phase | null {\n+  const t = String(ev.phase ?? ev.type ?? \"\").toLowerCase();\n+  if (t.includes(\"plan\") || t.includes(\"draft\")) return \"plan\";\n+  if (t.includes(\"intake\") || t.includes(\"understanding\")) return \"plan\";\n+  if (t.includes(\"tool\") || t.includes(\"act\") || t.includes(\"call\")) return \"act\";\n+  if (t.includes(\"model_slot\")) return \"observe\";\n+  if (t.includes(\"evidence\") || t.includes(\"observe\") || t.includes(\"source\"))\n+    return \"observe\";\n+  if (t.includes(\"verify\") || t.includes(\"verdict\") || t.includes(\"eval\"))\n+    return \"verify\";\n+  if (t.includes(\"memory\") || t.includes(\"fact\")) return \"memory\";\n+  return null;\n+}\n+\n+function PhaseTimeline({\n+  events,\n+  status,\n+}: {\n+  events: RunEvent[];\n+  status: string;\n+}) {\n+  const active = new Set<Phase>();\n+  for (const e of events) {\n+    const p = classifyPhase(e);\n+    if (p) active.add(p);\n+  }\n+  const complete = status === \"completed\";\n+  return (\n+    <div>\n+      <div className=\"flex items-center gap-1\">\n+        {PHASES.map((p, i) => {\n+          const on = active.has(p) || (complete && i < PHASES.length);\n+          const running =\n+            !complete && i === Array.from(active).length && active.has(p);\n+          return (\n+            <div\n+              key={p}\n+              className={cn(\n+                \"flex-1 h-[22px] rounded-[3px] grid place-items-center hairline transition-colors\",\n+                on\n+                  ? i < 2\n+                    ? \"bg-bg-success border-transparent\"\n+                    : \"bg-bg-accent border-transparent\"\n+                  : \"border-dashed border bg-surface-1\",\n+                running && \"shimmer\",\n+                i === 0 && \"rounded-l-md\",\n+                i === PHASES.length - 1 && \"rounded-r-md\",\n+              )}\n+            >\n+              <span\n+                className={cn(\n+                  \"text-[10px] font-mono\",\n+                  on\n+                    ? i < 2\n+                      ? \"text-text-success\"\n+                      : \"text-text-accent\"\n+                    : \"text-muted-foreground\",\n+                )}\n+              >\n+                {p}\n+              </span>\n+            </div>\n+          );\n+        })}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+/* ---------- Activity stream ---------- */\n+\n+function ActivityStream({\n+  events,\n+  isRunning,\n+}: {\n+  events: RunEvent[];\n+  isRunning: boolean;\n+}) {\n+  const visibleEvents = useMemo(\n+    () =>\n+      events.filter((e) => {\n+        const t = String(e.phase ?? e.type ?? \"\").toLowerCase();\n+        return t !== \"intake\";\n+      }),\n+    [events],\n+  );\n+\n+  if (visibleEvents.length === 0 && !isRunning) return null;\n+\n+  return (\n+    <div className=\"flex flex-col gap-1.5\">\n+      <div className=\"flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-muted-foreground\">\n+        <Wrench className=\"h-3 w-3\" /> Runtime activity\n+      </div>\n+      <div className=\"flex flex-col gap-1\">\n+        {visibleEvents.slice(-10).map((e, i) => (\n+          <ActivityRow key={e.id || i} ev={e} />\n+        ))}\n+        {isRunning && visibleEvents.length === 0 && (\n+          <div className=\"text-[12px] text-muted-foreground flex items-center gap-2\">\n+            <Loader2 className=\"h-3 w-3 animate-spin\" />\n+            Kernel thinking…\n+          </div>\n+        )}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function ActivityRow({ ev }: { ev: RunEvent }) {\n+  const phase = String(ev.phase ?? ev.type ?? \"event\");\n+  const status = String(ev.status ?? \"info\");\n+  const isResult = status === \"success\" || phase.toLowerCase().includes(\"result\");\n+  const isError = [\"error\", \"blocked\", \"warning\"].includes(status);\n+  const name =\n+    String(ev.data?.backend || ev.data?.tool || ev.data?.name || \"\") ||\n+    phase;\n+  const summary = summarize(ev);\n+  return (\n+    <div className=\"group flex items-start gap-2 rounded-md hairline border px-2.5 py-1.5 bg-surface-1 hover:bg-muted/60 transition-colors\">\n+      {phase === \"understanding\" ? (\n+        <MessageSquareText className=\"h-3 w-3 mt-1 text-text-accent shrink-0\" />\n+      ) : (\n+        <ChevronRight className=\"h-3 w-3 mt-1 text-muted-foreground shrink-0\" />\n+      )}\n+      <div className=\"min-w-0 flex-1\">\n+        <div className=\"flex items-center gap-1.5\">\n+          <span className=\"text-[11.5px] font-mono\">{name}</span>\n+          {isResult ? (\n+            <span className=\"text-[10px] text-text-success\">→ result</span>\n+          ) : isError ? (\n+            <span className=\"text-[10px] text-text-warning\">{status}</span>\n+          ) : (\n+            <span className=\"text-[10px] text-text-accent\">{status}</span>\n+          )}\n+        </div>\n+        {summary && (\n+          <div className=\"text-[11px] text-muted-foreground truncate font-mono\">\n+            {summary}\n+          </div>\n+        )}\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function summarize(ev: RunEvent): string {\n+  const obj = ev as Record<string, unknown>;\n+  if (typeof ev.summary === \"string\" && ev.summary.length > 0) {\n+    return ev.summary.slice(0, 180);\n+  }\n+  const data = (ev.data || {}) as Record<string, unknown>;\n+  for (const k of [\"query\", \"url\", \"input\", \"args\", \"result\", \"output\"]) {\n+    const dv = data[k];\n+    if (typeof dv === \"string\" && dv.length > 0) return dv.slice(0, 160);\n+    if (dv && typeof dv === \"object\") return JSON.stringify(dv).slice(0, 160);\n+    const v = obj[k];\n+    if (typeof v === \"string\" && v.length > 0) return v.slice(0, 160);\n+    if (v && typeof v === \"object\") return JSON.stringify(v).slice(0, 160);\n+  }\n+  return \"\";\n+}\n+\n+/* ---------- Answer ---------- */\n+\n+function AnswerBlock({\n+  run,\n+  isRunning,\n+}: {\n+  run?: RunRecord;\n+  isRunning: boolean;\n+}) {\n+  if (!run || (isRunning && !run.result)) {\n+    return (\n+      <div className=\"flex flex-col gap-2\">\n+        <div className=\"h-3 w-3/5 rounded shimmer\" />\n+        <div className=\"h-3 w-4/5 rounded shimmer\" />\n+        <div className=\"h-3 w-2/5 rounded shimmer\" />\n+      </div>\n+    );\n+  }\n+\n+  const result = run.result as\n+    | {\n+        answer?: string;\n+        summary?: string;\n+        text?: string;\n+        sources?: unknown[];\n+        evidence?: unknown[];\n+        artifacts?: unknown[];\n+        capability?: Record<string, unknown>;\n+      }\n+    | string\n+    | undefined;\n+\n+  const answer =\n+    typeof result === \"string\"\n+      ? result\n+      : result?.answer || result?.summary || result?.text || null;\n+\n+  const sources =\n+    (typeof result === \"object\" && (result?.sources || result?.evidence)) ||\n+    (run.evidence as unknown[]) ||\n+    [];\n+  const artifacts =\n+    (typeof result === \"object\" && Array.isArray(result?.artifacts)\n+      ? result.artifacts\n+      : []) || [];\n+  const capability =\n+    typeof result === \"object\" && result?.capability ? result.capability : null;\n+\n+  return (\n+    <div className=\"flex flex-col gap-4\">\n+      {answer ? (\n+        <div className=\"text-[14px] leading-relaxed whitespace-pre-wrap\">\n+          {answer}\n+        </div>\n+      ) : (\n+        <RawBlock data={run.result} label=\"Result\" />\n+      )}\n+\n+      {artifacts.length > 0 && (\n+        <div className=\"grid gap-2\">\n+          {artifacts.map((artifact, index) => (\n+            <ArtifactCard key={index} artifact={artifact} />\n+          ))}\n+        </div>\n+      )}\n+\n+      {capability && !capability.available && (\n+        <CapabilityGapCard capability={capability} />\n+      )}\n+\n+      {Array.isArray(sources) && sources.length > 0 && (\n+        <div className=\"flex flex-col gap-1.5\">\n+          <div className=\"flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-muted-foreground\">\n+            <Layers className=\"h-3 w-3\" /> Evidence · {sources.length}\n+          </div>\n+          <div className=\"grid gap-1.5\">\n+            {sources.slice(0, 6).map((s, i) => (\n+              <SourceRow key={i} source={s} />\n+            ))}\n+          </div>\n+        </div>\n+      )}\n+    </div>\n+  );\n+}\n+\n+function ArtifactCard({ artifact }: { artifact: unknown }) {\n+  const item = artifact as {\n+    type?: string;\n+    url?: string;\n+    path?: string;\n+    prompt?: string;\n+    model?: string;\n+    bytes?: number;\n+    error?: string;\n+    filename?: string;\n+    label?: string;\n+    agent?: string;\n+    status?: string;\n+  };\n+  const rawUrl = String(item?.url || \"\");\n+  const url = rawUrl.startsWith(\"http\") ? rawUrl : rawUrl ? `${getBaseUrl()}${rawUrl}` : \"\";\n+  if (item?.type === \"report\" || item?.filename?.endsWith(\".md\")) {\n+    return (\n+      <a\n+        href={url}\n+        target=\"_blank\"\n+        rel=\"noreferrer\"\n+        className=\"rounded-xl hairline border bg-surface-1 p-3 hover:bg-muted/60 transition-colors flex items-start gap-3\"\n+      >\n+        <Database className=\"h-4 w-4 text-text-accent mt-0.5 shrink-0\" />\n+        <div className=\"min-w-0\">\n+          <div className=\"text-[12.5px] font-medium truncate\">\n+            {item.label || item.filename || \"Report file\"}\n+          </div>\n+          <div className=\"mt-0.5 text-[10.5px] font-mono text-muted-foreground truncate\">\n+            {item.agent || \"agent\"} · {item.status || \"ready\"} · {item.bytes ? `${item.bytes} bytes` : \"file\"}\n+          </div>\n+          {item.filename && (\n+            <div className=\"mt-1 text-[11px] text-muted-foreground truncate\">\n+              {item.filename}\n+            </div>\n+          )}\n+        </div>\n+      </a>\n+    );\n+  }\n+  return (\n+    <div className=\"rounded-xl hairline border bg-surface-1 overflow-hidden\">\n+      {url ? (\n+        <a href={url} target=\"_blank\" rel=\"noreferrer\" className=\"block\">\n+          <img src={url} alt={item.prompt || \"Generated image\"} className=\"w-full max-h-[420px] object-contain bg-muted\" />\n+        </a>\n+      ) : null}\n+      <div className=\"p-3 flex flex-col gap-1\">\n+        <div className=\"text-[12px] font-medium\">\n+          {item.error ? \"Image generation error\" : \"Generated image\"}\n+        </div>\n+        {item.prompt && <div className=\"text-[11.5px] text-muted-foreground line-clamp-2\">{item.prompt}</div>}\n+        <div className=\"text-[10.5px] font-mono text-muted-foreground\">\n+          {item.model || \"model not recorded\"} · {item.bytes ? `${item.bytes} bytes` : item.path || \"artifact pending\"}\n+        </div>\n+      </div>\n+    </div>\n+  );\n+}\n+\n+function CapabilityGapCard({ capability }: { capability: Record<string, unknown> }) {\n+  const setup = Array.isArray(capability.setup) ? capability.setup.map(String) : [];\n+  const env = Array.isArray(capability.required_env) ? capability.required_env.map(String) : [];\n+  return (\n+    <div className=\"rounded-xl hairline border bg-bg-warning/50 p-3\">\n+      <div className=\"flex items-center gap-2 text-[12px] font-medium text-text-warning\">\n+        <AlertCircle className=\"h-3.5 w-3.5\" />\n+        Capability needs setup\n+      </div>\n+      <div className=\"mt-1 text-[12px] text-muted-foreground\">\n+        {String(capability.capability || \"capability\")} is recognized, but not executable yet.\n+      </div>\n+      {env.length > 0 && (\n+        <div className=\"mt-2 flex flex-wrap gap-1\">\n+          {env.map((item) => (\n+            <span key={item} className=\"rounded-full bg-surface-2 hairline border px-2 py-0.5 text-[10.5px] font-mono\">\n+              {item}\n+            </span>\n+          ))}\n+        </div>\n+      )}\n+      {setup.length > 0 && (\n+        <ul className=\"mt-2 list-disc pl-4 text-[11.5px] text-muted-foreground space-y-1\">\n+          {setup.map((item) => (\n+            <li key={item}>{item}</li>\n+          ))}\n+        </ul>\n+      )}\n+    </div>\n+  );\n+}\n+\n+function SourceRow({ source }: { source: unknown }) {\n+  const s = source as {\n+    url?: string;\n+    title?: string;\n+    snippet?: string;\n+    summary?: string;\n+    entity?: string;\n+  };\n+  if (!s || typeof s !== \"object\") {\n+    return (\n+      <div className=\"text-[11px] font-mono bg-surface-1 hairline border rounded-md px-2.5 py-1.5\">\n+        {String(source)}\n+      </div>\n+    );\n+  }\n+  return (\n+    <a\n+      href={s.url}\n+      target=\"_blank\"\n+      rel=\"noreferrer\"\n+      className=\"block rounded-md hairline border bg-surface-1 hover:bg-muted/60 px-2.5 py-2 transition-colors\"\n+    >\n+      <div className=\"text-[12.5px] font-medium truncate\">\n+        {s.title || s.entity || s.url || \"source\"}\n+      </div>\n+      {s.url && (\n+        <div className=\"text-[10.5px] text-muted-foreground truncate font-mono\">\n+          {s.url}\n+        </div>\n+      )}\n+      {(s.snippet || s.summary) && (\n+        <div className=\"text-[11.5px] text-muted-foreground mt-1 line-clamp-2\">\n+          {s.snippet || s.summary}\n+        </div>\n+      )}\n+    </a>\n+  );\n+}\n+\n+/* ---------- Context / Memory panels ---------- */\n+\n+function ContextPacket({ runId, run }: { runId: string; run?: RunRecord }) {\n+  const context = useQuery({\n+    queryKey: [\"run-context\", runId],\n+    queryFn: () => harness.getContext(runId),\n+    enabled: Boolean(runId),\n+    refetchInterval: run?.status === \"completed\" ? false : 2500,\n+  });\n+  const packet = (\n+    context.data as { context_packet?: Record<string, unknown> } | undefined\n+  )?.context_packet;\n+  const entries: [string, string][] = [];\n+  if (run?.objective) entries.push([\"objective\", String(run.objective)]);\n+  const resultEvidence =\n+    ((run?.result as { evidence?: unknown[] } | undefined)?.evidence as\n+      | unknown[]\n+      | undefined) || [];\n+  const evidenceCount =\n+    Number(packet?.evidence_count || 0) || resultEvidence.length || 0;\n+  if (evidenceCount) entries.push([\"evidence\", `${evidenceCount} items`]);\n+  if (packet?.policy) entries.push([\"policy\", String(packet.policy)]);\n+  if (packet?.next_required_action)\n+    entries.push([\"next\", String(packet.next_required_action)]);\n+  const locked = packet?.locked_entities;\n+  if (Array.isArray(locked) && locked.length)\n+    entries.push([\"locked\", locked.join(\", \")]);\n+  const missing = packet?.missing;\n+  if (Array.isArray(missing) && missing.length)\n+    entries.push([\"missing\", missing.length === 1 ? String(missing[0]) : `${missing.length} gaps`]);\n+  const trace = (run?.trace_ids as string[]) || [];\n+  if (trace.length) entries.push([\"trace\", trace.slice(0, 2).join(\", \")]);\n+  if (run?.status) entries.push([\"status\", String(run.status)]);\n+\n+  return (\n+    <PanelCard\n+      icon={<Database className=\"h-3 w-3\" />}\n+      title=\"Context packet\"\n+    >\n+      {entries.length === 0 ? (\n+        <div className=\"text-[11.5px] text-muted-foreground\">\n+          Awaiting context…\n+        </div>\n+      ) : (\n+        <div className=\"flex flex-col gap-1 font-mono text-[11.5px] text-muted-foreground\">\n+          {entries.map(([k, v]) => (\n+            <div key={k} className=\"truncate\">\n+              <span className=\"text-foreground/70\">{k}:</span> {v}\n+            </div>\n+          ))}\n+        </div>\n+      )}\n+    </PanelCard>\n+  );\n+}\n+\n+function MemoryGraph({ runId }: { runId: string }) {\n+  const q = useQuery({\n+    queryKey: [\"memory\", \"for\", runId],\n+    queryFn: harness.listMemory,\n+    refetchInterval: 4000,\n+  });\n+  const facts = useMemo<Fact[]>(() => {\n+    return normalizeFacts(q.data as Fact[] | { facts: Fact[] } | undefined);\n+  }, [q.data]);\n+\n+  return (\n+    <PanelCard icon={<Network className=\"h-3 w-3\" />} title=\"Memory graph\">\n+      {facts.length === 0 ? (\n+        <div className=\"text-[11.5px] text-muted-foreground\">\n+          No stored facts.\n+        </div>\n+      ) : (\n+        <div className=\"flex flex-col gap-1 font-mono text-[11.5px]\">\n+          {facts.slice(0, 6).map((f) => (\n+            <div\n+              key={f.fact_id}\n+              className={cn(\n+                \"truncate\",\n+                f.status === \"voided\"\n+                  ? \"line-through text-muted-foreground/70\"\n+                  : \"text-muted-foreground\",\n+              )}\n+            >\n+              {f.subject} · {f.predicate} ·{\" \"}\n+              <span\n+                className={\n+                  f.status === \"current\"\n+                    ? \"text-foreground/80\"\n+                    : \"text-text-warning\"\n+                }\n+              >\n+                {typeof f.object === \"string\"\n+                  ? f.object\n+                  : JSON.stringify(f.object)}\n+              </span>\n+            </div>\n+          ))}\n+        </div>\n+      )}\n+    </PanelCard>\n+  );\n+}\n+\n+function PanelCard({\n+  icon,\n+  title,\n+  children,\n+}: {\n+  icon: React.ReactNode;\n+  title: string;\n+  children: React.ReactNode;\n+}) {\n+  return (\n+    <div className=\"hairline border rounded-lg bg-surface-1 p-3 flex flex-col gap-2\">\n+      <div className=\"flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-muted-foreground\">\n+        {icon}\n+        {title}\n+      </div>\n+      {children}\n+    </div>\n+  );\n+}\n+\n+function RawBlock({ data, label }: { data: unknown; label?: string }) {\n+  if (data === undefined || data === null) return null;\n+  return (\n+    <details className=\"hairline border rounded-md bg-surface-1 group\">\n+      <summary className=\"cursor-pointer text-[10px] uppercase tracking-wider text-muted-foreground px-3 py-2 flex items-center gap-1.5 select-none\">\n+        <Square className=\"h-3 w-3\" />\n+        {label ?? \"Raw run\"}\n+      </summary>\n+      <pre className=\"text-[11px] font-mono px-3 pb-3 overflow-auto max-h-96\">\n+        {JSON.stringify(data, null, 2)}\n+      </pre>\n+    </details>\n+  );\n+}\n+\n+/* ---------- Memory ---------- */\n+\n+function MemoryPanel() {\n+  const qc = useQueryClient();\n+  const q = useQuery({ queryKey: [\"memory\"], queryFn: harness.listMemory });\n+  const facts = useMemo<Fact[]>(() => {\n+    return normalizeFacts(q.data as Fact[] | { facts: Fact[] } | undefined);\n+  }, [q.data]);\n+\n+  const voidFact = useMutation({\n+    mutationFn: (id: string) => harness.voidMemory(id),\n+    onSuccess: () => qc.invalidateQueries({ queryKey: [\"memory\"] }),\n+    onError: (e: Error) => toast.error(e.message),\n+  });\n+\n+  if (facts.length === 0) {\n+    return <div className=\"text-[11px] text-muted-foreground\">No facts.</div>;\n+  }\n+\n+  return (\n+    <ScrollArea className=\"max-h-[220px] pr-1\">\n+      <div className=\"flex flex-col gap-1\">\n+        {facts.map((f) => (\n+          <div\n+            key={f.fact_id}\n+            className=\"text-[11px] hairline border rounded-md bg-surface-2 px-2 py-1.5 group\"\n+          >\n+            <div className=\"flex items-center gap-1.5\">\n+              <Brain className=\"h-3 w-3 text-text-accent\" />\n+              <span\n+                className={cn(\n+                  \"text-[10px]\",\n+                  f.status === \"current\"\n+                    ? \"text-text-success\"\n+                    : \"text-text-warning\",\n+                )}\n+              >\n+                {f.status || \"?\"}\n+              </span>\n+              {f.status !== \"voided\" && (\n+                <button\n+                  onClick={() => voidFact.mutate(f.fact_id)}\n+                  className=\"ml-auto opacity-0 group-hover:opacity-100 text-[10px] text-muted-foreground hover:text-text-danger\"\n+                >\n+                  void\n+                </button>\n+              )}\n+            </div>\n+            <div className=\"font-mono text-[10.5px] text-muted-foreground truncate mt-0.5\">\n+              {f.subject} · {f.predicate} ·{\" \"}\n+              {typeof f.object === \"string\" ? f.object : JSON.stringify(f.object)}\n+            </div>\n+          </div>\n+        ))}\n+      </div>\n+    </ScrollArea>\n+  );\n+}\n+\n+/* ---------- Settings ---------- */\n+\n+function SettingsSheet({\n+  baseUrl,\n+  onSave,\n+}: {\n+  baseUrl: string;\n+  onSave: (url: string) => void;\n+}) {\n+  const [val, setVal] = useState(baseUrl);\n+  useEffect(() => setVal(baseUrl), [baseUrl]);\n+  return (\n+    <Sheet>\n+      <SheetTrigger asChild>\n+        <Button variant=\"ghost\" size=\"icon\" className=\"h-7 w-7\">\n+          <Settings2 className=\"h-3.5 w-3.5\" />\n+        </Button>\n+      </SheetTrigger>\n+      <SheetContent>\n+        <SheetHeader>\n+          <SheetTitle>Backend</SheetTitle>\n+          <SheetDescription>\n+            URL of your locally running <code>shovs-agent-harness</code>.\n+          </SheetDescription>\n+        </SheetHeader>\n+        <div className=\"grid gap-3 mt-6\">\n+          <label className=\"text-[11px] text-muted-foreground\">Base URL</label>\n+          <Input\n+            value={val}\n+            onChange={(e) => setVal(e.target.value)}\n+            placeholder=\"http://127.0.0.1:8095\"\n+          />\n+          <Button\n+            onClick={() => {\n+              onSave(val.trim());\n+              toast.success(\"Backend URL updated\");\n+            }}\n+          >\n+            Save\n+          </Button>\n+          <p className=\"text-[11px] text-muted-foreground\">\n+            The backend must allow CORS from this origin (or reverse-proxy the\n+            frontend on the same origin).\n+          </p>\n+        </div>\n+      </SheetContent>\n+    </Sheet>\n+  );\n+}"},{"sha":"20500c7f347db7dd59ff59e295be226aa317757f","filename":"extractions/shovs-agent-harness/frontend/src/server.ts","status":"added","additions":61,"deletions":0,"changes":61,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fserver.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fserver.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fserver.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,61 @@\n+import \"./lib/error-capture\";\n+\n+import { consumeLastCapturedError } from \"./lib/error-capture\";\n+import { renderErrorPage } from \"./lib/error-page\";\n+\n+type ServerEntry = {\n+  fetch: (request: Request, env: unknown, ctx: unknown) => Promise<Response> | Response;\n+};\n+\n+let serverEntryPromise: Promise<ServerEntry> | undefined;\n+\n+async function getServerEntry(): Promise<ServerEntry> {\n+  if (!serverEntryPromise) {\n+    serverEntryPromise = import(\"@tanstack/react-start/server-entry\").then(\n+      (m) => (m.default ?? m) as ServerEntry,\n+    );\n+  }\n+  return serverEntryPromise;\n+}\n+\n+// h3 swallows in-handler throws into a normal 500 Response with body\n+// {\"unhandled\":true,\"message\":\"HTTPError\"} — try/catch alone never fires for those.\n+async function normalizeCatastrophicSsrResponse(response: Response): Promise<Response> {\n+  if (response.status < 500) return response;\n+  const contentType = response.headers.get(\"content-type\") ?? \"\";\n+  if (!contentType.includes(\"application/json\")) return response;\n+\n+  const body = await response.clone().text();\n+  if (!isH3SwallowedErrorBody(body)) return response;\n+\n+  console.error(consumeLastCapturedError() ?? new Error(`h3 swallowed SSR error: ${body}`));\n+  return new Response(renderErrorPage(), {\n+    status: 500,\n+    headers: { \"content-type\": \"text/html; charset=utf-8\" },\n+  });\n+}\n+\n+function isH3SwallowedErrorBody(body: string): boolean {\n+  try {\n+    const payload = JSON.parse(body) as { unhandled?: unknown; message?: unknown };\n+    return payload.unhandled === true && payload.message === \"HTTPError\";\n+  } catch {\n+    return false;\n+  }\n+}\n+\n+export default {\n+  async fetch(request: Request, env: unknown, ctx: unknown) {\n+    try {\n+      const handler = await getServerEntry();\n+      const response = await handler.fetch(request, env, ctx);\n+      return await normalizeCatastrophicSsrResponse(response);\n+    } catch (error) {\n+      console.error(error);\n+      return new Response(renderErrorPage(), {\n+        status: 500,\n+        headers: { \"content-type\": \"text/html; charset=utf-8\" },\n+      });\n+    }\n+  },\n+};"},{"sha":"d6152eeee7ddddc2455ee343a1b1f9637fb86616","filename":"extractions/shovs-agent-harness/frontend/src/start.ts","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstart.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstart.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstart.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,22 @@\n+import { createStart, createMiddleware } from \"@tanstack/react-start\";\n+\n+import { renderErrorPage } from \"./lib/error-page\";\n+\n+const errorMiddleware = createMiddleware().server(async ({ next }) => {\n+  try {\n+    return await next();\n+  } catch (error) {\n+    if (error != null && typeof error === \"object\" && \"statusCode\" in error) {\n+      throw error;\n+    }\n+    console.error(error);\n+    return new Response(renderErrorPage(), {\n+      status: 500,\n+      headers: { \"content-type\": \"text/html; charset=utf-8\" },\n+    });\n+  }\n+});\n+\n+export const startInstance = createStart(() => ({\n+  requestMiddleware: [errorMiddleware],\n+}));"},{"sha":"7ef2f0b005eebd9b31383f560faf83510c7385a1","filename":"extractions/shovs-agent-harness/frontend/src/styles.css","status":"added","additions":186,"deletions":0,"changes":186,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstyles.css","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstyles.css","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fsrc%2Fstyles.css?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,186 @@\n+@import \"tailwindcss\" source(none);\n+@source \"../src\";\n+@import \"tw-animate-css\";\n+\n+@custom-variant dark (&:is(.dark *));\n+\n+@theme inline {\n+  --radius-sm: calc(var(--radius) - 4px);\n+  --radius-md: calc(var(--radius) - 2px);\n+  --radius-lg: var(--radius);\n+  --radius-xl: calc(var(--radius) + 4px);\n+  --radius-2xl: calc(var(--radius) + 8px);\n+  --radius-3xl: calc(var(--radius) + 12px);\n+  --color-background: var(--background);\n+  --color-foreground: var(--foreground);\n+  --color-card: var(--card);\n+  --color-card-foreground: var(--card-foreground);\n+  --color-popover: var(--popover);\n+  --color-popover-foreground: var(--popover-foreground);\n+  --color-primary: var(--primary);\n+  --color-primary-foreground: var(--primary-foreground);\n+  --color-secondary: var(--secondary);\n+  --color-secondary-foreground: var(--secondary-foreground);\n+  --color-muted: var(--muted);\n+  --color-muted-foreground: var(--muted-foreground);\n+  --color-accent: var(--accent);\n+  --color-accent-foreground: var(--accent-foreground);\n+  --color-destructive: var(--destructive);\n+  --color-destructive-foreground: var(--destructive-foreground);\n+  --color-border: var(--border);\n+  --color-input: var(--input);\n+  --color-ring: var(--ring);\n+  --color-sidebar: var(--sidebar);\n+  --color-sidebar-foreground: var(--sidebar-foreground);\n+  --color-sidebar-primary: var(--sidebar-primary);\n+  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);\n+  --color-sidebar-accent: var(--sidebar-accent);\n+  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);\n+  --color-sidebar-border: var(--sidebar-border);\n+  --color-sidebar-ring: var(--sidebar-ring);\n+  --color-surface-1: var(--surface-1);\n+  --color-surface-2: var(--surface-2);\n+  --color-border-strong: var(--border-strong);\n+  --color-text-accent: var(--text-accent);\n+  --color-bg-accent: var(--bg-accent);\n+  --color-text-success: var(--text-success);\n+  --color-bg-success: var(--bg-success);\n+  --color-text-warning: var(--text-warning);\n+  --color-bg-warning: var(--bg-warning);\n+  --color-text-danger: var(--text-danger);\n+  --color-bg-danger: var(--bg-danger);\n+  --font-mono: var(--font-mono);\n+}\n+\n+:root {\n+  --radius: 0.5rem;\n+\n+  --background: oklch(0.985 0.006 90);\n+  --foreground: oklch(0.20 0.01 60);\n+  --surface-1: oklch(0.975 0.008 88);\n+  --surface-2: oklch(1 0 0);\n+\n+  --card: var(--surface-2);\n+  --card-foreground: var(--foreground);\n+  --popover: var(--surface-2);\n+  --popover-foreground: var(--foreground);\n+\n+  --primary: oklch(0.25 0.02 60);\n+  --primary-foreground: oklch(0.985 0.006 90);\n+  --secondary: oklch(0.955 0.01 85);\n+  --secondary-foreground: oklch(0.25 0.02 60);\n+  --muted: oklch(0.955 0.01 85);\n+  --muted-foreground: oklch(0.55 0.01 70);\n+  --accent: oklch(0.94 0.03 240);\n+  --accent-foreground: oklch(0.35 0.11 250);\n+  --destructive: oklch(0.55 0.18 25);\n+  --destructive-foreground: oklch(0.985 0.006 90);\n+\n+  --border: oklch(0.90 0.008 85);\n+  --border-strong: oklch(0.82 0.01 82);\n+  --input: oklch(0.90 0.008 85);\n+  --ring: oklch(0.65 0.08 240);\n+\n+  --text-accent: oklch(0.45 0.13 250);\n+  --bg-accent: oklch(0.94 0.03 240);\n+  --text-success: oklch(0.42 0.12 140);\n+  --bg-success: oklch(0.94 0.04 130);\n+  --text-warning: oklch(0.50 0.13 65);\n+  --bg-warning: oklch(0.94 0.05 80);\n+  --text-danger: oklch(0.50 0.16 25);\n+  --bg-danger: oklch(0.95 0.04 25);\n+\n+  --chart-1: oklch(0.55 0.14 250);\n+  --chart-2: oklch(0.55 0.14 140);\n+  --chart-3: oklch(0.55 0.14 65);\n+  --chart-4: oklch(0.55 0.14 25);\n+  --chart-5: oklch(0.55 0.14 300);\n+\n+  --sidebar: var(--surface-1);\n+  --sidebar-foreground: var(--foreground);\n+  --sidebar-primary: var(--primary);\n+  --sidebar-primary-foreground: var(--primary-foreground);\n+  --sidebar-accent: var(--accent);\n+  --sidebar-accent-foreground: var(--accent-foreground);\n+  --sidebar-border: var(--border);\n+  --sidebar-ring: var(--ring);\n+\n+  --font-mono: \"JetBrains Mono\", \"SF Mono\", ui-monospace, Menlo, Consolas, monospace;\n+}\n+\n+.dark {\n+  --background: oklch(0.16 0.01 260);\n+  --foreground: oklch(0.95 0.008 90);\n+  --surface-1: oklch(0.19 0.012 260);\n+  --surface-2: oklch(0.22 0.014 260);\n+  --card: var(--surface-2);\n+  --card-foreground: var(--foreground);\n+  --popover: var(--surface-2);\n+  --popover-foreground: var(--foreground);\n+  --primary: oklch(0.92 0.01 90);\n+  --primary-foreground: oklch(0.20 0.01 60);\n+  --secondary: oklch(0.26 0.014 260);\n+  --secondary-foreground: var(--foreground);\n+  --muted: oklch(0.26 0.014 260);\n+  --muted-foreground: oklch(0.70 0.02 90);\n+  --accent: oklch(0.30 0.05 250);\n+  --accent-foreground: oklch(0.85 0.10 250);\n+  --destructive: oklch(0.65 0.18 25);\n+  --destructive-foreground: oklch(0.98 0.006 90);\n+  --border: oklch(1 0 0 / 10%);\n+  --border-strong: oklch(1 0 0 / 18%);\n+  --input: oklch(1 0 0 / 12%);\n+  --ring: oklch(0.65 0.08 240);\n+\n+  --text-accent: oklch(0.78 0.12 250);\n+  --bg-accent: oklch(0.30 0.06 250);\n+  --text-success: oklch(0.78 0.12 140);\n+  --bg-success: oklch(0.28 0.05 140);\n+  --text-warning: oklch(0.80 0.13 70);\n+  --bg-warning: oklch(0.30 0.05 65);\n+  --text-danger: oklch(0.78 0.14 25);\n+  --bg-danger: oklch(0.30 0.06 25);\n+\n+  --sidebar: var(--surface-1);\n+  --sidebar-foreground: var(--foreground);\n+  --sidebar-primary: oklch(0.65 0.14 250);\n+  --sidebar-primary-foreground: oklch(0.98 0.006 90);\n+  --sidebar-accent: var(--accent);\n+  --sidebar-accent-foreground: var(--accent-foreground);\n+  --sidebar-border: oklch(1 0 0 / 10%);\n+  --sidebar-ring: oklch(0.65 0.08 240);\n+}\n+\n+@layer base {\n+  * {\n+    border-color: var(--color-border);\n+  }\n+  body {\n+    background-color: var(--color-background);\n+    color: var(--color-foreground);\n+    font-feature-settings: \"ss01\", \"cv11\";\n+  }\n+  .hairline { border-width: 0.5px; }\n+}\n+\n+@keyframes pulse-orb {\n+  0%, 100% { transform: scale(1); opacity: 1; }\n+  50% { transform: scale(1.35); opacity: 0.75; }\n+}\n+.orb-pulse { animation: pulse-orb 1.6s ease-in-out infinite; }\n+\n+@keyframes shimmer-bar {\n+  0% { background-position: 200% 0; }\n+  100% { background-position: -200% 0; }\n+}\n+.shimmer {\n+  background: linear-gradient(90deg, var(--muted) 0%, var(--border-strong) 50%, var(--muted) 100%);\n+  background-size: 200% 100%;\n+  animation: shimmer-bar 1.6s linear infinite;\n+}\n+\n+@keyframes fade-up {\n+  from { opacity: 0; transform: translateY(4px); }\n+  to { opacity: 1; transform: translateY(0); }\n+}\n+.fade-up { animation: fade-up 0.28s ease-out both; }"},{"sha":"533d40171d4cbc61370abbffca39ba9256ad5927","filename":"extractions/shovs-agent-harness/frontend/tsconfig.json","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Ftsconfig.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Ftsconfig.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Ftsconfig.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,27 @@\n+{\n+  \"include\": [\"src/**/*.ts\", \"src/**/*.tsx\", \"vite.config.ts\", \"eslint.config.js\"],\n+  \"compilerOptions\": {\n+    \"target\": \"ES2022\",\n+    \"jsx\": \"react-jsx\",\n+    \"module\": \"ESNext\",\n+    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"],\n+    \"types\": [\"vite/client\"],\n+\n+    /* Bundler mode */\n+    \"moduleResolution\": \"Bundler\",\n+    \"allowImportingTsExtensions\": true,\n+    \"verbatimModuleSyntax\": false,\n+    \"noEmit\": true,\n+\n+    /* Linting */\n+    \"skipLibCheck\": true,\n+    \"strict\": true,\n+    \"noUnusedLocals\": false,\n+    \"noUnusedParameters\": false,\n+    \"noFallthroughCasesInSwitch\": true,\n+    \"noUncheckedSideEffectImports\": true,\n+    \"paths\": {\n+      \"@/*\": [\"./src/*\"]\n+    }\n+  }\n+}"},{"sha":"2b8ccd122bdacf9dbbbbf1c00eba69e9288e5cb1","filename":"extractions/shovs-agent-harness/frontend/vite.config.ts","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fvite.config.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fvite.config.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fvite.config.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,15 @@\n+// @lovable.dev/vite-tanstack-config already includes the following — do NOT add them manually\n+// or the app will break with duplicate plugins:\n+//   - tanstackStart, viteReact, tailwindcss, tsConfigPaths, nitro (build-only using cloudflare as a default target),\n+//     componentTagger (dev-only), VITE_* env injection, @ path alias, React/TanStack dedupe,\n+//     error logger plugins, and sandbox detection (port/host/strictPort).\n+// You can pass additional config via defineConfig({ vite: { ... }, etc... }) if needed.\n+import { defineConfig } from \"@lovable.dev/vite-tanstack-config\";\n+\n+export default defineConfig({\n+  tanstackStart: {\n+    // Redirect TanStack Start's bundled server entry to src/server.ts (our SSR error wrapper).\n+    // nitro/vite builds from this\n+    server: { entry: \"server\" },\n+  },\n+});"},{"sha":"5dc50b684da15351e48225553cd101cf16095d16","filename":"extractions/shovs-agent-harness/scripts/run_backend.sh","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_backend.sh","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_backend.sh","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_backend.sh?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,8 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+cd \"$(dirname \"$0\")/..\"\n+PYTHON_BIN=\"${PYTHON_BIN:-../../venv/bin/python}\"\n+if [ ! -x \"$PYTHON_BIN\" ]; then\n+  PYTHON_BIN=\"python\"\n+fi\n+exec \"$PYTHON_BIN\" -m backend.harness_api \"$@\""},{"sha":"03d28690145d592b2c9931898576c19c00fc918f","filename":"extractions/shovs-agent-harness/scripts/run_frontend.sh","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_frontend.sh","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_frontend.sh","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_frontend.sh?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,5 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+cd \"$(dirname \"$0\")/../frontend\"\n+npm install\n+exec npm run dev -- --host 127.0.0.1 --port \"${SHOVS_AGENT_HARNESS_FRONTEND_PORT:-5181}\""},{"sha":"c8e78d74ee2c4b480f76d0ce4a8fe40cabd11ba4","filename":"extractions/shovs-agent-harness/scripts/run_live_app.sh","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_live_app.sh","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_live_app.sh","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fscripts%2Frun_live_app.sh?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,7 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+ROOT=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\n+\"$ROOT/scripts/run_backend.sh\" &\n+BACKEND_PID=$!\n+trap 'kill \"$BACKEND_PID\" 2>/dev/null || true' EXIT\n+\"$ROOT/scripts/run_frontend.sh\""},{"sha":"a251f7b37aa43046d960eec3ed4e88f0440fb6ed","filename":"extractions/shovs-agent-harness/tests/conftest.py","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ftests%2Fconftest.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ftests%2Fconftest.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ftests%2Fconftest.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,7 @@\n+import sys\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+CORE = ROOT.parent / \"shovs-harness-core\"\n+sys.path.insert(0, str(ROOT))\n+sys.path.insert(0, str(CORE))"},{"sha":"2a84dcf7bdaa4c1626b47a4d8d3e5f03f33b2eaf","filename":"extractions/shovs-agent-harness/tests/test_backend.py","status":"added","additions":703,"deletions":0,"changes":703,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ftests%2Ftest_backend.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ftests%2Ftest_backend.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ftests%2Ftest_backend.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,703 @@\n+import asyncio\n+import json\n+import time\n+\n+from backend import adapters\n+from backend.adapters import ProductionAdapters, extract_entities\n+from backend.config import HarnessConfig\n+from backend.harness_api import compare_plain_vs_harness, draft_workflow, execute_harness_run\n+from backend.service import HarnessService\n+from backend.understanding import understand_objective\n+from backend.models import RunRecord, now\n+from backend.store import (\n+    JsonRunStore,\n+    MemoryDynamicToolStore,\n+    MemoryMemoryFactStore,\n+    MemoryRunStore,\n+    MemoryWorkflowStore,\n+    SqliteMemoryFactStore,\n+    SqliteRunStore,\n+)\n+\n+\n+def test_draft_workflow_maps_market_task_to_harness_contract():\n+    draft = draft_workflow(\"Create an agent that gathers top movers stocks and news.\")\n+\n+    assert draft.id == \"market_mover_brief\"\n+    assert draft.policy == \"plan_execute\"\n+    assert \"web_search\" in draft.tools\n+    assert \"No entity drift\" in draft.edge\n+\n+\n+def test_ticker_entity_extraction_keeps_symbols_separate():\n+    assert extract_entities(\"ROKU, TBN, SENEA, EPAM\", 3) == [\"ROKU\", \"TBN\", \"SENEA\"]\n+\n+\n+def test_compare_plain_vs_harness_blocks_drift():\n+    result = compare_plain_vs_harness(\"Search top 3 stocks, search each, fetch 3 URLs each.\")\n+\n+    assert result[\"plain_agent\"][\"status\"] == \"would_fail\"\n+    assert result[\"harness\"][\"status\"] == \"blocked\"\n+    assert result[\"harness\"][\"enforcement\"][\"violations\"]\n+\n+\n+def test_execute_harness_run_completes_with_evidence_gate():\n+    run = asyncio.run(execute_harness_run(\"Search top 3 stocks today, search each, fetch 3 URLs each.\"))\n+\n+    assert run.status == \"completed\"\n+    assert run.result is not None\n+    assert run.result[\"llm_calls\"] == 2\n+    assert run.result[\"fetched_count\"] == 9\n+    assert run.result[\"eval\"][\"ok\"] is True\n+    assert any(event.phase == \"verdict\" for event in run.events)\n+\n+\n+def test_run_store_persists_records(tmp_path):\n+    store = JsonRunStore(tmp_path / \"runs.json\")\n+    run = RunRecord(\n+        run_id=\"run_test\",\n+        objective=\"test objective\",\n+        workflow={\"id\": \"evidence_brief\"},\n+        status=\"completed\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    run.add_event(\"verdict\", \"success\", \"passed\")\n+    store.put(run)\n+\n+    reloaded = JsonRunStore(tmp_path / \"runs.json\").get(\"run_test\")\n+    assert reloaded is not None\n+    assert reloaded.status == \"completed\"\n+    assert reloaded.events[0].phase == \"verdict\"\n+\n+\n+def test_sqlite_run_store_persists_records(tmp_path):\n+    store = SqliteRunStore(tmp_path / \"harness.sqlite3\")\n+    run = RunRecord(\n+        run_id=\"run_sqlite\",\n+        objective=\"test sqlite\",\n+        workflow={\"id\": \"evidence_brief\"},\n+        status=\"completed\",\n+        created_at=now(),\n+        updated_at=now(),\n+        result={\"ok\": True},\n+    )\n+    run.add_event(\"tool\", \"success\", \"recorded\")\n+    store.put(run)\n+\n+    reloaded = SqliteRunStore(tmp_path / \"harness.sqlite3\").get(\"run_sqlite\")\n+    assert reloaded is not None\n+    assert reloaded.result == {\"ok\": True}\n+    assert reloaded.events[0].summary == \"recorded\"\n+\n+\n+def test_run_context_and_evidence_surfaces_are_derived_from_result():\n+    service = HarnessService(config=HarnessConfig(), store=MemoryRunStore(), memory_store=MemoryMemoryFactStore())\n+    run = asyncio.run(service.execute(\"Search top 3 stocks today, search each, fetch 3 URLs each.\"))\n+\n+    context = service.run_context(run.run_id)\n+    evidence = service.run_evidence(run.run_id)\n+\n+    assert context is not None\n+    assert context[\"context_packet\"][\"locked_entities\"] == [\"ROKU\", \"TBN\", \"SENEA\"]\n+    assert context[\"context_packet\"][\"evidence_count\"] == 9\n+    assert evidence is not None\n+    assert len(evidence[\"evidence\"]) == 9\n+\n+\n+def test_understanding_compiles_api_docs_context_plan():\n+    understanding = understand_objective(\"Fetch https://docs.example.com/api and implement the client\")\n+\n+    assert understanding.intent == \"api_docs_research\"\n+    assert understanding.next_action_hint == \"fetch_exact_docs_url\"\n+    assert understanding.context_plan[0][\"action\"] == \"web_fetch\"\n+    assert understanding.constraints[\"urls\"] == [\"https://docs.example.com/api\"]\n+\n+\n+def test_service_records_understanding_and_context_exposes_it():\n+    service = HarnessService(config=HarnessConfig(), store=MemoryRunStore(), memory_store=MemoryMemoryFactStore())\n+    run = asyncio.run(service.execute(\"Search top 3 stocks today, search each, fetch 3 URLs each.\"))\n+    context = service.run_context(run.run_id)\n+\n+    assert any(event.phase == \"understanding\" for event in run.events)\n+    assert context is not None\n+    assert context[\"context_packet\"][\"understanding\"][\"intent\"] == \"finance_source_collection\"\n+\n+\n+def test_stock_analysis_team_generates_file_backed_reports():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    run = asyncio.run(service.execute(\"Run stock analysis for TSLA with market, news, fundamentals, risk, and final report.\"))\n+\n+    assert run.status == \"completed\"\n+    assert run.result is not None\n+    assert run.result[\"understanding\"][\"intent\"] == \"stock_analysis_team\"\n+    assert run.result[\"ticker\"] == \"TSLA\"\n+    reports = run.result[\"reports\"]\n+    assert {report[\"agent\"] for report in reports} >= {\n+        \"market_analyst\",\n+        \"news_analyst\",\n+        \"fundamentals_analyst\",\n+        \"risk_analyst\",\n+        \"portfolio_manager\",\n+    }\n+    final = next(report for report in reports if report[\"agent\"] == \"portfolio_manager\")\n+    content = service.read_run_file(run.run_id, final[\"filename\"])\n+    assert content is not None\n+    assert \"Stock Analysis Final Report: TSLA\" in content[\"content\"]\n+\n+\n+def test_workflow_design_intent_returns_reusable_contract_without_running_tools():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    run = asyncio.run(service.execute(\"Create an agent workflow that gathers top movers stocks and news.\"))\n+\n+    assert run.status == \"completed\"\n+    assert run.result is not None\n+    assert run.result[\"understanding\"][\"intent\"] == \"workflow_design\"\n+    assert run.result[\"workflow\"][\"workflow_id\"].startswith(\"wf_\")\n+    assert run.result[\"workflow\"][\"runtime\"][\"source_draft_id\"] == \"market_mover_brief\"\n+    assert \"alpha_vantage_movers\" in run.result[\"workflow\"][\"tools\"]\n+    assert run.result[\"workflow\"][\"policy\"] == \"plan_execute\"\n+    assert run.result.get(\"tool_calls\") is None\n+    assert service.get_workflow(run.result[\"workflow\"][\"workflow_id\"]) is not None\n+    assert any(event.phase == \"workflow\" for event in run.events)\n+    assert any(event.phase == \"prompt_packet\" for event in run.events)\n+\n+\n+def test_create_and_run_workflow_contract_with_prompt_packets():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    created = service.create_workflow({\n+        \"objective\": \"Create an agent workflow that searches top 3 stocks and fetches 3 URLs each.\",\n+        \"model_provider\": \"groq\",\n+        \"model_name\": \"llama-3.3-70b-versatile\",\n+        \"tool_mode\": \"deterministic\",\n+    })\n+    workflow = created[\"workflow\"]\n+\n+    run = asyncio.run(service.run_workflow(\n+        workflow[\"workflow_id\"],\n+        {\"objective\": \"Search top 3 stocks today, search each, fetch 3 URLs each.\"},\n+    ))\n+\n+    assert workflow[\"runtime\"][\"model_provider\"] == \"groq\"\n+    assert run.workflow[\"workflow_id\"] == workflow[\"workflow_id\"]\n+    assert run.status == \"completed\"\n+    assert run.result is not None\n+    assert run.result[\"fetched_count\"] == 9\n+    packets = [event for event in run.events if event.phase == \"prompt_packet\"]\n+    assert {event.data[\"node_id\"] for event in packets} >= {\"planner\", \"actor\", \"verifier\", \"writer\"}\n+\n+\n+def test_start_run_background_completes_and_records_cursor_events():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    queued = service.start_run(\"Search top 3 stocks today, search each, fetch 3 URLs each.\")\n+    assert queued.status in {\"queued\", \"running\"}\n+\n+    current = queued\n+    for _ in range(80):\n+        current = service.get_run(queued.run_id) or current\n+        if current.status in {\"completed\", \"blocked\", \"failed\", \"interrupted\"}:\n+            break\n+        time.sleep(0.025)\n+\n+    assert current.status == \"completed\"\n+    assert current.result is not None\n+    assert current.result[\"fetched_count\"] == 9\n+    assert any(event.phase == \"step_cursor\" for event in current.events)\n+\n+\n+def test_start_workflow_background_uses_saved_contract():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    created = service.create_workflow({\n+        \"objective\": \"Create an agent workflow that searches top 3 stocks and fetches 3 URLs each.\",\n+        \"tool_mode\": \"deterministic\",\n+    })\n+    workflow_id = created[\"workflow\"][\"workflow_id\"]\n+\n+    queued = service.start_workflow(workflow_id, {\"objective\": \"Search top 3 stocks today, search each, fetch 3 URLs each.\"})\n+    current = queued\n+    for _ in range(80):\n+        current = service.get_run(queued.run_id) or current\n+        if current.status in {\"completed\", \"blocked\", \"failed\", \"interrupted\"}:\n+            break\n+        time.sleep(0.025)\n+\n+    assert current.status == \"completed\"\n+    assert current.workflow[\"workflow_id\"] == workflow_id\n+    assert current.result is not None\n+    assert current.result[\"eval\"][\"ok\"] is True\n+\n+\n+def test_interrupt_active_run_records_continuation_state():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    active = RunRecord(\n+        run_id=\"run_active_interrupt\",\n+        objective=\"Search top 3 stocks today.\",\n+        workflow={\"workflow_id\": \"wf_active\", \"policy\": \"plan_execute\"},\n+        status=\"running\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    service.store.put(active)\n+\n+    interrupted = service.interrupt_run(active.run_id, reason=\"pause after current safe step\")\n+\n+    assert interrupted[\"status\"] == \"interrupt_requested\"\n+    assert interrupted[\"result\"][\"continuation_state\"][\"workflow\"][\"workflow_id\"] == \"wf_active\"\n+\n+\n+def test_worker_honors_interrupt_requested_before_start():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    queued = RunRecord(\n+        run_id=\"run_queued_interrupt\",\n+        objective=\"Search top 3 stocks today.\",\n+        workflow={\"workflow_id\": \"wf_queued\", \"policy\": \"plan_execute\"},\n+        status=\"interrupt_requested\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    service.store.put(queued)\n+\n+    service._run_worker(queued.run_id)\n+    current = service.get_run(queued.run_id)\n+\n+    assert current is not None\n+    assert current.status == \"interrupted\"\n+    assert current.result is not None\n+    assert current.result[\"continuation_state\"][\"workflow\"][\"workflow_id\"] == \"wf_queued\"\n+\n+\n+def test_interrupt_and_continue_preserves_workflow_and_directive():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+    blocked = RunRecord(\n+        run_id=\"run_interrupt\",\n+        objective=\"Search top 3 stocks today.\",\n+        workflow={\"workflow_id\": \"wf_test\", \"policy\": \"plan_execute\", \"nodes\": []},\n+        status=\"blocked\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    service.store.put(blocked)\n+\n+    interrupted = service.interrupt_run(blocked.run_id, reason=\"change the output to a table\")\n+    continued = asyncio.run(service.continue_run(blocked.run_id, directive=\"continue with table output\"))\n+\n+    assert interrupted[\"status\"] == \"interrupted\"\n+    assert continued.workflow[\"workflow_id\"] == \"wf_test\"\n+    assert \"continue with table output\" in continued.objective\n+\n+\n+def test_continue_run_preserves_previous_objective_in_new_run():\n+    service = HarnessService(config=HarnessConfig(), store=MemoryRunStore(), memory_store=MemoryMemoryFactStore())\n+    blocked = RunRecord(\n+        run_id=\"run_blocked_continue\",\n+        objective=\"Search top 3 stocks today, search each, fetch 3 URLs each.\",\n+        workflow={},\n+        status=\"blocked\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    service.store.put(blocked)\n+\n+    continued = asyncio.run(service.continue_run(blocked.run_id))\n+\n+    assert continued.run_id != blocked.run_id\n+    assert \"Continue from previous run run_blocked_continue\" in continued.objective\n+    assert any(event.phase == \"continue\" for event in continued.events)\n+\n+\n+def test_manifest_exposes_runtime_config_and_adapter_slots():\n+    service = HarnessService(\n+        config=HarnessConfig(\n+            tool_mode=\"http\",\n+            search_backend=\"searxng\",\n+            search_url=\"http://search.local/search\",\n+            brave_search_key=\"secret\",\n+        ),\n+        store=MemoryRunStore(),\n+    )\n+    manifest = service.manifest()\n+\n+    assert manifest[\"config\"][\"tool_mode\"] == \"http\"\n+    assert manifest[\"config\"][\"search_backend\"] == \"searxng\"\n+    assert manifest[\"config\"][\"search_url\"] == \"http://search.local/search\"\n+    assert manifest[\"config\"][\"brave_search_key\"] == \"configured\"\n+    assert manifest[\"config\"][\"brave_search_key_configured\"] is True\n+    assert \"search\" in manifest[\"adapter_slots\"]\n+    assert manifest[\"tool_bridge\"][\"native_mode\"] == \"shovs_native\"\n+\n+\n+def test_tool_manifest_and_call_are_safe_without_full_app_import():\n+    service = HarnessService(config=HarnessConfig(), store=MemoryRunStore(), memory_store=MemoryMemoryFactStore())\n+\n+    manifest = service.tool_manifest()\n+    missing = asyncio.run(service.call_tool({\"tool\": \"definitely_missing\", \"arguments\": {}}))\n+\n+    assert manifest[\"native_mode\"] == \"shovs_native\"\n+    assert \"shovs_native\" in manifest\n+    assert missing[\"ok\"] is False\n+    assert missing[\"error\"] == \"tool_not_available\"\n+\n+\n+def test_harness_workflow_tools_create_list_and_run():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    manifest = service.tool_manifest()\n+    created = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_workflow_create\",\n+        \"arguments\": {\n+            \"objective\": \"Create an agent workflow that gathers top movers stocks and news.\",\n+            \"tool_mode\": \"deterministic\",\n+        },\n+    }))\n+    listed = asyncio.run(service.call_tool({\"tool\": \"harness_workflow_list\", \"arguments\": {}}))\n+    workflow_id = created[\"json\"][\"workflow\"][\"workflow_id\"]\n+    started = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_workflow_run\",\n+        \"arguments\": {\n+            \"workflow_id\": workflow_id,\n+            \"objective\": \"Search top 3 stocks today, search each, fetch 3 URLs each.\",\n+        },\n+    }))\n+\n+    assert any(tool[\"name\"] == \"harness_workflow_create\" for tool in manifest[\"tools\"])\n+    assert created[\"ok\"] is True\n+    assert listed[\"json\"][\"workflows\"][0][\"workflow_id\"] == workflow_id\n+    assert started[\"ok\"] is True\n+    assert started[\"json\"][\"run\"][\"status\"] in {\"queued\", \"running\"}\n+\n+\n+def test_dynamic_micro_tool_create_and_check_without_raw_context_bloat():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+        tool_store=MemoryDynamicToolStore(),\n+    )\n+\n+    created = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_tool_create\",\n+        \"arguments\": {\n+            \"objective\": \"check for verified URLs in final answer\",\n+        },\n+    }))\n+    tool_name = created[\"json\"][\"tool\"][\"name\"]\n+    checked = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_tool_check\",\n+        \"arguments\": {\n+            \"name\": tool_name,\n+            \"text\": \"Source: https://example.com/report. \" + (\"noise \" * 1000),\n+        },\n+    }))\n+\n+    assert created[\"ok\"] is True\n+    assert checked[\"ok\"] is True\n+    assert checked[\"json\"][\"result\"][\"ok\"] is True\n+    assert checked[\"json\"][\"result\"][\"checks\"][\"urls\"][\"count\"] == 1\n+    assert checked[\"json\"][\"result\"][\"input_chars_used\"] <= created[\"json\"][\"tool\"][\"context_policy\"][\"max_input_chars\"]\n+\n+\n+def test_dynamic_json_field_tool_detects_missing_fields():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+        tool_store=MemoryDynamicToolStore(),\n+    )\n+\n+    created = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_tool_create\",\n+        \"arguments\": {\n+            \"name\": \"quote_shape_check\",\n+            \"description\": \"Check quote payload shape\",\n+            \"kind\": \"json_field_check\",\n+            \"input_schema\": {\"json\": \"object\"},\n+            \"check_schema\": {\"required_fields\": [\"symbol\", \"price\", \"change_percent\"]},\n+            \"context_policy\": {\"max_input_chars\": 800, \"return_raw\": False},\n+        },\n+    }))\n+    checked = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_tool_check\",\n+        \"arguments\": {\n+            \"tool_id\": created[\"json\"][\"tool\"][\"tool_id\"],\n+            \"json\": {\"symbol\": \"TSLA\", \"price\": \"250\"},\n+        },\n+    }))\n+\n+    assert checked[\"json\"][\"result\"][\"ok\"] is False\n+    assert checked[\"json\"][\"result\"][\"missing\"] == [\"change_percent\"]\n+\n+\n+def test_tool_manifest_exposes_generated_tool_controls():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+        tool_store=MemoryDynamicToolStore(),\n+    )\n+    manifest = service.tool_manifest()\n+\n+    names = {tool[\"name\"] for tool in manifest[\"tools\"]}\n+    assert {\"harness_tool_draft\", \"harness_tool_create\", \"harness_tool_check\"}.issubset(names)\n+\n+\n+def test_image_generation_request_resolves_setup_gap_without_search(monkeypatch):\n+    monkeypatch.delenv(\"OPENAI_API_KEY\", raising=False)\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    run = asyncio.run(service.execute(\"Generate an image of a calm futuristic agent dashboard.\"))\n+\n+    assert run.status == \"blocked\"\n+    assert run.result is not None\n+    assert run.result[\"understanding\"][\"intent\"] == \"image_generation\"\n+    assert run.result[\"capability\"][\"capability\"] == \"image_generation\"\n+    assert \"OPENAI_API_KEY\" in run.result[\"capability\"][\"required_env\"]\n+    assert not any(event.phase == \"step_cursor\" and event.data.get(\"next_required_action\") == \"web_search\" for event in run.events)\n+\n+\n+def test_connector_request_returns_setup_contract_instead_of_source_loop():\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    run = asyncio.run(service.execute(\"Connect Slack as an MCP connector and create a workflow for channel alerts.\"))\n+\n+    assert run.status == \"blocked\"\n+    assert run.result is not None\n+    assert run.result[\"understanding\"][\"intent\"] == \"connector_setup\"\n+    assert run.result[\"capability\"][\"target\"] == \"slack\"\n+    assert \"SLACK_BOT_TOKEN\" in run.result[\"capability\"][\"required_env\"]\n+\n+\n+def test_capability_resolver_tool_reports_image_requirements(monkeypatch):\n+    monkeypatch.delenv(\"OPENAI_API_KEY\", raising=False)\n+    service = HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        workflow_store=MemoryWorkflowStore(),\n+    )\n+\n+    resolved = asyncio.run(service.call_tool({\n+        \"tool\": \"harness_capability_resolve\",\n+        \"arguments\": {\"capability\": \"image_generation\"},\n+    }))\n+\n+    assert resolved[\"ok\"] is True\n+    assert resolved[\"json\"][\"capability\"] == \"image_generation\"\n+    assert resolved[\"json\"][\"configured\"] is False\n+\n+\n+def test_shovs_native_adapter_prefers_alpha_before_generic_search():\n+    class FakeBridge:\n+        def has(self, name):\n+            return name in {\"alpha_vantage_movers\", \"web_search\"}\n+\n+        async def call(self, name, **kwargs):\n+            if name == \"alpha_vantage_movers\":\n+                return {\n+                    \"ok\": True,\n+                    \"json\": {\n+                        \"top_gainers\": [\n+                            {\"symbol\": \"ROKU\", \"price\": \"10\", \"change_percent\": \"12%\"},\n+                            {\"symbol\": \"TBN\", \"price\": \"8\", \"change_percent\": \"9%\"},\n+                            {\"symbol\": \"SENEA\", \"price\": \"6\", \"change_percent\": \"8%\"},\n+                        ]\n+                    },\n+                }\n+            raise AssertionError(\"generic web_search should not run before alpha movers\")\n+\n+    adapter = ProductionAdapters(\n+        objective=\"Search top 3 stocks today with major jumps.\",\n+        native_bridge=FakeBridge(),\n+    )\n+\n+    urls, compact = asyncio.run(adapter.search(\"top 3 stocks today with major jumps\"))\n+\n+    assert urls == [\"alpha-vantage://movers/ROKU\", \"alpha-vantage://movers/TBN\", \"alpha-vantage://movers/SENEA\"]\n+    assert \"ROKU\" in compact\n+\n+\n+def test_memory_store_requires_provenance_and_replaces_transactionally(tmp_path):\n+    store = SqliteMemoryFactStore(tmp_path / \"memory.sqlite3\")\n+\n+    first = store.add_fact(\n+        owner_id=\"owner\",\n+        subject=\"user\",\n+        predicate=\"location\",\n+        object_value=\"Toronto\",\n+        source=\"user\",\n+        provenance={\"message_id\": \"m1\"},\n+    )\n+    second = store.add_fact(\n+        owner_id=\"owner\",\n+        subject=\"user\",\n+        predicate=\"location\",\n+        object_value=\"Vancouver\",\n+        source=\"user\",\n+        provenance={\"message_id\": \"m2\"},\n+    )\n+\n+    current = store.list_facts(owner_id=\"owner\")\n+    all_facts = store.list_facts(owner_id=\"owner\", include_voided=True)\n+    assert [fact.object for fact in current] == [\"Vancouver\"]\n+    assert second.supersedes_id == first.id\n+    assert any(fact.id == first.id and fact.status == \"voided\" for fact in all_facts)\n+\n+    try:\n+        store.add_fact(\n+            owner_id=\"owner\",\n+            subject=\"user\",\n+            predicate=\"preference\",\n+            object_value=\"pink buttons\",\n+            source=\"user\",\n+            provenance={},\n+        )\n+    except ValueError as exc:\n+        assert \"provenance\" in str(exc)\n+    else:\n+        raise AssertionError(\"missing provenance should fail\")\n+\n+\n+def test_service_rejects_derived_memory_from_incomplete_run():\n+    service = HarnessService(config=HarnessConfig(), store=MemoryRunStore(), memory_store=MemoryMemoryFactStore())\n+    run = RunRecord(\n+        run_id=\"run_blocked\",\n+        objective=\"blocked\",\n+        workflow={},\n+        status=\"blocked\",\n+        created_at=now(),\n+        updated_at=now(),\n+    )\n+    service.store.put(run)\n+\n+    try:\n+        service.remember_fact({\n+            \"owner_id\": \"owner\",\n+            \"run_id\": \"run_blocked\",\n+            \"subject\": \"ROKU\",\n+            \"predicate\": \"news\",\n+            \"object\": \"jumped\",\n+            \"source\": \"tool\",\n+            \"provenance\": {\"evidence_id\": \"e1\"},\n+        })\n+    except ValueError as exc:\n+        assert \"completed run\" in str(exc)\n+    else:\n+        raise AssertionError(\"derived memory from blocked run should fail\")\n+\n+\n+def test_production_adapter_parses_searxng_results(monkeypatch):\n+    def fake_get(url, timeout, headers=None):\n+        assert \"q=ROKU+stock+news\" in url\n+        return json.dumps({\n+            \"results\": [\n+                {\"title\": \"ROKU jumps\", \"url\": \"https://news.example/roku\", \"content\": \"earnings catalyst\"},\n+                {\"title\": \"Duplicate\", \"url\": \"https://news.example/roku\", \"content\": \"duplicate\"},\n+                {\"title\": \"TBN note\", \"url\": \"https://news.example/tbn\", \"content\": \"second\"},\n+            ]\n+        })\n+\n+    monkeypatch.setattr(adapters, \"_http_get\", fake_get)\n+    adapter = ProductionAdapters(\n+        objective=\"Search top 3 stocks today.\",\n+        search_backend=\"searxng\",\n+        search_url=\"http://search.local/search\",\n+    )\n+\n+    urls, compact = asyncio.run(adapter.search(\"ROKU stock news\"))\n+\n+    assert urls == [\"https://news.example/roku\", \"https://news.example/tbn\"]\n+    assert \"earnings catalyst\" in compact\n+\n+\n+def test_production_adapter_uses_alpha_vantage_movers_for_stock_discovery(monkeypatch):\n+    def fake_get(url, timeout, headers=None):\n+        assert \"TOP_GAINERS_LOSERS\" in url\n+        return json.dumps({\n+            \"top_gainers\": [\n+                {\"ticker\": \"ROKU\", \"price\": \"10\", \"change_percentage\": \"12%\"},\n+                {\"ticker\": \"TBN\", \"price\": \"8\", \"change_percentage\": \"9%\"},\n+                {\"ticker\": \"SENEA\", \"price\": \"6\", \"change_percentage\": \"8%\"},\n+            ]\n+        })\n+\n+    monkeypatch.setattr(adapters, \"_http_get\", fake_get)\n+    adapter = ProductionAdapters(\n+        objective=\"Search top 3 stocks today with major jumps.\",\n+        alpha_key=\"demo\",\n+    )\n+\n+    urls, compact = asyncio.run(adapter.search(\"stocks today\"))\n+\n+    assert urls[:3] == [\"alpha-vantage://movers/ROKU\", \"alpha-vantage://movers/TBN\", \"alpha-vantage://movers/SENEA\"]\n+    assert extract_entities(compact, 3) == [\"ROKU\", \"TBN\", \"SENEA\"]\n+\n+\n+def test_model_slot_failure_falls_back_to_deterministic_parser():\n+    adapter = ProductionAdapters(\n+        objective=\"Search top 3 stocks today.\",\n+        model_slots_enabled=True,\n+        model_provider=\"missing-provider\",\n+    )\n+\n+    entities = asyncio.run(adapter.extract_entities(\"objective\", \"ROKU, TBN, SENEA\", 3))\n+\n+    assert entities == [\"ROKU\", \"TBN\", \"SENEA\"]"},{"sha":"e0e8b218189d78360d02159eae5589d43ddddfc4","filename":"extractions/shovs-harness-core/.gitignore","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2F.gitignore","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2F.gitignore","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2F.gitignore?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,6 @@\n+__pycache__/\n+*.py[cod]\n+.pytest_cache/\n+frontend/dist/\n+frontend/node_modules/\n+frontend/tsconfig.app.tsbuildinfo"},{"sha":"5ec04defddf452352d534ddd0fcf6e239af94d1f","filename":"extractions/shovs-harness-core/QUALITY_BAR.md","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FQUALITY_BAR.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FQUALITY_BAR.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2FQUALITY_BAR.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,35 @@\n+# Quality Bar\n+\n+This project is good only if it catches failures that normal chat traces hide.\n+\n+## Minimum Passing Signals\n+\n+| Signal | Pass condition |\n+| --- | --- |\n+| Tool truth | A result without a known tool call is rejected |\n+| Claim truth | A final answer cannot cite failed or missing result IDs |\n+| Source contract | \"top N ... M URLs each\" becomes `N * M` required fetches |\n+| Topic agnostic | Stocks, sushi, laptops, and papers compile to the same source workflow shape |\n+| Drift detection | A run that locks entities A/B/C and searches D fails |\n+| Continuation | The kernel keeps acting until required evidence exists |\n+| Small context | Phase attention ranks missing/risky items above stale completed items |\n+\n+## What Counts As A Real Improvement\n+\n+Do not compare prose quality first. Compare run behavior:\n+\n+1. Did the plain loop stop early?\n+2. Did it invent or drift entities?\n+3. Did it cite tools that did not succeed?\n+4. Did it fetch the required number of sources?\n+5. Did the trace explain why the run continued or stopped?\n+\n+If the harness improves those numbers on the same model, it is useful.\n+\n+## What Does Not Count\n+\n+- A prettier final answer.\n+- A longer plan.\n+- A trace full of labels but no invariants.\n+- A memory write with no provenance.\n+- A benchmark result that cannot replay the underlying run."},{"sha":"69d5e25861419bb43d991328b5f8cd3008360c65","filename":"extractions/shovs-harness-core/README.md","status":"added","additions":480,"deletions":0,"changes":480,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FREADME.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FREADME.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2FREADME.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,480 @@\n+# Shovs Harness Core\n+\n+A small extraction from ShovsOS for testing agent reliability wedges without the full app.\n+\n+This is not another chat UI. It is a tiny harness kernel:\n+\n+1. Turn a user request into a source contract.\n+2. Let models propose actions.\n+3. Let the ledger decide what actually happened.\n+4. Keep phase attention small and weighted.\n+5. Evaluate the trace against state, not vibes.\n+\n+The code is deliberately boring. The value is in the invariant:\n+\n+```text\n+model text is not authority\n+tool results are not authority unless linked to a tool call\n+final answers cannot cite failed or missing tool results\n+workflow completion is checked against a contract\n+```\n+\n+## Why This Exists\n+\n+ShovsOS grew into a large research system: memory, context lanes, evidence lanes, phase packets, traces, tool guards, and runtime tests. The useful wedge is smaller:\n+\n+> A plug-in harness that makes agent runs inspectable, topic-agnostic, and harder to fake.\n+\n+That matters because the same failure appears across domains:\n+\n+```text\n+User: find top 3 X, search each, fetch 3 URLs each\n+Agent: finds X correctly\n+Agent: drifts to unrelated Y\n+Agent: fetches generic pages\n+Agent: answers confidently anyway\n+```\n+\n+The harness catches that as a state error.\n+\n+## What Is Unique Here\n+\n+| Wedge | What it does | Why it is useful |\n+| --- | --- | --- |\n+| Source contract | Compiles plain language into counts and required tools | Keeps \"3 each\" from becoming random browsing |\n+| Run ledger | Records tool calls and results as linked facts | Stops \"I used a tool\" hallucinations |\n+| Runtime attention | Scores context by phase | Avoids flooding the model with stale context |\n+| Continuation gate | Refuses final response until quota/state is satisfied | Keeps multi-step work alive |\n+| Trace eval | Checks the run against locked entities and required steps | Produces a concrete pass/fail report |\n+| Action gate (`enforce_proposed_actions`) | The model proposes actions; the gate decides which become state | Drift, over-fetch, off-contract URLs, and premature responses become *violations*, not tool truth |\n+| Kernel control plane (`run_source_collection`) | A deterministic loop drives the whole multi-step run; the model is a slot-filler | One \"top N, M each\" task = **2 LLM calls** (lock entities + synthesize), not 2T+3 |\n+\n+## Kernel-Driven Control Plane\n+\n+The newest piece (`run_source_collection`) inverts the usual agent loop. Instead\n+of the model deciding *plan → act → observe → verify* (one LLM call each, every\n+turn), a **deterministic kernel owns control flow** and the model is called at\n+exactly two points:\n+\n+```text\n+contract (the todo)                              ← deterministic\n+  → discovery search           (deterministic query)\n+  → LLM: lock the N entities    ← model slot #1\n+  → for each entity:           (deterministic structure)\n+       entity search           (topic-aware query, no LLM)\n+       fetch M urls             ← contract decides the count\n+  → LLM: synthesize the answer ← model slot #2\n+```\n+\n+Everything else — which tool, when to search, how many to fetch, when to stop,\n+which entity a fetch belongs to — is deterministic and contract-enforced, so the\n+run **cannot drift, under-fetch, or stop early** by construction.\n+\n+A real run of the messy stock task (`scripts/kernel_demo.py`, Gemini\n+`gemini-2.5-flash`, live `web_search`/`web_fetch`):\n+\n+```text\n+task   : top 3 stocks with major jumps, search each, fetch 3 urls each, tldr table\n+locked : ['MSTR', 'MRNA', 'AAPL']        fetched: 9/9     contract eval: score=1.0 ok=True\n+LLM    : 2 calls   (vs the orchestrator loop's ~2*9+3 = 21)\n+output : a grounded TLDR table, every row backed by a fetched, ledger-linked source\n+```\n+\n+It is topic-agnostic: `discovery_query` and `entity_search_query` compile the\n+probe from plain language (stocks → \"<E> stock news\", restaurants → \"<E>\n+reviews sources\", products → \"<E> reviews price sources\", papers → \"<E>\n+research paper sources\"). Tools and the model are injected, so the core stays\n+free of any web/LLM import:\n+\n+```python\n+from shovs_harness_core import run_source_collection\n+\n+result = await run_source_collection(\n+    \"Search top 3 stocks today, search each, fetch 3 urls each, write a tldr table.\",\n+    search_fn=...,            # query -> (urls, text)        e.g. real web_search\n+    fetch_fn=...,             # url   -> (ok, content)       e.g. real web_fetch\n+    extract_entities_fn=...,  # model slot #1 (lock N)\n+    synth_fn=...,             # model slot #2 (final answer)\n+)\n+assert result.llm_calls == 2 and result.eval.ok\n+```\n+\n+The offline test (`tests/test_source_runner.py`) proves the structure\n+deterministically: 3 entities × 3 URLs = 9 fetches, exactly 2 LLM calls, drift\n+structurally impossible, eval score 1.0.\n+\n+## Research Fit\n+\n+This extraction lines up with current agent research without copying any system:\n+\n+- [ToolOrchestra](https://arxiv.org/abs/2511.21689) argues for efficient orchestration of models and tools.\n+- [Small Model as Master Orchestrator](https://arxiv.org/abs/2604.17009) points at protocol normalization and state feedback for extensible agent/tool systems.\n+- [Can Small Agents Collaborate to Beat a Single Large Language Model?](https://arxiv.org/abs/2601.11327) reports that orchestration quality can matter more than model scale for tool-heavy work.\n+- [Proxy State-Based Evaluation](https://arxiv.org/abs/2602.16246) evaluates tool/user hallucinations against scenario state.\n+- [AgentTrace](https://arxiv.org/abs/2602.10133) frames structured traces as operational, cognitive, and contextual observability.\n+- [ToolSpec](https://arxiv.org/abs/2604.13519) notes that tool traces are structured enough for schema-aware execution.\n+\n+The extraction thesis is simple:\n+\n+> Most agent failures are not fixed by louder prompts. They are fixed by typed state, linked tool truth, small context, and state-based evals.\n+\n+## Run\n+\n+From this folder:\n+\n+```bash\n+../../venv/bin/python -m pytest -q\n+```\n+\n+From the repo root:\n+\n+```bash\n+venv/bin/python -m pytest extractions/shovs-harness-core/tests -q\n+```\n+\n+## New Developer Setup\n+\n+From the repo root:\n+\n+```bash\n+# Create/use the main repo venv first if needed.\n+python -m venv venv\n+venv/bin/python -m pip install -r requirements.txt\n+\n+# Install JS dependencies used by the small frontend demo.\n+npm install\n+cd frontend_consumer && npm install && cd ..\n+\n+# Check the extracted harness environment.\n+venv/bin/python extractions/shovs-harness-core/scripts/check_setup.py\n+```\n+\n+The setup checker reports:\n+\n+- Python version and `pytest`\n+- Node/npm availability\n+- whether the Vite/TypeScript binaries used by the frontend demo exist\n+- whether `llama-server` / `llama-cli` are on `PATH`\n+- whether a local llama.cpp OpenAI-compatible server is reachable\n+\n+The checker treats llama.cpp as optional. The harness tests and static demo work\n+without it.\n+\n+## Run The Harness As A Live App\n+\n+The extraction now has a tiny dependency-free JSON backend and a Vite frontend.\n+The frontend still works as a static demo, but when the backend is running it can\n+call the real Python extension through `POST /api/run`.\n+\n+From the repo root:\n+\n+```bash\n+# Terminal 1\n+extractions/shovs-harness-core/scripts/run_backend.sh\n+\n+# Terminal 2\n+extractions/shovs-harness-core/scripts/run_frontend.sh\n+```\n+\n+Open:\n+\n+```text\n+http://127.0.0.1:5177\n+```\n+\n+Or run both together:\n+\n+```bash\n+extractions/shovs-harness-core/scripts/run_live_app.sh\n+```\n+\n+Default local endpoints:\n+\n+| Surface | URL |\n+| --- | --- |\n+| Frontend | `http://127.0.0.1:5177` |\n+| Backend health | `http://127.0.0.1:8091/health` |\n+| Manifest | `http://127.0.0.1:8091/api/manifest` |\n+| Run extension | `POST http://127.0.0.1:8091/api/run` |\n+| llama.cpp health | `http://127.0.0.1:8091/api/llamacpp/health` |\n+| llama.cpp probe | `POST http://127.0.0.1:8091/api/llamacpp/probe` |\n+\n+Use custom ports if needed:\n+\n+```bash\n+HARNESS_BACKEND_PORT=8092 HARNESS_FRONTEND_PORT=5178 \\\n+  extractions/shovs-harness-core/scripts/run_live_app.sh\n+```\n+\n+Quick backend smoke:\n+\n+```bash\n+curl -s http://127.0.0.1:8091/health\n+curl -s http://127.0.0.1:8091/api/manifest\n+curl -s -X POST http://127.0.0.1:8091/api/run \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"objective\":\"Search top 3 stocks today, search each, fetch 3 URLs each.\",\"include_traces\":false}'\n+```\n+\n+### Live kernel run (real tools + a real model)\n+\n+`scripts/kernel_demo.py` wires the kernel to the main project's real\n+`web_search`/`web_fetch` and a Gemini model, and runs the full multi-entity\n+source-collection task through `run_source_collection`. It prints the locked\n+entities, fetch coverage, contract eval, and the **LLM call count vs the\n+orchestrator loop**.\n+\n+```bash\n+cd extractions/shovs-harness-core\n+../../venv/bin/python scripts/kernel_demo.py gemini-2.5-flash   # needs GEMINI_API_KEY in the repo .env\n+```\n+\n+### Modules\n+\n+| Module | Surface |\n+| --- | --- |\n+| `contract` | `infer_source_contract`, `discovery_query`, `entity_search_query` |\n+| `ledger` | `Ledger` — linked tool-call/result truth; rejects orphan results and failed-result claims |\n+| `kernel` | `HarnessKernel.decide()` — the deterministic next-step decision |\n+| `evals` | `evaluate_trace` — state-based pass/fail (drift, missing quota) |\n+| `proposers` | `ProposedAction`, `ScriptedProposer`, `LLMProposer` (inject any adapter) |\n+| `action_runner` | `enforce_proposed_actions` — model proposes, harness disposes |\n+| `source_runner` | `run_source_collection` — the deterministic control plane |\n+| `extension` | `run_extension_payload` / `HarnessExtension` — embeddable JSON surface, no heavy deps |\n+| `llamacpp` | `LlamaCppClient` — local, OpenAI-compatible, sovereign inference |\n+\n+## Use As An Extension\n+\n+This folder should be treated as the small ShovsOS engine extension, not just a\n+demo. It has no dependency on the main app, FastAPI, React, Ollama, or any cloud\n+model SDK.\n+\n+```python\n+from shovs_harness_core import run_extension_payload\n+\n+report = run_extension_payload({\n+    \"objective\": \"Search top 3 stocks today, search each, fetch 3 URLs each.\",\n+    \"entities\": [\"ROKU\", \"TBN\", \"SENEA\"],\n+})\n+\n+assert report[\"reports\"][\"harness_loop\"][\"ok\"] is True\n+assert report[\"reports\"][\"plain_loop\"][\"ok\"] is False\n+```\n+\n+The extension output is plain JSON:\n+\n+- `contract`: what the request requires\n+- `decision`: what the kernel would do next\n+- `reports`: state-based evals for traces\n+- `traces`: optional example traces for UI/debug\n+- `verdict`: small comparison summary\n+\n+A host can mount this behind an API route, CLI command, plugin, or frontend\n+without importing the full ShovsOS platform.\n+\n+## Use With llama.cpp\n+\n+`shovs-harness-core` includes a tiny dependency-free llama.cpp client for\n+OpenAI-compatible local servers. The model is used as a proposer; the harness\n+still decides what is valid.\n+\n+### Install llama.cpp\n+\n+Option A: Homebrew.\n+\n+Homebrew should be writable by your normal macOS user. If `brew install` says\n+`/opt/homebrew is not writable`, that is a Homebrew prefix ownership problem,\n+not a llama.cpp problem. Do not use `sudo brew install`.\n+\n+```bash\n+brew doctor\n+brew --prefix\n+ls -ld \"$(brew --prefix)\" \"$(brew --prefix)/var/homebrew/locks\"\n+brew install llama.cpp\n+command -v llama-server\n+command -v llama-cli\n+```\n+\n+If Homebrew reports that specific directories are not writable, repair only the\n+Homebrew prefix/directories it reports, then retry. On a normal Apple Silicon\n+single-user Homebrew install, the prefix is usually `/opt/homebrew`.\n+\n+Example repair when Homebrew explicitly reports these paths:\n+\n+```bash\n+sudo chown -R \"$USER\" /opt/homebrew /opt/homebrew/share/zsh /opt/homebrew/share/zsh/site-functions /opt/homebrew/var/homebrew/locks\n+chmod u+w /opt/homebrew /opt/homebrew/share/zsh /opt/homebrew/share/zsh/site-functions /opt/homebrew/var/homebrew/locks\n+brew doctor\n+brew install llama.cpp\n+```\n+\n+If you do not want to repair Homebrew, use the source build below. The harness\n+does not require Homebrew.\n+\n+Option B: build llama.cpp from source:\n+\n+```bash\n+git clone https://github.com/ggml-org/llama.cpp\n+cd llama.cpp\n+cmake -B build\n+cmake --build build --config Release -j\n+./build/bin/llama-server --help\n+```\n+\n+On Apple Silicon, current llama.cpp CMake builds use Metal acceleration by\n+default on macOS. If your local build does not, rebuild with Metal explicitly:\n+\n+```bash\n+cmake -B build -DGGML_METAL=ON\n+cmake --build build --config Release -j\n+```\n+\n+Download a trusted `.gguf` instruct model separately. For an M4 Max with 36 GB\n+RAM, start with a 7B/8B/14B instruct model in `Q4_K_M` or `Q5_K_M`. Larger\n+models can work, but the harness should first prove behavior on fast local\n+models.\n+\n+### Start llama.cpp Safely\n+\n+Use localhost only. Do not bind to `0.0.0.0` unless you intentionally want LAN\n+access.\n+\n+This repo uses `8081` in examples because `8080` is commonly used by Docker or\n+other local services:\n+\n+```text\n+http://127.0.0.1:8081/v1\n+```\n+\n+Start the server:\n+\n+```bash\n+llama-server \\\n+  -m /absolute/path/to/model.gguf \\\n+  --host 127.0.0.1 \\\n+  --port 8081\n+```\n+\n+Then run:\n+\n+```bash\n+cd extractions/shovs-harness-core\n+LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1 \\\n+LLAMACPP_DEFAULT_MODEL=your-local-model \\\n+../../venv/bin/python scripts/llamacpp_probe.py\n+```\n+\n+If you started the live backend, you can also check:\n+\n+```bash\n+curl -s http://127.0.0.1:8091/api/llamacpp/health\n+curl -s -X POST http://127.0.0.1:8091/api/llamacpp/probe \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"objective\":\"Search top 3 stocks today, search each, fetch 3 URLs each.\",\"model\":\"your-local-model\"}'\n+```\n+\n+The probe asks the local model to propose a locked-entity/fetch/respond action\n+list, then runs that list through `enforce_proposed_actions(...)`.\n+\n+This is the intended control boundary:\n+\n+```text\n+llama.cpp model -> proposed JSON actions -> harness gate -> accepted trace/report\n+```\n+\n+If the model drifts to an off-list entity, fetches a URL outside the contract,\n+duplicates a fetch, or responds early, the action is reported as a violation\n+instead of becoming tool truth.\n+\n+### ShovsOS Env For llama.cpp\n+\n+For the full ShovsOS app:\n+\n+```env\n+LLM_PROVIDER=llamacpp\n+LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1\n+LLAMACPP_API_KEY=llama.cpp\n+LLAMACPP_DEFAULT_MODEL=your-local-model\n+DEFAULT_MODEL=llamacpp:your-local-model\n+```\n+\n+Keep cloud fallbacks separate. The local harness should be able to fail cleanly\n+when llama.cpp is down instead of silently switching to a different provider.\n+\n+## Extension Vs Full App\n+\n+Use this extraction to prove the wedge. Use the full ShovsOS app to show the\n+complete platform.\n+\n+| Surface | Use it for | Avoid using it for |\n+| --- | --- | --- |\n+| `shovs-harness-core` | public proof, tests, package, extension, evaluator | broad chat UX claims |\n+| full ShovsOS | integrated runtime, memory, UI, tools, traces | explaining the core idea first |\n+\n+The main app should consume this kind of kernel as a module. It should not be\n+the only way to understand the architecture.\n+\n+## Frontend Demo\n+\n+There is a small browser demo in `frontend/`. It has no backend dependency.\n+\n+From the repo root:\n+\n+```bash\n+cd extractions/shovs-harness-core/frontend\n+npm run dev\n+```\n+\n+Then open the local Vite URL. The page lets you:\n+\n+- paste a source-collection task\n+- see the inferred contract\n+- compare a drifted plain loop against a harness loop\n+- inspect the trace timeline\n+- inspect raw contract/eval/decision JSON\n+\n+Build check:\n+\n+```bash\n+cd extractions/shovs-harness-core/frontend\n+npm run build\n+```\n+\n+## Example\n+\n+```python\n+from shovs_harness_core import HarnessKernel\n+\n+kernel = HarnessKernel(\"Find top 3 sushi places, search each, fetch 3 URLs each.\")\n+\n+decision = kernel.decide()\n+assert decision.next_tool == \"web_search\"\n+\n+kernel.add_tool_result(\"web_search\", {\"query\": \"sushi\"}, True, {\"results\": []})\n+\n+for i in range(9):\n+    kernel.add_tool_result(\"web_fetch\", {\"url\": f\"https://source.test/{i}\"}, True, {\"body\": \"ok\"})\n+\n+assert kernel.decide().state == \"respond\"\n+```\n+\n+## What This Is Not\n+\n+- It is not a full agent runtime.\n+- It is not a benchmark claim.\n+- It is not proof that ShovsOS beats another system.\n+- It is a small falsifiable kernel for testing whether specific reliability wedges work.\n+\n+## Status & Next\n+\n+Done: source contract + ledger + trace eval + runtime attention; `enforce_proposed_actions`\n+(model proposes, harness disposes); the `run_source_collection` control plane (2 LLM calls,\n+verified live on a 9-URL task); local proposers via `llamacpp`; the embeddable `extension`\n+surface; plain-vs-harness comparison and JSON reports. 22 tests pass.\n+\n+Genuinely next:\n+\n+1. Promote this kernel to drive the main ShovsOS engine loop (the \"one move\" at full scale), replacing the orchestrator's per-stage LLM calls.\n+2. Same-provider model fallback in the demo so a daily-quota 429 routes to a model with headroom.\n+3. An optional third model slot for per-source analysis (today the run uses one synthesis call).\n+4. Golden fixtures drawn from real failure transcripts, gated in CI."},{"sha":"e67b40154e9cf7c59948822f77a3e7e747f24652","filename":"extractions/shovs-harness-core/RESEARCH_MAP.md","status":"added","additions":52,"deletions":0,"changes":52,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FRESEARCH_MAP.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FRESEARCH_MAP.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2FRESEARCH_MAP.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,52 @@\n+# Research Map\n+\n+The extraction is positioned as a small harness layer, not a frontier model.\n+\n+## What The Field Is Validating\n+\n+1. Tool-heavy agents need orchestration, not just larger models.\n+   - ToolOrchestra reports that lightweight orchestrators coordinating tools/models can improve accuracy and cost tradeoffs.\n+   - Small-agent collaboration work reports that orchestration quality can matter more than raw model scale on tool-heavy tasks.\n+\n+2. Agent/tool systems need protocol normalization and state feedback.\n+   - Agent-as-Tool / ParaManager frames tools and agents as a standardized action space with explicit state feedback.\n+   - This maps directly to the ledger: one action format, linked results, visible state.\n+\n+3. Agent evaluation is moving from final-text judging to state-based judging.\n+   - Proxy State-Based Evaluation checks full traces against scenario facts, expected final state, and hallucination constraints.\n+   - This extraction uses a simpler version: source contracts plus trace state.\n+\n+4. Tool traces are structured enough to optimize.\n+   - ToolSpec argues that tool-calling traces have recurring schema patterns.\n+   - This extraction keeps the schema small enough to test directly.\n+\n+5. Observability must include context and cognitive state, not just API logs.\n+   - AgentTrace describes operational, cognitive, and contextual trace surfaces.\n+   - This extraction records contract, ledger, attention, and trace eval as separate inspectable surfaces.\n+\n+## The Actual ShovsOS Uniqueness\n+\n+The unique part is not any single module. It is the combination:\n+\n+```text\n+contract -> ledger authority -> phase attention -> continuation gate -> state eval\n+```\n+\n+Most agent systems have some of these. The useful wedge is making them small, composable, and testable enough to drop into another agent stack.\n+\n+## Claims We Can Make Now\n+\n+- The extraction rejects orphaned tool results.\n+- It rejects claims against failed tool results.\n+- It detects entity drift in deterministic source-collection traces.\n+- It keeps acting until source quota is satisfied.\n+- It compiles equivalent source-collection requests across unrelated topics.\n+\n+## Claims We Cannot Make Yet\n+\n+- It does not prove higher real-world task success.\n+- It does not prove lower token cost on live models.\n+- It does not prove superiority over LangGraph, Claude Code, Codex, OpenAI Agents SDK, or other frameworks.\n+- It does not yet include broad live web or Ollama benchmarks.\n+\n+Those claims require repeated runs, fixed scenarios, raw trace export, and plain-loop baselines."},{"sha":"0e8ae7ac306e35ca60ff70d08ffca584a85d64dc","filename":"extractions/shovs-harness-core/THESIS.md","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FTHESIS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2FTHESIS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2FTHESIS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,34 @@\n+# Thesis\n+\n+The model is the language engine. The harness is the physics.\n+\n+Prompts tell the model what to try. The harness decides what is valid, what is missing, what can be cited, and whether the run is allowed to finish.\n+\n+## The Minimal Shape\n+\n+```text\n+request\n+  -> contract\n+  -> ledger\n+  -> action\n+  -> observation\n+  -> attention\n+  -> verification\n+  -> response or continuation\n+```\n+\n+Each part is independently testable.\n+\n+## The Practical Bet\n+\n+Enterprise users do not need a new chatbot first. They need agent runs that can answer:\n+\n+- What was the task?\n+- What tools were allowed?\n+- Which tool calls actually happened?\n+- Which outputs came back?\n+- Which claims are supported by which result IDs?\n+- Why did the agent stop?\n+- What is still missing?\n+\n+This folder is the smallest version of that bet."},{"sha":"42465772cc16fcfd55fa5646d218506cd1518e64","filename":"extractions/shovs-harness-core/frontend/index.html","status":"added","additions":12,"deletions":0,"changes":12,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Findex.html","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Findex.html","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Findex.html?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,12 @@\n+<!doctype html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <title>Shovs Harness Core</title>\n+  </head>\n+  <body>\n+    <div id=\"root\"></div>\n+    <script type=\"module\" src=\"/src/main.ts\"></script>\n+  </body>\n+</html>"},{"sha":"437bf777e0e5b7ff2dd365365c1ec28c452791b2","filename":"extractions/shovs-harness-core/frontend/package.json","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fpackage.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fpackage.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Fpackage.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,13 @@\n+{\n+  \"name\": \"shovs-harness-core-demo\",\n+  \"private\": true,\n+  \"version\": \"0.1.0\",\n+  \"type\": \"module\",\n+  \"scripts\": {\n+    \"dev\": \"../../../frontend_consumer/node_modules/.bin/vite --host 127.0.0.1 --port 5177\",\n+    \"build\": \"../../../frontend_consumer/node_modules/.bin/tsc -b && ../../../frontend_consumer/node_modules/.bin/vite build\",\n+    \"preview\": \"../../../frontend_consumer/node_modules/.bin/vite preview --host 127.0.0.1 --port 4177\"\n+  },\n+  \"dependencies\": {},\n+  \"devDependencies\": {}\n+}"},{"sha":"fd0f0a13bc375c01c30dda5b05c39acd5fc0b19d","filename":"extractions/shovs-harness-core/frontend/src/harness.ts","status":"added","additions":174,"deletions":0,"changes":174,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fharness.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fharness.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fharness.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,174 @@\n+export type SourceContract = {\n+  objective: string;\n+  entityCount: number;\n+  urlsPerEntity: number;\n+  totalUrls: number;\n+  requiredTools: string[];\n+  missing: string[];\n+};\n+\n+export type TraceEvent = {\n+  kind?: string;\n+  tool?: string;\n+  entity?: string;\n+  url?: string;\n+  ok?: boolean;\n+  summary?: string;\n+};\n+\n+export type TraceEval = {\n+  ok: boolean;\n+  score: number;\n+  failures: string[];\n+  metrics: {\n+    searchCount: number;\n+    fetchCount: number;\n+    requiredFetchCount: number;\n+    lockedEntities: string[];\n+  };\n+};\n+\n+export type KernelDecision = {\n+  state: \"act\" | \"respond\";\n+  reason: string;\n+  nextTool?: string;\n+  nextArgs?: Record<string, string>;\n+};\n+\n+const WORDS: Record<string, number> = {\n+  one: 1,\n+  two: 2,\n+  three: 3,\n+  four: 4,\n+  five: 5,\n+  six: 6,\n+  seven: 7,\n+  eight: 8,\n+  nine: 9,\n+  ten: 10,\n+};\n+const NUMBER_PATTERN = \"\\\\d+|one|two|three|four|five|six|seven|eight|nine|ten\";\n+\n+function numberValue(raw: string | undefined): number {\n+  if (!raw) return 0;\n+  return /^\\d+$/.test(raw) ? Number(raw) : WORDS[raw] ?? 0;\n+}\n+\n+export function inferSourceContract(objective: string): SourceContract {\n+  const text = objective.toLowerCase().replace(/\\s+/g, \" \").trim();\n+  const entityCount = numberValue(text.match(new RegExp(`\\\\btop\\\\s+(${NUMBER_PATTERN})\\\\b`))?.[1]);\n+  const urlsPerEntity = numberValue(\n+    text.match(\n+      new RegExp(\n+        `\\\\b(${NUMBER_PATTERN})\\\\s+(?:relevant\\\\s+)?(?:urls?|links?|results?|sources?|articles?)\\\\s+(?:for\\\\s+)?(?:each|per)\\\\b`,\n+      ),\n+    )?.[1],\n+  );\n+  const requiredTools: string[] = [];\n+  if (/(search|find|lookup)/.test(text)) requiredTools.push(\"web_search\");\n+  if (/(fetch|open|read)/.test(text)) requiredTools.push(\"web_fetch\");\n+  if (requiredTools.includes(\"web_fetch\") && !requiredTools.includes(\"web_search\")) {\n+    requiredTools.unshift(\"web_search\");\n+  }\n+  const missing: string[] = [];\n+  if (text.includes(\"each\") && !entityCount) missing.push(\"entity_count\");\n+  if (text.includes(\"each\") && !urlsPerEntity) missing.push(\"urls_per_entity\");\n+  return {\n+    objective,\n+    entityCount,\n+    urlsPerEntity,\n+    totalUrls: entityCount && urlsPerEntity ? entityCount * urlsPerEntity : 0,\n+    requiredTools,\n+    missing,\n+  };\n+}\n+\n+export function discoveryQuery(objective: string): string {\n+  const stripped = objective\n+    .replace(\n+      /\\b(?:then|and then|after that|web\\s*search|search\\s+each|search\\s+those|search\\s+these|web\\s*fetch|fetch|capture|analy[sz]e|write|produce|report|tldr|tl;dr|summary table|one by one|separately|each)\\b.*$/i,\n+      \"\",\n+    )\n+    .replace(/^\\s*(?:please\\s+)?(?:web\\s*search|search\\s+for|search|find|look\\s*up)\\s+/i, \"\")\n+    .replace(new RegExp(`\\\\b(top\\\\s+(?:${NUMBER_PATTERN})|those|these|(?:${NUMBER_PATTERN})\\\\s+relevant|all\\\\s+(?:${NUMBER_PATTERN})\\\\s+urls?)\\\\b`, \"gi\"), \"\")\n+    .replace(/\\s+/g, \" \")\n+    .trim()\n+    .replace(/[.,:;]+$/g, \"\");\n+  return stripped || objective.slice(0, 80).trim();\n+}\n+\n+export function evaluateTrace(contract: SourceContract, events: TraceEvent[]): TraceEval {\n+  const searches = events.filter((event) => event.tool === \"web_search\" && event.ok !== false);\n+  const fetches = events.filter((event) => event.tool === \"web_fetch\" && event.ok !== false);\n+  const lockedEntities = Array.from(\n+    new Set(\n+      events\n+        .filter((event) => event.kind === \"entity_locked\" && event.entity)\n+        .map((event) => String(event.entity).toUpperCase()),\n+    ),\n+  ).sort();\n+  const failures: string[] = [];\n+  if (contract.requiredTools.includes(\"web_search\") && searches.length === 0) failures.push(\"missing_search\");\n+  if (contract.totalUrls && fetches.length < contract.totalUrls) failures.push(\"missing_fetch_quota\");\n+  const drifted = [...searches, ...fetches]\n+    .filter((event) => event.entity && lockedEntities.length > 0)\n+    .map((event) => String(event.entity).toUpperCase())\n+    .filter((entity) => !lockedEntities.includes(entity));\n+  if (drifted.length > 0) failures.push(`entity_drift:${Array.from(new Set(drifted)).sort().join(\",\")}`);\n+  const target = Math.max(1, contract.requiredTools.length + (contract.totalUrls ? 1 : 0));\n+  return {\n+    ok: failures.length === 0,\n+    score: Math.max(0, Number(((target - failures.length) / target).toFixed(3))),\n+    failures,\n+    metrics: {\n+      searchCount: searches.length,\n+      fetchCount: fetches.length,\n+      requiredFetchCount: contract.totalUrls,\n+      lockedEntities,\n+    },\n+  };\n+}\n+\n+export function makePlainTrace(): TraceEvent[] {\n+  return [\n+    { kind: \"entity_locked\", entity: \"ROKU\", summary: \"Locked top mover\" },\n+    { kind: \"entity_locked\", entity: \"TBN\", summary: \"Locked top mover\" },\n+    { kind: \"entity_locked\", entity: \"SENEA\", summary: \"Locked top mover\" },\n+    { tool: \"web_search\", entity: \"EPAM\", ok: true, summary: \"Planner drifted to unrelated ticker\" },\n+    { tool: \"web_fetch\", entity: \"ROKU\", url: \"https://source.test/ROKU/0\", ok: true, summary: \"Fetched one source\" },\n+  ];\n+}\n+\n+export function makeHarnessTrace(contract: SourceContract): TraceEvent[] {\n+  const entities = contract.entityCount === 3 ? [\"ROKU\", \"TBN\", \"SENEA\"] : [\"A\", \"B\", \"C\"].slice(0, contract.entityCount || 3);\n+  const events: TraceEvent[] = entities.map((entity) => ({\n+    kind: \"entity_locked\",\n+    entity,\n+    summary: \"Locked entity before source collection\",\n+  }));\n+  entities.forEach((entity) => {\n+    events.push({ tool: \"web_search\", entity, ok: true, summary: `Searched ${entity}` });\n+  });\n+  entities.forEach((entity) => {\n+    for (let index = 0; index < (contract.urlsPerEntity || 1); index += 1) {\n+      events.push({\n+        tool: \"web_fetch\",\n+        entity,\n+        url: `https://source.test/${entity}/${index}`,\n+        ok: true,\n+        summary: `Fetched source ${index + 1} for ${entity}`,\n+      });\n+    }\n+  });\n+  return events;\n+}\n+\n+export function decide(contract: SourceContract, evalReport: TraceEval): KernelDecision {\n+  if (contract.totalUrls && evalReport.metrics.fetchCount >= contract.totalUrls) {\n+    return { state: \"respond\", reason: \"source quota met\" };\n+  }\n+  if (evalReport.metrics.searchCount === 0) {\n+    return { state: \"act\", reason: \"need entity discovery/search\", nextTool: \"web_search\", nextArgs: { query: discoveryQuery(contract.objective) } };\n+  }\n+  return { state: \"act\", reason: \"need selected URL fetches\", nextTool: \"web_fetch\", nextArgs: { url: \"<selected_url>\" } };\n+}"},{"sha":"550e18e5de34df8deea40fea28f20b3c9013cec1","filename":"extractions/shovs-harness-core/frontend/src/main.ts","status":"added","additions":223,"deletions":0,"changes":223,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fmain.ts","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fmain.ts","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fmain.ts?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,223 @@\n+import {\n+  decide,\n+  evaluateTrace,\n+  inferSourceContract,\n+  makeHarnessTrace,\n+  makePlainTrace,\n+  type SourceContract,\n+  type TraceEvent,\n+  type TraceEval,\n+} from \"./harness\";\n+import \"./styles.css\";\n+\n+const examples = [\n+  \"Search top 3 stocks today, then search each, fetch 3 URLs each.\",\n+  \"Find top 3 sushi places in Toronto, search each, fetch 3 URLs each.\",\n+  \"Find top three laptops for students, search each, fetch three articles each.\",\n+];\n+\n+let objective = examples[0];\n+let selectedRun: \"plain\" | \"harness\" = \"harness\";\n+let backendState: { status: \"idle\" | \"loading\" | \"ready\" | \"error\"; summary: string; raw?: unknown } = {\n+  status: \"idle\",\n+  summary: \"Backend not checked\",\n+};\n+\n+function render() {\n+  const contract = inferSourceContract(objective);\n+  const plainTrace = makePlainTrace();\n+  const harnessTrace = makeHarnessTrace(contract);\n+  const plainEval = evaluateTrace(contract, plainTrace);\n+  const harnessEval = evaluateTrace(contract, harnessTrace);\n+  const activeTrace = selectedRun === \"plain\" ? plainTrace : harnessTrace;\n+  const activeEval = selectedRun === \"plain\" ? plainEval : harnessEval;\n+  const decision = decide(contract, activeEval);\n+  const root = document.querySelector<HTMLDivElement>(\"#root\");\n+  if (!root) return;\n+  root.innerHTML = `\n+    <main class=\"shell\">\n+      <section class=\"hero\">\n+        <div>\n+          <p class=\"eyebrow\">Shovs Harness Core</p>\n+          <h1>Test the agent run, not the final prose.</h1>\n+          <p class=\"subhead\">\n+            Paste a task and see how a small harness compiles requirements, catches drift,\n+            and decides whether the run can answer.\n+          </p>\n+        </div>\n+        <div class=\"heroStats\" aria-label=\"Current harness score\">\n+          <span>${Math.round(harnessEval.score * 100)}%</span>\n+          <small>harness trace score</small>\n+        </div>\n+      </section>\n+\n+      <section class=\"workspace\">\n+        <aside class=\"controlPanel\">\n+          <label class=\"fieldLabel\" for=\"objective\">Task</label>\n+          <textarea id=\"objective\">${escapeHtml(objective)}</textarea>\n+          <div class=\"examples\">\n+            ${examples\n+              .map((example, index) => `<button type=\"button\" data-example=\"${index}\">${escapeHtml(example.split(\",\")[0])}</button>`)\n+              .join(\"\")}\n+          </div>\n+          ${card(\"Inferred Contract\", metrics(contract))}\n+        </aside>\n+\n+        <section class=\"runPanel\">\n+          <div class=\"tabs\" role=\"tablist\" aria-label=\"Run comparison\">\n+            <button class=\"${selectedRun === \"plain\" ? \"active\" : \"\"}\" type=\"button\" data-run=\"plain\">Plain loop</button>\n+            <button class=\"${selectedRun === \"harness\" ? \"active\" : \"\"}\" type=\"button\" data-run=\"harness\">Harness loop</button>\n+          </div>\n+          ${scorecard(selectedRun === \"plain\" ? \"Plain loop\" : \"Harness loop\", activeEval)}\n+          ${card(\n+            \"Kernel Decision\",\n+            `<div class=\"decision ${decision.state}\">\n+              <strong>${decision.state}</strong>\n+              <span>${escapeHtml(decision.reason)}</span>\n+            </div>\n+            ${decision.nextTool ? `<code>${escapeHtml(`${decision.nextTool} ${JSON.stringify(decision.nextArgs)}`)}</code>` : \"\"}`,\n+          )}\n+          ${timeline(activeTrace)}\n+        </section>\n+\n+        <aside class=\"detailPanel\">\n+          ${backendCard()}\n+          ${card(\n+            \"Why This Matters\",\n+            `<p>The model can suggest work. The ledger decides what happened.\n+            The trace eval decides whether the answer is allowed.</p>`,\n+          )}\n+          ${card(\"Raw State\", `<pre>${escapeHtml(JSON.stringify({ contract, activeEval, decision }, null, 2))}</pre>`)}\n+        </aside>\n+      </section>\n+    </main>\n+  `;\n+  bindEvents();\n+}\n+\n+function bindEvents() {\n+  document.querySelector<HTMLTextAreaElement>(\"#objective\")?.addEventListener(\"input\", (event) => {\n+    objective = (event.target as HTMLTextAreaElement).value;\n+    render();\n+  });\n+  document.querySelectorAll<HTMLButtonElement>(\"[data-example]\").forEach((button) => {\n+    button.addEventListener(\"click\", () => {\n+      objective = examples[Number(button.dataset.example ?? 0)] ?? examples[0];\n+      render();\n+    });\n+  });\n+  document.querySelectorAll<HTMLButtonElement>(\"[data-run]\").forEach((button) => {\n+    button.addEventListener(\"click\", () => {\n+      selectedRun = button.dataset.run === \"plain\" ? \"plain\" : \"harness\";\n+      render();\n+    });\n+  });\n+  const backendButton = document.querySelector<HTMLButtonElement>(\"[data-backend-run]\");\n+  backendButton?.addEventListener(\"click\", () => {\n+    void runBackend();\n+  });\n+}\n+\n+function card(title: string, body: string) {\n+  return `<section class=\"card\"><h2>${escapeHtml(title)}</h2>${body}</section>`;\n+}\n+\n+function metrics(contract: SourceContract) {\n+  return [\n+    metric(\"Entities\", contract.entityCount || \"not recorded\"),\n+    metric(\"URLs each\", contract.urlsPerEntity || \"not recorded\"),\n+    metric(\"Total fetches\", contract.totalUrls || \"not recorded\"),\n+    metric(\"Tools\", contract.requiredTools.join(\", \") || \"none\"),\n+  ].join(\"\");\n+}\n+\n+function metric(label: string, value: string | number) {\n+  return `<div class=\"metric\"><span>${escapeHtml(label)}</span><strong>${escapeHtml(String(value))}</strong></div>`;\n+}\n+\n+function scorecard(label: string, report: TraceEval) {\n+  return `\n+    <section class=\"scorecard ${report.ok ? \"pass\" : \"fail\"}\">\n+      <div>\n+        <p>${escapeHtml(label)}</p>\n+        <strong>${Math.round(report.score * 100)}%</strong>\n+      </div>\n+      <div>\n+        <span>${report.metrics.fetchCount}/${report.metrics.requiredFetchCount || 0} fetches</span>\n+        <span>${escapeHtml(report.failures.length ? report.failures.join(\" · \") : \"state checks passed\")}</span>\n+      </div>\n+    </section>\n+  `;\n+}\n+\n+function timeline(events: TraceEvent[]) {\n+  return `\n+    <section class=\"timeline\" aria-label=\"Trace timeline\">\n+      <h2>Trace Timeline</h2>\n+      ${events\n+        .map(\n+          (event) => `\n+            <article class=\"traceRow\">\n+              <span class=\"dot\"></span>\n+              <div>\n+                <header>\n+                  <strong>${escapeHtml(event.kind ?? event.tool ?? \"event\")}</strong>\n+                  <span>${escapeHtml(event.entity ?? \"not recorded\")}</span>\n+                </header>\n+                <p>${escapeHtml(event.summary ?? event.url ?? \"No summary recorded\")}</p>\n+                ${event.url ? `<code>${escapeHtml(event.url)}</code>` : \"\"}\n+              </div>\n+            </article>\n+          `,\n+        )\n+        .join(\"\")}\n+    </section>\n+  `;\n+}\n+\n+function backendCard() {\n+  const status = backendState.status;\n+  const raw = backendState.raw ? `<pre>${escapeHtml(JSON.stringify(backendState.raw, null, 2))}</pre>` : \"\";\n+  return card(\n+    \"Live Extension Backend\",\n+    `<div class=\"backendStatus ${status}\">\n+      <strong>${escapeHtml(status)}</strong>\n+      <span>${escapeHtml(backendState.summary)}</span>\n+    </div>\n+    <button type=\"button\" data-backend-run>Run Python extension</button>\n+    ${raw}`,\n+  );\n+}\n+\n+async function runBackend() {\n+  backendState = { status: \"loading\", summary: \"Calling http://127.0.0.1:8091/api/run\" };\n+  render();\n+  try {\n+    const response = await fetch(\"http://127.0.0.1:8091/api/run\", {\n+      method: \"POST\",\n+      headers: { \"Content-Type\": \"application/json\" },\n+      body: JSON.stringify({ objective, include_traces: false }),\n+    });\n+    if (!response.ok) throw new Error(`HTTP ${response.status}`);\n+    const payload = await response.json();\n+    const verdict = payload?.verdict?.summary || \"extension returned JSON\";\n+    backendState = { status: \"ready\", summary: verdict, raw: payload };\n+  } catch (error) {\n+    backendState = {\n+      status: \"error\",\n+      summary: error instanceof Error ? error.message : \"Backend unavailable. Start scripts/run_backend.sh.\",\n+    };\n+  }\n+  render();\n+}\n+\n+function escapeHtml(value: string) {\n+  return value\n+    .replace(/&/g, \"&amp;\")\n+    .replace(/</g, \"&lt;\")\n+    .replace(/>/g, \"&gt;\")\n+    .replace(/\"/g, \"&quot;\")\n+    .replace(/'/g, \"&#039;\");\n+}\n+\n+render();"},{"sha":"88ebefcf63a05f968dac8b0f42721e32a13e9c85","filename":"extractions/shovs-harness-core/frontend/src/styles.css","status":"added","additions":412,"deletions":0,"changes":412,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fstyles.css","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fstyles.css","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Fsrc%2Fstyles.css?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,412 @@\n+:root {\n+  color-scheme: light;\n+  font-family:\n+    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\",\n+    sans-serif;\n+  background: #eef2f5;\n+  color: #17212b;\n+  font-synthesis: none;\n+  text-rendering: optimizeLegibility;\n+}\n+\n+* {\n+  box-sizing: border-box;\n+}\n+\n+body {\n+  margin: 0;\n+  min-width: 320px;\n+}\n+\n+button,\n+textarea {\n+  font: inherit;\n+}\n+\n+button {\n+  border: 1px solid #cbd5df;\n+  background: #ffffff;\n+  color: #203040;\n+  border-radius: 8px;\n+  cursor: pointer;\n+}\n+\n+button:hover {\n+  border-color: #4d8ea8;\n+}\n+\n+.shell {\n+  width: min(1500px, calc(100vw - 32px));\n+  margin: 0 auto;\n+  padding: 24px 0;\n+}\n+\n+.hero {\n+  min-height: 220px;\n+  display: grid;\n+  grid-template-columns: 1fr 360px;\n+  gap: 24px;\n+  align-items: end;\n+  padding: 30px 0 24px;\n+}\n+\n+.eyebrow {\n+  margin: 0 0 10px;\n+  color: #24657c;\n+  font-size: 0.78rem;\n+  font-weight: 800;\n+  letter-spacing: 0.08em;\n+  text-transform: uppercase;\n+}\n+\n+h1 {\n+  max-width: 820px;\n+  margin: 0;\n+  font-size: clamp(2.2rem, 5vw, 5.2rem);\n+  line-height: 0.96;\n+  letter-spacing: 0;\n+}\n+\n+.subhead {\n+  max-width: 720px;\n+  margin: 18px 0 0;\n+  color: #526273;\n+  font-size: 1.05rem;\n+  line-height: 1.55;\n+}\n+\n+.heroStats {\n+  min-height: 150px;\n+  display: grid;\n+  align-content: center;\n+  justify-items: start;\n+  padding: 24px;\n+  background: #17212b;\n+  color: #f6fbff;\n+  border-radius: 8px;\n+}\n+\n+.heroStats span {\n+  font-size: 4.2rem;\n+  font-weight: 850;\n+  line-height: 1;\n+}\n+\n+.heroStats small {\n+  color: #b8d7e2;\n+  font-weight: 700;\n+}\n+\n+.workspace {\n+  display: grid;\n+  grid-template-columns: minmax(280px, 0.9fr) minmax(520px, 1.6fr) minmax(280px, 0.9fr);\n+  gap: 16px;\n+  align-items: start;\n+}\n+\n+.controlPanel,\n+.runPanel,\n+.detailPanel {\n+  display: grid;\n+  gap: 14px;\n+}\n+\n+.fieldLabel {\n+  font-size: 0.82rem;\n+  font-weight: 800;\n+  color: #425164;\n+}\n+\n+textarea {\n+  width: 100%;\n+  min-height: 132px;\n+  resize: vertical;\n+  border: 1px solid #cbd5df;\n+  border-radius: 8px;\n+  padding: 14px;\n+  color: #17212b;\n+  background: #ffffff;\n+  line-height: 1.45;\n+}\n+\n+.examples {\n+  display: grid;\n+  gap: 8px;\n+}\n+\n+.examples button {\n+  padding: 10px 12px;\n+  text-align: left;\n+  color: #526273;\n+}\n+\n+.card,\n+.scorecard,\n+.timeline {\n+  border: 1px solid #d8e0e8;\n+  background: rgba(255, 255, 255, 0.86);\n+  border-radius: 8px;\n+  padding: 16px;\n+  box-shadow: 0 12px 30px rgba(23, 33, 43, 0.06);\n+}\n+\n+.card h2,\n+.timeline h2 {\n+  margin: 0 0 12px;\n+  font-size: 0.92rem;\n+  color: #203040;\n+}\n+\n+.card p {\n+  margin: 0;\n+  color: #526273;\n+  line-height: 1.5;\n+}\n+\n+.metric {\n+  display: flex;\n+  justify-content: space-between;\n+  gap: 12px;\n+  padding: 9px 0;\n+  border-top: 1px solid #edf1f5;\n+}\n+\n+.metric:first-of-type {\n+  border-top: 0;\n+}\n+\n+.metric span {\n+  color: #627386;\n+}\n+\n+.metric strong {\n+  max-width: 60%;\n+  text-align: right;\n+  color: #17212b;\n+}\n+\n+.tabs {\n+  display: grid;\n+  grid-template-columns: 1fr 1fr;\n+  gap: 8px;\n+  padding: 5px;\n+  background: #dfe7ee;\n+  border-radius: 8px;\n+}\n+\n+.tabs button {\n+  padding: 10px;\n+  border-color: transparent;\n+  background: transparent;\n+  font-weight: 750;\n+}\n+\n+.tabs button.active {\n+  background: #ffffff;\n+  border-color: #cbd5df;\n+  color: #1c657d;\n+  box-shadow: 0 8px 18px rgba(23, 33, 43, 0.08);\n+}\n+\n+.scorecard {\n+  display: grid;\n+  grid-template-columns: 0.7fr 1.3fr;\n+  gap: 16px;\n+  align-items: center;\n+  border-left-width: 5px;\n+}\n+\n+.scorecard.pass {\n+  border-left-color: #238568;\n+}\n+\n+.scorecard.fail {\n+  border-left-color: #b04d46;\n+}\n+\n+.scorecard p {\n+  margin: 0 0 4px;\n+  color: #627386;\n+  font-weight: 750;\n+}\n+\n+.scorecard strong {\n+  font-size: 2.6rem;\n+  line-height: 1;\n+}\n+\n+.scorecard span {\n+  display: block;\n+  color: #526273;\n+  line-height: 1.45;\n+}\n+\n+.decision {\n+  display: grid;\n+  grid-template-columns: auto 1fr;\n+  gap: 10px;\n+  align-items: center;\n+  margin-bottom: 10px;\n+}\n+\n+.decision strong {\n+  padding: 5px 9px;\n+  border-radius: 999px;\n+  background: #e7f3ef;\n+  color: #1d765d;\n+  font-size: 0.8rem;\n+  text-transform: uppercase;\n+}\n+\n+.backendStatus {\n+  display: grid;\n+  gap: 4px;\n+  margin-bottom: 10px;\n+  padding: 10px;\n+  border-radius: 8px;\n+  background: #eef5f8;\n+  border: 1px solid #d6e5eb;\n+}\n+\n+.backendStatus strong {\n+  color: #1c657d;\n+  text-transform: uppercase;\n+  font-size: 0.78rem;\n+}\n+\n+.backendStatus span {\n+  color: #526273;\n+  line-height: 1.4;\n+}\n+\n+.backendStatus.ready {\n+  background: #eef8f4;\n+  border-color: #cce7db;\n+}\n+\n+.backendStatus.error {\n+  background: #fff1ef;\n+  border-color: #efd0cc;\n+}\n+\n+.backendStatus.error strong {\n+  color: #9b3f39;\n+}\n+\n+.card button[data-backend-run] {\n+  width: 100%;\n+  padding: 10px 12px;\n+  font-weight: 750;\n+}\n+\n+.decision.act strong {\n+  background: #eef4f8;\n+  color: #1c657d;\n+}\n+\n+code,\n+pre {\n+  display: block;\n+  width: 100%;\n+  overflow: auto;\n+  border-radius: 8px;\n+  background: #111923;\n+  color: #d7eef5;\n+  padding: 12px;\n+  font-size: 0.82rem;\n+}\n+\n+pre {\n+  max-height: 420px;\n+  margin: 0;\n+  white-space: pre-wrap;\n+}\n+\n+.timeline {\n+  display: grid;\n+  gap: 0;\n+}\n+\n+.traceRow {\n+  position: relative;\n+  display: grid;\n+  grid-template-columns: 20px 1fr;\n+  gap: 10px;\n+  padding: 11px 0;\n+  border-top: 1px solid #edf1f5;\n+}\n+\n+.traceRow:first-of-type {\n+  border-top: 0;\n+}\n+\n+.dot {\n+  width: 10px;\n+  height: 10px;\n+  margin-top: 5px;\n+  border-radius: 50%;\n+  background: #4d8ea8;\n+  box-shadow: 0 0 0 4px #dcecf2;\n+}\n+\n+.traceRow header {\n+  display: flex;\n+  flex-wrap: wrap;\n+  gap: 8px;\n+  align-items: center;\n+}\n+\n+.traceRow header strong {\n+  color: #17212b;\n+}\n+\n+.traceRow header span {\n+  color: #627386;\n+  font-size: 0.86rem;\n+}\n+\n+.traceRow p {\n+  margin: 4px 0 0;\n+  color: #526273;\n+  line-height: 1.42;\n+}\n+\n+.traceRow code {\n+  margin-top: 8px;\n+  padding: 8px;\n+}\n+\n+@media (max-width: 1100px) {\n+  .hero,\n+  .workspace {\n+    grid-template-columns: 1fr;\n+  }\n+\n+  .heroStats {\n+    min-height: 120px;\n+  }\n+}\n+\n+@media (max-width: 620px) {\n+  .shell {\n+    width: min(100vw - 20px, 1500px);\n+    padding: 12px 0;\n+  }\n+\n+  .hero {\n+    padding-top: 14px;\n+  }\n+\n+  .scorecard {\n+    grid-template-columns: 1fr;\n+  }\n+\n+  .metric {\n+    display: grid;\n+  }\n+\n+  .metric strong {\n+    max-width: none;\n+    text-align: left;\n+  }\n+}"},{"sha":"152a811e14a3355655c3cc3827447f3511e3c5a5","filename":"extractions/shovs-harness-core/frontend/tsconfig.app.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.app.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.app.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.app.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"compilerOptions\": {\n+    \"tsBuildInfoFile\": \"./node_modules/.tmp/tsconfig.app.tsbuildinfo\",\n+    \"target\": \"ES2020\",\n+    \"useDefineForClassFields\": true,\n+    \"lib\": [\"ES2020\", \"DOM\", \"DOM.Iterable\"],\n+    \"module\": \"ESNext\",\n+    \"skipLibCheck\": true,\n+    \"moduleResolution\": \"bundler\",\n+    \"allowImportingTsExtensions\": true,\n+    \"isolatedModules\": true,\n+    \"moduleDetection\": \"force\",\n+    \"noEmit\": true,\n+    \"jsx\": \"react-jsx\",\n+    \"strict\": true,\n+    \"noUnusedLocals\": true,\n+    \"noUnusedParameters\": true,\n+    \"noFallthroughCasesInSwitch\": true,\n+    \"types\": []\n+  },\n+  \"include\": [\"src\"]\n+}"},{"sha":"82a8007eb973e068a4d47c608a7f8e259e76dcf3","filename":"extractions/shovs-harness-core/frontend/tsconfig.json","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Ffrontend%2Ftsconfig.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,4 @@\n+{\n+  \"files\": [],\n+  \"references\": [{ \"path\": \"./tsconfig.app.json\" }]\n+}"},{"sha":"17ec6bfa6532e11ba256dd808558a5d9fc526b52","filename":"extractions/shovs-harness-core/pyproject.toml","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fpyproject.toml","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fpyproject.toml","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Fpyproject.toml?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,10 @@\n+[project]\n+name = \"shovs-harness-core\"\n+version = \"0.1.0\"\n+description = \"A small, testable agent harness kernel extracted from ShovsOS.\"\n+requires-python = \">=3.10\"\n+dependencies = []\n+\n+[tool.pytest.ini_options]\n+testpaths = [\"tests\"]\n+pythonpath = [\".\"]"},{"sha":"6a1e675cb539c98e4e0c18ee158a01e4ce688a64","filename":"extractions/shovs-harness-core/scripts/check_setup.py","status":"added","additions":180,"deletions":0,"changes":180,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fcheck_setup.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fcheck_setup.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Fscripts%2Fcheck_setup.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,180 @@\n+from __future__ import annotations\n+\n+import json\n+import os\n+import platform\n+import shutil\n+import socket\n+import subprocess\n+import sys\n+import urllib.error\n+import urllib.request\n+from pathlib import Path\n+from typing import Any\n+\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+REPO = ROOT.parents[1]\n+\n+\n+def main() -> int:\n+    checks = [\n+        _check_python(),\n+        _check_pytest(),\n+        _check_node(),\n+        _check_frontend_tooling(),\n+        _check_homebrew(),\n+        _check_llamacpp_binary(),\n+        _check_llamacpp_server(),\n+    ]\n+    print(json.dumps({\"root\": str(ROOT), \"checks\": checks}, indent=2))\n+    blocking = [item for item in checks if item[\"status\"] == \"fail\" and item.get(\"required\")]\n+    return 1 if blocking else 0\n+\n+\n+def _check_python() -> dict[str, Any]:\n+    ok = sys.version_info >= (3, 10)\n+    return {\n+        \"name\": \"python\",\n+        \"status\": \"pass\" if ok else \"fail\",\n+        \"required\": True,\n+        \"detail\": platform.python_version(),\n+    }\n+\n+\n+def _check_pytest() -> dict[str, Any]:\n+    try:\n+        import pytest  # noqa: F401\n+        return {\"name\": \"pytest\", \"status\": \"pass\", \"required\": True, \"detail\": \"importable\"}\n+    except Exception as exc:\n+        return {\"name\": \"pytest\", \"status\": \"fail\", \"required\": True, \"detail\": str(exc)}\n+\n+\n+def _check_node() -> dict[str, Any]:\n+    node = shutil.which(\"node\")\n+    npm = shutil.which(\"npm\")\n+    detail = {\"node\": node, \"npm\": npm}\n+    if not node or not npm:\n+        return {\"name\": \"node/npm\", \"status\": \"warn\", \"required\": False, \"detail\": detail}\n+    try:\n+        detail[\"node_version\"] = subprocess.check_output([node, \"--version\"], text=True).strip()\n+        detail[\"npm_version\"] = subprocess.check_output([npm, \"--version\"], text=True).strip()\n+    except Exception as exc:\n+        detail[\"version_error\"] = str(exc)\n+    return {\"name\": \"node/npm\", \"status\": \"pass\", \"required\": False, \"detail\": detail}\n+\n+\n+def _check_frontend_tooling() -> dict[str, Any]:\n+    vite = REPO / \"frontend_consumer\" / \"node_modules\" / \".bin\" / \"vite\"\n+    tsc = REPO / \"frontend_consumer\" / \"node_modules\" / \".bin\" / \"tsc\"\n+    ok = vite.exists() and tsc.exists()\n+    return {\n+        \"name\": \"harness frontend tooling\",\n+        \"status\": \"pass\" if ok else \"warn\",\n+        \"required\": False,\n+        \"detail\": {\n+            \"vite\": str(vite),\n+            \"vite_exists\": vite.exists(),\n+            \"tsc_exists\": tsc.exists(),\n+            \"fix\": \"from repo root run npm install, or install frontend dependencies used by the harness demo\",\n+        },\n+    }\n+\n+\n+def _check_homebrew() -> dict[str, Any]:\n+    brew = shutil.which(\"brew\")\n+    if not brew:\n+        return {\n+            \"name\": \"homebrew\",\n+            \"status\": \"warn\",\n+            \"required\": False,\n+            \"detail\": {\"brew\": None, \"fix\": \"install llama.cpp from source, or install Homebrew first\"},\n+        }\n+    detail: dict[str, Any] = {\"brew\": brew}\n+    try:\n+        prefix = subprocess.check_output([brew, \"--prefix\"], text=True, stderr=subprocess.STDOUT).strip()\n+        detail[\"prefix\"] = prefix\n+        prefix_path = Path(prefix)\n+        detail[\"prefix_exists\"] = prefix_path.exists()\n+        detail[\"prefix_writable\"] = os.access(prefix, os.W_OK)\n+        locks = prefix_path / \"var\" / \"homebrew\" / \"locks\"\n+        detail[\"locks\"] = str(locks)\n+        detail[\"locks_writable\"] = os.access(locks, os.W_OK) if locks.exists() else None\n+        if detail[\"prefix_writable\"] is False or detail[\"locks_writable\"] is False:\n+            return {\n+                \"name\": \"homebrew\",\n+                \"status\": \"warn\",\n+                \"required\": False,\n+                \"detail\": {\n+                    **detail,\n+                    \"fix\": \"Homebrew prefix is not writable by this user. Run brew doctor and repair ownership before brew install.\",\n+                },\n+            }\n+    except Exception as exc:\n+        detail[\"error\"] = str(exc)\n+        return {\"name\": \"homebrew\", \"status\": \"warn\", \"required\": False, \"detail\": detail}\n+    return {\"name\": \"homebrew\", \"status\": \"pass\", \"required\": False, \"detail\": detail}\n+\n+\n+def _check_llamacpp_binary() -> dict[str, Any]:\n+    bins = {\n+        \"llama-server\": shutil.which(\"llama-server\"),\n+        \"llama-cli\": shutil.which(\"llama-cli\"),\n+    }\n+    status = \"pass\" if any(bins.values()) else \"warn\"\n+    return {\n+        \"name\": \"llama.cpp binaries\",\n+        \"status\": status,\n+        \"required\": False,\n+        \"detail\": {\n+            **bins,\n+            \"fix\": \"install llama.cpp, then ensure llama-server is on PATH\",\n+        },\n+    }\n+\n+\n+def _check_llamacpp_server() -> dict[str, Any]:\n+    base_url = os.getenv(\"LLAMACPP_BASE_URL\", \"http://127.0.0.1:8081/v1\").rstrip(\"/\")\n+    parsed = _parse_host_port(base_url)\n+    detail: dict[str, Any] = {\"base_url\": base_url}\n+    if parsed:\n+        host, port = parsed\n+        detail[\"port_open\"] = _port_open(host, port)\n+    try:\n+        with urllib.request.urlopen(f\"{base_url}/models\", timeout=2.0) as response:\n+            payload = json.loads(response.read().decode(\"utf-8\"))\n+        models = [\n+            str(item.get(\"id\") or item.get(\"name\") or \"\")\n+            for item in payload.get(\"data\", [])\n+            if isinstance(item, dict)\n+        ]\n+        detail[\"models\"] = [item for item in models if item][:10]\n+        return {\"name\": \"llama.cpp server\", \"status\": \"pass\", \"required\": False, \"detail\": detail}\n+    except urllib.error.HTTPError as exc:\n+        detail[\"error\"] = f\"HTTP {exc.code}\"\n+    except Exception as exc:\n+        detail[\"error\"] = f\"{type(exc).__name__}: {exc}\"\n+    detail[\"fix\"] = \"start llama-server on localhost, e.g. --host 127.0.0.1 --port 8081\"\n+    return {\"name\": \"llama.cpp server\", \"status\": \"warn\", \"required\": False, \"detail\": detail}\n+\n+\n+def _parse_host_port(base_url: str) -> tuple[str, int] | None:\n+    try:\n+        without_scheme = base_url.split(\"://\", 1)[1] if \"://\" in base_url else base_url\n+        host_port = without_scheme.split(\"/\", 1)[0]\n+        host, port = host_port.rsplit(\":\", 1)\n+        return host, int(port)\n+    except Exception:\n+        return None\n+\n+\n+def _port_open(host: str, port: int) -> bool:\n+    try:\n+        with socket.create_connection((host, port), timeout=1.0):\n+            return True\n+    except OSError:\n+        return False\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())"},{"sha":"0ef3909b303c3d0091fa4516276b4b1de6de2a62","filename":"extractions/shovs-harness-core/scripts/harness_backend.py","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fharness_backend.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fharness_backend.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Fscripts%2Fharness_backend.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b"},{"sha":"0a6976bd238fce786497dcea52df47080e5ebd5e","filename":"extractions/shovs-harness-core/scripts/kernel_demo.py","status":"added","additions":155,"deletions":0,"changes":155,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fkernel_demo.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fkernel_demo.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Fscripts%2Fkernel_demo.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b"},{"sha":"d6c20c100e5607806102d120952ab4f02cf4af34","filename":"extractions/shovs-harness-core/scripts/llamacpp_probe.py","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fllamacpp_probe.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-harness-core%2Fscripts%2Fllamacpp_probe.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-harness-core%2Fscripts%2Fllamacpp
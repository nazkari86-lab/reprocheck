{"sha":"a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","node_id":"C_kwDORv3YP9oAKGE2ODBjODRhM2I4ZjJmOGRmYWYyNTA2MGExY2ExODM5MGI4MzVkMmI","commit":{"author":{"name":"Shovon Saha","email":"97457556+theshovonsaha@users.noreply.github.com","date":"2026-07-03T23:35:16Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-07-03T23:35:16Z"},"message":"Merge pull request #8 from theshovonsaha/working-test/thesis\n\nWorking test/thesis","tree":{"sha":"2e3ab8e97c5ec4d23d1828dc62c06071c0124c86","url":"https://api.github.com/repos/theshovonsaha/shovsOS/git/trees/2e3ab8e97c5ec4d23d1828dc62c06071c0124c86"},"url":"https://api.github.com/repos/theshovonsaha/shovsOS/git/commits/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqSEc0CRC1aQ7uu5UhlAAA02AQACta/CIrI2wXahQukUqq8G0l\n4+adkywpQJ/+dnneyPZaci+AwsELLO6gm4QybMyzHzt8/6DgDUjAvhF97JOQ8V2u\nb6uZBbKNDxLTVv68zDWAIlhWrUlI34lWj04j9fMTNChRq7Zez2azFGo05YgvNKOD\ntaKy3LlQuV8/2BOSiFjPjNkaInFJXNwk8Q3WlQ0OyihrK+/QBsqI9rVV4q6q6LWp\npk5Py3QTuPxb1ed/akCPnccCcInFPmEzhzDy+Gi92LW/LWMgnne36oalhAFmVLhz\njB/+E4KcFO+cW6trrsgH7YYrzPjO5TYvlrj7/qp+sDxNAgRBlliKA6NOX/wF2jb7\nm30PfC+dCo9rTMM6A+r5SGLBk0BdSsQVz1u5QgR6lBiAtodvxC/4fOX0Vdd0yyl1\nMm6bHWS0llIPu8NBGPGkHntwfhO5jvfVf255IbYc1zsiyV6i8kMaSeKzQAFZ8tn/\nOLJMIMMpvldQ2CrK2izVadB4kGUhq0J2OGEiB5S6jhp6JyJwlqIGW8Yr0TFJtvAj\nna6DdBV07NZrS4DFe1AN0VO5j6gegdizTJDWwWflNHd72Re42dz7eRO2t22k2GUs\nSqt7bVtLUD/F7oWcPWH87XxEv8MwceuZ7Pnc0ydKQGKg+fnG6aZGpYPafhr/yuiv\no/nW99Xnb63AMkOb8VSb\n=VdYp\n-----END PGP SIGNATURE-----\n","payload":"tree 2e3ab8e97c5ec4d23d1828dc62c06071c0124c86\nparent f6f3eaa98ef8c4584a8d24c623152465c7f26d7c\nparent fc33e1cf15aa1d3151277e2df554e67ec773bda7\nauthor Shovon Saha <97457556+theshovonsaha@users.noreply.github.com> 1783121716 -0400\ncommitter GitHub <noreply@github.com> 1783121716 -0400\n\nMerge pull request #8 from theshovonsaha/working-test/thesis\n\nWorking test/thesis","verified_at":"2026-07-03T23:35:16Z"}},"url":"https://api.github.com/repos/theshovonsaha/shovsOS/commits/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","html_url":"https://github.com/theshovonsaha/shovsOS/commit/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","comments_url":"https://api.github.com/repos/theshovonsaha/shovsOS/commits/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/comments","author":{"login":"theshovonsaha","id":97457556,"node_id":"U_kgDOBc8VlA","avatar_url":"https://avatars.githubusercontent.com/u/97457556?v=4","gravatar_id":"","url":"https://api.github.com/users/theshovonsaha","html_url":"https://github.com/theshovonsaha","followers_url":"https://api.github.com/users/theshovonsaha/followers","following_url":"https://api.github.com/users/theshovonsaha/following{/other_user}","gists_url":"https://api.github.com/users/theshovonsaha/gists{/gist_id}","starred_url":"https://api.github.com/users/theshovonsaha/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/theshovonsaha/subscriptions","organizations_url":"https://api.github.com/users/theshovonsaha/orgs","repos_url":"https://api.github.com/users/theshovonsaha/repos","events_url":"https://api.github.com/users/theshovonsaha/events{/privacy}","received_events_url":"https://api.github.com/users/theshovonsaha/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f6f3eaa98ef8c4584a8d24c623152465c7f26d7c","url":"https://api.github.com/repos/theshovonsaha/shovsOS/commits/f6f3eaa98ef8c4584a8d24c623152465c7f26d7c","html_url":"https://github.com/theshovonsaha/shovsOS/commit/f6f3eaa98ef8c4584a8d24c623152465c7f26d7c"},{"sha":"fc33e1cf15aa1d3151277e2df554e67ec773bda7","url":"https://api.github.com/repos/theshovonsaha/shovsOS/commits/fc33e1cf15aa1d3151277e2df554e67ec773bda7","html_url":"https://github.com/theshovonsaha/shovsOS/commit/fc33e1cf15aa1d3151277e2df554e67ec773bda7"}],"stats":{"total":57496,"additions":56725,"deletions":771},"files":[{"sha":"2992272468891499bb36a47fd1eab692ebe6b8de","filename":".env.example","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/.env.example","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/.env.example","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/.env.example?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -54,6 +54,7 @@ EXA_TEXT_MAX_CHARACTERS=20000\n \n # Optional integrations\n GOOGLE_PLACES_API_KEY=\n+ALPHA_VANTAGE_API_KEY=\n DEEPGRAM_API_KEY=\n \n # Storage"},{"sha":"dcf9120538d6b79191fd8a1ff191fbd7c6933970","filename":".gitignore","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/.gitignore","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/.gitignore","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/.gitignore?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -30,6 +30,8 @@ eggs/\n .eggs/\n lib/\n lib64/\n+!extractions/shovs-agent-harness/frontend/src/lib/\n+!extractions/shovs-agent-harness/frontend/src/lib/**\n parts/\n sdist/\n var/"},{"sha":"93fd913b5a6c92e98104e3d0f0297184086eb498","filename":"BENCHMARKS.md","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/BENCHMARKS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/BENCHMARKS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/BENCHMARKS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -49,6 +49,10 @@ The bottom layers should be fast and deterministic. Public demos should be built\n | Scenario | What it checks | Primary tests |\n | --- | --- | --- |\n | Source collection contract | The agent keeps selected entities locked and fetches the requested sources instead of drifting. | `tests/test_runtime_e2e_diagnostics.py`, `tests/test_agent_harness_core_benchmarks.py` |\n+| Workflow contract inference | Topic-agnostic source-collection requests become explicit quotas, tool policy, and completion gates. | `tests/test_workflow_contracts_runtime.py` |\n+| Pass framework | Workflow contracts map to specialist passes, context strategies, and stop conditions. | `tests/test_pass_framework.py` |\n+| Ledger-authority tool inputs | Managed source selection rejects fake model-supplied search payloads and resolves successful ledger result IDs. | `tests/test_web_search_context.py`, `tests/test_run_engine_contract.py` |\n+| Runtime attention | Phase-specific ledger scoring is deterministic and selects pending/evidence records differently by phase. | `tests/test_run_ledger.py` |\n | Tool hallucination guard | Tested final-response paths reject or clean tool-call-shaped JSON before user-facing output. | `tests/test_response_guard.py` |\n | Ledger linking | Ledger helpers reject tool results without a known tool call. | `tests/test_run_ledger.py`, `tests/test_agent_harness_core_benchmarks.py` |\n | Memory rollback | Tested replacement paths avoid destroying the old fact if the new fact fails to store. | `tests/test_shovs_memory.py` |"},{"sha":"c605bbed14192a4e0ae531c8bce201a41139010d","filename":"CLAIMS.md","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/CLAIMS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/CLAIMS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/CLAIMS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -7,7 +7,12 @@ This file separates locally validated claims from active work.\n | Claim | Evidence |\n | --- | --- |\n | Tool results must link to known tool calls. | `RunLedger.link_tool_result` rejects orphaned results. |\n+| Source-collection workflow contracts can be inferred without topic-specific code. | `infer_workflow_contract(...)` extracts entity/source/fetch quotas for stocks, products, tools, and similar collection tasks. |\n+| Workflow contracts can produce typed specialist pass graphs. | `build_pass_graph(...)` maps source collection, research reports, coding changes, memory corrections, simple chat, and general tasks to explicit pass roles and stop conditions. |\n+| Execution contracts separate planning authority from execution authority. | `RunLedger.execution_contract()` derives user-owned decisions, agent-owned decisions, evidence requirements, action queue, readiness, and AgentIR from the same ledger state. |\n+| Managed source selection rejects model-fabricated search payloads. | `source_select` uses ledger context in managed runs and rejects raw `search_payloads` unless backed by successful ledger tool results. |\n | Source-collection drift can be detected from trace state. | `SourceCollectionEval` catches forbidden query drift and missing fetch quotas. |\n+| Runtime attention scoring is deterministic from ledger state. | `RunLedger.attention_for_phase(...)` produces stable phase-weighted snapshots used by phase packets. |\n | Small/local final-answer JSON leaks can be guarded in tested paths. | `guard_final_response` converts tool-shaped JSON into clean user-facing text or a safe fallback. |\n | Memory fact replacement is rollback-safe. | `SemanticGraph.replace_temporal_facts` keeps the old fact if the replacement fails. |\n | The memory inspector reports real current fact counts, not only the last timeline page. | Inspector tests count facts beyond the timeline limit. |\n@@ -16,6 +21,11 @@ This file separates locally validated claims from active work.\n \n - ShovsOS is best described as an agent harness/runtime.\n - The central abstraction is structured run state, not a longer system prompt.\n+- Recognizable multi-step workflows should become explicit contracts before prompting.\n+- Live runs should expose an execution contract that preserves user-owned objective, constraints, entities, evidence quota, and definition of done.\n+- Specialist passes should be explicit runtime objects, not implied by one large prompt.\n+- Deterministic tools should consume ledger-backed IDs in managed runs, not raw model-provided state.\n+- Runtime attention should score structured run state before context is compiled.\n - The UI should inspect ledger events, not raw model text.\n - Memory should expose current, superseded, candidate, and disputed state separately.\n "},{"sha":"e84beef57d6177850bf4eae0eb6977903fa7c030","filename":"EVALS.md","status":"modified","additions":13,"deletions":1,"changes":14,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/EVALS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/EVALS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/EVALS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -32,6 +32,19 @@ The eval checks the trace against locked scenario state:\n - forbidden query terms\n - allowed URLs\n - source-contract events\n+- execution-contract readiness and action queue\n+\n+## Execution Contract Eval\n+\n+The execution contract is checked as state, not prose.\n+\n+The important checks are:\n+\n+- user-owned objective and evidence quota remain stable\n+- locked entities do not drift unless the user changes the task\n+- next action matches the required tool and arguments\n+- final answer is blocked while evidence slots are missing\n+- AgentIR summarizes the same work shape the ledger enforces\n \n ## Tool Honesty Eval\n \n@@ -79,4 +92,3 @@ It returns clean user-facing text and records what changed.\n   }\n }\n ```\n-"},{"sha":"255443032f5fe3c1955bff04b91f0748a79016f1","filename":"HARNESS.md","status":"modified","additions":354,"deletions":0,"changes":354,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/HARNESS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/HARNESS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/HARNESS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -10,12 +10,25 @@ flowchart LR\n     H --> P[\"Plan\"]\n     H --> C[\"Context packet\"]\n     H --> L[\"Run ledger\"]\n+    H --> W[\"Workflow contract\"]\n+    H --> WP[\"Workflow plugins\"]\n+    H --> CP[\"Control policy\"]\n+    H --> G[\"Pass graph\"]\n+    H --> A[\"Runtime attention\"]\n+    H --> K[\"Language kernel snapshot\"]\n     H --> T[\"Tool registry\"]\n     H --> E[\"Evidence lane\"]\n     H --> M[\"Memory\"]\n     H --> V[\"Verifier + response guard\"]\n     H --> R[\"Trace + replay evals\"]\n     P --> Model[\"LLM\"]\n+    W --> WP\n+    W --> CP\n+    WP --> G\n+    CP --> G\n+    G --> A\n+    A --> K\n+    K --> C\n     C --> Model\n     Model --> T\n     T --> L\n@@ -27,13 +40,42 @@ flowchart LR\n ## What The Harness Does\n \n - Keeps a typed run ledger for the current task.\n+- Converts recognizable task shapes into workflow contracts with completion gates.\n+- Routes domain-specific workflow behavior through registered workflow plugins instead of hardcoded engine branches.\n+- Selects a control policy per run: ReAct, plan-act-observe, plan-then-execute, or structured graph harness.\n+- Maps workflow contracts to specialist pass graphs with explicit roles and stop conditions.\n+- Scores ledger records by phase so context is weighted before the model sees it.\n+- Composes a language-kernel snapshot: prompt contract, context ladder, tool gate, memory immune report, experience graph, proxy-state eval, micro-agent jobs, and UI run map.\n - Builds phase packets from that ledger instead of passing loose prompt text around.\n+- Validates plan-execute tool calls against locked entities, source contracts, and next required actions.\n+- Blocks or replaces invalid calls in `ledger_enforced` mode while recording violations in `shadow` mode.\n+- Uses a context ladder so the model sees compact signals first and raw payloads only by reference unless needed.\n - Links every tool result to a real tool call.\n - Turns web and tool output into evidence before final response generation.\n - Stops final answers from claiming tool work that is not in the ledger.\n - Stores memory with provenance and rollback behavior.\n - Produces traces that can be replayed by tests and inspected by the UI.\n \n+## Smallest Live Harness\n+\n+The smallest standalone version lives in\n+[`extractions/shovs-harness-core`](extractions/shovs-harness-core). Use it when\n+you want to test the core idea without the full ShovsOS app:\n+\n+```bash\n+venv/bin/python extractions/shovs-harness-core/scripts/check_setup.py\n+extractions/shovs-harness-core/scripts/run_live_app.sh\n+```\n+\n+It runs a local JSON backend on `127.0.0.1:8091` and a Vite frontend on\n+`127.0.0.1:5177`. The backend exposes the extracted extension contract and can\n+probe a local llama.cpp server when `LLAMACPP_BASE_URL` is set.\n+\n+For local llama.cpp tests, prefer `llama-server --host 127.0.0.1 --port 8081`.\n+If `brew install llama.cpp` fails with `/opt/homebrew is not writable`, fix the\n+Homebrew prefix ownership or build llama.cpp from source; do not run\n+`sudo brew install`.\n+\n ## What It Is Not\n \n - It is not a new foundation model.\n@@ -63,6 +105,21 @@ stateDiagram-v2\n \n Each state has expected inputs and allowed outputs. In the current implementation, acting and observation can loop within a run. Final verification can recommend replanning and persist continuation state for the next turn; it does not yet automatically re-enter the acting loop after the final response.\n \n+## Control Policies\n+\n+The loop is now an explicit policy, not a hidden assumption.\n+\n+Supported policies:\n+\n+- `react`: reason-act-observe. Useful for bounded low-risk tasks and quick tool iteration.\n+- `plan_observe`: the compatibility policy. Planner narrows tools, actor performs one action, observer decides whether to continue.\n+- `plan_execute`: safer default for web/source workflows. The plan is committed before untrusted web content is read; observations fill slots but should not redefine the task.\n+- `graph_harness`: structured pass graph with bounded recovery. Better for coding, high-risk, or long-horizon workflows.\n+\n+`auto` chooses a policy from the workflow contract, risk policy, and tool set. Source collection and time-sensitive web tasks prefer `plan_execute`; coding and high-risk tasks prefer `graph_harness`; simple chat can use `react`.\n+\n+`LEDGER_MODE=shadow` records violations without changing legacy behavior. `LEDGER_MODE=ledger_enforced` turns the ledger into a runtime gate: wrong next tools, unlocked-entity searches, off-contract fetches, and incomplete source coverage are blocked or redirected before the response is treated as complete.\n+\n ## Why This Matters\n \n Most agent failures look reasonable in the final answer. The trace is where the failure appears:\n@@ -74,3 +131,300 @@ Most agent failures look reasonable in the final answer. The trace is where the\n - Raw tool JSON leaked into chat.\n \n ShovsOS treats those as runtime problems, not just prompt problems.\n+\n+## Workflow Plugins\n+\n+The engine should stay topic-agnostic. Domain behavior belongs in workflow plugins.\n+\n+Current plugins:\n+\n+- `stock_movers_source_collection`: detects requests like \"top 3 stocks, search each, fetch 3 URLs each\", fetches a market-movers source, locks ticker entities, enforces separate ticker searches, then requires the fetched source quota before final response.\n+- `local_place_source_collection`: locks local places from discovery search results, then requires separate per-place searches and fetched evidence.\n+- `comparison_source_collection`: locks compared products/items/options, gathers per-entity sources, and supports evidence-backed comparison tables.\n+\n+Plugin shape:\n+\n+```text\n+detect objective\n+  -> infer source contract\n+  -> extract or lock entities from tool evidence\n+  -> choose next tool\n+  -> return missing slots, argument clues, and completion state\n+```\n+\n+The engine calls the plugin registry through `select_workflow_override(...)`. It does not need stock-specific source rules in the loop.\n+\n+## Deterministic Source Tool\n+\n+`source_collect` is the compact tool surface over the source workflow primitives.\n+It does not replace `web_search` or `web_fetch`. It compiles the current source\n+state into one inspectable object:\n+\n+- inferred source contract\n+- locked and rejected entities\n+- selected URLs grouped by entity\n+- fetched URL coverage\n+- missing slots\n+- exact next action\n+- final-answer gate\n+\n+This gives smaller models a stable path through multi-source tasks. Instead of\n+remembering to call `source_contract`, then `source_select`, then `source_coverage`,\n+then choosing the next fetch manually, the model can ask the harness what source\n+step is allowed next. Managed runs still prefer ledger-backed tool result IDs over\n+model-supplied payloads, so the tool cannot be used to launder fabricated search\n+results into evidence.\n+\n+## Search Query Boundary\n+\n+The full user request is not the search query.\n+\n+Source-collection turns often contain several different kinds of information:\n+\n+- the objective: \"top 3 stocks today\"\n+- workflow instructions: \"search each separately\"\n+- source quotas: \"capture 3 results each\"\n+- tool steps: \"fetch all 9 URLs\"\n+- output format: \"write a TLDR table\"\n+\n+Those belong in the ledger, workflow contract, and completion gate. The\n+`web_search.query` field should contain only the retrieval probe. The runtime\n+therefore compiles workflow-like search text before execution. For example:\n+\n+```text\n+Search top 3 stocks today with major jumps web search those 3 stocks separately\n+and capture 3 relevant results for each, web fetch all 9 URLs, write a TLDR table\n+```\n+\n+becomes:\n+\n+```text\n+top 3 stocks today with major jumps\n+```\n+\n+The original objective is still preserved in trace and planning state. The\n+search engine just receives the smaller query it can actually answer.\n+\n+## Context Ladder\n+\n+The actor should not receive every memory block, trace payload, and raw tool result by default. ShovsOS now represents context as a ladder:\n+\n+```text\n+keyword hint\n+  -> compact memory signal\n+  -> relevant block\n+  -> evidence reference\n+  -> raw payload on demand\n+```\n+\n+Phase packets include this ladder as structured runtime context. Raw payloads stay available for trace inspection and verification, but the model gets the smallest useful view first.\n+\n+Simple chat uses a sparse packet. Short greetings and acknowledgements do not\n+receive stale plans, runtime attention, historical transcript, compressed memory,\n+or source workflow state. This prevents old cognitive context from bleeding into\n+turns like \"hi again\" while preserving full packets for source, coding, memory,\n+and research workflows.\n+\n+When the optional BGE reranker is unavailable, session retrieval now falls back to\n+a deterministic lexical reranker. Exact entity and query-term matches are promoted\n+over generic vector hits, which keeps locked entities and current objectives more\n+stable on lightweight installs.\n+\n+`coherence_eval` provides a small regression surface for intent routing and packet\n+leak checks. It is not a benchmark claim; it is a guardrail for failures where the\n+final answer sounds normal but the runtime used the wrong workflow or injected the\n+wrong context.\n+\n+Compression also has a low-value-turn gate. Greetings and acknowledgements such\n+as \"hi again\", \"thanks that helps\", and \"ok got it\" are not written into durable\n+or convergent memory, even when the assistant response is verbose. Existing\n+serialized context is preserved on those turns, so a trivial acknowledgement\n+cannot wipe V2/V3 memory state.\n+\n+Frontend/API chat also uses deferred memory maintenance by default. The response\n+stream can finish before compression and vector indexing complete, while direct\n+`RunEngine` calls still default to synchronous commits for deterministic tests.\n+Set `SHOVSOS_MEMORY_COMMIT_MODE=sync` to force old blocking behavior, `async` to\n+respond first and commit in the background, or `skip` for no memory maintenance\n+on a run.\n+\n+LLM compression is also adaptive. Deterministic memory governance can run every\n+turn, but the expensive `compress_exchange` model call now runs only when a turn\n+has durable memory signals, corrections, deterministic fact updates, candidate\n+stance signals, or a periodic maintenance interval. Configure this with\n+`SHOVSOS_LLM_COMPRESSION_MODE=adaptive|always|off` and\n+`SHOVSOS_LLM_COMPRESSION_INTERVAL` (default `6`). This keeps ordinary Q&A turns\n+from paying an extra model call just to rewrite context.\n+\n+## Language Kernel Snapshot\n+\n+`run_engine/language_kernel.py` is the compact runtime object for the next\n+ShovsOS direction. It does not call a model. It gathers the seven reliability\n+lanes into one typed snapshot that prompts, tests, traces, and UI can consume.\n+\n+The snapshot contains:\n+\n+- `prompt_contract`: the current role, policy, locked entities, allowed next tool, missing slots, successful result IDs, and short runtime rules.\n+- `context_ladder`: compact memory and evidence first, raw payloads by reference unless explicitly requested.\n+- `attention`: phase-weighted ledger items from runtime attention.\n+- `tool_gate`: next required action, source contract, completion gate, and policy violations.\n+- `memory_immune_report`: memory writes, provenance status, disputed writes, and conflict traces.\n+- `experience_graph`: objective, plan, tool calls, tool results, and evidence as reusable trajectory nodes.\n+- `proxy_state_eval`: state-based checks for missing evidence, unsupported tool claims, drift, and completion.\n+- `micro_agent_jobs`: small bounded jobs suitable for cheap verifier/classifier/compressor models.\n+- `ui_run_map`: simple sections a frontend can render as Objective -> Plan -> Tools -> Evidence -> Memory -> Verification -> Response.\n+\n+The important design choice is that this layer is deterministic. Provider-native\n+tool calling is treated as a transport detail; the language kernel decides what\n+state the model is allowed to see and what the runtime must verify.\n+\n+Tool selection now uses this layer actively. If the ledger has an exact\n+`next_required_action` with complete arguments, the runtime can select that tool\n+without another actor-model call. If the next action is not deterministic, the\n+actor prompt receives the language-kernel contract above the older context. That\n+keeps provider-native tool calling useful while preventing it from becoming the\n+source of truth.\n+\n+Example actor contract:\n+\n+```text\n+Runtime Prompt Contract:\n+- role: actor\n+- phase: acting\n+- objective: Search top 3 stocks, search each separately, fetch 3 URLs each\n+- policy: plan_execute\n+- final answer allowed: false\n+- allowed next tool: web_search\n+- allowed arguments: {'query': 'ROKU stock news June 13 2026'}\n+- locked entities: ROKU, TBN, SENEA\n+- missing slots: fetched_urls:0/9\n+Rules:\n+- Do not claim a tool ran unless its successful result id is listed.\n+- Use the allowed next tool when one is provided.\n+- Do not search or fetch outside locked entities/source contracts.\n+- Do not write memory unless provenance or evidence is available.\n+- Do not produce a final answer while missing slots remain.\n+```\n+\n+This is the practical form of the research thesis: use language for intent and\n+judgment, but let the harness own state, tools, memory, continuation, and proof.\n+\n+## Turn Relation Calculus\n+\n+Context is not retrieved by similarity alone. Each turn is first classified by\n+its relationship to prior context:\n+\n+- `fresh_topic`: isolate from old plans and locked entities.\n+- `direct_continuation`: load continuation state, pending steps, and next required action.\n+- `distant_resumption`: retrieve compact memory signals and raw refs, not full history.\n+- `correction`: latest explicit correction dominates older conflicting facts.\n+- `refinement`: patch the current plan or constraint without restarting everything.\n+- `deviation`: preserve stable preferences, but replan workflow state.\n+- `meta_instruction`: apply as runtime/style policy, not domain factual content.\n+\n+The classifier emits a proof packet:\n+\n+```text\n+relation\n+confidence\n+anchors\n+required_context\n+blocked_context\n+memory_write_policy\n+tool_policy\n+proof_obligations\n+```\n+\n+That packet is stored on the run ledger and rendered inside the language-kernel\n+prompt contract. A real model sees a compact directive such as:\n+\n+```text\n+- turn relation: direct_continuation\n+- relation required context: continuation_state, locked_entities, next_required_action\n+- relation blocked context: unrelated_memory, old_completed_plans\n+```\n+\n+This gives the harness a logical reason for context inclusion. It can prove why\n+old state was used, ignored, patched, or demoted.\n+\n+## Provider Capability Matrix\n+\n+`llm/provider_capabilities.py` describes provider/model features as runtime\n+flags:\n+\n+- native tool transport\n+- structured JSON support\n+- vision input support\n+- image generation support\n+- reasoning-control support\n+- parallel tool support\n+- explicit tool-choice support\n+- fallback protocol\n+\n+The engine should not assume every model behaves the same. Native tools are\n+preferred when available, but unknown providers fall back to the same internal\n+`ToolCallDraft`/JSON protocol. The business logic stays in the harness; provider\n+features only choose the safest transport.\n+\n+## Harness Lab\n+\n+Harness Lab exposes deterministic comparisons between runtime modes:\n+\n+- plain model\n+- model plus tools\n+- ShovsOS ReAct\n+- ShovsOS Plan-Execute\n+- ShovsOS Graph Harness\n+\n+The point is not to show prettier answers. It shows the execution path: policy selected, tool trace, entity drift, source-contract coverage, completion gate status, and state-eval score.\n+\n+Harness Lab now reports two deterministic eval layers:\n+\n+- source collection eval: did the run preserve entities, exact searches, and fetch quotas?\n+- policy trace eval: did the trace prove the selected policy, ledger mode, recovery behavior, and completion gate?\n+\n+## Workflow Lab\n+\n+Workflow Lab is the platform-facing surface over the harness. It treats workflows as typed runtime contracts, not loose prompt blobs.\n+\n+Current workflow definitions:\n+\n+- `research_brief_v1`\n+- `shopping_comparison_v1`\n+- `local_recommendation_v1`\n+- `memory_fact_guard_v1`\n+- `coding_patch_eval_v1`\n+\n+Each definition exposes:\n+\n+- input schema\n+- output schema\n+- policy and ledger mode\n+- prompt version\n+- allowed tools\n+- memory policy\n+- step timeline\n+- gates and produced artifacts\n+\n+External apps can start and inspect deterministic workflow runs through:\n+\n+```text\n+GET  /workflow-lab/catalog\n+POST /workflow-lab/workflows/{workflow_id}/runs\n+GET  /workflow-lab/runs/{run_id}\n+GET  /workflow-lab/runs/{run_id}/events\n+GET  /workflow-lab/runs/{run_id}/result\n+```\n+\n+This layer is deliberately small but now runtime-backed. Workflow runs are stored in SQLite, expose status/events/result endpoints, and support two run modes:\n+\n+- `deterministic_contract`: fast local contract proof with no live model call\n+- `live_run_engine`: asynchronous execution through `RunEngine.stream(...)`, persisted under the same workflow run envelope\n+\n+It proves that ShovsOS features can be composed as workflows with visible status, events, memory policy, trace semantics, and expected result shape. It is still not a full production automation service: auth, API keys, webhooks, multi-worker queues, and persistent user-authored workflow editing are still future work.\n+\n+## Graph Harness State\n+\n+`graph_harness` now carries deterministic pass-node state in the run ledger. A pass graph is initialized from the workflow contract, each node has a status (`pending`, `running`, `completed`, `failed`, or `blocked`), dependencies are explicit, and graph execution is emitted as trace events.\n+\n+Trace Monitor and run replay expose Policy, Graph, and Recovery lanes so the UI can show the harness path without parsing raw JSON."},{"sha":"df3ea618c4b7d61ccf920b8336d34844243ceabf","filename":"README.md","status":"modified","additions":141,"deletions":12,"changes":153,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/README.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/README.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/README.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -1,4 +1,4 @@\n-# Shovs OS - LLM Runtime Agent Harness\n+# ShovsOS - LLM Runtime Agent Harness Platform\n \n A local-first research runtime for studying agents that plan, use tools, remember, verify, and explain what happened.\n \n@@ -22,11 +22,13 @@ If you are evaluating Shovs quickly, read these in order:\n \n | File | Purpose |\n | --- | --- |\n+| [extractions/shovs-harness-core](extractions/shovs-harness-core) | Small standalone harness extension with setup checks, a live demo app, and llama.cpp probe support. |\n | [HARNESS.md](HARNESS.md) | Defines the agent harness in simple terms, with runtime diagrams. |\n | [BENCHMARKS.md](BENCHMARKS.md) | Shows the deterministic benchmark suite and what each scenario checks. |\n | [EVALS.md](EVALS.md) | Explains scenario-state evaluation and why final-answer-only judging is not enough. |\n | [CLAIMS.md](CLAIMS.md) | Separates locally validated claims from active research and product work. |\n | [RESULTS.md](RESULTS.md) | Records the latest local validation snapshot and live smoke checks. |\n+| [LOGICAL_PROOFS.md](documentation/public/LOGICAL_PROOFS.md) | States the runtime invariants behind Agent Language, AgentIR, contracts, ledger truth, and context minimization. |\n \n Core benchmark command:\n \n@@ -43,6 +45,29 @@ The operator UI also includes a **Harness** workspace tab. It exposes the same r\n - run the deterministic Agent Harness Core benchmark from the browser\n - see related research references beside the actual runtime features\n \n+The UI now also includes a **Workflows** workspace tab. This is the beginning of a product-facing platform layer over the same runtime pieces:\n+\n+- choose a typed workflow such as Research Brief, Shopping Comparison, Local Recommendation, Memory Fact Guard, or Coding Patch Eval\n+- inspect the workflow steps, required inputs, allowed tools, memory policy, completion gates, and output schema\n+- run a deterministic contract-backed workflow preview\n+- run an optional live `RunEngine` workflow under the same API envelope\n+- inspect status events and the result contract\n+- copy the API request shape that another frontend app could use\n+\n+The workflow layer is intentionally contract-first. It is not a free-form node canvas yet. Its current purpose is to make ShovsOS features composable and inspectable through stable workflow definitions, durable run records, status polling, event history, and result contracts.\n+\n+## Current UI Test Run\n+\n+These screenshots were captured from the local React frontend running against the local FastAPI backend. They are not benchmark claims; they show the operator surfaces used to inspect whether a run preserved entities, followed tool policy, gathered evidence, and completed the expected workflow.\n+\n+![Harness Lab policy comparison test run](images/harness_lab_test_run.png)\n+\n+The Harness Lab view compares a plain model path, a model-with-tools path, and Shovs runtime modes on the same source-collection task. The useful signal is not prettier prose. The useful signal is whether the run can prove its locked entities, search/fetch counts, policy gate, ledger mode, trace events, and unresolved issues.\n+\n+![Workflow Lab deterministic contract run](images/workflow_lab_test_run.png)\n+\n+The Workflow Lab view exposes ShovsOS features as typed workflows. In this run, the Shopping Comparison workflow shows the selected policy, context mode, completion status, and ordered events from intake through response.\n+\n ---\n \n ## Why this exists\n@@ -53,6 +78,9 @@ Shovs takes a different approach. It treats language as input and output, but no\n \n - the user's objective\n - the current plan\n+- workflow contract, when the request has a recognizable work shape\n+- execution contract, which separates user-owned decisions from agent-owned execution\n+- pass graph, which names the specialist passes needed for the workflow\n - allowed tools\n - tool calls and tool results\n - evidence gathered so far\n@@ -62,14 +90,32 @@ Shovs takes a different approach. It treats language as input and output, but no\n \n Each phase gets a compiled packet built from that state. Planning sees the objective and constraints. Acting sees the next tool requirement. Observation sees tool results and missing slots. Verification checks claims against evidence. Memory commit only writes eligible facts.\n \n-Five research ideas make this different from a prompt wrapper:\n+Shovs also infers a workflow contract for recognizable task shapes, builds a pass graph of specialist roles, then computes a small runtime attention snapshot before packet compilation. This is not neural attention inside the model. It is deterministic scoring over ledger records so the runtime can show which objective, workflow contract, pass graph, plan step, tool result, evidence item, verification issue, or memory write is most relevant for the current phase.\n+\n+The execution contract is the stricter live-run view. It is derived from the ledger and records what the user owns, what the agent owns, which entities are locked, which evidence slots are still missing, what action is next, and whether a final answer is allowed. It also emits a compact AgentIR shape such as `intent -> lock{} -> search[] -> fetch[] -> answer`, so prompts and UI can inspect the same runtime state without dumping raw history.\n+\n+Core research ideas make this different from a prompt wrapper:\n \n | Idea | Plain meaning |\n | --- | --- |\n | **Run ledger** | Every important action in a run gets a durable record: plan, tool call, result, evidence, memory write, verification, and continuation state. |\n+| **Workflow contracts** | Recognizable tasks become explicit constraints: workflow shape, entity locks, evidence requirements, tool policy, completion gate, and continuation policy. |\n+| **Execution contracts** | Live runs separate user-owned decisions from agent-owned execution and expose readiness, action queue, evidence slots, and AgentIR. |\n+| **Workflow Lab** | Product-facing workflow definitions expose inputs, steps, tools, memory policy, trace events, result schemas, and API contracts. |\n+| **Deterministic source compiler** | `source_collect` turns multi-source tasks into one inspectable contract, coverage report, fetch queue, and final-answer gate. |\n+| **Search query boundary** | The rich user objective stays in the ledger; `web_search.query` is compiled into a compact retrieval probe before execution. |\n+| **Pass framework** | Each workflow maps to specialist passes such as retrieval, reasoning, scoring, evaluation, summarization, and orchestration. |\n+| **Runtime attention** | The runtime scores ledger records by phase before building context, then records the weights for trace/UI inspection. |\n | **Phase packets** | The model does not see one giant blob. It sees the right context for the current phase. |\n+| **Attention policy** | Each phase gets a deterministic context budget and lane policy. Source/tool loops suppress stale history, candidate memory, and capability prose unless the state actually needs them. |\n+| **Context readiness** | Before planning, the runtime checks whether prior context is safe to carry, should be suppressed for this turn, or needs clarification. This blocks stale continuation state, poisoned candidate context, and bare referents like “do it” when there is no reliable active frame. |\n+| **Ledger-authority tools** | Managed deterministic tools should read prior successful ledger results by ID instead of trusting model-supplied payloads. |\n | **Fact guard** | User-stated facts and corrections become structured memory. Guesses stay in a candidate lane until verified. |\n | **Tool honesty** | The runtime has guards that can reject or warn on unsupported tool-success claims in tested paths. Write tools must verify expected paths. |\n+| **Tool scheduler** | The runtime classifies proposed calls as parallel read-only, batched read-only, ordered, side-effect, or skipped. For locked source workflows it can group per-entity searches and selected URL fetches. The model proposes work; the harness decides safe execution. |\n+| **Evidence compiler** | Search, fetch, batch-fetch, and finance payloads become compact citation refs so raw pages do not flood the next model pass. |\n+| **Tool catalog search** | The runtime can retrieve relevant tool definitions instead of loading the full catalog into every prompt. |\n+| **Context editor** | Old or oversized tool payloads can be replaced with summaries plus raw refs after they are consumed. |\n | **Scenario evals** | The system can judge the path taken, not only the final answer. If the agent searched the wrong ticker or fetched the wrong URL, the run can fail even if the response sounds plausible. |\n \n ---\n@@ -81,7 +127,11 @@ The smallest testable Shovs wedge is the agent harness core:\n ```mermaid\n flowchart LR\n   A[\"User objective\"] --> B[\"Run ledger\"]\n-  B --> C[\"Phase packets\"]\n+  B --> BC[\"Workflow contract\"]\n+  BC --> BEC[\"Execution contract<br/>User authority + action queue\"]\n+  BEC --> BD[\"Pass graph\"]\n+  BD --> BA[\"Runtime attention\"]\n+  BA --> C[\"Phase packets\"]\n   C --> D[\"Model\"]\n   D --> E[\"Tool call draft\"]\n   E --> F[\"Tool registry\"]\n@@ -90,17 +140,44 @@ flowchart LR\n   H --> I[\"Response guard\"]\n   I --> J[\"User answer\"]\n   G --> K[\"Memory\"]\n+  F --> M[\"Search evidence compiler<br/>citation refs + raw refs\"]\n+  M --> H\n   B --> L[\"Trace replay + evals\"]\n ```\n \n This is the part being shaped toward possible reuse inside another agent system:\n \n - use the ledger to hold task state\n+- use workflow contracts to preserve the structure of multi-step work\n+- use execution contracts to preserve user-owned constraints while letting the agent choose execution details\n+- use pass graphs to make specialist roles and stop conditions explicit\n+- use runtime attention to rank phase-relevant state before packet compilation\n+- use attention policies to keep acting, response, verification, and memory-commit prompts small\n - use phase packets to reduce prompt drift\n+- use the tool scheduler so safe read-only calls can be grouped while ordered and side-effect calls stay gated\n+- use the evidence compiler and citation registry so final answers cite stored evidence refs, not raw model memory\n+- use tool catalog search so broad/default runs load relevant tool definitions while explicit agent tool settings still win\n+- use context editing and compaction state so long runs preserve decisions and next actions without dumping old payloads\n+- use ledger-authority tool inputs so models cannot invent prior search/fetch payloads\n - use evidence IDs to ground final answers\n - use memory lanes to avoid stale facts\n - use replay evals to catch wrong paths\n \n+### Latency and context control\n+\n+The slow path in many agent systems is not only model inference. It is repeated context work: rebuilding large packets, recompressing ordinary turns, and sending old memory or trace prose into phases that only need the next action.\n+\n+Shovs now treats this as a runtime policy:\n+\n+- **Attention control:** phase packets use deterministic budgets and lane switches.\n+- **Latent compression:** the model receives compact state labels such as objective, workflow shape, locked entities, next required action, evidence status, and missing slots.\n+- **Bias engineering:** the actor sees only the valid tool/action surface for the current state when the runtime can determine it.\n+- **Context readiness:** a pre-turn gate decides whether old continuation, candidate memory, and compressed context are safe to carry into the next prompt.\n+- **Ledger authority:** final answers and tool claims are checked against structured run records, not free-form chat memory.\n+- **Deterministic memory commit:** ordinary turns can skip expensive LLM compression while still applying deterministic fact and candidate-memory rules.\n+\n+This follows the same practical lesson seen in recent agent-context research: long histories make agents slower and less reliable unless the runtime actively compresses, ranks, and gates what each pass can see.\n+\n ---\n \n ## Architecture\n@@ -119,16 +196,23 @@ flowchart TD\n   end\n \n   subgraph FastAPI_ENTRYPOINTS[\"🚪 API Gateways\"]\n-    B1[\"/chat/stream\"]\n-    B2[\"/consumer/chat/stream\"]\n-    B3[\"/sessions/* · /agents/* · /memory/* · /rag/*\"]\n+  B1[\"/chat/stream\"]\n+  B2[\"/consumer/chat/stream\"]\n+  B3[\"/sessions/* · /agents/* · /memory/* · /rag/*\"]\n+  B4[\"/workflow-lab/*\"]\n   end\n \n   subgraph RunEngine[\"⚙️ Managed Runtime\"]\n     direction TB\n     C0[\"Run Ledger\"]:::tech\n+    C01[\"Workflow Contract<br/>(shape, locks, requirements, gate)\"]:::tech\n+    C02[\"Pass Graph<br/>(specialist passes + stop condition)\"]:::tech\n+    C00[\"Runtime Attention<br/>(phase-weighted ledger scoring)\"]:::tech\n     C1{\"1. PLAN\"} --> C2(\"2. ACT\") --> C3{\"3. OBSERVE\"} --> C4(\"4. VERIFY\") --> C5[/\"5. MEMORY COMMIT\"/]:::magic\n-    C0 -.-> C1 & C2 & C3 & C4 & C5\n+    C0 -.-> C01\n+    C01 -.-> C02\n+    C02 -.-> C00\n+    C00 -.-> C1 & C2 & C3 & C4 & C5\n     \n     C2 -.-> C6[\"Tool Sandbox\"]\n     C4 -.-> C8[\"🛡️ Side-Effect Guard<br/>(Trust & Correctness)\"]:::guard\n@@ -158,7 +242,7 @@ flowchart TD\n   %% Flow\n   A1 -->|Admin| B1\n   A2 -->|End-User| B2\n-  B1 & B2 & B3 --> RunEngine\n+  B1 & B2 & B3 & B4 --> RunEngine\n   \n   RunEngine -->|Drives| PROVIDERS\n   RunEngine -->|Persists| STORAGE_TOPOLOGY\n@@ -258,9 +342,13 @@ Handlers run concurrently via `asyncio.gather`; exceptions are logged, never rai\n # Verify the install\n python3 scripts/doctor.py\n \n-# Run Shovs Platform (operator workspace)\n-npm run dev:shovs\n-# → http://localhost:5174\n+# Run Shovs Platform (operator workspace, no Docker required)\n+npm run dev\n+# → backend + frontend_shovs; Docker-backed bash returns a typed denial\n+\n+# Run with Docker services enabled\n+npm run dev:shovs:docker\n+# → starts SearXNG + agent-sandbox, then backend + frontend_shovs\n \n # Run Consumer plane\n npm run dev:consumer\n@@ -270,10 +358,28 @@ npm run dev:backend\n # → http://localhost:8000  ·  /docs for OpenAPI\n ```\n \n-`scripts/doctor.py` checks: Python ≥3.10, provider API keys, Ollama reachability, writable DB/chroma/logs paths, all 5 LLM adapters import, skill loader works (≥1 skill), unified context engine has its budget knobs.\n+`scripts/doctor.py` checks: Python ≥3.10, provider API keys, Ollama reachability, optional Docker/SearXNG/llama.cpp services, writable DB/chroma/logs paths, LLM adapters import, skill loader works (≥1 skill), unified context engine has its budget knobs.\n \n The full interactive setup (Docker services, embed model selection) is in [setup-linux-mac.sh](setup-linux-mac.sh) and [setup-windows.ps1](setup-windows.ps1).\n \n+### Running without Docker\n+\n+Docker is useful for the sandboxed `bash` tool and local SearXNG search, but the main app should not require Docker just to open and test agents.\n+\n+Use:\n+\n+```bash\n+npm run dev\n+```\n+\n+This starts the backend from `./venv/bin/python` when the project venv exists, disables MCP for the lightweight local run, and sets `DOCKER_DISABLED=true`. The app still boots; Docker-only execution returns a clear denial instead of crashing. `/runtime/health` reports Docker, SearXNG, and llama.cpp as optional service statuses so the frontend can show what is missing.\n+\n+If port `8000` is already occupied, run the backend on another port:\n+\n+```bash\n+BACKEND_PORT=8010 npm run dev:backend:local\n+```\n+\n ---\n \n ## Configure providers\n@@ -293,17 +399,40 @@ DEFAULT_MODEL=qwen2.5-coder-3b-instruct-mlx\n \n LLM_PROVIDER=llamacpp\n LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1\n+LLAMACPP_DEFAULT_MODEL=local-model\n \n # Cloud\n OPENAI_API_KEY=sk-...\n ANTHROPIC_API_KEY=sk-ant-...\n GROQ_API_KEY=gsk_...\n GEMINI_API_KEY=AIza...\n NVIDIA_API_KEY=nvapi-...\n+\n+# Optional market data\n+ALPHA_VANTAGE_API_KEY=...\n+\n+# Optional image generation\n+IMAGE_GENERATION_MODEL=gpt-image-1\n ```\n \n Embedding transport auto-detects `/api/embed` (current Ollama) and `/api/embeddings` (legacy); LM Studio / llama.cpp / OpenAI-compatible servers use `/v1/embeddings`.\n \n+Image generation is exposed both as an agent tool (`image_generate`) and as `POST /images/generate`. Generated files are saved under the sandbox and served from `/sandbox/generated/images/...`. If `OPENAI_API_KEY` is missing, the tool returns a typed failure instead of pretending an image was created.\n+\n+For llama.cpp on Apple Silicon:\n+\n+```bash\n+# install via Homebrew, then start a local OpenAI-compatible server\n+llama-server -m /absolute/path/to/model.gguf --host 127.0.0.1 --port 8080\n+\n+export LLM_PROVIDER=llamacpp\n+export LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1\n+export LLAMACPP_DEFAULT_MODEL=local-model\n+npm run dev:local\n+```\n+\n+If port `8080` is already used, start `llama-server` on another port and set `LLAMACPP_BASE_URL` to match.\n+\n ---\n \n ## Repository map"},{"sha":"907875b7ab6b377eff4b58662d8f5531895da937","filename":"api/consumer_routes.py","status":"modified","additions":15,"deletions":1,"changes":16,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fconsumer_routes.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fconsumer_routes.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Fconsumer_routes.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -1,6 +1,7 @@\n from __future__ import annotations\n \n import json\n+import os\n from typing import Optional\n \n from fastapi import APIRouter, Body, File, Form, HTTPException, UploadFile\n@@ -12,6 +13,8 @@\n from engine.file_processor import FileProcessor\n from memory.semantic_graph import SemanticGraph\n from llm.adapter_factory import create_adapter\n+from llm.model_capabilities import capability_flags\n+from config.config import cfg\n from plugins.tool_registry import ToolRegistry\n from api.memory_inspector import build_session_memory_payload\n from api.owner import require_owner_id\n@@ -95,7 +98,17 @@ async def consumer_models():\n                     grouped[provider] = models\n             except Exception:\n                 pass\n-        return {\"models\": grouped}\n+        capabilities = {\n+            f\"{provider}:{model}\": capability_flags(f\"{provider}:{model}\")\n+            for provider, models in grouped.items()\n+            for model in models\n+        }\n+        return {\n+            \"models\": grouped,\n+            \"capabilities\": capabilities,\n+            \"vision_model\": cfg.VISION_MODEL,\n+            \"image_generation_model\": cfg.IMAGE_GENERATION_MODEL,\n+        }\n \n     @router.get(\"/options\")\n     async def get_consumer_options():\n@@ -243,6 +256,7 @@ async def generate():\n                 ledger_mode=getattr(profile, \"ledger_mode\", \"shadow\"),\n                 workspace_path=getattr(profile, \"workspace_path\", None),\n                 reasoning_enabled=reasoning_enabled,\n+                memory_commit_mode=os.getenv(\"SHOVSOS_MEMORY_COMMIT_MODE\", \"async\"),\n             )\n             async for event in run_engine.stream(run_request):\n                 event_type = event.get(\"type\")"},{"sha":"463cd2174db769687d1cf6001da6a27f2e532032","filename":"api/harness_lab.py","status":"modified","additions":573,"deletions":1,"changes":574,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fharness_lab.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fharness_lab.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Fharness_lab.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -1,15 +1,21 @@\n from __future__ import annotations\n \n+import json\n import tempfile\n from pathlib import Path\n+from types import SimpleNamespace\n from typing import Any, Optional\n \n from fastapi import APIRouter, Body\n \n from engine.response_guard import guard_final_response\n from memory.semantic_graph import SemanticGraph\n from run_engine.ledger import RunLedger\n-from run_engine.scenario_eval import SourceCollectionScenario, evaluate_source_collection_trace\n+from run_engine.control_policies import resolve_control_policy\n+from run_engine.workflow_contracts import infer_workflow_contract\n+from run_engine.workflow_plugins import source_collection_contract_from_objective\n+from run_engine.pass_framework import build_pass_graph\n+from run_engine.scenario_eval import SourceCollectionScenario, evaluate_policy_trace, evaluate_source_collection_trace\n from shovs_memory import ShovsMemory\n \n \n@@ -115,6 +121,34 @@\n         \"best_for\": \"Operator-supervised agents and debugging.\",\n         \"expected_failure\": \"Some ledger checks may be shadow-mode until promoted to enforcement.\",\n     },\n+    {\n+        \"id\": \"shovs_react\",\n+        \"label\": \"Shovs ReAct\",\n+        \"included_wedges\": [\"run_ledger\", \"phase_packets\", \"response_guard\", \"trace_replay\"],\n+        \"best_for\": \"Low-risk iterative tool use where observations can steer the next action.\",\n+        \"expected_failure\": \"Can drift on source workflows because the plan remains mutable.\",\n+    },\n+    {\n+        \"id\": \"shovs_plan_execute\",\n+        \"label\": \"Shovs Plan-Execute\",\n+        \"included_wedges\": [\"run_ledger\", \"phase_packets\", \"source_contract\", \"response_guard\", \"trace_replay\"],\n+        \"best_for\": \"Web/source workflows where entities, URLs, and quotas must stay fixed.\",\n+        \"expected_failure\": \"May block completion when evidence is missing instead of guessing.\",\n+    },\n+    {\n+        \"id\": \"shovs_graph_harness\",\n+        \"label\": \"Shovs Graph Harness\",\n+        \"included_wedges\": [\n+            \"run_ledger\",\n+            \"phase_packets\",\n+            \"source_contract\",\n+            \"memory_lanes\",\n+            \"response_guard\",\n+            \"trace_replay\",\n+        ],\n+        \"best_for\": \"Long-horizon, coding, memory-sensitive, or enterprise workflows.\",\n+        \"expected_failure\": \"Less flexible than a free-form loop but easier to inspect and recover.\",\n+    },\n     {\n         \"id\": \"shovs_enforced\",\n         \"label\": \"Shovs Enforced\",\n@@ -151,6 +185,239 @@ def _record(\n     }\n \n \n+def _slug(value: str) -> str:\n+    clean = \"\".join(ch.lower() if ch.isalnum() else \"-\" for ch in str(value or \"\"))\n+    while \"--\" in clean:\n+        clean = clean.replace(\"--\", \"-\")\n+    return clean.strip(\"-\") or \"entity\"\n+\n+\n+def _allowed_urls_for_entities(entities: list[str], per_entity: int, *, topic: str) -> dict[str, list[str]]:\n+    return {\n+        entity: [\n+            f\"https://sources.example.com/{topic}/{_slug(entity)}-{index}\"\n+            for index in range(1, per_entity + 1)\n+        ]\n+        for entity in entities\n+    }\n+\n+\n+def _demo_source_scenario(objective: str) -> SourceCollectionScenario:\n+    text = str(objective or \"\").lower()\n+    contract = source_collection_contract_from_objective(objective) or {\n+        \"entity_count\": 3,\n+        \"urls_per_entity\": 3,\n+        \"total_urls\": 9,\n+    }\n+    entity_count = max(1, min(int(contract.get(\"entity_count\") or 3), 5))\n+    urls_per_entity = max(1, min(int(contract.get(\"urls_per_entity\") or 3), 5))\n+    total_urls = max(entity_count * urls_per_entity, int(contract.get(\"total_urls\") or entity_count * urls_per_entity))\n+\n+    if any(term in text for term in (\"sushi\", \"restaurant\", \"restaurants\", \"places\", \"place\", \"coffee\", \"toronto\")):\n+        entities = [\"Sushi Masaki Saito\", \"Yasu\", \"Sushi Kaji\", \"Miku\", \"Aburi Hana\"][:entity_count]\n+        return SourceCollectionScenario(\n+            objective=objective,\n+            entities=entities,\n+            urls_per_entity=urls_per_entity,\n+            total_urls=total_urls,\n+            discovery_url=\"https://local.example.com/toronto/best-sushi\",\n+            query_template=\"{entity} reviews Toronto sources\",\n+            forbidden_query_terms=[\"Vancouver\", \"Montreal\", \"EPAM\"],\n+            allowed_fetch_urls_by_entity=_allowed_urls_for_entities(entities, urls_per_entity, topic=\"local\"),\n+        )\n+\n+    if any(term in text for term in (\"shopping\", \"stores\", \"store\", \"price\", \"prices\", \"compare\", \"comparison\", \"product\", \"products\")):\n+        entities = [\"Costco\", \"Walmart\", \"Best Buy\", \"Canadian Tire\", \"Dollarama\"][:entity_count]\n+        return SourceCollectionScenario(\n+            objective=objective,\n+            entities=entities,\n+            urls_per_entity=urls_per_entity,\n+            total_urls=total_urls,\n+            discovery_url=\"https://shopping.example.com/store-comparison\",\n+            query_template=\"{entity} product price review sources\",\n+            forbidden_query_terms=[\"ROKU\", \"ARKO\", \"unrelated store\"],\n+            allowed_fetch_urls_by_entity=_allowed_urls_for_entities(entities, urls_per_entity, topic=\"shopping\"),\n+        )\n+\n+    entities = [\"ROKU\", \"TBN\", \"SENEA\", \"LEU\", \"SNDK\"][:entity_count]\n+    return SourceCollectionScenario(\n+        objective=objective,\n+        entities=entities,\n+        urls_per_entity=urls_per_entity,\n+        total_urls=total_urls,\n+        discovery_url=\"https://www.morningstar.com/markets\",\n+        query_template=\"{entity} stock news June 13 2026\",\n+        forbidden_query_terms=[\"EPAM\", \"ARKO\"],\n+        allowed_fetch_urls_by_entity=_allowed_urls_for_entities(entities, urls_per_entity, topic=\"stocks\"),\n+    )\n+\n+\n+def _mode_trace(mode: str, scenario: SourceCollectionScenario) -> list[dict[str, Any]]:\n+    allowed = scenario.allowed_fetch_urls_by_entity\n+    locked_label = \", \".join(scenario.entities)\n+    drift_term = scenario.forbidden_query_terms[0] if scenario.forbidden_query_terms else \"unrelated\"\n+    if mode == \"plain_model\":\n+        return [\n+            {\"phase\": \"intake\", \"actor\": \"model\", \"action\": \"read_task\", \"status\": \"ok\", \"summary\": \"Task accepted as plain text.\"},\n+            {\"phase\": \"response\", \"actor\": \"model\", \"action\": \"answer_from_prior\", \"status\": \"unsupported\", \"summary\": \"Produces a plausible answer without executable tool evidence.\"},\n+        ]\n+    if mode == \"model_plus_tools\":\n+        return [\n+            {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_fetch\", \"url\": scenario.discovery_url, \"status\": \"success\", \"summary\": \"Fetched mover discovery page.\"},\n+            {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_search\", \"query\": f\"{drift_term} broad search\", \"status\": \"success\", \"summary\": \"Drifted to an unrelated entity after discovery.\"},\n+            {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_fetch\", \"url\": \"https://generic.example.com/broad-list\", \"status\": \"success\", \"summary\": \"Fetched generic article outside the requested entity set.\"},\n+            {\"phase\": \"response\", \"actor\": \"model\", \"action\": \"summarize\", \"status\": \"warning\", \"summary\": \"Answer can sound useful, but the path no longer matches the task.\"},\n+        ]\n+    if mode == \"shovs_react\":\n+        return [\n+            {\"phase\": \"policy\", \"actor\": \"shovs\", \"action\": \"select_policy\", \"status\": \"active\", \"control_policy\": \"react\", \"summary\": \"ReAct lets observations steer the next action.\"},\n+            {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_fetch\", \"url\": scenario.discovery_url, \"status\": \"success\", \"summary\": \"Fetched discovery page.\"},\n+            {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_search\", \"query\": f\"{drift_term} broad search\", \"status\": \"success\", \"summary\": \"Observation-driven loop drifted to a noisy entity.\"},\n+            {\"phase\": \"policy_violation\", \"actor\": \"shovs\", \"action\": \"detect_drift\", \"status\": \"warning\", \"summary\": \"Ledger can see drift, but ReAct policy is not source-contract enforced.\"},\n+        ]\n+    calls = [\n+        {\"phase\": \"policy\", \"actor\": \"shovs\", \"action\": \"select_policy\", \"status\": \"active\", \"control_policy\": \"graph_harness\" if mode == \"shovs_graph_harness\" else \"plan_execute\", \"ledger_mode\": \"ledger_enforced\", \"summary\": \"Policy selected from workflow shape.\"},\n+        {\"phase\": \"tool\", \"actor\": \"tool\", \"tool\": \"web_fetch\", \"url\": scenario.discovery_url, \"status\": \"success\", \"summary\": \"Fetched discovery page before locking entities.\"},\n+        {\"phase\": \"contract\", \"actor\": \"shovs\", \"action\": \"lock_entities\", \"status\": \"success\", \"summary\": f\"Locked {locked_label} as the source contract entities.\", \"entities\": scenario.entities},\n+        {\"phase\": \"contract\", \"actor\": \"shovs\", \"action\": \"set_quota\", \"status\": \"success\", \"summary\": f\"Required {scenario.urls_per_entity} URLs per entity, {scenario.total_urls} total.\", \"source_contract\": {\"total_urls\": scenario.total_urls}},\n+    ]\n+    for entity in scenario.entities:\n+        calls.append({\n+            \"phase\": \"tool\",\n+            \"actor\": \"tool\",\n+            \"tool\": \"web_search\",\n+            \"query\": scenario.query_template.format(entity=entity),\n+            \"status\": \"success\",\n+            \"summary\": f\"Searched exact query for {entity}.\",\n+        })\n+    for entity, urls in allowed.items():\n+        for url in urls:\n+            calls.append({\n+                \"phase\": \"tool\",\n+                \"actor\": \"tool\",\n+                \"tool\": \"web_fetch\",\n+                \"url\": url,\n+                \"status\": \"success\",\n+                \"summary\": f\"Fetched selected source for {entity}.\",\n+            })\n+    calls.append({\"phase\": \"verify\", \"actor\": \"shovs\", \"action\": \"state_eval\", \"status\": \"success\", \"summary\": \"Verified entity locks and fetch quota before response.\"})\n+    if mode == \"shovs_graph_harness\":\n+        calls.insert(1, {\"phase\": \"pass_graph_execution\", \"event_type\": \"pass_node_started\", \"actor\": \"shovs\", \"action\": \"node_start\", \"status\": \"success\", \"summary\": \"Pass graph executes discover -> lock -> collect -> fetch -> verify nodes.\"})\n+        calls.append({\"phase\": \"pass_graph_execution\", \"event_type\": \"pass_node_completed\", \"actor\": \"shovs\", \"action\": \"node_complete\", \"status\": \"success\", \"summary\": \"Graph completion gate passed.\"})\n+    return calls\n+\n+\n+def _tool_calls_from_trace(trace: list[dict[str, Any]]) -> list[dict[str, Any]]:\n+    calls: list[dict[str, Any]] = []\n+    for event in trace:\n+        if not isinstance(event, dict) or not event.get(\"tool\"):\n+            continue\n+        call = {\"tool\": event.get(\"tool\")}\n+        if event.get(\"query\"):\n+            call[\"query\"] = event.get(\"query\")\n+        if event.get(\"url\"):\n+            call[\"url\"] = event.get(\"url\")\n+        calls.append(call)\n+    return calls\n+\n+\n+def run_mode_comparison(objective: str, *, modes: Optional[list[str]] = None) -> dict[str, Any]:\n+    task = str(objective or \"\").strip() or \"Search top 3 stocks today, then search each, fetch 3 URLs each.\"\n+    selected_modes = modes or [\"plain_model\", \"model_plus_tools\", \"shovs_react\", \"shovs_plan_execute\", \"shovs_graph_harness\"]\n+    scenario = _demo_source_scenario(task)\n+    contract = infer_workflow_contract(task, allowed_tools=[\"web_search\", \"web_fetch\"])\n+    pass_graph = build_pass_graph(contract)\n+    results = []\n+    for mode in selected_modes:\n+        trace = _mode_trace(mode, scenario)\n+        eval_result = evaluate_source_collection_trace(\n+            scenario=scenario,\n+            tool_calls=_tool_calls_from_trace(trace),\n+            source_contract_events=trace if mode in {\"shovs_stateful\", \"shovs_plan_execute\", \"shovs_graph_harness\"} else [],\n+        )\n+        policy_eval = evaluate_policy_trace(\n+            trace_events=trace,\n+            expected_policy={\n+                \"plain_model\": \"none\",\n+                \"model_plus_tools\": \"none\",\n+                \"shovs_react\": \"react\",\n+                \"shovs_plan_execute\": \"plan_execute\",\n+                \"shovs_graph_harness\": \"graph_harness\",\n+                \"shovs_stateful\": \"plan_execute\",\n+            }.get(mode, \"\"),\n+            expected_ledger_mode=\"ledger_enforced\" if mode in {\"shovs_plan_execute\", \"shovs_graph_harness\", \"shovs_stateful\"} else \"\",\n+            require_completion_gate=mode in {\"shovs_plan_execute\", \"shovs_graph_harness\", \"shovs_stateful\"},\n+            require_recovery_for_violations=mode in {\"shovs_plan_execute\", \"shovs_graph_harness\", \"shovs_stateful\"},\n+            require_graph_nodes=mode == \"shovs_graph_harness\",\n+        )\n+        if mode == \"plain_model\":\n+            score = 0.0\n+            passed = False\n+            issues = [\"no_tool_evidence\", \"no_ledger_authority\", \"no_source_contract\"]\n+            summary = \"Plain model mode cannot prove search/fetch work. It may answer, but it has no executable trace.\"\n+        elif mode == \"model_plus_tools\":\n+            score = eval_result.score\n+            passed = eval_result.passed\n+            issues = eval_result.issues\n+            summary = \"Tool mode executed tools, but state-based eval exposes drift and missing per-entity coverage.\"\n+        elif mode == \"shovs_react\":\n+            score = eval_result.score\n+            passed = False\n+            issues = list(dict.fromkeys(eval_result.issues + [\"mutable_plan_drift_risk\"]))\n+            summary = \"Shovs ReAct keeps trace state, but source workflows still need plan-execute enforcement.\"\n+        else:\n+            score = eval_result.score\n+            passed = eval_result.passed\n+            issues = eval_result.issues\n+            if mode == \"shovs_graph_harness\":\n+                summary = \"Shovs graph harness adds explicit node structure over the same source contract and verification gates.\"\n+            else:\n+                summary = \"Shovs plan-execute mode locks entities, uses exact queries, fetches required URLs, and verifies before answer.\"\n+        results.append({\n+            \"mode\": mode,\n+            \"label\": {\n+                \"plain_model\": \"Plain Model\",\n+                \"model_plus_tools\": \"Model + Tools\",\n+                \"shovs_stateful\": \"ShovsOS Stateful\",\n+                \"shovs_react\": \"ShovsOS ReAct\",\n+                \"shovs_plan_execute\": \"ShovsOS Plan-Execute\",\n+                \"shovs_graph_harness\": \"ShovsOS Graph Harness\",\n+            }.get(mode, mode),\n+            \"control_policy\": {\n+                \"plain_model\": \"none\",\n+                \"model_plus_tools\": \"none\",\n+                \"shovs_react\": \"react\",\n+                \"shovs_plan_execute\": \"plan_execute\",\n+                \"shovs_graph_harness\": \"graph_harness\",\n+                \"shovs_stateful\": \"plan_execute\",\n+            }.get(mode, \"unknown\"),\n+            \"ledger_mode\": \"ledger_enforced\" if mode in {\"shovs_plan_execute\", \"shovs_graph_harness\", \"shovs_stateful\"} else \"shadow\",\n+            \"passed\": passed,\n+            \"score\": round(float(score), 4),\n+            \"issues\": issues,\n+            \"summary\": summary,\n+            \"trace\": trace,\n+            \"trace_summary\": {\n+                \"event_count\": len(trace),\n+                \"policy_violations\": len([event for event in trace if event.get(\"phase\") == \"policy_violation\"]),\n+                \"tool_events\": len([event for event in trace if event.get(\"tool\")]),\n+                \"completion_gate\": \"passed\" if passed else \"blocked_or_unproven\",\n+            },\n+            \"state_eval\": eval_result.to_dict(),\n+            \"policy_eval\": policy_eval.to_dict(),\n+        })\n+    return {\n+        \"suite\": \"shovs_mode_comparison\",\n+        \"objective\": task,\n+        \"live_model\": False,\n+        \"deterministic\": True,\n+        \"contract\": contract.to_dict(),\n+        \"pass_graph\": pass_graph.to_dict(),\n+        \"results\": results,\n+        \"takeaway\": \"The difference is not better prose. The difference is whether the run can prove what happened and refuse completion when required state is missing.\",\n+    }\n+\n+\n def get_harness_lab_catalog() -> dict[str, Any]:\n     return {\n         \"title\": \"Harness Lab\",\n@@ -176,6 +443,22 @@ def get_harness_lab_catalog() -> dict[str, Any]:\n             \"live_llm_required\": False,\n             \"network_required\": False,\n         },\n+        \"comparison\": {\n+            \"suite\": \"shovs_mode_comparison\",\n+            \"endpoint\": \"/harness-lab/compare/run\",\n+            \"frontend_endpoint\": \"/api/harness-lab/compare/run\",\n+            \"modes\": [\"plain_model\", \"model_plus_tools\", \"shovs_react\", \"shovs_plan_execute\", \"shovs_graph_harness\"],\n+            \"live_model_required\": False,\n+            \"network_required\": False,\n+        },\n+        \"runtime\": {\n+            \"suite\": \"shovs_runtime_harness\",\n+            \"endpoint\": \"/harness-lab/runtime/run\",\n+            \"frontend_endpoint\": \"/api/harness-lab/runtime/run\",\n+            \"deterministic\": True,\n+            \"live_model_required\": False,\n+            \"network_required\": False,\n+        },\n     }\n \n \n@@ -263,6 +546,30 @@ def run_harness_core_benchmark() -> dict[str, Any]:\n         )\n     )\n \n+    policy_eval = evaluate_policy_trace(\n+        trace_events=[\n+            {\"phase\": \"policy\", \"control_policy\": \"plan_execute\", \"ledger_mode\": \"ledger_enforced\", \"status\": \"active\"},\n+            {\"phase\": \"policy_violation\", \"type\": \"policy_violation\", \"issue\": \"unlocked_entity_search\", \"recovery_class\": \"entity_drift\"},\n+            {\"phase\": \"recovery_started\", \"type\": \"recovery_started\", \"recovered_tool\": \"web_search\"},\n+            {\"phase\": \"tool\", \"tool\": \"web_search\", \"query\": \"ROKU stock news June 13 2026\", \"status\": \"success\"},\n+            {\"phase\": \"completion_gate\", \"action\": \"completion_gate\", \"status\": \"blocked\"},\n+        ],\n+        expected_policy=\"plan_execute\",\n+        expected_ledger_mode=\"ledger_enforced\",\n+        require_completion_gate=True,\n+        require_recovery_for_violations=True,\n+    )\n+    records.append(\n+        _record(\n+            \"policy_trace_recovery_contract\",\n+            policy_eval.passed,\n+            score=policy_eval.score,\n+            issues=policy_eval.issues,\n+            summary=policy_eval.detail,\n+            evidence=policy_eval.state,\n+        )\n+    )\n+\n     ledger = RunLedger(\n         run_id=\"harness-lab-run\",\n         session_id=\"harness-lab-session\",\n@@ -326,6 +633,261 @@ def run_harness_core_benchmark() -> dict[str, Any]:\n     }\n \n \n+class _RuntimeHarnessAsyncIter:\n+    def __init__(self, items: list[str]):\n+        self.items = items\n+\n+    async def __aiter__(self):\n+        for item in self.items:\n+            yield item\n+\n+\n+class _RuntimeHarnessAdapter:\n+    async def complete(self, **_kwargs):\n+        return json.dumps(\n+            {\n+                \"tool_calls\": [\n+                    {\n+                        \"function\": {\n+                            \"name\": \"image_generate\",\n+                            \"arguments\": json.dumps({\"prompt\": \"a calm product mockup\"}),\n+                        }\n+                    }\n+                ]\n+            }\n+        )\n+\n+    def stream(self, **_kwargs):\n+        return _RuntimeHarnessAsyncIter([\"Generated image ready.\"])\n+\n+    async def list_models(self):\n+        return [\"runtime-harness-small-model\"]\n+\n+    async def health(self):\n+        return True\n+\n+\n+class _RuntimeHarnessContext:\n+    def build_context_block(self, *_args, **_kwargs):\n+        return \"\"\n+\n+    async def compress_exchange(self, *_args, **_kwargs):\n+        return \"\", [], []\n+\n+\n+class _RuntimeHarnessTraceStore:\n+    def __init__(self):\n+        self.events: list[dict[str, Any]] = []\n+\n+    def append_event(self, agent_id, session_id, event_type, data, **kwargs):\n+        event = {\n+            \"agent_id\": agent_id,\n+            \"session_id\": session_id,\n+            \"event_type\": event_type,\n+            \"data\": data,\n+            **kwargs,\n+        }\n+        self.events.append(event)\n+        return event\n+\n+\n+async def _run_image_generation_runtime_probe(tmp: Path) -> dict[str, Any]:\n+    from orchestration.run_store import RunStore\n+    from orchestration.session_manager import SessionManager\n+    from plugins.tool_registry import Tool, ToolRegistry\n+    from run_engine.engine import RunEngine\n+    from run_engine.types import RunEngineRequest\n+\n+    async def image_generate(prompt: str, **_kwargs):\n+        return json.dumps(\n+            {\n+                \"type\": \"image_generation_result\",\n+                \"url\": \"/sandbox/generated/images/runtime-harness.png\",\n+                \"path\": \"generated/images/runtime-harness.png\",\n+                \"prompt\": prompt,\n+                \"model\": \"runtime-harness-image-model\",\n+                \"bytes\": 12,\n+            }\n+        )\n+\n+    registry = ToolRegistry()\n+    registry.register(\n+        Tool(\n+            name=\"image_generate\",\n+            description=\"Generate a deterministic image artifact for runtime harness testing.\",\n+            parameters={\n+                \"type\": \"object\",\n+                \"properties\": {\"prompt\": {\"type\": \"string\"}},\n+                \"required\": [\"prompt\"],\n+            },\n+            handler=image_generate,\n+            response_format=\"json\",\n+        )\n+    )\n+    trace_store = _RuntimeHarnessTraceStore()\n+    engine = RunEngine(\n+        adapter=_RuntimeHarnessAdapter(),\n+        sessions=SessionManager(db_path=str(tmp / \"sessions.db\")),\n+        tool_registry=registry,\n+        run_store=RunStore(db_path=str(tmp / \"runs.db\")),\n+        trace_store=trace_store,\n+        orchestrator=None,\n+        context_engine=_RuntimeHarnessContext(),\n+        graph=SemanticGraph(db_path=str(tmp / \"memory.db\")),\n+    )\n+    events = [\n+        event\n+        async for event in engine.stream(\n+            RunEngineRequest(\n+                session_id=\"runtime-harness-image\",\n+                owner_id=\"runtime-harness-owner\",\n+                agent_id=\"default\",\n+                user_message=\"Generate an image of a calm product mockup\",\n+                model=\"llama3.2\",\n+                system_prompt=\"You are Shovs.\",\n+                allowed_tools=(\"image_generate\",),\n+                use_planner=False,\n+            )\n+        )\n+    ]\n+    tool_call = next((event for event in events if event.get(\"type\") == \"tool_call\"), {})\n+    tool_result = next((event for event in events if event.get(\"type\") == \"tool_result\"), {})\n+    payload = {}\n+    try:\n+        payload = json.loads(str(tool_result.get(\"content\") or \"{}\"))\n+    except Exception:\n+        payload = {}\n+    passed = (\n+        tool_call.get(\"tool_name\") == \"image_generate\"\n+        and tool_result.get(\"success\") is True\n+        and payload.get(\"type\") == \"image_generation_result\"\n+        and any(event.get(\"type\") == \"done\" for event in events)\n+    )\n+    return _record(\n+        \"runtime_image_generation_tool_loop\",\n+        passed,\n+        summary=\"Actual RunEngine stream selected image_generate, executed the tool, and returned a structured image artifact.\",\n+        evidence={\n+            \"event_types\": [event.get(\"type\") for event in events],\n+            \"tool_call\": tool_call,\n+            \"tool_result_payload\": payload,\n+            \"trace_event_count\": len(trace_store.events),\n+        },\n+    )\n+\n+\n+def _run_fake_tool_claim_probe() -> dict[str, Any]:\n+    ledger = RunLedger(\n+        run_id=\"runtime-fake-claim\",\n+        session_id=\"runtime-fake-claim-session\",\n+        turn_id=\"turn-1\",\n+        objective=\"Detect unsupported tool work claims.\",\n+        allowed_tools=[\"web_search\"],\n+        ledger_mode=\"ledger_enforced\",\n+    )\n+    support = ledger.response_support_check(\"I searched the web and verified the answer.\")\n+    return _record(\n+        \"runtime_ledger_rejects_fake_tool_claim\",\n+        support.get(\"supported\") is False\n+        and \"response_claims_tool_work_without_successful_tool_result\" in support.get(\"issues\", []),\n+        summary=\"Ledger support check rejected a final answer that claimed tool work without a successful tool result.\",\n+        evidence=support,\n+    )\n+\n+\n+def _run_entity_drift_recovery_probe(tmp: Path) -> dict[str, Any]:\n+    from orchestration.run_store import RunStore\n+    from orchestration.session_manager import SessionManager\n+    from plugins.tool_registry import ToolCall, ToolRegistry\n+    from run_engine.engine import RunEngine\n+\n+    trace_store = _RuntimeHarnessTraceStore()\n+    engine = RunEngine(\n+        adapter=_RuntimeHarnessAdapter(),\n+        sessions=SessionManager(db_path=str(tmp / \"drift_sessions.db\")),\n+        tool_registry=ToolRegistry(),\n+        run_store=RunStore(db_path=str(tmp / \"drift_runs.db\")),\n+        trace_store=trace_store,\n+        orchestrator=None,\n+        context_engine=_RuntimeHarnessContext(),\n+        graph=SemanticGraph(db_path=str(tmp / \"drift_memory.db\")),\n+    )\n+    ledger = RunLedger(\n+        run_id=\"runtime-drift\",\n+        session_id=\"runtime-drift-session\",\n+        turn_id=\"turn-1\",\n+        objective=\"Search ROKU, TBN, SENEA separately and fetch sources.\",\n+        allowed_tools=[\"web_search\", \"web_fetch\"],\n+        ledger_mode=\"ledger_enforced\",\n+    )\n+    ledger.set_control_policy(resolve_control_policy(ledger.objective, requested=\"plan_execute\"))\n+    ledger.lock_entities([\"ROKU\", \"TBN\", \"SENEA\"])\n+    ledger.set_source_contract(\n+        {\n+            \"next_tool\": \"web_search\",\n+            \"next_arguments\": {\"query\": \"ROKU stock news June 13 2026\"},\n+            \"forbid_unlocked_entity_drift\": True,\n+        },\n+        source=\"runtime_harness\",\n+    )\n+    recovered, event = engine._gate_tool_call_with_ledger(\n+        request=SimpleNamespace(session_id=\"runtime-drift-session\", agent_id=\"default\", owner_id=\"runtime-harness-owner\"),\n+        run_id=\"runtime-drift\",\n+        ledger=ledger,\n+        tool_call=ToolCall(\"web_search\", {\"query\": \"EPAM stock news June 13 2026\"}, \"{}\"),\n+        tool_turn=1,\n+    )\n+    passed = (\n+        recovered is not None\n+        and recovered.tool_name == \"web_search\"\n+        and recovered.arguments == {\"query\": \"ROKU stock news June 13 2026\"}\n+        and event\n+        and event.get(\"type\") == \"recovery_started\"\n+    )\n+    return _record(\n+        \"runtime_policy_gate_recovers_entity_drift\",\n+        passed,\n+        summary=\"Plan-execute ledger gate recovered an off-entity search into the next required locked-entity search.\",\n+        evidence={\n+            \"recovered_tool\": recovered.tool_name if recovered else \"\",\n+            \"recovered_arguments\": recovered.arguments if recovered else {},\n+            \"gate_event\": event or {},\n+            \"trace_events\": trace_store.events,\n+        },\n+    )\n+\n+\n+async def run_runtime_harness_tests() -> dict[str, Any]:\n+    with tempfile.TemporaryDirectory(prefix=\"shovs-runtime-harness-\") as raw_tmp:\n+        tmp = Path(raw_tmp)\n+        records = [\n+            await _run_image_generation_runtime_probe(tmp),\n+            _run_fake_tool_claim_probe(),\n+            _run_entity_drift_recovery_probe(tmp),\n+        ]\n+    passed = all(item[\"passed\"] for item in records)\n+    return {\n+        \"suite\": \"shovs_runtime_harness\",\n+        \"version\": 1,\n+        \"deterministic\": True,\n+        \"live_model_required\": False,\n+        \"network_required\": False,\n+        \"passed\": passed,\n+        \"score\": round(sum(item[\"score\"] for item in records) / max(1, len(records)), 4),\n+        \"results\": records,\n+        \"coverage\": {\n+            \"entrypoints\": [\"RunEngine.stream\", \"RunLedger.response_support_check\", \"RunEngine._gate_tool_call_with_ledger\"],\n+            \"failure_modes\": [\"tool_not_called\", \"fake_tool_claim\", \"entity_drift\"],\n+            \"frontend_contract\": [\"tool_call\", \"tool_result\", \"image_generation_result\", \"done\"],\n+        },\n+        \"operator_guidance\": [\n+            \"If runtime_image_generation_tool_loop fails, the model/tool router is not selecting or executing creation tools.\",\n+            \"If runtime_ledger_rejects_fake_tool_claim fails, final answers can claim tool work without evidence.\",\n+            \"If runtime_policy_gate_recovers_entity_drift fails, locked-entity workflows can drift to unrelated searches.\",\n+        ],\n+    }\n+\n+\n def make_harness_lab_router() -> APIRouter:\n     router = APIRouter(prefix=\"/harness-lab\", tags=[\"harness-lab\"])\n \n@@ -337,4 +899,14 @@ async def catalog():\n     async def benchmark_run(_payload: Optional[dict] = Body(default=None)):\n         return run_harness_core_benchmark()\n \n+    @router.post(\"/compare/run\")\n+    async def compare_run(payload: Optional[dict] = Body(default=None)):\n+        data = payload or {}\n+        modes = data.get(\"modes\") if isinstance(data.get(\"modes\"), list) else None\n+        return run_mode_comparison(str(data.get(\"objective\") or \"\"), modes=modes)\n+\n+    @router.post(\"/runtime/run\")\n+    async def runtime_run(_payload: Optional[dict] = Body(default=None)):\n+        return await run_runtime_harness_tests()\n+\n     return router"},{"sha":"79482fa4469ad5f074c9156ff33553abc3fc4232","filename":"api/log_routes.py","status":"modified","additions":99,"deletions":10,"changes":109,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Flog_routes.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Flog_routes.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Flog_routes.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -90,6 +90,65 @@ def _event_summary(event: Optional[dict], fallback: str = \"not recorded\") -> str\n     return _clip_text(preview or event.get(\"event_type\") or fallback, 180)\n \n \n+def _extract_language_kernel_run_map(trace_events: list[dict]) -> Optional[dict]:\n+    for event in trace_events:\n+        data = event.get(\"data\") if isinstance(event.get(\"data\"), dict) else {}\n+        ledger = data.get(\"run_ledger\") if isinstance(data.get(\"run_ledger\"), dict) else data\n+        kernel = ledger.get(\"language_kernel\") if isinstance(ledger.get(\"language_kernel\"), dict) else data.get(\"language_kernel\")\n+        if not isinstance(kernel, dict):\n+            continue\n+        run_map = kernel.get(\"ui_run_map\")\n+        if not isinstance(run_map, dict):\n+            continue\n+        sections = run_map.get(\"sections\")\n+        if not isinstance(sections, list):\n+            continue\n+        clean_sections = []\n+        for section in sections:\n+            if not isinstance(section, dict):\n+                continue\n+            section_id = str(section.get(\"id\") or section.get(\"label\") or \"\").strip()\n+            label = str(section.get(\"label\") or section.get(\"id\") or \"\").strip()\n+            if not section_id or not label:\n+                continue\n+            clean_sections.append({\n+                \"id\": section_id,\n+                \"label\": label,\n+                \"status\": str(section.get(\"status\") or \"not_recorded\"),\n+                \"count\": int(section.get(\"count\") or 0),\n+                \"event_id\": event.get(\"id\"),\n+                \"event_type\": event.get(\"event_type\"),\n+            })\n+        if clean_sections:\n+            return {\n+                \"version\": str(run_map.get(\"version\") or kernel.get(\"version\") or \"\"),\n+                \"next_focus\": str(run_map.get(\"next_focus\") or \"\"),\n+                \"sections\": clean_sections,\n+            }\n+    return None\n+\n+\n+def _kernel_section_summary(section: dict) -> str:\n+    section_id = str(section.get(\"id\") or \"\")\n+    status = str(section.get(\"status\") or \"not_recorded\").replace(\"_\", \" \")\n+    count = int(section.get(\"count\") or 0)\n+    if section_id == \"objective\":\n+        return \"Current run goal is captured.\" if count else \"No objective recorded yet.\"\n+    if section_id == \"plan\":\n+        return f\"{count} plan step(s) recorded.\" if count else \"Plan not recorded yet.\"\n+    if section_id == \"tools\":\n+        return f\"{count} tool call(s) linked.\" if count else \"No tool calls yet.\"\n+    if section_id == \"evidence\":\n+        return f\"{count} evidence item(s) selected.\" if count else \"Evidence not selected yet.\"\n+    if section_id == \"memory\":\n+        return f\"{count} memory write(s) recorded.\" if count else \"No memory write recorded.\"\n+    if section_id == \"verification\":\n+        return f\"{count or 1} issue(s) need attention.\" if status == \"blocked\" else f\"Verification is {status}.\"\n+    if section_id == \"response\":\n+        return \"Final response is blocked.\" if status == \"blocked\" else \"Final response is allowed.\"\n+    return f\"{section.get('label') or section_id} is {status}.\"\n+\n+\n def _build_operator_story(\n     *,\n     run,\n@@ -102,12 +161,16 @@ def _build_operator_story(\n     usage: dict,\n ) -> dict:\n     latest_plan = _latest_event(trace_events, {\"plan\", \"plan_steps\", \"continuation_gate\"})\n+    latest_policy = _latest_event(trace_events, {\"control_policy\", \"policy_selected\", \"policy_violation\"})\n+    latest_graph = _latest_event(trace_events, {\"pass_graph_execution\", \"pass_node_started\", \"pass_node_completed\", \"pass_node_failed\"})\n     latest_context = _latest_event(trace_events, {\"phase_packet\", \"phase_context\", \"compiled_context\"})\n     latest_tool_result = _latest_event(trace_events, {\"tool_result\"})\n     latest_tool_call = _latest_event(trace_events, {\"tool_call\"})\n+    latest_recovery = _latest_event(trace_events, {\"recovery_started\", \"completion_gate\"})\n     latest_verification = _latest_event(trace_events, {\"verification_warning\", \"verification_result\"})\n     latest_memory = _latest_event(trace_events, {\"memory_commit_plan\", \"memory_write_policy\", \"memory_commit_skipped\"})\n     latest_response = _latest_event(trace_events, {\"assistant_response\"})\n+    kernel_run_map = _extract_language_kernel_run_map(trace_events)\n \n     def lane(\n         lane_id: str,\n@@ -138,7 +201,7 @@ def lane(\n             \"summary\": summary or _event_summary(event),\n         }\n \n-    return {\n+    base_story = {\n         \"status\": run.status,\n         \"objective\": _clip_text(\n             getattr(passes[-1], \"objective\", \"\")\n@@ -154,21 +217,47 @@ def lane(\n             \"total_tokens\": usage[\"total_tokens\"],\n             \"estimated_cost_usd\": usage[\"estimated_cost_usd\"],\n         },\n-        \"lanes\": [\n-            lane(\"plan\", \"Plan\", latest_plan, count=len([p for p in passes if str(p.phase).lower() == \"planning\"])),\n-            lane(\"context\", \"Context\", latest_context, count=len([e for e in trace_events if e.get(\"event_type\") in {\"phase_packet\", \"phase_context\", \"compiled_context\"}])),\n-            lane(\"tool\", \"Tools\", latest_tool_result or latest_tool_call, count=len([e for e in trace_events if e.get(\"event_type\") in {\"tool_call\", \"tool_result\"}])),\n-            lane(\"evidence\", \"Evidence\", None, summary=(evidence[0].get(\"summary\") if evidence else \"No evidence selected yet.\"), count=len(evidence), status=\"done\" if evidence else \"idle\"),\n-            lane(\"memory\", \"Memory\", latest_memory, count=len([e for e in trace_events if \"memory\" in str(e.get(\"event_type\") or \"\")])),\n-            lane(\"verify\", \"Verify\", latest_verification, count=len(evals)),\n-            lane(\"response\", \"Response\", latest_response, count=len([e for e in trace_events if e.get(\"event_type\") == \"assistant_response\"])),\n-        ],\n         \"next_best_action\": _event_summary(\n             _latest_event(trace_events, {\"continuation_state_updated\", \"replan_recommended\", \"verification_warning\"}),\n             \"No follow-up action recorded.\",\n         ),\n         \"artifact_count\": len(artifacts),\n     }\n+    if kernel_run_map:\n+        base_story[\"source\"] = \"language_kernel\"\n+        base_story[\"next_best_action\"] = (\n+            f\"Next focus: {kernel_run_map['next_focus']}\"\n+            if kernel_run_map.get(\"next_focus\")\n+            else base_story[\"next_best_action\"]\n+        )\n+        base_story[\"lanes\"] = [\n+            {\n+                \"id\": section[\"id\"],\n+                \"label\": section[\"label\"],\n+                \"status\": section[\"status\"],\n+                \"count\": section[\"count\"],\n+                \"event_id\": section.get(\"event_id\"),\n+                \"event_type\": section.get(\"event_type\"),\n+                \"phase\": section[\"id\"],\n+                \"summary\": _kernel_section_summary(section),\n+            }\n+            for section in kernel_run_map[\"sections\"]\n+        ]\n+        return base_story\n+    base_story[\"source\"] = \"trace_timeline\"\n+    base_story[\"lanes\"] = [\n+        lane(\"plan\", \"Plan\", latest_plan, count=len([p for p in passes if str(p.phase).lower() == \"planning\"])),\n+        lane(\"policy\", \"Policy\", latest_policy, count=len([e for e in trace_events if e.get(\"event_type\") in {\"control_policy\", \"policy_selected\", \"policy_violation\"}])),\n+        lane(\"graph\", \"Graph\", latest_graph, count=len([e for e in trace_events if e.get(\"event_type\") in {\"pass_graph_execution\", \"pass_node_started\", \"pass_node_completed\", \"pass_node_failed\"}])),\n+        lane(\"context\", \"Context\", latest_context, count=len([e for e in trace_events if e.get(\"event_type\") in {\"phase_packet\", \"phase_context\", \"compiled_context\"}])),\n+        lane(\"tool\", \"Tools\", latest_tool_result or latest_tool_call, count=len([e for e in trace_events if e.get(\"event_type\") in {\"tool_call\", \"tool_result\"}])),\n+        lane(\"evidence\", \"Evidence\", None, summary=(evidence[0].get(\"summary\") if evidence else \"No evidence selected yet.\"), count=len(evidence), status=\"done\" if evidence else \"idle\"),\n+        lane(\"recovery\", \"Recovery\", latest_recovery, count=len([e for e in trace_events if e.get(\"event_type\") in {\"recovery_started\", \"completion_gate\"}])),\n+        lane(\"memory\", \"Memory\", latest_memory, count=len([e for e in trace_events if \"memory\" in str(e.get(\"event_type\") or \"\")])),\n+        lane(\"verify\", \"Verify\", latest_verification, count=len(evals)),\n+        lane(\"response\", \"Response\", latest_response, count=len([e for e in trace_events if e.get(\"event_type\") == \"assistant_response\"])),\n+    ]\n+    return base_story\n \n \n def _build_run_replay_payload(*, run_id: str, owner_id: str, trace_limit: int = 160) -> dict:"},{"sha":"5aab0a0ce4c14969cf518e7e0fdfe0dcc6f889e1","filename":"api/main.py","status":"modified","additions":433,"deletions":9,"changes":442,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fmain.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fmain.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Fmain.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -14,6 +14,9 @@\n import asyncio\n import json\n import os\n+import shutil\n+import socket\n+from dataclasses import asdict\n from pathlib import Path\n from contextlib import asynccontextmanager\n from dotenv import load_dotenv\n@@ -52,20 +55,24 @@\n from api.rag_routes import make_rag_router            # ← NEW\n from api.consumer_routes import make_consumer_router\n from api.harness_lab import make_harness_lab_router\n+from api.workflow_lab import make_workflow_lab_router\n from api.memory_inspector import build_session_memory_payload\n from api.owner import require_owner_id\n from services.storage_admin import StorageAdminService, StoreSelection\n from services.consumer_store import ConsumerStoreService\n+from services.image_generation import generate_image\n from plugins.shovs_meta_gateway import inject_gateway_dependencies, register_gateway_tools\n \n from guardrails import GuardrailMiddleware\n from guardrails.api_routes import make_guardrail_router\n from orchestration.run_store import get_run_store\n from config.trace_store import get_trace_store\n from run_engine import RunEngine, RunEngineRequest\n+from run_engine.kernel_engine import KernelRunEngine\n \n from config.config import cfg\n from engine.fact_guard import is_grounded_fact_record\n+from llm.model_capabilities import capability_flags\n FALLBACK_CHAT_MODEL = cfg.DEFAULT_MODEL\n CHAT_RATE_LIMIT = os.getenv(\"CHAT_RATE_LIMIT\", \"30/minute\")\n \n@@ -128,6 +135,215 @@ def _coerce_agent_patch_value(key: str, value: Any) -> Any:\n             return 8000\n     return value\n \n+\n+def _python_module_available(module_name: str) -> bool:\n+    try:\n+        __import__(module_name)\n+        return True\n+    except Exception:\n+        return False\n+\n+\n+def _port_open(host: str, port: int, timeout: float = 0.35) -> bool:\n+    try:\n+        with socket.create_connection((host, port), timeout=timeout):\n+            return True\n+    except Exception:\n+        return False\n+\n+\n+async def _docker_runtime_status() -> dict[str, Any]:\n+    if os.getenv(\"DOCKER_DISABLED\", \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}:\n+        return {\n+            \"configured\": False,\n+            \"available\": False,\n+            \"message\": \"Docker sandbox disabled by DOCKER_DISABLED=true\",\n+        }\n+    if not shutil.which(\"docker\"):\n+        return {\n+            \"configured\": False,\n+            \"available\": False,\n+            \"message\": \"Docker CLI not found; Docker-backed tools are unavailable\",\n+        }\n+\n+    def _ping() -> tuple[bool, str]:\n+        try:\n+            import docker\n+\n+            client = docker.from_env()\n+            client.ping()\n+            return True, \"Docker daemon reachable\"\n+        except Exception as exc:\n+            return False, f\"Docker daemon not reachable ({type(exc).__name__})\"\n+\n+    available, message = await asyncio.to_thread(_ping)\n+    return {\n+        \"configured\": True,\n+        \"available\": available,\n+        \"message\": message,\n+    }\n+\n+\n+async def _local_service_status(name: str, base_url: str, path: str = \"/\") -> dict[str, Any]:\n+    raw_url = (base_url or \"\").strip()\n+    if not raw_url:\n+        return {\n+            \"configured\": False,\n+            \"available\": False,\n+            \"base_url\": \"\",\n+            \"message\": f\"{name} URL is not configured\",\n+        }\n+\n+    def _probe() -> dict[str, Any]:\n+        import urllib.error\n+        import urllib.parse\n+        import urllib.request\n+\n+        parsed = urllib.parse.urlparse(raw_url)\n+        host = parsed.hostname or \"127.0.0.1\"\n+        port = parsed.port or (443 if parsed.scheme == \"https\" else 80)\n+        is_port_open = _port_open(host, port)\n+        probe_url = raw_url.rstrip(\"/\") + (path if path.startswith(\"/\") else f\"/{path}\")\n+        try:\n+            request = urllib.request.Request(probe_url, headers={\"User-Agent\": \"shovs-runtime-health/1.0\"})\n+            with urllib.request.urlopen(request, timeout=0.75) as response:\n+                return {\n+                    \"configured\": True,\n+                    \"available\": 200 <= int(response.status) < 500,\n+                    \"base_url\": raw_url,\n+                    \"port_open\": is_port_open,\n+                    \"message\": f\"{name} returned HTTP {response.status}\",\n+                }\n+        except urllib.error.HTTPError as exc:\n+            return {\n+                \"configured\": True,\n+                \"available\": int(exc.code) < 500,\n+                \"base_url\": raw_url,\n+                \"port_open\": is_port_open,\n+                \"message\": f\"{name} returned HTTP {exc.code}\",\n+            }\n+        except Exception as exc:\n+            return {\n+                \"configured\": True,\n+                \"available\": False,\n+                \"base_url\": raw_url,\n+                \"port_open\": is_port_open,\n+                \"message\": f\"{name} not reachable ({type(exc).__name__})\",\n+            }\n+\n+    return await asyncio.to_thread(_probe)\n+\n+\n+def _voice_runtime_status() -> dict[str, Any]:\n+    stt_backends: list[str] = []\n+    tts_backends: list[str] = []\n+    if os.getenv(\"DEEPGRAM_API_KEY\"):\n+        stt_backends.append(\"deepgram\")\n+        tts_backends.append(\"deepgram-aura\")\n+    if os.getenv(\"GROQ_API_KEY\"):\n+        stt_backends.append(\"groq-whisper\")\n+    if _python_module_available(\"faster_whisper\"):\n+        stt_backends.append(\"faster-whisper\")\n+    if _python_module_available(\"edge_tts\"):\n+        tts_backends.append(\"edge-tts\")\n+    if _python_module_available(\"kokoro\"):\n+        tts_backends.append(\"kokoro\")\n+    return {\n+        \"websocket_paths\": [\"/ws/voice\", \"/api/ws/voice\"],\n+        \"stt_available\": bool(stt_backends),\n+        \"tts_available\": bool(tts_backends),\n+        \"stt_backends\": stt_backends,\n+        \"tts_backends\": tts_backends,\n+        \"message\": \"configured\" if stt_backends and tts_backends else \"voice requires at least one STT backend and one TTS backend\",\n+    }\n+\n+\n+def _session_runtime_state(session, *, owner_id: str) -> dict[str, Any]:\n+    store = get_run_store()\n+    latest_run = store.latest_for_session(session.id, owner_id=owner_id)\n+    latest_run_payload: dict[str, Any] | None = None\n+    latest_pass_payload: dict[str, Any] | None = None\n+    latest_checkpoint_payload: dict[str, Any] | None = None\n+    if latest_run:\n+        latest_run_payload = asdict(latest_run)\n+        passes = store.list_passes(latest_run.run_id)\n+        checkpoints = store.list_checkpoints(latest_run.run_id)\n+        if passes:\n+            latest_pass_payload = asdict(passes[-1])\n+        if checkpoints:\n+            latest_checkpoint_payload = asdict(checkpoints[-1])\n+\n+    trace_store = get_trace_store()\n+    latest_ledger: dict[str, Any] | None = None\n+    for event in trace_store.list_events(\n+        limit=30,\n+        session_id=session.id,\n+        owner_id=owner_id,\n+        event_type=\"run_ledger\",\n+    ):\n+        hydrated = trace_store.get_event(str(event.get(\"id\") or \"\")) or event\n+        data = hydrated.get(\"data\") if isinstance(hydrated.get(\"data\"), dict) else {}\n+        if data:\n+            latest_ledger = {\n+                \"event_id\": hydrated.get(\"id\"),\n+                \"run_id\": hydrated.get(\"run_id\") or data.get(\"run_id\"),\n+                \"created_at\": hydrated.get(\"iso_ts\"),\n+                \"reason\": data.get(\"reason\"),\n+                \"ledger_mode\": data.get(\"ledger_mode\"),\n+                \"phase\": data.get(\"phase\") or data.get(\"current_phase\"),\n+                \"objective\": data.get(\"objective\"),\n+                \"summary\": data.get(\"summary\") or {},\n+                \"next_required_action\": data.get(\"next_required_action\") or {},\n+                \"completion_gate\": data.get(\"completion_gate\") or {},\n+                \"execution_contract\": data.get(\"execution_contract\") or {},\n+                \"missing_requirements\": data.get(\"missing_requirements\") or [],\n+                \"locked_entities\": data.get(\"locked_entities\") or [],\n+                \"policy_violations\": data.get(\"policy_violations\") or [],\n+            }\n+            break\n+\n+    compressed_context = str(getattr(session, \"compressed_context\", \"\") or \"\")\n+    continuation_state = dict(getattr(session, \"continuation_state\", {}) or {})\n+    full_history = list(getattr(session, \"full_history\", []) or [])\n+    candidate_signals = list(getattr(session, \"candidate_signals\", []) or [])\n+    context_status = \"ready\"\n+    stale_reasons: list[str] = []\n+    if not compressed_context and len(full_history) >= 4:\n+        context_status = \"needs_compression\"\n+        stale_reasons.append(\"session has history but no compressed context\")\n+    if continuation_state:\n+        context_status = \"continuation_pending\"\n+        stale_reasons.append(\"session has pending continuation state\")\n+    if latest_ledger and latest_ledger.get(\"missing_requirements\"):\n+        context_status = \"evidence_or_state_missing\"\n+        stale_reasons.append(\"latest ledger reports missing requirements\")\n+\n+    return {\n+        \"context_status\": context_status,\n+        \"stale_reasons\": stale_reasons,\n+        \"db_paths\": {\n+            \"sessions\": session_manager.db_path,\n+            \"agents\": profile_manager.db_path,\n+            \"runs\": store.db_path,\n+            \"semantic_memory\": semantic_graph.db_path,\n+        },\n+        \"session\": {\n+            \"id\": session.id,\n+            \"agent_id\": getattr(session, \"agent_id\", \"default\"),\n+            \"message_count\": int(getattr(session, \"message_count\", 0) or 0),\n+            \"history_count\": len(full_history),\n+            \"sliding_window_count\": len(getattr(session, \"sliding_window\", []) or []),\n+            \"compressed_context_chars\": len(compressed_context),\n+            \"candidate_signal_count\": len(candidate_signals),\n+            \"continuation_pending\": bool(continuation_state),\n+            \"continuation_state\": continuation_state,\n+        },\n+        \"latest_run\": latest_run_payload,\n+        \"latest_pass\": latest_pass_payload,\n+        \"latest_checkpoint\": latest_checkpoint_payload,\n+        \"latest_ledger\": latest_ledger,\n+    }\n+\n # ── Singletons ────────────────────────────────────────────────────────────────\n adapter         = OllamaAdapter()\n tool_registry   = ToolRegistry()\n@@ -164,6 +380,20 @@ def _coerce_agent_patch_value(key: str, value: Any) -> Any:\n     context_engine=context_engine,\n     graph=semantic_graph,\n )\n+# Kernel-driven runtime (the deterministic control plane). Same construction\n+# surface and the same `.stream(request)` signature as RunEngine, so it is a\n+# drop-in A/B path: selected when control_policy == \"kernel\". The model is a\n+# slot-filler (lock entities + synthesize = 2 LLM calls), not the orchestrator.\n+kernel_run_engine = KernelRunEngine(\n+    adapter=adapter,\n+    sessions=session_manager,\n+    tool_registry=tool_registry,\n+    run_store=get_run_store(),\n+    trace_store=get_trace_store(),\n+    orchestrator=orchestrator,\n+    context_engine=context_engine,\n+    graph=semantic_graph,\n+)\n storage_admin = StorageAdminService(session_manager, profile_manager)\n consumer_session_manager = SessionManager(max_sessions=200, db_path=\"consumer_sessions.db\")\n consumer_context_engine = ContextEngine(adapter=adapter, compression_model=FALLBACK_CHAT_MODEL)\n@@ -224,16 +454,57 @@ def _seed_standard_profiles():\n             name=\"Research Specialist\",\n             model=cfg.DEFAULT_MODEL,\n             tools=[\n+                \"source_collect\",\n                 \"source_contract\", \"source_select\", \"source_next_action\",\n                 \"web_fetch_batch\", \"source_coverage\",\n-                \"web_search\", \"web_fetch\", \"rag_search\", \"query_memory\", \"store_memory\",\n+                \"stock_analysis_report\", \"finance_snapshot\", \"alpha_vantage_movers\", \"alpha_vantage_quote\", \"alpha_vantage_overview\", \"alpha_vantage_news\",\n+                \"alpha_vantage_income_statement\", \"alpha_vantage_balance_sheet\", \"alpha_vantage_cash_flow\", \"alpha_vantage_earnings\",\n+                \"alpha_vantage_market_status\", \"alpha_vantage_technical_indicator\",\n+                \"web_search\", \"web_fetch\", \"image_search\", \"image_generate\", \"rag_search\", \"query_memory\", \"store_memory\",\n             ],\n             system_prompt=(\n                 \"You are a meticulous research agent. Always verify claims across multiple sources. \"\n                 \"CRITICAL: Only call web_fetch with URLs returned by a prior web_search result. \"\n                 \"Never invent or guess URLs. Cite sources. Never fabricate data.\"\n             ),\n         ),\n+        AgentProfile(\n+            id=\"finance-analyst\",\n+            name=\"Finance Analyst\",\n+            description=\"Ticker and market-mover analyst using deterministic Alpha Vantage data before web expansion.\",\n+            model=cfg.DEFAULT_MODEL,\n+            tools=[\n+                \"stock_analysis_report\",\n+                \"finance_snapshot\",\n+                \"alpha_vantage_movers\",\n+                \"alpha_vantage_quote\",\n+                \"alpha_vantage_overview\",\n+                \"alpha_vantage_news\",\n+                \"alpha_vantage_income_statement\",\n+                \"alpha_vantage_balance_sheet\",\n+                \"alpha_vantage_cash_flow\",\n+                \"alpha_vantage_earnings\",\n+                \"alpha_vantage_market_status\",\n+                \"alpha_vantage_technical_indicator\",\n+                \"source_collect\",\n+                \"source_contract\", \"source_select\", \"source_next_action\",\n+                \"web_fetch_batch\", \"source_coverage\",\n+                \"web_search\", \"web_fetch\", \"query_memory\",\n+            ],\n+            system_prompt=(\n+                \"You are a finance research analyst. Use stock_analysis_report for full ticker reports. Use Alpha Vantage \"\n+                \"movers first for market-mover discovery, and quote/overview/news/statement tools for narrower questions. \"\n+                \"Lock ticker symbols from deterministic data before web expansion. Keep reports structured, cite only URLs \"\n+                \"present in tool results, and avoid buy/sell advice unless the user explicitly asks for a risk-framed opinion.\"\n+            ),\n+            default_use_planner=True,\n+            default_loop_mode=\"managed\",\n+            default_context_mode=\"v3\",\n+            workflow_template=\"finance_analyst_v1\",\n+            prompt_version=\"finance_snapshot_v1\",\n+            risk_policy=\"finance_read_only\",\n+            ledger_mode=\"shadow\",\n+        ),\n         AgentProfile(\n             id=\"analyst\",\n             name=\"Data Analyst\",\n@@ -260,9 +531,10 @@ def _seed_standard_profiles():\n             description=\"Plain-language assistant for the consumer chat surface.\",\n             model=\"groq:moonshotai/kimi-k2-instruct\",\n             tools=[\n+                \"source_collect\",\n                 \"source_contract\", \"source_select\", \"source_next_action\",\n                 \"web_fetch_batch\", \"source_coverage\",\n-                \"web_search\", \"web_fetch\", \"query_memory\",\n+                \"web_search\", \"web_fetch\", \"image_search\", \"image_generate\", \"query_memory\",\n             ],\n             system_prompt=(\n                 \"You are a clear, calm assistant for the consumer product surface. \"\n@@ -279,7 +551,7 @@ def _seed_standard_profiles():\n             description=\"Verifies product pages, prices, and tradeoffs before recommending.\",\n             model=cfg.DEFAULT_MODEL,\n             tools=[\n-                \"shopping_advice\", \"source_contract\", \"source_select\", \"source_next_action\",\n+                \"shopping_advice\", \"source_collect\", \"source_contract\", \"source_select\", \"source_next_action\",\n                 \"web_fetch_batch\", \"source_coverage\",\n                 \"web_search\", \"web_fetch\", \"query_memory\", \"store_memory\",\n             ],\n@@ -304,9 +576,20 @@ def _seed_standard_profiles():\n         if not existing:\n             profile_manager.create(p)\n             log(\"startup\", \"profiles\", f\"Seeded agent profile: {p.id}\")\n-        elif existing.default_use_planner != p.default_use_planner:\n-            profile_manager.create(p)\n-            log(\"startup\", \"profiles\", f\"Migrated planner default for profile: {p.id}\")\n+        else:\n+            merged_tools = list(existing.tools or [])\n+            for tool in p.tools or []:\n+                if tool not in merged_tools:\n+                    merged_tools.append(tool)\n+            profile_changed = merged_tools != list(existing.tools or [])\n+            if profile_changed:\n+                existing.tools = merged_tools\n+            if existing.default_use_planner != p.default_use_planner:\n+                existing.default_use_planner = p.default_use_planner\n+                profile_changed = True\n+            if profile_changed:\n+                profile_manager.create(existing)\n+                log(\"startup\", \"profiles\", f\"Migrated standard profile: {p.id}\")\n \n \n # ── App lifespan ──────────────────────────────────────────────────────────────\n@@ -326,11 +609,36 @@ async def lifespan(app: FastAPI):\n limiter = Limiter(key_func=get_remote_address)\n app.state.limiter = limiter\n app.add_exception_handler(RateLimitExceeded, _rate_limit_exceeded_handler)\n+\n+\n+@app.middleware(\"http\")\n+async def api_prefix_compatibility(request: Request, call_next):\n+    \"\"\"Allow frontend/static deployments to call /api/* without a dev proxy.\n+\n+    Vite strips /api during local development, but a production/static backend\n+    may receive /api/models or /api/chat/stream directly. Rewriting here keeps\n+    both deployment shapes equivalent without duplicating every route.\n+    \"\"\"\n+    path = request.scope.get(\"path\", \"\")\n+    if path == \"/api\":\n+        request.scope[\"path\"] = \"/\"\n+    elif isinstance(path, str) and path.startswith(\"/api/\"):\n+        request.scope[\"path\"] = path[4:]\n+    return await call_next(request)\n+\n+\n setup_log_routes(app)\n setup_voice_routes(app, run_engine=run_engine, profile_manager=profile_manager)\n app.include_router(make_guardrail_router(guardrail_middleware), prefix=\"/guardrails\")\n app.include_router(make_rag_router(), prefix=\"/rag\")          # ← NEW\n app.include_router(make_harness_lab_router())\n+app.include_router(\n+    make_workflow_lab_router(\n+        run_engine=run_engine,\n+        profile_manager=profile_manager,\n+        default_model=FALLBACK_CHAT_MODEL,\n+    )\n+)\n app.include_router(\n     make_consumer_router(\n         profile_manager=profile_manager,\n@@ -379,6 +687,15 @@ class StorageBackupPayload(StorageSelectionPayload):\n     backup_label: str = \"\"\n \n \n+class ImageGenerationPayload(BaseModel):\n+    prompt: str = Field(..., min_length=1, max_length=8000)\n+    model: str = \"\"\n+    size: str = \"1024x1024\"\n+    quality: str = \"auto\"\n+    background: str = \"auto\"\n+    output_format: str = \"png\"\n+\n+\n class MemorySearchPayload(BaseModel):\n     query: str = Field(..., min_length=1, max_length=4096)\n     top_k: int = Field(default=5, ge=1, le=50)\n@@ -454,12 +771,114 @@ async def list_models():\n         \"openai:text-embedding-ada-002\"\n     ])\n     \n-    return {\"models\": grouped, \"embeddings\": list(set(embeddings))}\n+    capabilities: dict[str, dict[str, Any]] = {}\n+    for provider, provider_models in grouped.items():\n+        for model_name in provider_models:\n+            full_name = f\"{provider}:{model_name}\"\n+            capabilities[full_name] = capability_flags(full_name)\n+    for embedding_model in set(embeddings):\n+        capabilities[embedding_model] = capability_flags(embedding_model)\n+    return {\n+        \"models\": grouped,\n+        \"embeddings\": list(set(embeddings)),\n+        \"capabilities\": capabilities,\n+        \"vision_model\": cfg.VISION_MODEL,\n+        \"image_generation_model\": cfg.IMAGE_GENERATION_MODEL,\n+    }\n \n @app.get(\"/tools\")\n async def list_tools():\n     return {\"tools\": tool_registry.list_tools()}\n \n+\n+@app.get(\"/runtime/health\")\n+async def runtime_health():\n+    tools = tool_registry.list_tools()\n+    tool_names = [str(tool.get(\"name\") or \"\") for tool in tools]\n+    docker_status, searxng_status, llamacpp_status = await asyncio.gather(\n+        _docker_runtime_status(),\n+        _local_service_status(\"SearXNG\", os.getenv(\"SEARXNG_URL\", \"\"), \"/\"),\n+        _local_service_status(\n+            \"llama.cpp\",\n+            os.getenv(\"LLAMACPP_BASE_URL\", \"http://127.0.0.1:8080/v1\"),\n+            \"/models\",\n+        ),\n+    )\n+    voice_status = _voice_runtime_status()\n+    return {\n+        \"status\": \"ok\",\n+        \"runtime\": \"run_engine\",\n+        \"local_mode\": os.getenv(\"DOCKER_DISABLED\", \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"},\n+        \"tool_count\": len(tools),\n+        \"tools\": {\n+            \"web_search\": \"web_search\" in tool_names,\n+            \"web_fetch\": \"web_fetch\" in tool_names,\n+            \"image_generate\": \"image_generate\" in tool_names,\n+            \"image_search\": \"image_search\" in tool_names,\n+            \"finance_snapshot\": \"finance_snapshot\" in tool_names,\n+            \"alpha_vantage_movers\": \"alpha_vantage_movers\" in tool_names,\n+        },\n+        \"models\": {\n+            \"default_model\": cfg.DEFAULT_MODEL,\n+            \"vision_model\": cfg.VISION_MODEL,\n+            \"image_generation_model\": cfg.IMAGE_GENERATION_MODEL,\n+        },\n+        \"persistence\": {\n+            \"project_root\": cfg.PROJECT_ROOT,\n+            \"sessions_db\": session_manager.db_path,\n+            \"agents_db\": profile_manager.db_path,\n+            \"runs_db\": get_run_store().db_path,\n+            \"semantic_memory_db\": semantic_graph.db_path,\n+            \"chroma_db_path\": cfg.CHROMA_DB_PATH,\n+        },\n+        \"features\": {\n+            \"harness_lab\": True,\n+            \"workflow_lab\": True,\n+            \"api_prefix_compatibility\": True,\n+            \"sandbox_static\": True,\n+            \"voice_io\": True,\n+            \"finance_data\": \"finance_snapshot\" in tool_names,\n+        },\n+        \"optional_services\": {\n+            \"docker_sandbox\": docker_status,\n+            \"searxng\": searxng_status,\n+            \"llamacpp\": llamacpp_status,\n+            \"voice\": voice_status,\n+            \"alpha_vantage\": {\n+                \"available\": bool(os.getenv(\"ALPHA_VANTAGE_API_KEY\") or os.getenv(\"ALPHAVANTAGE_API_KEY\")),\n+                \"configured\": bool(os.getenv(\"ALPHA_VANTAGE_API_KEY\") or os.getenv(\"ALPHAVANTAGE_API_KEY\")),\n+                \"message\": \"configured\" if (os.getenv(\"ALPHA_VANTAGE_API_KEY\") or os.getenv(\"ALPHAVANTAGE_API_KEY\")) else \"ALPHA_VANTAGE_API_KEY not set\",\n+            },\n+        },\n+        \"requirements\": {\n+            \"image_generation\": \"OPENAI_API_KEY\" if not cfg.OPENAI_API_KEY else \"configured\",\n+            \"vision\": \"VISION_MODEL\" if not cfg.VISION_MODEL else \"configured\",\n+            \"voice\": \"configured\" if voice_status.get(\"stt_available\") and voice_status.get(\"tts_available\") else voice_status.get(\"message\"),\n+            \"bash_tool\": \"configured\" if docker_status.get(\"available\") else docker_status.get(\"message\"),\n+            \"local_search\": \"configured\" if searxng_status.get(\"available\") else searxng_status.get(\"message\"),\n+            \"llamacpp\": \"configured\" if llamacpp_status.get(\"available\") else llamacpp_status.get(\"message\"),\n+            \"alpha_vantage\": \"configured\" if (os.getenv(\"ALPHA_VANTAGE_API_KEY\") or os.getenv(\"ALPHAVANTAGE_API_KEY\")) else \"ALPHA_VANTAGE_API_KEY not set\",\n+        },\n+    }\n+\n+\n+@app.post(\"/images/generate\")\n+async def generate_image_endpoint(payload: ImageGenerationPayload):\n+    try:\n+        return await generate_image(\n+            prompt=payload.prompt,\n+            model=payload.model,\n+            size=payload.size,\n+            quality=payload.quality,\n+            background=payload.background,\n+            output_format=payload.output_format,\n+        )\n+    except ValueError as exc:\n+        raise HTTPException(status_code=400, detail=str(exc))\n+    except Exception as exc:\n+        raise HTTPException(status_code=503, detail=str(exc))\n+\n+\n @app.post(\"/chat/stream\")\n @limiter.limit(CHAT_RATE_LIMIT)\n async def chat_stream(\n@@ -594,11 +1013,14 @@ async def generate():\n                 prompt_version=getattr(profile, \"prompt_version\", \"role_contracts_v1\"),\n                 risk_policy=getattr(profile, \"risk_policy\", \"standard\"),\n                 ledger_mode=getattr(profile, \"ledger_mode\", \"shadow\"),\n+                control_policy=loop_mode or getattr(profile, \"default_loop_mode\", \"auto\"),\n                 forced_tools=tuple(str(item) for item in forced_tools if isinstance(item, str)),\n                 workspace_path=getattr(profile, \"workspace_path\", None),\n                 reasoning_enabled=reasoning_enabled,\n+                memory_commit_mode=os.getenv(\"SHOVSOS_MEMORY_COMMIT_MODE\", \"async\"),\n             )\n-            async for event in run_engine.stream(run_request):\n+            _engine = kernel_run_engine if run_request.control_policy == \"kernel\" else run_engine\n+            async for event in _engine.stream(run_request):\n                 yield f\"data: {json.dumps(event)}\\n\\n\"\n             return\n \n@@ -832,12 +1254,14 @@ async def get_session_memory_state(session_id: str, owner_id: str):\n     s = session_manager.get(session_id, owner_id=owner_id)\n     if not s:\n         raise HTTPException(404, \"Session not found\")\n-    return build_session_memory_payload(\n+    payload = build_session_memory_payload(\n         session=s,\n         owner_id=owner_id,\n         context_preview=_context_preview,\n         graph=semantic_graph,\n     )\n+    payload[\"runtime_state\"] = _session_runtime_state(s, owner_id=owner_id)\n+    return payload\n \n @app.get(\"/memory\")\n async def list_memories(limit: int = 100, owner_id: Optional[str] = None):"},{"sha":"c51aee6dba3b6559cadffb0f4567095bd782e9ca","filename":"api/voice_endpoint.py","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fvoice_endpoint.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fvoice_endpoint.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Fvoice_endpoint.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -42,6 +42,7 @@\n def setup_voice_routes(app: FastAPI, *, run_engine, profile_manager) -> None:\n     \"\"\"Register voice WebSocket endpoint.\"\"\"\n \n+    @app.websocket(\"/api/ws/voice\")\n     @app.websocket(\"/ws/voice\")\n     async def voice_endpoint(ws: WebSocket):\n         await ws.accept()"},{"sha":"f267a5a4b2ec61b1565f4775da4fc80da3c4ce91","filename":"api/workflow_lab.py","status":"added","additions":1613,"deletions":0,"changes":1613,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fworkflow_lab.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/api%2Fworkflow_lab.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/api%2Fworkflow_lab.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,1613 @@\n+from __future__ import annotations\n+\n+import asyncio\n+import json\n+import re\n+import sqlite3\n+import uuid\n+from copy import deepcopy\n+from dataclasses import asdict, dataclass\n+from datetime import datetime, timezone\n+from pathlib import Path\n+from typing import Any, Optional\n+\n+from fastapi import APIRouter, BackgroundTasks, Body, HTTPException\n+\n+from run_engine.control_policies import resolve_control_policy\n+from run_engine.ledger import RunLedger\n+from run_engine.types import RunEngineRequest\n+\n+\n+DEFAULT_WORKFLOW_RUNS_DB = \"workflow_runs.db\"\n+\n+\n+def _now() -> str:\n+    return datetime.now(timezone.utc).isoformat()\n+\n+\n+def _id(prefix: str) -> str:\n+    return f\"{prefix}_{uuid.uuid4().hex[:12]}\"\n+\n+\n+def _json_dumps(value: Any) -> str:\n+    return json.dumps(value, ensure_ascii=True, sort_keys=True)\n+\n+\n+def _json_loads(value: str | None, fallback: Any) -> Any:\n+    if not value:\n+        return fallback\n+    try:\n+        return json.loads(value)\n+    except Exception:\n+        return fallback\n+\n+\n+@dataclass(frozen=True)\n+class WorkflowStepDefinition:\n+    id: str\n+    label: str\n+    kind: str\n+    description: str\n+    consumes: tuple[str, ...] = ()\n+    produces: tuple[str, ...] = ()\n+    gates: tuple[str, ...] = ()\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        data = asdict(self)\n+        data[\"consumes\"] = list(self.consumes)\n+        data[\"produces\"] = list(self.produces)\n+        data[\"gates\"] = list(self.gates)\n+        return data\n+\n+\n+@dataclass(frozen=True)\n+class WorkflowDefinition:\n+    id: str\n+    label: str\n+    description: str\n+    template: str\n+    policy: str\n+    ledger_mode: str\n+    context_mode: str\n+    prompt_version: str\n+    risk_policy: str\n+    tools: tuple[str, ...]\n+    memory_policy: dict[str, Any]\n+    input_schema: dict[str, Any]\n+    output_schema: dict[str, Any]\n+    steps: tuple[WorkflowStepDefinition, ...]\n+    tags: tuple[str, ...] = ()\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return {\n+            \"id\": self.id,\n+            \"label\": self.label,\n+            \"description\": self.description,\n+            \"template\": self.template,\n+            \"runtime\": {\n+                \"policy\": self.policy,\n+                \"ledger_mode\": self.ledger_mode,\n+                \"context_mode\": self.context_mode,\n+                \"prompt_version\": self.prompt_version,\n+                \"risk_policy\": self.risk_policy,\n+            },\n+            \"tools\": list(self.tools),\n+            \"memory_policy\": deepcopy(self.memory_policy),\n+            \"input_schema\": deepcopy(self.input_schema),\n+            \"output_schema\": deepcopy(self.output_schema),\n+            \"steps\": [step.to_dict() for step in self.steps],\n+            \"tags\": list(self.tags),\n+        }\n+\n+\n+def _workflow_definition_from_dict(payload: dict[str, Any]) -> WorkflowDefinition:\n+    runtime = payload.get(\"runtime\") if isinstance(payload.get(\"runtime\"), dict) else {}\n+    output_schema = payload.get(\"output_schema\") if isinstance(payload.get(\"output_schema\"), dict) else {}\n+    fields = output_schema.get(\"fields\") if isinstance(output_schema.get(\"fields\"), list) else []\n+    steps_payload = payload.get(\"steps\") if isinstance(payload.get(\"steps\"), list) else []\n+    steps = tuple(\n+        WorkflowStepDefinition(\n+            id=str(item.get(\"id\") or f\"step_{index + 1}\"),\n+            label=str(item.get(\"label\") or f\"Step {index + 1}\"),\n+            kind=str(item.get(\"kind\") or \"step\"),\n+            description=str(item.get(\"description\") or \"\"),\n+            consumes=tuple(str(value) for value in item.get(\"consumes\", []) if str(value).strip())\n+            if isinstance(item, dict) and isinstance(item.get(\"consumes\"), list)\n+            else (),\n+            produces=tuple(str(value) for value in item.get(\"produces\", []) if str(value).strip())\n+            if isinstance(item, dict) and isinstance(item.get(\"produces\"), list)\n+            else (),\n+            gates=tuple(str(value) for value in item.get(\"gates\", []) if str(value).strip())\n+            if isinstance(item, dict) and isinstance(item.get(\"gates\"), list)\n+            else (),\n+        )\n+        for index, item in enumerate(steps_payload)\n+        if isinstance(item, dict)\n+    )\n+    return WorkflowDefinition(\n+        id=str(payload.get(\"id\") or \"\"),\n+        label=str(payload.get(\"label\") or \"Custom Workflow\"),\n+        description=str(payload.get(\"description\") or \"\"),\n+        template=str(payload.get(\"template\") or \"custom_workflow_v1\"),\n+        policy=str(runtime.get(\"policy\") or payload.get(\"policy\") or \"plan_execute\"),\n+        ledger_mode=str(runtime.get(\"ledger_mode\") or payload.get(\"ledger_mode\") or \"ledger_enforced\"),\n+        context_mode=str(runtime.get(\"context_mode\") or payload.get(\"context_mode\") or \"ladder\"),\n+        prompt_version=str(runtime.get(\"prompt_version\") or payload.get(\"prompt_version\") or \"custom_contract_v1\"),\n+        risk_policy=str(runtime.get(\"risk_policy\") or payload.get(\"risk_policy\") or \"evidence_first\"),\n+        tools=tuple(str(item).strip() for item in (payload.get(\"tools\") or []) if str(item).strip()),\n+        memory_policy=dict(payload.get(\"memory_policy\") or {\"read\": [], \"write\": \"explicit_user_preferences_only\", \"provenance_required\": True}),\n+        input_schema=dict(payload.get(\"input_schema\") or {\"query\": \"string\"}),\n+        output_schema={\n+            \"type\": str(output_schema.get(\"type\") or payload.get(\"output_type\") or \"custom_result\"),\n+            \"fields\": [str(item) for item in fields if str(item).strip()] or [\"summary\", \"sources\", \"unresolved\"],\n+        },\n+        steps=steps or COMMON_SOURCE_STEPS,\n+        tags=tuple(str(item).strip() for item in (payload.get(\"tags\") or [\"custom\"]) if str(item).strip()),\n+    )\n+\n+\n+def _slugify_workflow_id(label: str) -> str:\n+    base = re.sub(r\"[^a-z0-9]+\", \"_\", str(label or \"custom_workflow\").lower()).strip(\"_\")\n+    if not base:\n+        base = \"custom_workflow\"\n+    if not base.endswith(\"_v1\"):\n+        base = f\"{base}_v1\"\n+    return base[:80]\n+\n+\n+def _list_from_text_or_array(value: Any, *, fallback: list[str]) -> list[str]:\n+    if isinstance(value, list):\n+        items = value\n+    else:\n+        items = re.split(r\"[,\\\\n]+\", str(value or \"\"))\n+    cleaned = [str(item).strip() for item in items if str(item).strip()]\n+    return cleaned or list(fallback)\n+\n+\n+def build_custom_workflow_definition(payload: dict[str, Any], *, existing_ids: set[str] | None = None) -> WorkflowDefinition:\n+    label = str(payload.get(\"label\") or \"Custom Workflow\").strip() or \"Custom Workflow\"\n+    workflow_id = str(payload.get(\"id\") or \"\").strip() or _slugify_workflow_id(label)\n+    existing = set(existing_ids or set())\n+    if workflow_id in WORKFLOW_DEFINITIONS or workflow_id in existing:\n+        workflow_id = f\"{workflow_id}_{uuid.uuid4().hex[:6]}\"\n+    policy = str(payload.get(\"policy\") or \"plan_execute\").strip()\n+    if policy not in {\"react\", \"plan_execute\", \"graph_harness\"}:\n+        policy = \"plan_execute\"\n+    tools = _list_from_text_or_array(\n+        payload.get(\"tools\"),\n+        fallback=[\"web_search\", \"web_fetch\", \"source_collect\", \"source_contract\", \"source_select\", \"query_memory\"],\n+    )\n+    input_fields = _list_from_text_or_array(payload.get(\"input_fields\"), fallback=[\"query\"])\n+    output_fields = _list_from_text_or_array(payload.get(\"output_fields\"), fallback=[\"summary\", \"sources\", \"unresolved\"])\n+    use_case = str(payload.get(\"use_case\") or payload.get(\"description\") or \"\").strip()\n+    steps = (\n+        WorkflowStepDefinition(\n+            id=\"intake\",\n+            label=\"Input\",\n+            kind=\"input\",\n+            description=\"Normalize external input into the workflow objective and constraints.\",\n+            consumes=(\"external_input\",),\n+            produces=(\"objective\", \"constraints\"),\n+        ),\n+        WorkflowStepDefinition(\n+            id=\"context\",\n+            label=\"Context\",\n+            kind=\"context\",\n+            description=\"Build a compact context ladder from active input, memory policy, and workflow contract.\",\n+            consumes=(\"objective\",),\n+            produces=(\"context_ladder\",),\n+            gates=(\"hide_stale_memory\",),\n+        ),\n+        WorkflowStepDefinition(\n+            id=\"plan\",\n+            label=\"Plan\",\n+            kind=\"prompt\",\n+            description=\"Select allowed tools and commit the next required action before execution.\",\n+            consumes=(\"context_ladder\",),\n+            produces=(\"plan\", \"next_required_action\"),\n+            gates=(\"allowed_tools_only\",),\n+        ),\n+        WorkflowStepDefinition(\n+            id=\"tools\",\n+            label=\"Tools\",\n+            kind=\"tool\",\n+            description=\"Execute allowed tools and store tool results as evidence references.\",\n+            consumes=(\"next_required_action\",),\n+            produces=(\"tool_results\", \"evidence_refs\"),\n+        ),\n+        WorkflowStepDefinition(\n+            id=\"verify\",\n+            label=\"Verify\",\n+            kind=\"verify\",\n+            description=\"Check completion gates and mark unresolved fields instead of guessing.\",\n+            consumes=(\"evidence_refs\",),\n+            produces=(\"verification\",),\n+            gates=(\"no_fake_evidence\",),\n+        ),\n+        WorkflowStepDefinition(\n+            id=\"response\",\n+            label=\"Response\",\n+            kind=\"response\",\n+            description=\"Return the configured output schema.\",\n+            consumes=(\"verification\",),\n+            produces=(\"result\",),\n+        ),\n+    )\n+    return WorkflowDefinition(\n+        id=workflow_id,\n+        label=label,\n+        description=use_case or \"Custom ShovsOS workflow.\",\n+        template=str(payload.get(\"template\") or \"custom_workflow_v1\"),\n+        policy=policy,\n+        ledger_mode=str(payload.get(\"ledger_mode\") or \"ledger_enforced\"),\n+        context_mode=str(payload.get(\"context_mode\") or \"ladder\"),\n+        prompt_version=str(payload.get(\"prompt_version\") or \"custom_contract_v1\"),\n+        risk_policy=str(payload.get(\"risk_policy\") or \"evidence_first\"),\n+        tools=tuple(tools),\n+        memory_policy={\n+            \"read\": [\"workflow_preferences\"],\n+            \"write\": str(payload.get(\"memory_write\") or \"explicit_user_preferences_only\"),\n+            \"provenance_required\": True,\n+        },\n+        input_schema={field: \"string\" for field in input_fields},\n+        output_schema={\"type\": _slugify_workflow_id(label).removesuffix(\"_v1\"), \"fields\": output_fields},\n+        steps=steps,\n+        tags=tuple([\"custom\", policy, *(str(payload.get(\"tags\") or \"\").split())]),\n+    )\n+\n+\n+def draft_workflow_from_prompt(prompt: str, *, existing_ids: set[str] | None = None) -> dict[str, Any]:\n+    \"\"\"Compile a natural-language workflow request into a draft contract.\n+\n+    This is deterministic on purpose. It gives the UI a reliable keynote path:\n+    the model can help later, but the platform can always turn common workflow\n+    requests into a typed ShovsOS contract without hallucinating tools.\n+    \"\"\"\n+\n+    text = re.sub(r\"\\s+\", \" \", str(prompt or \"\")).strip()\n+    lowered = text.lower()\n+    if not text:\n+        text = \"Create a workflow that gathers evidence and returns a concise answer.\"\n+        lowered = text.lower()\n+\n+    if any(term in lowered for term in (\"price\", \"buy\", \"shopping\", \"store\", \"costco\", \"walmart\", \"bestbuy\", \"best buy\", \"canadian tire\", \"dollarama\", \"shoppers\")):\n+        label = \"Best Buy Link Agent\"\n+        description = \"Compare stores or product pages and return the best practical buy option with source URLs.\"\n+        tools = [\"web_search\", \"web_fetch\", \"shopping_advice\", \"source_collect\", \"source_contract\", \"source_select\", \"source_coverage\", \"query_memory\"]\n+        input_fields = [\"product\", \"location\", \"stores\", \"budget\"]\n+        output_fields = [\"best_option\", \"buy_link\", \"price_notes\", \"tradeoffs\", \"source_urls\", \"unresolved\"]\n+        tags = \"shopping consumer comparison\"\n+        policy = \"plan_execute\"\n+        template = \"shopping_advisor_v1\"\n+        sample_input = {\n+            \"product\": _extract_after_terms(text, [\"buy\", \"find\", \"compare\", \"product\"]) or \"razr phone\",\n+            \"location\": _extract_location_hint(text) or \"Toronto\",\n+            \"stores\": _extract_store_hints(text) or [\"Costco\", \"Walmart\", \"Best Buy\"],\n+            \"budget\": _extract_budget_hint(text) or \"\",\n+        }\n+    elif any(term in lowered for term in (\"stock\", \"stocks\", \"ticker\", \"market\", \"movers\", \"alpha vantage\", \"finance\", \"tesla\", \"nvda\", \"earnings\")):\n+        label = \"Market Mover Brief Agent\"\n+        description = \"Use finance tools to lock tickers, gather quotes/news, and return a source-backed market brief.\"\n+        tools = [\"alpha_vantage_movers\", \"alpha_vantage_quote\", \"alpha_vantage_overview\", \"alpha_vantage_news\", \"finance_snapshot\", \"web_search\", \"web_fetch\"]\n+        input_fields = [\"query\", \"symbols\", \"date\"]\n+        output_fields = [\"summary\", \"movers\", \"news\", \"sources\", \"unresolved\"]\n+        tags = \"finance alpha_vantage evidence\"\n+        policy = \"plan_execute\"\n+        template = \"finance_analyst_v1\"\n+        sample_input = {\n+            \"query\": text,\n+            \"symbols\": _extract_symbol_hints(text),\n+            \"date\": \"\",\n+        }\n+    elif any(term in lowered for term in (\"image\", \"screenshot\", \"photo\", \"receipt\", \"ocr\", \"vision\", \"visible\")):\n+        label = \"Vision Inspection Agent\"\n+        description = \"Inspect attached images, extract visible details, and avoid claims about unseen content.\"\n+        tools = [\"query_memory\"]\n+        input_fields = [\"question\", \"image_count\", \"focus\"]\n+        output_fields = [\"answer\", \"visible_details\", \"visible_text\", \"uncertainties\", \"followups\"]\n+        tags = \"vision images ocr\"\n+        policy = \"react\"\n+        template = \"research_agent_v1\"\n+        sample_input = {\n+            \"question\": text,\n+            \"image_count\": 1,\n+            \"focus\": \"objects, text, and obvious issues\",\n+        }\n+    elif any(term in lowered for term in (\"code\", \"repo\", \"test\", \"bug\", \"patch\", \"fix\", \"file\")):\n+        label = \"Patch Eval Agent\"\n+        description = \"Inspect files, make scoped changes, run tests, and return evidence of the patch.\"\n+        tools = [\"file_view\", \"file_str_replace\", \"file_create\", \"bash\", \"query_memory\"]\n+        input_fields = [\"task\", \"workspace_path\", \"test_command\"]\n+        output_fields = [\"changed_files\", \"tests\", \"risks\", \"next_steps\"]\n+        tags = \"coding tests patch\"\n+        policy = \"graph_harness\"\n+        template = \"coding_agent_v1\"\n+        sample_input = {\"task\": text, \"workspace_path\": \"\", \"test_command\": \"\"}\n+    elif any(term in lowered for term in (\"memory\", \"fact\", \"remember\", \"preference\", \"contradiction\", \"void\", \"supersede\")):\n+        label = \"Memory Fact Guard Agent\"\n+        description = \"Inspect memory facts, demote conflicts, and commit only provenance-backed facts.\"\n+        tools = [\"query_memory\", \"store_memory\", \"shovs_memory_query\", \"shovs_memory_store\", \"shovs_memory_update\", \"shovs_memory_void\"]\n+        input_fields = [\"claim\", \"source\", \"owner_scope\"]\n+        output_fields = [\"current\", \"candidate\", \"superseded\", \"conflicts\", \"decision\"]\n+        tags = \"memory facts provenance\"\n+        policy = \"graph_harness\"\n+        template = \"memory_agent_v1\"\n+        sample_input = {\"claim\": text, \"source\": \"user_prompt\", \"owner_scope\": \"\"}\n+    else:\n+        label = \"Evidence Brief Agent\"\n+        description = \"Search, fetch, verify, and return a compact source-backed brief.\"\n+        tools = [\"web_search\", \"web_fetch\", \"source_collect\", \"source_contract\", \"source_select\", \"source_coverage\", \"query_memory\"]\n+        input_fields = [\"query\", \"source_count\", \"freshness\"]\n+        output_fields = [\"summary\", \"findings\", \"sources\", \"confidence\", \"unresolved\"]\n+        tags = \"research sources verification\"\n+        policy = \"plan_execute\"\n+        template = \"research_agent_v1\"\n+        sample_input = {\"query\": text, \"source_count\": 3, \"freshness\": \"recent\"}\n+\n+    definition = build_custom_workflow_definition(\n+        {\n+            \"label\": label,\n+            \"description\": description,\n+            \"policy\": policy,\n+            \"template\": template,\n+            \"tools\": tools,\n+            \"input_fields\": input_fields,\n+            \"output_fields\": output_fields,\n+            \"tags\": tags,\n+            \"ledger_mode\": \"ledger_enforced\",\n+            \"context_mode\": \"ladder\",\n+            \"risk_policy\": \"evidence_first\" if policy != \"react\" else \"standard\",\n+        },\n+        existing_ids=existing_ids,\n+    )\n+    workflow = definition.to_dict()\n+    return {\n+        \"prompt\": text,\n+        \"workflow\": workflow,\n+        \"suggested_input\": sample_input,\n+        \"actions\": [\n+            {\"label\": \"Create\", \"intent\": \"create_workflow\"},\n+            {\"label\": \"Test\", \"intent\": \"run_deterministic_contract\"},\n+            {\"label\": \"API\", \"intent\": \"copy_api_contract\"},\n+        ],\n+        \"evidence\": {\n+            \"compiler\": \"deterministic_workflow_draft_v1\",\n+            \"policy\": workflow[\"runtime\"][\"policy\"],\n+            \"ledger_mode\": workflow[\"runtime\"][\"ledger_mode\"],\n+            \"tools\": workflow[\"tools\"],\n+        },\n+    }\n+\n+\n+def _extract_after_terms(text: str, terms: list[str]) -> str:\n+    lowered = text.lower()\n+    for term in terms:\n+        idx = lowered.find(term)\n+        if idx >= 0:\n+            value = text[idx + len(term):].strip(\" :.-\")\n+            value = re.split(r\"\\b(?:near|in|at|under|below|from|across|with)\\b\", value, maxsplit=1, flags=re.IGNORECASE)[0]\n+            return value.strip(\" .,:;\")[:80]\n+    return \"\"\n+\n+\n+def _extract_location_hint(text: str) -> str:\n+    match = re.search(r\"\\b(?:near|in|around)\\s+([A-Za-z][A-Za-z\\s,.-]{1,60})\", text, re.IGNORECASE)\n+    if not match:\n+        return \"\"\n+    value = re.split(r\"\\b(?:under|below|from|at|with|and)\\b\", match.group(1), maxsplit=1, flags=re.IGNORECASE)[0]\n+    return value.strip(\" .,:;\")\n+\n+\n+def _extract_budget_hint(text: str) -> str:\n+    match = re.search(r\"\\b(?:under|below|less than)\\s+([$]?\\d+(?:\\.\\d{2})?\\s*(?:cad|usd|dollars?)?)\", text, re.IGNORECASE)\n+    return match.group(0).strip() if match else \"\"\n+\n+\n+def _extract_store_hints(text: str) -> list[str]:\n+    known = [\n+        (\"costco\", \"Costco\"),\n+        (\"walmart\", \"Walmart\"),\n+        (\"best buy\", \"Best Buy\"),\n+        (\"bestbuy\", \"Best Buy\"),\n+        (\"canadian tire\", \"Canadian Tire\"),\n+        (\"shoppers\", \"Shoppers Drug Mart\"),\n+        (\"metro\", \"Metro\"),\n+        (\"dollarama\", \"Dollarama\"),\n+    ]\n+    lowered = text.lower()\n+    stores = [label for key, label in known if key in lowered]\n+    return list(dict.fromkeys(stores))\n+\n+\n+def _extract_symbol_hints(text: str) -> list[str]:\n+    symbols = [\n+        token.upper()\n+        for token in re.findall(r\"\\b[A-Z]{1,5}\\b\", text)\n+        if token.upper() not in {\"API\", \"LLM\", \"AI\", \"USD\", \"CAD\"}\n+    ]\n+    common = {\n+        \"tesla\": \"TSLA\",\n+        \"nvidia\": \"NVDA\",\n+        \"apple\": \"AAPL\",\n+        \"microsoft\": \"MSFT\",\n+        \"airbnb\": \"ABNB\",\n+    }\n+    lowered = text.lower()\n+    symbols.extend(symbol for name, symbol in common.items() if name in lowered)\n+    return list(dict.fromkeys(symbols))\n+\n+\n+COMMON_SOURCE_STEPS = (\n+    WorkflowStepDefinition(\n+        id=\"intake\",\n+        label=\"Input\",\n+        kind=\"input\",\n+        description=\"Normalize the request into objective, location, entities, and constraints.\",\n+        consumes=(\"external_input\",),\n+        produces=(\"objective\", \"constraints\"),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"context\",\n+        label=\"Context Build\",\n+        kind=\"context\",\n+        description=\"Build the small context ladder: active objective, memory signal, contract, and evidence refs.\",\n+        consumes=(\"objective\", \"memory_policy\"),\n+        produces=(\"phase_packet\", \"context_ladder\"),\n+        gates=(\"hide_stale_memory\",),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"plan\",\n+        label=\"Plan\",\n+        kind=\"prompt\",\n+        description=\"Commit a source contract before acting: locked entities, required searches, required fetches.\",\n+        consumes=(\"phase_packet\",),\n+        produces=(\"source_contract\", \"next_required_action\"),\n+        gates=(\"entity_lock_required\",),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"tools\",\n+        label=\"Tools\",\n+        kind=\"tool\",\n+        description=\"Run only allowed tools and validate each call against the source contract.\",\n+        consumes=(\"next_required_action\",),\n+        produces=(\"tool_results\", \"evidence_refs\"),\n+        gates=(\"reject_off_contract_fetch\", \"reject_unlocked_entity_search\"),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"evidence\",\n+        label=\"Evidence\",\n+        kind=\"evidence\",\n+        description=\"Select successful tool results as evidence and record missing coverage explicitly.\",\n+        consumes=(\"tool_results\",),\n+        produces=(\"selected_evidence\", \"coverage_report\"),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"memory\",\n+        label=\"Memory\",\n+        kind=\"memory\",\n+        description=\"Read useful preferences and write only provenance-backed facts or candidates.\",\n+        consumes=(\"selected_evidence\", \"memory_policy\"),\n+        produces=(\"memory_writes\",),\n+        gates=(\"provenance_required\",),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"verify\",\n+        label=\"Verification\",\n+        kind=\"verify\",\n+        description=\"Block final response if required evidence or source coverage is missing.\",\n+        consumes=(\"selected_evidence\", \"coverage_report\"),\n+        produces=(\"verification\", \"completion_gate\"),\n+        gates=(\"no_final_with_missing_evidence\",),\n+    ),\n+    WorkflowStepDefinition(\n+        id=\"response\",\n+        label=\"Response\",\n+        kind=\"response\",\n+        description=\"Return the configured output schema with source IDs and unresolved slots.\",\n+        consumes=(\"verification\", \"selected_evidence\"),\n+        produces=(\"result\",),\n+    ),\n+)\n+\n+\n+WORKFLOW_DEFINITIONS: dict[str, WorkflowDefinition] = {\n+    \"research_brief_v1\": WorkflowDefinition(\n+        id=\"research_brief_v1\",\n+        label=\"Research Brief\",\n+        description=\"Evidence-first brief that searches, fetches, verifies, and reports source-backed findings.\",\n+        template=\"research_agent_v1\",\n+        policy=\"plan_execute\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"role_contracts_v1\",\n+        risk_policy=\"evidence_first\",\n+        tools=(\"web_search\", \"web_fetch\", \"source_collect\", \"source_contract\", \"source_select\", \"source_coverage\", \"query_memory\"),\n+        memory_policy={\"read\": [\"topic_preferences\"], \"write\": \"verified_facts_only\", \"provenance_required\": True},\n+        input_schema={\"query\": \"string\", \"source_count\": \"number\", \"freshness\": \"optional string\"},\n+        output_schema={\"type\": \"research_brief\", \"fields\": [\"summary\", \"findings\", \"sources\", \"confidence\", \"unresolved\"]},\n+        steps=COMMON_SOURCE_STEPS,\n+        tags=(\"research\", \"sources\", \"verification\"),\n+    ),\n+    \"shopping_comparison_v1\": WorkflowDefinition(\n+        id=\"shopping_comparison_v1\",\n+        label=\"Shopping Comparison\",\n+        description=\"Compare products or stores using locked entities, fetched source pages, and explicit tradeoffs.\",\n+        template=\"shopping_advisor_v1\",\n+        policy=\"plan_execute\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"shopping_patch_v1\",\n+        risk_policy=\"consumer_verified\",\n+        tools=(\"web_search\", \"web_fetch\", \"shopping_advice\", \"source_collect\", \"source_contract\", \"source_select\", \"source_coverage\", \"query_memory\"),\n+        memory_policy={\"read\": [\"location_preferences\", \"store_preferences\"], \"write\": \"explicit_user_preferences_only\", \"provenance_required\": True},\n+        input_schema={\"product\": \"string\", \"location\": \"optional string\", \"stores\": \"optional string[]\", \"budget\": \"optional string\"},\n+        output_schema={\"type\": \"comparison_table\", \"fields\": [\"option\", \"price\", \"match_quality\", \"rating\", \"source_urls\", \"recommendation\"]},\n+        steps=COMMON_SOURCE_STEPS,\n+        tags=(\"shopping\", \"consumer\", \"comparison\"),\n+    ),\n+    \"local_recommendation_v1\": WorkflowDefinition(\n+        id=\"local_recommendation_v1\",\n+        label=\"Local Recommendation\",\n+        description=\"Find local places, lock candidates, fetch review/menu/source pages, and summarize practical fit.\",\n+        template=\"research_agent_v1\",\n+        policy=\"plan_execute\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"role_contracts_v1\",\n+        risk_policy=\"consumer_verified\",\n+        tools=(\"web_search\", \"web_fetch\", \"source_collect\", \"source_contract\", \"source_select\", \"source_coverage\", \"query_memory\"),\n+        memory_policy={\"read\": [\"location_preferences\", \"taste_preferences\"], \"write\": \"explicit_user_preferences_only\", \"provenance_required\": True},\n+        input_schema={\"category\": \"string\", \"location\": \"string\", \"constraints\": \"optional string\"},\n+        output_schema={\"type\": \"ranked_local_options\", \"fields\": [\"place\", \"why\", \"best_for\", \"cautions\", \"source_urls\"]},\n+        steps=COMMON_SOURCE_STEPS,\n+        tags=(\"local\", \"places\", \"recommendation\"),\n+    ),\n+    \"vision_inspection_v1\": WorkflowDefinition(\n+        id=\"vision_inspection_v1\",\n+        label=\"Vision Inspection\",\n+        description=\"Analyze attached images with a vision-capable model, extract visible details, and answer a focused question.\",\n+        template=\"research_agent_v1\",\n+        policy=\"react\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"role_contracts_v1\",\n+        risk_policy=\"evidence_first\",\n+        tools=(\"query_memory\",),\n+        memory_policy={\"read\": [\"visual_preferences\"], \"write\": \"explicit_user_preferences_only\", \"provenance_required\": True},\n+        input_schema={\"question\": \"string\", \"images\": \"optional base64[]\", \"focus\": \"optional string\"},\n+        output_schema={\"type\": \"vision_inspection\", \"fields\": [\"answer\", \"visible_details\", \"visible_text\", \"uncertainties\", \"followups\"]},\n+        steps=(\n+            COMMON_SOURCE_STEPS[0],\n+            COMMON_SOURCE_STEPS[1],\n+            WorkflowStepDefinition(\n+                id=\"inspect\",\n+                label=\"Inspect Image\",\n+                kind=\"model\",\n+                description=\"Use a vision-capable model to inspect attached image content without inventing unseen details.\",\n+                consumes=(\"objective\", \"images\"),\n+                produces=(\"visual_observations\",),\n+                gates=(\"vision_model_required\", \"no_unseen_detail_claims\"),\n+            ),\n+            COMMON_SOURCE_STEPS[6],\n+            COMMON_SOURCE_STEPS[7],\n+        ),\n+        tags=(\"vision\", \"images\", \"inspection\"),\n+    ),\n+    \"memory_fact_guard_v1\": WorkflowDefinition(\n+        id=\"memory_fact_guard_v1\",\n+        label=\"Memory Fact Guard\",\n+        description=\"Inspect, dispute, demote, and commit memory facts with provenance and contradiction traces.\",\n+        template=\"memory_agent_v1\",\n+        policy=\"graph_harness\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"role_contracts_v1\",\n+        risk_policy=\"memory_strict\",\n+        tools=(\"query_memory\", \"store_memory\", \"shovs_memory_query\", \"shovs_memory_store\", \"shovs_list_loci\"),\n+        memory_policy={\"read\": [\"current_facts\", \"candidates\", \"disputes\"], \"write\": \"provenance_required\", \"provenance_required\": True},\n+        input_schema={\"claim\": \"string\", \"source\": \"optional string\", \"owner_scope\": \"optional string\"},\n+        output_schema={\"type\": \"memory_audit\", \"fields\": [\"current\", \"candidate\", \"superseded\", \"conflicts\", \"decision\"]},\n+        steps=(\n+            COMMON_SOURCE_STEPS[0],\n+            COMMON_SOURCE_STEPS[1],\n+            WorkflowStepDefinition(\n+                id=\"inspect\",\n+                label=\"Inspect Memory\",\n+                kind=\"memory\",\n+                description=\"Read current facts, candidates, and dispute traces before deciding.\",\n+                consumes=(\"claim\", \"memory_policy\"),\n+                produces=(\"memory_state\",),\n+            ),\n+            COMMON_SOURCE_STEPS[6],\n+            COMMON_SOURCE_STEPS[7],\n+        ),\n+        tags=(\"memory\", \"facts\", \"provenance\"),\n+    ),\n+    \"coding_patch_eval_v1\": WorkflowDefinition(\n+        id=\"coding_patch_eval_v1\",\n+        label=\"Coding Patch Eval\",\n+        description=\"Inspect files, make scoped changes, run tests, and return patch evidence.\",\n+        template=\"coding_agent_v1\",\n+        policy=\"graph_harness\",\n+        ledger_mode=\"ledger_enforced\",\n+        context_mode=\"ladder\",\n+        prompt_version=\"role_contracts_v1\",\n+        risk_policy=\"change_controlled\",\n+        tools=(\"file_view\", \"file_str_replace\", \"file_create\", \"bash\", \"query_memory\"),\n+        memory_policy={\"read\": [\"project_preferences\"], \"write\": \"explicit_project_lessons_only\", \"provenance_required\": True},\n+        input_schema={\"task\": \"string\", \"workspace_path\": \"optional string\", \"test_command\": \"optional string\"},\n+        output_schema={\"type\": \"patch_report\", \"fields\": [\"changed_files\", \"tests\", \"risks\", \"next_steps\"]},\n+        steps=(\n+            COMMON_SOURCE_STEPS[0],\n+            COMMON_SOURCE_STEPS[1],\n+            WorkflowStepDefinition(\n+                id=\"inspect\",\n+                label=\"Inspect Files\",\n+                kind=\"tool\",\n+                description=\"Read relevant files before editing.\",\n+                consumes=(\"objective\",),\n+                produces=(\"file_context\",),\n+                gates=(\"no_edit_before_inspect\",),\n+            ),\n+            WorkflowStepDefinition(\n+                id=\"patch\",\n+                label=\"Patch\",\n+                kind=\"tool\",\n+                description=\"Apply scoped file changes.\",\n+                consumes=(\"file_context\",),\n+                produces=(\"patch_artifacts\",),\n+            ),\n+            WorkflowStepDefinition(\n+                id=\"test\",\n+                label=\"Test\",\n+                kind=\"tool\",\n+                description=\"Run relevant verification commands and store outputs.\",\n+                consumes=(\"patch_artifacts\",),\n+                produces=(\"test_results\",),\n+            ),\n+            COMMON_SOURCE_STEPS[6],\n+            COMMON_SOURCE_STEPS[7],\n+        ),\n+        tags=(\"coding\", \"tests\", \"patch\"),\n+    ),\n+}\n+\n+\n+class WorkflowRunStore:\n+    def __init__(self, db_path: str = DEFAULT_WORKFLOW_RUNS_DB):\n+        self.db_path = str(Path(db_path))\n+        self._init_db()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        conn = sqlite3.connect(self.db_path)\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init_db(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS workflow_runs (\n+                    run_id TEXT PRIMARY KEY,\n+                    workflow_id TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    mode TEXT NOT NULL,\n+                    owner_id TEXT,\n+                    callback_url TEXT,\n+                    created_at TEXT NOT NULL,\n+                    updated_at TEXT NOT NULL,\n+                    error TEXT,\n+                    definition_json TEXT NOT NULL,\n+                    input_json TEXT NOT NULL,\n+                    result_json TEXT\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS workflow_events (\n+                    event_id TEXT PRIMARY KEY,\n+                    run_id TEXT NOT NULL,\n+                    event_index INTEGER NOT NULL,\n+                    event_type TEXT NOT NULL,\n+                    phase TEXT,\n+                    status TEXT,\n+                    summary TEXT,\n+                    created_at TEXT NOT NULL,\n+                    event_json TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_workflow_events_run_id ON workflow_events(run_id, event_index)\")\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_workflow_runs_owner_id ON workflow_runs(owner_id)\")\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS workflow_definitions (\n+                    workflow_id TEXT PRIMARY KEY,\n+                    owner_id TEXT,\n+                    created_at TEXT NOT NULL,\n+                    updated_at TEXT NOT NULL,\n+                    definition_json TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_workflow_definitions_owner_id ON workflow_definitions(owner_id)\")\n+            conn.commit()\n+\n+    def save_workflow_definition(self, definition: WorkflowDefinition, *, owner_id: str = \"\") -> dict[str, Any]:\n+        now = _now()\n+        existing = self.get_workflow_definition(definition.id)\n+        created_at = str((existing or {}).get(\"created_at\") or now)\n+        payload = definition.to_dict()\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT OR REPLACE INTO workflow_definitions\n+                (workflow_id, owner_id, created_at, updated_at, definition_json)\n+                VALUES (?, ?, ?, ?, ?)\n+                \"\"\",\n+                (definition.id, owner_id, created_at, now, _json_dumps(payload)),\n+            )\n+            conn.commit()\n+        return {\"created_at\": created_at, \"updated_at\": now, \"definition\": payload}\n+\n+    def list_workflow_definitions(self, *, owner_id: str = \"\") -> list[dict[str, Any]]:\n+        with self._connect() as conn:\n+            if owner_id:\n+                rows = conn.execute(\n+                    \"SELECT * FROM workflow_definitions WHERE owner_id IN ('', ?) ORDER BY created_at ASC\",\n+                    (owner_id,),\n+                ).fetchall()\n+            else:\n+                rows = conn.execute(\"SELECT * FROM workflow_definitions ORDER BY created_at ASC\").fetchall()\n+        definitions: list[dict[str, Any]] = []\n+        for row in rows:\n+            payload = _json_loads(row[\"definition_json\"], {})\n+            if isinstance(payload, dict):\n+                payload.setdefault(\"custom\", True)\n+                payload.setdefault(\"created_at\", row[\"created_at\"])\n+                payload.setdefault(\"updated_at\", row[\"updated_at\"])\n+                payload.setdefault(\"owner_id\", row[\"owner_id\"] or \"\")\n+                definitions.append(payload)\n+        return definitions\n+\n+    def get_workflow_definition(self, workflow_id: str) -> Optional[dict[str, Any]]:\n+        with self._connect() as conn:\n+            row = conn.execute(\"SELECT * FROM workflow_definitions WHERE workflow_id = ?\", (workflow_id,)).fetchone()\n+        if row is None:\n+            return None\n+        payload = _json_loads(row[\"definition_json\"], {})\n+        if not isinstance(payload, dict):\n+            return None\n+        payload.setdefault(\"custom\", True)\n+        payload.setdefault(\"created_at\", row[\"created_at\"])\n+        payload.setdefault(\"updated_at\", row[\"updated_at\"])\n+        payload.setdefault(\"owner_id\", row[\"owner_id\"] or \"\")\n+        return payload\n+\n+    def create_run(\n+        self,\n+        *,\n+        definition: WorkflowDefinition,\n+        input_payload: dict[str, Any],\n+        mode: str,\n+        owner_id: str = \"\",\n+        callback_url: str = \"\",\n+        status: str = \"created\",\n+        run_id: str = \"\",\n+    ) -> dict[str, Any]:\n+        now = _now()\n+        record = {\n+            \"run_id\": run_id or _id(\"wfr\"),\n+            \"workflow_id\": definition.id,\n+            \"status\": status,\n+            \"mode\": mode,\n+            \"owner_id\": owner_id,\n+            \"callback_url\": callback_url,\n+            \"created_at\": now,\n+            \"updated_at\": now,\n+            \"error\": \"\",\n+            \"definition\": definition.to_dict(),\n+            \"input\": deepcopy(input_payload),\n+            \"events\": [],\n+            \"result\": None,\n+        }\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT OR REPLACE INTO workflow_runs\n+                (run_id, workflow_id, status, mode, owner_id, callback_url, created_at, updated_at, error, definition_json, input_json, result_json)\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n+                \"\"\",\n+                (\n+                    record[\"run_id\"],\n+                    record[\"workflow_id\"],\n+                    record[\"status\"],\n+                    record[\"mode\"],\n+                    record[\"owner_id\"],\n+                    record[\"callback_url\"],\n+                    record[\"created_at\"],\n+                    record[\"updated_at\"],\n+                    record[\"error\"],\n+                    _json_dumps(record[\"definition\"]),\n+                    _json_dumps(record[\"input\"]),\n+                    None,\n+                ),\n+            )\n+            conn.commit()\n+        return record\n+\n+    def update_status(self, run_id: str, status: str, *, error: str = \"\") -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"UPDATE workflow_runs SET status = ?, updated_at = ?, error = ? WHERE run_id = ?\",\n+                (status, _now(), error, run_id),\n+            )\n+            conn.commit()\n+\n+    def append_event(self, run_id: str, event: dict[str, Any]) -> dict[str, Any]:\n+        event_payload = dict(event)\n+        event_payload.setdefault(\"id\", _id(\"wfe\"))\n+        event_payload.setdefault(\"run_id\", run_id)\n+        event_payload.setdefault(\"created_at\", _now())\n+        event_payload.setdefault(\"status\", \"info\")\n+        event_payload.setdefault(\"phase\", \"\")\n+        event_payload.setdefault(\"event_type\", \"workflow_event\")\n+        event_payload.setdefault(\"summary\", \"\")\n+        with self._connect() as conn:\n+            row = conn.execute(\"SELECT COALESCE(MAX(event_index), -1) + 1 AS idx FROM workflow_events WHERE run_id = ?\", (run_id,)).fetchone()\n+            event_index = int(row[\"idx\"] if row else 0)\n+            event_payload[\"index\"] = event_index\n+            conn.execute(\n+                \"\"\"\n+                INSERT INTO workflow_events\n+                (event_id, run_id, event_index, event_type, phase, status, summary, created_at, event_json)\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n+                \"\"\",\n+                (\n+                    str(event_payload[\"id\"]),\n+                    run_id,\n+                    event_index,\n+                    str(event_payload.get(\"event_type\") or \"\"),\n+                    str(event_payload.get(\"phase\") or \"\"),\n+                    str(event_payload.get(\"status\") or \"\"),\n+                    str(event_payload.get(\"summary\") or \"\"),\n+                    str(event_payload.get(\"created_at\") or _now()),\n+                    _json_dumps(event_payload),\n+                ),\n+            )\n+            conn.execute(\"UPDATE workflow_runs SET updated_at = ? WHERE run_id = ?\", (_now(), run_id))\n+            conn.commit()\n+        return event_payload\n+\n+    def set_result(self, run_id: str, result: dict[str, Any], *, status: str = \"completed\") -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"UPDATE workflow_runs SET result_json = ?, status = ?, updated_at = ?, error = '' WHERE run_id = ?\",\n+                (_json_dumps(result), status, _now(), run_id),\n+            )\n+            conn.commit()\n+\n+    def get_run(self, run_id: str) -> Optional[dict[str, Any]]:\n+        with self._connect() as conn:\n+            row = conn.execute(\"SELECT * FROM workflow_runs WHERE run_id = ?\", (run_id,)).fetchone()\n+            if row is None:\n+                return None\n+            record = dict(row)\n+        events = self.list_events(run_id)\n+        return {\n+            \"run_id\": record[\"run_id\"],\n+            \"workflow_id\": record[\"workflow_id\"],\n+            \"status\": record[\"status\"],\n+            \"mode\": record[\"mode\"],\n+            \"owner_id\": record.get(\"owner_id\") or \"\",\n+            \"callback_url\": record.get(\"callback_url\") or \"\",\n+            \"created_at\": record[\"created_at\"],\n+            \"updated_at\": record[\"updated_at\"],\n+            \"error\": record.get(\"error\") or \"\",\n+            \"definition\": _json_loads(record.get(\"definition_json\"), {}),\n+            \"input\": _json_loads(record.get(\"input_json\"), {}),\n+            \"events\": events,\n+            \"result\": _json_loads(record.get(\"result_json\"), None),\n+        }\n+\n+    def list_events(self, run_id: str) -> list[dict[str, Any]]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\n+                \"SELECT event_json FROM workflow_events WHERE run_id = ? ORDER BY event_index ASC\",\n+                (run_id,),\n+            ).fetchall()\n+        return [_json_loads(row[\"event_json\"], {}) for row in rows]\n+\n+\n+DEFAULT_WORKFLOW_RUN_STORE = WorkflowRunStore()\n+\n+\n+def list_workflow_definitions(*, store: WorkflowRunStore | None = None, owner_id: str = \"\") -> list[dict[str, Any]]:\n+    definitions = [definition.to_dict() for definition in WORKFLOW_DEFINITIONS.values()]\n+    if store is not None:\n+        known = {item[\"id\"] for item in definitions}\n+        for custom in store.list_workflow_definitions(owner_id=owner_id):\n+            if custom.get(\"id\") not in known:\n+                definitions.append(custom)\n+                known.add(str(custom.get(\"id\") or \"\"))\n+    return definitions\n+\n+\n+def get_workflow_definition(workflow_id: str, *, store: WorkflowRunStore | None = None) -> WorkflowDefinition:\n+    definition = WORKFLOW_DEFINITIONS.get(str(workflow_id or \"\").strip())\n+    if definition is not None:\n+        return definition\n+    if store is not None:\n+        custom = store.get_workflow_definition(str(workflow_id or \"\").strip())\n+        if custom:\n+            return _workflow_definition_from_dict(custom)\n+    raise KeyError(workflow_id)\n+\n+\n+def _compact_input(payload: dict[str, Any]) -> str:\n+    parts = []\n+    for key, value in payload.items():\n+        if value in (None, \"\", [], {}):\n+            continue\n+        rendered = \", \".join(str(item) for item in value[:4]) if isinstance(value, list) else str(value)\n+        parts.append(f\"{key}: {rendered}\")\n+    return \"; \".join(parts) or \"empty input\"\n+\n+\n+def _input_payload(payload: dict[str, Any]) -> dict[str, Any]:\n+    if isinstance(payload.get(\"input\"), dict):\n+        data = dict(payload.get(\"input\") or {})\n+    else:\n+        data = {\n+            key: value\n+            for key, value in payload.items()\n+            if key not in {\"owner_id\", \"callback_url\", \"mode\", \"session_id\", \"agent_id\", \"model\", \"images\", \"image_base64\"}\n+        }\n+    raw_images = _image_payload(payload, data)\n+    data.pop(\"images\", None)\n+    data.pop(\"image_base64\", None)\n+    if raw_images:\n+        data[\"image_count\"] = len(raw_images)\n+    return data\n+\n+\n+def _image_payload(payload: dict[str, Any], input_payload: dict[str, Any]) -> list[str]:\n+    candidates: Any = payload.get(\"images\")\n+    raw_input = payload.get(\"input\") if isinstance(payload.get(\"input\"), dict) else {}\n+    if candidates is None:\n+        candidates = raw_input.get(\"images\") or input_payload.get(\"images\")\n+    if candidates is None and (raw_input.get(\"image_base64\") or input_payload.get(\"image_base64\")):\n+        candidates = [raw_input.get(\"image_base64\") or input_payload.get(\"image_base64\")]\n+    if isinstance(candidates, str):\n+        candidates = [candidates]\n+    if not isinstance(candidates, list):\n+        return []\n+    return [str(item).strip() for item in candidates if str(item or \"\").strip()]\n+\n+\n+def _workflow_event(\n+    *,\n+    run_id: str,\n+    workflow_id: str,\n+    phase: str,\n+    event_type: str,\n+    status: str,\n+    summary: str,\n+    data: Optional[dict[str, Any]] = None,\n+) -> dict[str, Any]:\n+    return {\n+        \"id\": _id(\"wfe\"),\n+        \"run_id\": run_id,\n+        \"workflow_id\": workflow_id,\n+        \"phase\": phase,\n+        \"event_type\": event_type,\n+        \"status\": status,\n+        \"created_at\": _now(),\n+        \"summary\": summary,\n+        \"data\": dict(data or {}),\n+    }\n+\n+\n+def _build_workflow_events(\n+    definition: WorkflowDefinition,\n+    run_id: str,\n+    payload: dict[str, Any],\n+    *,\n+    contract_snapshot: Optional[dict[str, Any]] = None,\n+) -> list[dict[str, Any]]:\n+    events: list[dict[str, Any]] = []\n+    objective = _compact_input(payload)\n+    for index, step in enumerate(definition.steps):\n+        status = \"success\"\n+        summary = step.description\n+        data: dict[str, Any] = {\n+            \"step_id\": step.id,\n+            \"step_label\": step.label,\n+            \"kind\": step.kind,\n+            \"consumes\": list(step.consumes),\n+            \"produces\": list(step.produces),\n+            \"gates\": list(step.gates),\n+        }\n+        if step.id == \"intake\":\n+            summary = f\"Accepted input: {objective}\"\n+            data[\"input\"] = deepcopy(payload)\n+        elif step.id == \"plan\":\n+            summary = f\"Selected {definition.policy} with {definition.ledger_mode}.\"\n+            data[\"policy\"] = definition.policy\n+            data[\"ledger_mode\"] = definition.ledger_mode\n+            if contract_snapshot:\n+                data[\"execution_contract\"] = deepcopy(contract_snapshot.get(\"execution_contract\") or {})\n+                data[\"next_required_action\"] = deepcopy(contract_snapshot.get(\"next_required_action\") or {})\n+                data[\"completion_gate\"] = deepcopy(contract_snapshot.get(\"completion_gate\") or {})\n+        elif step.id == \"tools\":\n+            summary = f\"Allowed tools: {', '.join(definition.tools[:6])}.\"\n+            data[\"allowed_tools\"] = list(definition.tools)\n+        elif step.id == \"memory\":\n+            summary = \"Memory reads/writes are governed by the workflow memory policy.\"\n+            data[\"memory_policy\"] = deepcopy(definition.memory_policy)\n+        elif step.id == \"verify\":\n+            summary = \"Completion gate requires produced outputs and policy checks before response.\"\n+            data[\"completion_gate\"] = {\"final_answer_allowed\": True, \"reason\": \"deterministic_workflow_contract_satisfied\"}\n+        event = _workflow_event(\n+            run_id=run_id,\n+            workflow_id=definition.id,\n+            phase=step.id,\n+            event_type=f\"workflow_{step.kind}\",\n+            status=status,\n+            summary=summary,\n+            data=data,\n+        )\n+        event[\"index\"] = index\n+        events.append(event)\n+    if contract_snapshot:\n+        contract_event = _workflow_event(\n+            run_id=run_id,\n+            workflow_id=definition.id,\n+            phase=\"contract\",\n+            event_type=\"workflow_execution_contract\",\n+            status=\"ready\",\n+            summary=\"Compiled Agent Language and Execution Contract for this workflow run.\",\n+            data={\n+                \"run_map\": deepcopy(contract_snapshot),\n+                \"execution_contract\": deepcopy(contract_snapshot.get(\"execution_contract\") or {}),\n+                \"next_required_action\": deepcopy(contract_snapshot.get(\"next_required_action\") or {}),\n+                \"completion_gate\": deepcopy(contract_snapshot.get(\"completion_gate\") or {}),\n+            },\n+        )\n+        contract_event[\"index\"] = len(events)\n+        events.append(contract_event)\n+    return events\n+\n+\n+def _build_workflow_result(\n+    definition: WorkflowDefinition,\n+    run_id: str,\n+    payload: dict[str, Any],\n+    events: list[dict[str, Any]],\n+    *,\n+    final_text: str = \"\",\n+    run_engine_run_id: str = \"\",\n+    session_id: str = \"\",\n+    contract_snapshot: Optional[dict[str, Any]] = None,\n+) -> dict[str, Any]:\n+    output_fields = list(definition.output_schema.get(\"fields\") or [])\n+    live = bool(run_engine_run_id or final_text)\n+    fields = {}\n+    for field in output_fields:\n+        if field in {\"summary\", \"recommendation\", \"decision\", \"next_steps\"} and final_text:\n+            fields[field] = {\"status\": \"ready\", \"value\": final_text}\n+        elif live:\n+            fields[field] = {\"status\": \"not_recorded\", \"value\": \"not recorded by live run output parser\"}\n+        else:\n+            fields[field] = {\n+                \"status\": \"not_recorded\",\n+                \"value\": \"not recorded in deterministic contract preview\",\n+            }\n+    return {\n+        \"run_id\": run_id,\n+        \"workflow_id\": definition.id,\n+        \"status\": \"completed\",\n+        \"output_schema\": deepcopy(definition.output_schema),\n+        \"summary\": final_text.strip() or f\"{definition.label} completed through {len(events)} typed steps.\",\n+        \"fields\": fields,\n+        \"api_contract\": {\n+            \"start\": f\"POST /workflow-lab/workflows/{definition.id}/runs\",\n+            \"status\": f\"GET /workflow-lab/runs/{run_id}\",\n+            \"events\": f\"GET /workflow-lab/runs/{run_id}/events\",\n+            \"result\": f\"GET /workflow-lab/runs/{run_id}/result\",\n+        },\n+        \"input_echo\": deepcopy(payload),\n+        \"run_engine_run_id\": run_engine_run_id,\n+        \"session_id\": session_id,\n+        \"trace_summary\": {\n+            \"event_count\": len(events),\n+            \"policy\": definition.policy,\n+            \"ledger_mode\": definition.ledger_mode,\n+            \"tools\": list(definition.tools),\n+            \"live_run_engine\": live,\n+        },\n+        \"contract_snapshot\": deepcopy(contract_snapshot or {}),\n+    }\n+\n+\n+def start_workflow_run(\n+    workflow_id: str,\n+    payload: dict[str, Any],\n+    *,\n+    store: WorkflowRunStore | None = None,\n+    status: str = \"completed\",\n+) -> dict[str, Any]:\n+    store = store or DEFAULT_WORKFLOW_RUN_STORE\n+    definition = get_workflow_definition(workflow_id, store=store)\n+    input_payload = _input_payload(payload)\n+    mode = str(payload.get(\"mode\") or \"deterministic_contract\")\n+    record = store.create_run(\n+        definition=definition,\n+        input_payload=input_payload,\n+        mode=mode,\n+        owner_id=str(payload.get(\"owner_id\") or \"\"),\n+        callback_url=str(payload.get(\"callback_url\") or \"\"),\n+        status=\"running\" if status == \"completed\" else status,\n+    )\n+    contract_snapshot = _workflow_contract_snapshot(definition, record[\"run_id\"], input_payload)\n+    events = _build_workflow_events(\n+        definition,\n+        record[\"run_id\"],\n+        input_payload,\n+        contract_snapshot=contract_snapshot,\n+    )\n+    for event in events:\n+        store.append_event(record[\"run_id\"], event)\n+    if status == \"completed\":\n+        result = _build_workflow_result(\n+            definition,\n+            record[\"run_id\"],\n+            input_payload,\n+            events,\n+            contract_snapshot=contract_snapshot,\n+        )\n+        store.set_result(record[\"run_id\"], result, status=\"completed\")\n+    else:\n+        store.update_status(record[\"run_id\"], status)\n+    return store.get_run(record[\"run_id\"]) or record\n+\n+\n+def workflow_catalog(*, store: WorkflowRunStore | None = None, owner_id: str = \"\") -> dict[str, Any]:\n+    return {\n+        \"title\": \"Workflow Lab\",\n+        \"subtitle\": \"Compose ShovsOS features into typed agent workflows that external apps can run.\",\n+        \"workflows\": list_workflow_definitions(store=store, owner_id=owner_id),\n+        \"lifecycle\": [\"created\", \"queued\", \"running\", \"waiting\", \"failed\", \"completed\"],\n+        \"run_modes\": [\"deterministic_contract\", \"live_run_engine\"],\n+        \"api\": {\n+            \"list\": \"GET /workflow-lab/catalog\",\n+            \"start\": \"POST /workflow-lab/workflows/{workflow_id}/runs\",\n+            \"status\": \"GET /workflow-lab/runs/{run_id}\",\n+            \"events\": \"GET /workflow-lab/runs/{run_id}/events\",\n+            \"result\": \"GET /workflow-lab/runs/{run_id}/result\",\n+        },\n+        \"legal_usage\": [\n+            \"Use workflows as automation and decision-support, not regulated final decisions without human review.\",\n+            \"Do not store sensitive personal data unless the workflow memory policy explicitly allows it.\",\n+            \"Third-party source content must keep attribution through source URLs or evidence IDs.\",\n+            \"If required evidence is not recorded, clients should display not recorded instead of guessing.\",\n+        ],\n+    }\n+\n+\n+def _workflow_objective(definition: WorkflowDefinition, payload: dict[str, Any]) -> str:\n+    return (\n+        f\"Run workflow {definition.id} ({definition.label}). \"\n+        f\"Use the workflow contract, allowed tools, memory policy, and completion gates. \"\n+        f\"Input JSON: {_json_dumps(payload)}\"\n+    )\n+\n+\n+def _workflow_contract_snapshot(\n+    definition: WorkflowDefinition,\n+    run_id: str,\n+    payload: dict[str, Any],\n+) -> dict[str, Any]:\n+    objective = _workflow_objective(definition, payload)\n+    ledger = RunLedger(\n+        run_id=run_id,\n+        session_id=f\"workflow-{run_id}\",\n+        turn_id=f\"{run_id}-turn-1\",\n+        objective=objective,\n+        allowed_tools=list(definition.tools),\n+        ledger_mode=definition.ledger_mode,\n+        phase=\"intake\",\n+    )\n+    ledger.set_control_policy(\n+        resolve_control_policy(\n+            objective,\n+            requested=definition.policy,\n+            risk_policy=definition.risk_policy,\n+            allowed_tools=list(definition.tools),\n+        ),\n+        source=\"workflow_lab\",\n+    )\n+    execution_contract = ledger.execution_contract()\n+    program = execution_contract.agent_language\n+    if program and program.workflow_shape == \"source_collection\":\n+        discover_step = next((step for step in program.steps if step.tool == \"web_search\"), None)\n+        if discover_step is not None:\n+            ledger.set_source_contract(\n+                {\n+                    \"workflow_shape\": program.workflow_shape,\n+                    \"entity_type\": program.entity_type,\n+                    \"entity_count\": program.entity_count,\n+                    \"urls_per_entity\": program.urls_per_entity,\n+                    \"total_urls\": program.total_fetches,\n+                    \"total_fetches\": program.total_fetches,\n+                    \"next_tool\": \"web_search\",\n+                    \"next_arguments\": dict(discover_step.arguments or {}),\n+                    \"next_reason\": \"agent_language_discover_entities\",\n+                    \"missing_slots\": [\"discover_entities\"],\n+                    \"forbid_unlocked_entity_drift\": True,\n+                    \"compiled_from\": \"agent_language\",\n+                },\n+                source=\"workflow_lab\",\n+            )\n+    ledger.append_event(\n+        \"workflow_contract_snapshot\",\n+        source=\"workflow_lab\",\n+        status=\"ready\",\n+        data={\n+            \"workflow_id\": definition.id,\n+            \"mode\": \"deterministic_contract\",\n+            \"input_keys\": sorted(payload.keys()),\n+        },\n+    )\n+    return ledger.to_phase_packet(\"plan\")\n+\n+\n+def _agent_id_for_definition(definition: WorkflowDefinition, requested: str = \"\") -> str:\n+    if requested:\n+        return requested\n+    return {\n+        \"shopping_advisor_v1\": \"shopping-advisor\",\n+        \"research_agent_v1\": \"researcher\",\n+        \"coding_agent_v1\": \"coder\",\n+        \"memory_agent_v1\": \"default\",\n+    }.get(definition.template, \"default\")\n+\n+\n+def _event_from_run_engine(\n+    *,\n+    run_id: str,\n+    workflow_id: str,\n+    raw: dict[str, Any],\n+    token_index: int,\n+) -> dict[str, Any]:\n+    raw_type = str(raw.get(\"type\") or raw.get(\"event_type\") or \"event\")\n+    status = \"success\"\n+    phase = str(raw.get(\"phase\") or raw_type)\n+    summary = raw_type.replace(\"_\", \" \")\n+    if raw_type == \"token\":\n+        summary = \"Received answer token.\"\n+        phase = \"response\"\n+    elif raw_type == \"tool_call\":\n+        summary = f\"Tool call: {raw.get('tool') or raw.get('tool_name') or 'tool'}\"\n+        phase = \"tools\"\n+    elif raw_type == \"tool_result\":\n+        summary = f\"Tool result: {raw.get('tool') or raw.get('tool_name') or 'tool'}\"\n+        phase = \"tools\"\n+    elif raw_type == \"done\":\n+        summary = \"RunEngine completed.\"\n+        phase = \"response\"\n+    elif raw_type == \"error\":\n+        summary = str(raw.get(\"message\") or \"RunEngine error\")\n+        phase = \"error\"\n+        status = \"error\"\n+    return _workflow_event(\n+        run_id=run_id,\n+        workflow_id=workflow_id,\n+        phase=phase,\n+        event_type=f\"run_engine_{raw_type}\",\n+        status=status,\n+        summary=summary if raw_type != \"token\" else f\"Received answer token {token_index}.\",\n+        data={\"raw\": raw},\n+    )\n+\n+\n+async def execute_live_workflow_run(\n+    *,\n+    run_id: str,\n+    store: WorkflowRunStore,\n+    run_engine: Any,\n+    definition: WorkflowDefinition,\n+    input_payload: dict[str, Any],\n+    owner_id: str = \"\",\n+    session_id: str = \"\",\n+    agent_id: str = \"\",\n+    model: str = \"\",\n+    system_prompt: str = \"\",\n+    max_tool_calls: Optional[int] = None,\n+    max_turns: Optional[int] = None,\n+    images: Optional[list[str]] = None,\n+) -> None:\n+    if run_engine is None:\n+        store.update_status(run_id, \"failed\", error=\"live_run_engine mode requires RunEngine\")\n+        store.append_event(\n+            run_id,\n+            _workflow_event(\n+                run_id=run_id,\n+                workflow_id=definition.id,\n+                phase=\"runtime\",\n+                event_type=\"workflow_runtime_missing\",\n+                status=\"error\",\n+                summary=\"RunEngine dependency was not available.\",\n+            ),\n+        )\n+        return\n+    contract_snapshot = _workflow_contract_snapshot(definition, run_id, input_payload)\n+    store.update_status(run_id, \"running\")\n+    store.append_event(\n+        run_id,\n+        _workflow_event(\n+            run_id=run_id,\n+            workflow_id=definition.id,\n+            phase=\"contract\",\n+            event_type=\"workflow_execution_contract\",\n+            status=\"ready\",\n+            summary=\"Compiled Agent Language and Execution Contract for this workflow run.\",\n+            data={\n+                \"run_map\": deepcopy(contract_snapshot),\n+                \"execution_contract\": deepcopy(contract_snapshot.get(\"execution_contract\") or {}),\n+                \"next_required_action\": deepcopy(contract_snapshot.get(\"next_required_action\") or {}),\n+                \"completion_gate\": deepcopy(contract_snapshot.get(\"completion_gate\") or {}),\n+            },\n+        ),\n+    )\n+    store.append_event(\n+        run_id,\n+        _workflow_event(\n+            run_id=run_id,\n+            workflow_id=definition.id,\n+            phase=\"runtime\",\n+            event_type=\"workflow_live_run_started\",\n+            status=\"running\",\n+            summary=\"Live RunEngine execution started.\",\n+            data={\"policy\": definition.policy, \"ledger_mode\": definition.ledger_mode},\n+        ),\n+    )\n+    final_text = \"\"\n+    run_engine_run_id = \"\"\n+    effective_session_id = session_id or f\"workflow-{run_id}\"\n+    try:\n+        request = RunEngineRequest(\n+            session_id=effective_session_id,\n+            owner_id=owner_id,\n+            agent_id=_agent_id_for_definition(definition, agent_id),\n+            user_message=_workflow_objective(definition, input_payload),\n+            model=model or \"llama3.2\",\n+            system_prompt=system_prompt,\n+            context_mode=\"v3\" if definition.context_mode == \"ladder\" else definition.context_mode,\n+            allowed_tools=tuple(definition.tools),\n+            use_planner=True,\n+            max_tool_calls=max_tool_calls,\n+            max_turns=max_turns,\n+            workflow_template=definition.template,\n+            prompt_version=definition.prompt_version,\n+            risk_policy=definition.risk_policy,\n+            ledger_mode=definition.ledger_mode,\n+            control_policy=definition.policy,\n+            images=images or None,\n+        )\n+        token_index = 0\n+        async for raw in run_engine.stream(request):\n+            if not isinstance(raw, dict):\n+                continue\n+            raw_type = str(raw.get(\"type\") or \"\")\n+            if raw_type == \"token\":\n+                token_index += 1\n+                final_text += str(raw.get(\"content\") or \"\")\n+                if token_index > 25 and token_index % 20 != 0:\n+                    continue\n+            if raw_type == \"session\":\n+                effective_session_id = str(raw.get(\"session_id\") or effective_session_id)\n+                run_engine_run_id = str(raw.get(\"run_id\") or run_engine_run_id)\n+            if raw_type == \"done\":\n+                run_engine_run_id = str(raw.get(\"run_id\") or run_engine_run_id)\n+                effective_session_id = str(raw.get(\"session_id\") or effective_session_id)\n+            store.append_event(\n+                run_id,\n+                _event_from_run_engine(\n+                    run_id=run_id,\n+                    workflow_id=definition.id,\n+                    raw=raw,\n+                    token_index=token_index,\n+                ),\n+            )\n+        events = store.list_events(run_id)\n+        result = _build_workflow_result(\n+            definition,\n+            run_id,\n+            input_payload,\n+            events,\n+            final_text=final_text,\n+            run_engine_run_id=run_engine_run_id,\n+            session_id=effective_session_id,\n+            contract_snapshot=contract_snapshot,\n+        )\n+        store.set_result(run_id, result, status=\"completed\")\n+        store.append_event(\n+            run_id,\n+            _workflow_event(\n+                run_id=run_id,\n+                workflow_id=definition.id,\n+                phase=\"runtime\",\n+                event_type=\"workflow_live_run_completed\",\n+                status=\"success\",\n+                summary=\"Live RunEngine execution completed.\",\n+                data={\"run_engine_run_id\": run_engine_run_id, \"session_id\": effective_session_id},\n+            ),\n+        )\n+    except asyncio.CancelledError:\n+        store.update_status(run_id, \"failed\", error=\"workflow run cancelled\")\n+        raise\n+    except Exception as exc:\n+        store.update_status(run_id, \"failed\", error=str(exc))\n+        store.append_event(\n+            run_id,\n+            _workflow_event(\n+                run_id=run_id,\n+                workflow_id=definition.id,\n+                phase=\"runtime\",\n+                event_type=\"workflow_live_run_failed\",\n+                status=\"error\",\n+                summary=str(exc),\n+            ),\n+        )\n+\n+\n+def _run_summary(record: dict[str, Any]) -> dict[str, Any]:\n+    return {\n+        \"run_id\": record[\"run_id\"],\n+        \"workflow_id\": record[\"workflow_id\"],\n+        \"status\": record[\"status\"],\n+        \"mode\": record[\"mode\"],\n+        \"created_at\": record[\"created_at\"],\n+        \"updated_at\": record[\"updated_at\"],\n+        \"event_count\": len(record.get(\"events\") or []),\n+        \"result_ready\": bool(record.get(\"result\")),\n+        \"error\": record.get(\"error\") or \"\",\n+        \"definition\": record[\"definition\"],\n+    }\n+\n+\n+def make_workflow_lab_router(\n+    *,\n+    run_engine: Any = None,\n+    profile_manager: Any = None,\n+    store: WorkflowRunStore | None = None,\n+    default_model: str = \"llama3.2\",\n+) -> APIRouter:\n+    store = store or DEFAULT_WORKFLOW_RUN_STORE\n+    router = APIRouter(prefix=\"/workflow-lab\", tags=[\"workflow-lab\"])\n+\n+    @router.get(\"/catalog\")\n+    async def catalog(owner_id: str = \"\"):\n+        return workflow_catalog(store=store, owner_id=owner_id)\n+\n+    @router.post(\"/draft\")\n+    async def draft_workflow(payload: dict[str, Any] = Body(default_factory=dict)):\n+        payload = payload or {}\n+        owner_id = str(payload.get(\"owner_id\") or \"\")\n+        prompt = str(payload.get(\"prompt\") or payload.get(\"message\") or payload.get(\"query\") or \"\")\n+        existing_ids = {item.get(\"id\") for item in list_workflow_definitions(store=store, owner_id=owner_id)}\n+        draft = draft_workflow_from_prompt(prompt, existing_ids={str(item) for item in existing_ids if item})\n+        return draft\n+\n+    @router.post(\"/workflows\")\n+    async def create_workflow(payload: dict[str, Any] = Body(default_factory=dict)):\n+        payload = payload or {}\n+        existing_ids = {item.get(\"id\") for item in list_workflow_definitions(store=store)}\n+        definition = build_custom_workflow_definition(payload, existing_ids={str(item) for item in existing_ids if item})\n+        owner_id = str(payload.get(\"owner_id\") or \"\")\n+        saved = store.save_workflow_definition(definition, owner_id=owner_id)\n+        workflow_payload = dict(saved[\"definition\"])\n+        workflow_payload[\"custom\"] = True\n+        return {\n+            \"workflow\": workflow_payload,\n+            \"created_at\": saved[\"created_at\"],\n+            \"updated_at\": saved[\"updated_at\"],\n+            \"detail_url\": f\"/workflow-lab/workflows/{definition.id}\",\n+            \"run_url\": f\"/workflow-lab/workflows/{definition.id}/runs\",\n+        }\n+\n+    @router.get(\"/workflows/{workflow_id}\")\n+    async def workflow_detail(workflow_id: str):\n+        try:\n+            return get_workflow_definition(workflow_id, store=store).to_dict()\n+        except KeyError:\n+            raise HTTPException(status_code=404, detail=\"Workflow not found\")\n+\n+    @router.post(\"/workflows/{workflow_id}/runs\")\n+    async def create_run(\n+        workflow_id: str,\n+        background_tasks: BackgroundTasks,\n+        payload: dict[str, Any] = Body(default_factory=dict),\n+    ):\n+        try:\n+            definition = get_workflow_definition(workflow_id, store=store)\n+        except KeyError:\n+            raise HTTPException(status_code=404, detail=\"Workflow not found\")\n+        payload = payload or {}\n+        mode = str(payload.get(\"mode\") or \"deterministic_contract\")\n+        owner_id = str(payload.get(\"owner_id\") or \"\")\n+        callback_url = str(payload.get(\"callback_url\") or \"\")\n+        input_payload = _input_payload(payload)\n+        images = _image_payload(payload, input_payload)\n+        if mode == \"live_run_engine\":\n+            record = store.create_run(\n+                definition=definition,\n+                input_payload=input_payload,\n+                mode=mode,\n+                owner_id=owner_id,\n+                callback_url=callback_url,\n+                status=\"queued\",\n+            )\n+            profile = None\n+            agent_id = _agent_id_for_definition(definition, str(payload.get(\"agent_id\") or \"\"))\n+            if profile_manager is not None:\n+                try:\n+                    profile = profile_manager.get(agent_id, owner_id=owner_id) or profile_manager.get(\"default\", owner_id=owner_id)\n+                except Exception:\n+                    profile = None\n+            background_tasks.add_task(\n+                execute_live_workflow_run,\n+                run_id=record[\"run_id\"],\n+                store=store,\n+                run_engine=run_engine,\n+                definition=definition,\n+                input_payload=input_payload,\n+                owner_id=owner_id,\n+                session_id=str(payload.get(\"session_id\") or \"\"),\n+                agent_id=agent_id,\n+                model=str(payload.get(\"model\") or getattr(profile, \"model\", None) or default_model or \"llama3.2\"),\n+                system_prompt=str(payload.get(\"system_prompt\") or getattr(profile, \"system_prompt\", \"\") or definition.description),\n+                max_tool_calls=payload.get(\"max_tool_calls\") if isinstance(payload.get(\"max_tool_calls\"), int) else None,\n+                max_turns=payload.get(\"max_turns\") if isinstance(payload.get(\"max_turns\"), int) else None,\n+                images=images,\n+            )\n+            record = store.get_run(record[\"run_id\"]) or record\n+        else:\n+            record = start_workflow_run(workflow_id, payload, store=store)\n+        return {\n+            \"run_id\": record[\"run_id\"],\n+            \"workflow_id\": record[\"workflow_id\"],\n+            \"status\": record[\"status\"],\n+            \"mode\": record[\"mode\"],\n+            \"created_at\": record[\"created_at\"],\n+            \"status_url\": f\"/workflow-lab/runs/{record['run_id']}\",\n+            \"events_url\": f\"/workflow-lab/runs/{record['run_id']}/events\",\n+            \"result_url\": f\"/workflow-lab/runs/{record['run_id']}/result\",\n+        }\n+\n+    @router.get(\"/runs/{run_id}\")\n+    async def run_status(run_id: str):\n+        record = store.get_run(run_id)\n+        if not record:\n+            raise HTTPException(status_code=404, detail=\"Workflow run not found\")\n+        return _run_summary(record)\n+\n+    @router.get(\"/runs/{run_id}/events\")\n+    async def run_events(run_id: str):\n+        record = store.get_run(run_id)\n+        if not record:\n+            raise HTTPException(status_code=404, detail=\"Workflow run not found\")\n+        return {\"run_id\": run_id, \"events\": record.get(\"events\") or []}\n+\n+    @router.get(\"/runs/{run_id}/result\")\n+    async def run_result(run_id: str):\n+        record = store.get_run(run_id)\n+        if not record:\n+            raise HTTPException(status_code=404, detail=\"Workflow run not found\")\n+        if not record.get(\"result\"):\n+            raise HTTPException(status_code=409, detail=\"Workflow result is not ready\")\n+        return record[\"result\"]\n+\n+    return router"},{"sha":"e14c83c38b31571d2b46c92bd6564f5964b9ef94","filename":"config/config.py","status":"modified","additions":23,"deletions":4,"changes":27,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/config%2Fconfig.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/config%2Fconfig.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/config%2Fconfig.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -11,16 +11,30 @@\n \n import os\n from dataclasses import dataclass, field\n+from pathlib import Path\n from dotenv import load_dotenv\n \n load_dotenv()\n \n \n+PROJECT_ROOT = Path(__file__).resolve().parent.parent\n+\n+\n+def _project_path_env(name: str, default: str) -> str:\n+    raw = os.getenv(name, default)\n+    path = Path(raw).expanduser()\n+    if path.is_absolute():\n+        return str(path)\n+    return str((PROJECT_ROOT / path).resolve())\n+\n+\n @dataclass\n class Config:\n     # ── LLM Models ────────────────────────────────────────────────────────\n     LLM_PROVIDER: str = os.getenv(\"LLM_PROVIDER\", \"auto\")  # auto|ollama|openai|groq|gemini\n     DEFAULT_MODEL: str = os.getenv(\"DEFAULT_MODEL\", \"qwen2.5-coder:latest\")\n+    VISION_MODEL: str = os.getenv(\"VISION_MODEL\", \"\")\n+    IMAGE_GENERATION_MODEL: str = os.getenv(\"IMAGE_GENERATION_MODEL\", \"gpt-image-1\")\n     \n     # Provider-Specific Fallbacks\n     OLLAMA_DEFAULT_MODEL: str = os.getenv(\"OLLAMA_DEFAULT_MODEL\", \"qwen2.5-coder:latest\")\n@@ -48,9 +62,14 @@ class Config:\n     MAX_SESSIONS: int = int(os.getenv(\"MAX_SESSIONS\", \"200\"))\n \n     # ── Database ──────────────────────────────────────────────────────────\n-    SESSIONS_DB: str = os.getenv(\"SESSIONS_DB\", \"sessions.db\")\n-    AGENTS_DB: str = os.getenv(\"AGENTS_DB\", \"agents.db\")\n-    CHROMA_DB_PATH: str = os.getenv(\"CHROMA_DB_PATH\", \"./chroma_db\")\n+    PROJECT_ROOT: str = str(PROJECT_ROOT)\n+    SESSIONS_DB: str = _project_path_env(\"SESSIONS_DB\", \"sessions.db\")\n+    AGENTS_DB: str = _project_path_env(\"AGENTS_DB\", \"agents.db\")\n+    RUNS_DB: str = _project_path_env(\"RUNS_DB\", \"runs.db\")\n+    MEMORY_GRAPH_DB: str = _project_path_env(\"MEMORY_GRAPH_DB\", \"memory_graph.db\")\n+    TOOL_RESULTS_DB: str = _project_path_env(\"TOOL_RESULTS_DB\", \"tool_results.db\")\n+    SESSION_TASKS_DB: str = _project_path_env(\"SESSION_TASKS_DB\", \"session_tasks.db\")\n+    CHROMA_DB_PATH: str = _project_path_env(\"CHROMA_DB_PATH\", \"./chroma_db\")\n     EMBED_MODEL: str = os.getenv(\"EMBED_MODEL\", \"qwen3-embedding:latest\")\n     EMBEDDING_HTTP_TIMEOUT: float = float(os.getenv(\"EMBEDDING_HTTP_TIMEOUT\", \"20\"))\n     EMBEDDING_HTTP_RETRIES: int = int(os.getenv(\"EMBEDDING_HTTP_RETRIES\", \"2\"))\n@@ -66,7 +85,7 @@ class Config:\n     RETRIEVAL_TOP_K_FACT: int = int(os.getenv(\"RETRIEVAL_TOP_K_FACT\", \"4\"))\n \n     # ── Tools ─────────────────────────────────────────────────────────────\n-    SANDBOX_DIR: str = os.getenv(\"SANDBOX_DIR\", \"./agent_sandbox\")\n+    SANDBOX_DIR: str = _project_path_env(\"SANDBOX_DIR\", \"./agent_sandbox\")\n     BASH_TIMEOUT: int = int(os.getenv(\"BASH_TIMEOUT\", \"30\"))\n     GOOGLE_PLACES_API_KEY: str = os.getenv(\"GOOGLE_PLACES_API_KEY\", \"\")\n "},{"sha":"26717bb09b8d15989bfdcc9020c190db33a2153b","filename":"documentation/public/DEVELOPER_GUIDE.md","status":"modified","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FDEVELOPER_GUIDE.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FDEVELOPER_GUIDE.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/documentation%2Fpublic%2FDEVELOPER_GUIDE.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -57,6 +57,36 @@ Public credibility docs:\n   - checks the actual tool path against expected entities, searches, fetches, and forbidden drift\n   - useful when a final answer can sound correct even though the workflow was wrong\n \n+- [run_engine/tool_scheduler.py](../../run_engine/tool_scheduler.py)\n+  - classifies tool calls as parallel read-only, batched read-only, ordered, exclusive side-effect, or skipped\n+  - groups independent read-only calls into execution batches\n+  - returns one result per proposed tool call, including blocked/skipped calls\n+  - intended to keep scheduling authority in the runtime, not in model prose\n+\n+  The managed runtime now uses this for deterministic source workflows when\n+  the ledger has enough locked state. Examples: search each locked entity in a\n+  group, or fetch selected URLs with `web_fetch_batch`.\n+\n+- [run_engine/search_evidence.py](../../run_engine/search_evidence.py)\n+  - compiles search, fetch, batch-fetch, Alpha Vantage, and finance snapshot payloads into compact evidence citations\n+  - preserves raw refs while keeping large payloads out of actor context by default\n+\n+- [run_engine/tool_catalog_search.py](../../run_engine/tool_catalog_search.py)\n+  - retrieves relevant tool definitions from the registered catalog\n+  - avoids injecting every available tool into prompts when only a few are relevant\n+\n+- [run_engine/context_editor.py](../../run_engine/context_editor.py)\n+  - replaces old or oversized tool payloads with compact refs after they have been consumed\n+  - keeps summaries in context and raw payloads available for UI/debug by ID\n+\n+- [run_engine/compaction_state.py](../../run_engine/compaction_state.py)\n+  - builds a compact state snapshot for long-run compaction\n+  - preserves objective, next required action, locked entities, evidence IDs, unresolved slots, and recent decisions\n+\n+- [run_engine/citation_registry.py](../../run_engine/citation_registry.py)\n+  - records allowed citation IDs\n+  - verifies final text does not cite evidence IDs that were never compiled or selected\n+\n - [engine/core.py](../../engine/core.py)\n   - legacy/native execution kernel\n   - prompt construction\n@@ -165,6 +195,26 @@ Do not let response text claim:\n - evidence was fetched unless the URL appears in successful tool results\n - a memory fact was stored unless memory commit accepted it\n \n+### Tool Scheduling Rules\n+\n+The model may propose tool calls, but the runtime decides how they execute.\n+\n+Default classes:\n+\n+- `parallel_readonly`: `web_search`, `alpha_vantage_quote`, `alpha_vantage_news`, `weather_fetch`, `places_search`, `image_search`\n+- `batched_readonly`: `web_fetch_batch`\n+- `sequential_ordered`: source workflow tools and single `web_fetch`\n+- `exclusive_side_effect`: shell, file writes, memory writes, app generation, image generation, delegation, and task writes\n+\n+Rules:\n+\n+- read-only calls can run together only when they do not depend on each other\n+- source workflows keep their contract order: discover, lock, search, select, fetch, verify\n+- side-effect tools run alone\n+- blocked calls still produce a structured skipped result\n+- every result must stay linked to the tool call ID that produced it\n+- `web_fetch_batch` completion gates count fetched URLs from the batch result payload, not just the requested URL list\n+\n ### Scenario-State Evals\n \n Some failures cannot be caught by reading the final answer."},{"sha":"485e041bb7fe0762454d40f926932dd80e984248","filename":"documentation/public/FEATURES_AND_ROADMAP.md","status":"modified","additions":113,"deletions":10,"changes":123,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FFEATURES_AND_ROADMAP.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FFEATURES_AND_ROADMAP.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/documentation%2Fpublic%2FFEATURES_AND_ROADMAP.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -37,7 +37,46 @@ This happens inside one run. It is not a default multi-agent swarm. The runtime\n - run evals\n - trace events tied to runs\n \n-### 4. Memory and State\n+### 4. Workflow Contracts\n+\n+- deterministic task-shape classification for simple chat, source collection, coding, research, and memory-correction-style turns\n+- source-collection contracts with entity quotas, per-entity source requirements, fetch requirements, tool policy, and completion gates\n+- contract snapshots persisted through the run ledger\n+- contract state visible in phase packets and runtime attention\n+\n+### 4.1 Execution Contracts\n+\n+- live run contract derived from the same run ledger\n+- separates user-owned decisions from agent-owned execution details\n+- exposes locked entities, evidence requirements, action queue, readiness, and compact AgentIR\n+- included in phase packets so prompts, traces, tests, and UI can inspect the same state\n+- designed to stop the runtime from silently mutating the user's goal, entities, evidence quota, or definition of done\n+\n+### 4.2 Agent Language Compiler\n+\n+- compiles messy user language into a typed Agent Language Program\n+- normalizes common spelling/noise without making the user speak symbols\n+- emits AgentIR symbols such as `intent -> search[] -> lock{} -> fetch[] -> verify= -> answer`\n+- seeds the first required tool action for source-collection workflows before planner drift can occur\n+- stores logical proof obligations as compact runtime state instead of prompt decoration\n+\n+### 5. Agent Pass Framework\n+\n+- workflow contracts map to typed specialist passes rather than one large prompt\n+- pass roles include retrieval, reasoning, summary, scoring, evaluation, and orchestration\n+- context strategies distinguish direct response, local retrieval, chunk-wise analysis, global reasoning, deterministic ranking, scenario-state evals, and completion gates\n+- pass graphs are stored in the run ledger so the UI and tests can inspect the intended workflow structure\n+- pass graph execution state tracks node status, dependencies, attempts, outputs, and graph completion\n+\n+### 6. Runtime Attention\n+\n+- deterministic phase-weighted scoring over run ledger records\n+- separate heads for objective, pending work, tool state, evidence, verification, memory, continuation, and risk\n+- workflow contract and pass graph records included as high-signal state\n+- attention snapshots included in phase packets and traces\n+- designed to make context selection inspectable without modifying model internals\n+\n+### 7. Memory and State\n \n - deterministic facts\n - candidate signal lane\n@@ -48,27 +87,41 @@ This happens inside one run. It is not a default multi-agent swarm. The runtime\n - session RAG\n - task tracking\n \n-### 5. State Integrity\n+### 8. State Integrity\n \n - grounded fact filtering\n - failed-turn preservation\n+- pre-turn context readiness checks for stale continuation, poisoned candidate context, and ambiguous bare referents\n - task-bootstrap suppression inside a run\n - follow-up context sanitation after tool execution\n - prompt overflow retry for local models\n - cumulative evidence retention across a run so verified exact-domain fetches survive later noisy searches\n - source-contract workflow guards for entity/source collection tasks\n+- ledger-enforced source gates for opt-in runs: wrong next tools, unlocked-entity searches, and off-contract fetches are detected before execution\n+- execution-contract readiness gates that expose missing evidence and the next required action before final response\n+- completion gates that mark source workflows incomplete until required evidence is present\n - scenario-state evals that catch wrong tool paths even when final text sounds plausible\n \n-### 6. Tool and Evidence Discipline\n+### 9. Tool and Evidence Discipline\n \n - hidden tool-call draft parsing before UI emission\n - unknown tool rejection before execution\n - duplicate tool-call suppression\n+- tool scheduler primitives for classifying calls as parallel read-only, batched read-only, ordered, exclusive side-effect, or skipped\n+- managed runtime grouped execution for deterministic source workflows after entities or selected URLs are locked\n+- skipped and blocked tool calls can be represented as explicit error results instead of disappearing from the run\n+- search evidence compiler for turning noisy web/search/fetch/finance tool payloads into compact citation refs\n+- citation registry primitives for checking final-answer citation IDs against stored evidence refs\n+- tool catalog search for narrowing broad/default planner tool context while preserving explicitly configured tools\n+- context editor primitive for replacing old or oversized tool payloads with compact raw refs\n+- compaction-state primitive that preserves objective, next action, locked entities, unresolved slots, evidence IDs, tool result IDs, and memory write IDs\n+- ledger-authority source selection in managed runs, so deterministic source tools use successful prior tool results instead of model-supplied payloads\n - deterministic pivoting when a workflow contract knows the next required action\n+- policy violation and recovery events for drift, duplicate loops, missing evidence, failed fetches, and unsupported response claims\n - side-effect guard for unsupported file/write claims\n - `HARD_FAILURE` status when write tools cannot verify expected outputs\n \n-### 7. Provider Layer\n+### 10. Provider Layer\n \n Supported providers:\n \n@@ -82,20 +135,20 @@ Supported providers:\n - Gemini\n - Nvidia\n \n-### 8. Model-Aware Runtime Shaping\n+### 11. Model-Aware Runtime Shaping\n \n - execution profiles for small local, local standard, and frontier-class models\n - adaptive prompt budgets\n - adaptive evidence packet sizing\n - smaller acting surfaces for weaker local models\n \n-### 9. Memory and Embedding Compatibility\n+### 12. Memory and Embedding Compatibility\n \n - runtime embed-model propagation into memory tools\n - Ollama embedding compatibility across `/api/embed` and legacy `/api/embeddings`\n - OpenAI-compatible embedding transport for LM Studio, llama.cpp, and local OpenAI servers\n \n-### 10. Frontend Planes\n+### 13. Frontend Planes\n \n - Shovs Platform workspace\n - consumer frontend\n@@ -107,6 +160,8 @@ Shovs Platform already includes:\n - planner toggle\n - reasoning visibility\n - Harness Lab for comparing plain model behavior against Shovs runtime wedges\n+- Harness Lab policy comparison across plain model, model + tools, Shovs ReAct, Shovs Plan-Execute, and Shovs Graph Harness\n+- Trace Monitor lanes for Policy, Graph, and Recovery events\n - readable monitor\n - trace replay\n - run eval display\n@@ -138,9 +193,9 @@ The public credibility path is:\n \n These are the remaining meaningful gaps.\n \n-### 1. Ledger-Enforced Prompting\n+### 1. Contract-First Prompting\n \n-The runtime already carries a run ledger and phase packets. More prompt inputs should be derived directly from ledger requirements instead of local lists or conversational carryover.\n+The runtime now derives an execution contract from the ledger and uses Agent Language to seed source-collection workflows when the planner path is unavailable. Source workflows can execute grouped per-entity searches and selected URL batch fetches once the ledger has locked state. The remaining work is to move more workflow families onto the same compiler path.\n \n ### 2. Broader Scenario Evals\n \n@@ -162,7 +217,55 @@ This is much better than before, but still one of the main practical gaps for lo\n \n ### 6. Richer Monitor Lanes\n \n-The monitor is much more readable now, but source contracts, missing slots, continuation state, and eval failures can still be surfaced more clearly.\n+The monitor is much more readable now, but source contracts, missing slots, continuation state, workflow plugin decisions, and eval failures can still be surfaced more clearly.\n+\n+The highest-value UI fields are:\n+\n+- user-owned objective and constraints\n+- locked entities\n+- evidence quota and observed coverage\n+- next required action\n+- final-answer readiness\n+- policy violations and recovery actions\n+- compiled evidence citation refs\n+- tool schedule batches and skipped calls\n+\n+### Workflow Plugins\n+\n+ShovsOS now routes domain-specific source-collection behavior through workflow plugins instead of adding one-off branches directly inside the run loop.\n+\n+Current plugins:\n+\n+- `stock_movers_source_collection`: locks stock tickers from a mover source, then enforces separate searches and fetched-source quotas.\n+- `local_place_source_collection`: locks places from search results, then enforces separate searches and fetched-source quotas.\n+- `comparison_source_collection`: locks compared items/products/options, then enforces per-entity evidence collection.\n+\n+This is the pattern for future niches: shopping comparison, local-store checks, restaurant research, paper triage, or enterprise evidence collection can each become a plugin while the engine keeps the same contract, ledger, trace, and verification rules.\n+\n+### Control Policies\n+\n+The managed runtime now resolves an explicit control policy per run.\n+\n+- `react` for lightweight reason-act-observe tasks.\n+- `plan_observe` for the existing planner/actor/observer compatibility loop.\n+- `plan_execute` for web/source workflows where untrusted page content should not rewrite the task.\n+- `graph_harness` for coding, higher-risk, or long-horizon workflows with typed pass graphs.\n+\n+This lets ShovsOS compare and compose agent architectures instead of betting the whole system on one loop style.\n+\n+Harness Lab now exposes those policy differences directly. It returns each mode's control policy, ledger mode, trace summary, state-eval score, policy-trace score, and issues, so the UI can show why one run drifted and another passed.\n+\n+### Context Ladder\n+\n+Phase packets now include a compact context ladder:\n+\n+- keyword hint\n+- compact memory signal\n+- relevant block\n+- evidence reference\n+- raw payload reference\n+\n+This keeps actor context smaller and more inspectable. Raw payloads stay available for verifier and UI inspection instead of being dumped into every model turn.\n \n ### 7. Active Workspace Builder Controls\n "},{"sha":"9308787617f33da6916599adf290424ba6f342a1","filename":"documentation/public/LOGICAL_PROOFS.md","status":"added","additions":145,"deletions":0,"changes":145,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FLOGICAL_PROOFS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FLOGICAL_PROOFS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/documentation%2Fpublic%2FLOGICAL_PROOFS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,145 @@\n+# Logical Proofs for the Shovs Runtime\n+\n+This document states the runtime logic in plain language.\n+\n+The point is not that symbols make a model smarter by themselves. The point is\n+that the runtime compiles messy language into state that can be checked.\n+\n+## Core Pipeline\n+\n+```text\n+messy user language\n+-> Agent Language Program\n+-> AgentIR\n+-> ExecutionContract\n+-> RunLedger\n+-> tools/evidence\n+-> verifier\n+-> final answer or continuation\n+```\n+\n+## Proof 1: State Externalization\n+\n+Claim:\n+\n+An agent is more coherent when obligations are stored outside the stateless\n+model.\n+\n+Invariant:\n+\n+Required actions, evidence slots, locked entities, and readiness must live in\n+runtime state, not only in prompt text.\n+\n+Runtime check:\n+\n+`RunLedger.to_phase_packet(...)` includes `execution_contract`,\n+`next_required_action`, `completion_gate`, and `missing_requirements`.\n+\n+Why it matters:\n+\n+The model can forget or re-interpret a long instruction. The runtime can reload\n+the same state every pass.\n+\n+## Proof 2: Agent Language Is Not Prompt Decoration\n+\n+Claim:\n+\n+Symbols help only when they are runtime-readable.\n+\n+Invariant:\n+\n+`search[] -> lock{} -> foreach(search[]) -> fetch[] -> verify= -> answer`\n+must map to stored steps, action gates, and evidence requirements.\n+\n+Runtime check:\n+\n+`compile_agent_language(...)` produces a typed `AgentLanguageProgram`, and\n+`RunLedger.execution_contract()` exposes that as `AgentIR`.\n+For source-collection workflows, `RunEngine` seeds the first required\n+`web_search` action from this program before planner output can drift.\n+\n+Why it matters:\n+\n+The user should not need to speak symbols. The system compiles natural language\n+into symbols and typed state internally.\n+\n+## Proof 3: Tool Truth\n+\n+Claim:\n+\n+The final answer cannot truthfully claim tool work unless the ledger has\n+successful tool-result IDs.\n+\n+Invariant:\n+\n+Tool calls and tool results are linked records. Responses can cite successful\n+results, not imagined actions.\n+\n+Runtime check:\n+\n+`RunLedger.link_tool_result(...)` rejects orphaned results.\n+`RunLedger.response_support_check(...)` flags fake search/fetch claims.\n+\n+Why it matters:\n+\n+This directly attacks \"I searched/fetched\" hallucinations.\n+\n+## Proof 4: Entity And Evidence Lock\n+\n+Claim:\n+\n+Entity drift is preventable when selected entities and evidence quotas become\n+runtime invariants.\n+\n+Invariant:\n+\n+Once entities are locked, searches and fetches must stay inside the contract.\n+The final answer is blocked until required evidence is present or the run is\n+reported as partial.\n+\n+Runtime check:\n+\n+`plan_execute` rejects unlocked-entity searches and off-contract fetches.\n+`completion_gate()` blocks final answers while evidence slots are missing.\n+\n+Why it matters:\n+\n+This is the stock/sushi/shopping failure pattern: the model finds the right\n+entities, then drifts to unrelated ones. The runtime should catch that path,\n+not merely judge the final prose.\n+\n+## Proof 5: Context Minimization\n+\n+Claim:\n+\n+Accuracy and speed improve when raw data is stored outside the prompt and only\n+the current state view enters the model.\n+\n+Invariant:\n+\n+Raw payloads stay in storage. Phase packets receive summaries, IDs, slots,\n+locked entities, next action, and verification status.\n+\n+Runtime check:\n+\n+The context ladder emits `raw_payload_ref` unless raw content is explicitly\n+requested. Attention policies suppress stale history and candidate memory in\n+source/tool loops.\n+\n+Why it matters:\n+\n+The model sees what it needs for this pass, not every old trace or raw page.\n+\n+## Practical Standard\n+\n+A Shovs run is stronger when it can prove:\n+\n+1. what the user asked for\n+2. what the internal agent language compiled\n+3. what the contract requires\n+4. what the next action is\n+5. what tools actually ran\n+6. what evidence exists\n+7. why the response is allowed or blocked\n+\n+That is the difference between a prompt-heavy agent and a runtime harness."},{"sha":"3cca5eb608a53b2d8bd133850e1ddc2caf9669b8","filename":"documentation/public/SETUP.md","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FSETUP.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FSETUP.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/documentation%2Fpublic%2FSETUP.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -152,6 +152,19 @@ BRAVE_SEARCH_KEY=\n EXA_API_KEY=\n ```\n \n+## Market Data\n+\n+Alpha Vantage is optional. It enables deterministic finance tools for ticker\n+quotes, top movers, company overview, news sentiment, and compact finance\n+snapshots:\n+\n+```env\n+ALPHA_VANTAGE_API_KEY=\n+```\n+\n+If the key is missing or rate-limited, finance tools return a typed failure\n+instead of pretending market data was retrieved.\n+\n ## Optional Services\n \n ### SearXNG and Sandbox"},{"sha":"d5bc45a5639d645da8f7d0614932c9b269deef5e","filename":"documentation/public/VISION.md","status":"modified","additions":30,"deletions":6,"changes":36,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FVISION.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/documentation%2Fpublic%2FVISION.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/documentation%2Fpublic%2FVISION.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -13,6 +13,10 @@ Shovs does this through:\n - controlled context assembly\n - explicit execution phases\n - a canonical run ledger\n+- workflow contracts for recognizable multi-step task shapes\n+- execution contracts that separate user-owned planning authority from agent-owned execution details\n+- typed pass graphs for specialist retrieval, reasoning, scoring, evaluation, summarization, and orchestration roles\n+- runtime attention over structured run state\n - verified tool grounding\n - structured fact and candidate lanes\n - checkpoints, artifacts, traces, and evals\n@@ -38,6 +42,7 @@ Shovs uses language to talk to users and models, but it does not treat the chat\n In plain terms:\n \n - the user owns the goal\n+- the user-owned constraints stay visible as contract state\n - the runtime owns the state\n - the model helps plan, act, observe, and explain\n - tools produce evidence\n@@ -57,6 +62,10 @@ Shovs is being built as a runtime with:\n \n - a managed `plan -> act -> observe -> verify -> memory_commit` loop\n - a run ledger for plan steps, tool calls, tool results, evidence, memory writes, verification, and continuation state\n+- workflow contracts for entity locks, evidence requirements, tool policy, completion gates, and continuation policy\n+- execution contracts that expose the objective, locked entities, evidence quota, action queue, readiness gate, and compact AgentIR\n+- pass graphs that make workflow decomposition, context strategy, and stop conditions inspectable\n+- runtime attention snapshots that score which ledger records matter for the current phase\n - phase-aware context compilation\n - deterministic fact vs candidate-signal lanes\n - side-effect guards for tool claims\n@@ -80,6 +89,18 @@ In practical terms:\n - control center: Shovs Platform and operator-facing observability surfaces\n - autonomous body: runtime phases, tool execution, memory updates, and verification flows\n \n+The most important implementation rule is:\n+\n+```text\n+contract > prompt\n+ledger > chat memory\n+tool result IDs > claimed actions\n+phase packet > transcript dump\n+verification gate > plausible answer\n+```\n+\n+This is how Shovs tries to keep a probabilistic model useful without asking it to remember every obligation by itself. The model can reason and write, but the runtime carries the run state.\n+\n A robust agent on Shovs is defined by a combination of:\n \n - system prompt\n@@ -132,12 +153,14 @@ The smallest proof is a run where the system can show:\n \n 1. what the user asked for\n 2. what entities or targets were selected\n-3. which tools were allowed\n-4. which tool calls actually happened\n-5. which results succeeded\n-6. what evidence was gathered\n-7. what memory was written or rejected\n-8. why the final answer passed or failed verification\n+3. which constraints and evidence quotas are user-owned\n+4. what next action the runtime requires\n+5. which tools were allowed\n+6. which tool calls actually happened\n+7. which results succeeded\n+8. what evidence was gathered\n+9. what memory was written or rejected\n+10. why the final answer passed or failed verification\n \n That is why Shovs invests in run ledgers, trace replay, memory inspection, and scenario evals.\n \n@@ -152,6 +175,7 @@ The public proof path is intentionally small:\n 3. Inspect scenario-state evals: [EVALS.md](../../EVALS.md)\n 4. Check claim boundaries: [CLAIMS.md](../../CLAIMS.md)\n 5. Compare latest local results: [RESULTS.md](../../RESULTS.md)\n+6. Read the invariant proof sketch: [LOGICAL_PROOFS.md](LOGICAL_PROOFS.md)\n \n ## Frontier Direction\n "},{"sha":"8d75f926ca89fb6c84d02c1cccae4c15feeaff27","filename":"engine/context_engine.py","status":"modified","additions":28,"deletions":7,"changes":35,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/engine%2Fcontext_engine.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -19,6 +19,7 @@\n from llm.adapter_factory import create_adapter, strip_provider_prefix\n from engine.context_schema import ContextItem, ContextKind, ContextPhase\n from engine.fact_guard import is_grounded_fact_record\n+from engine.context_hygiene import should_skip_memory_compression\n from config.config import cfg\n \n \n@@ -100,10 +101,7 @@ def set_adapter(self, adapter: BaseLLMAdapter):\n         self.adapter = adapter\n \n     def is_trivial(self, user_message: str, assistant_response: str) -> bool:\n-        return (\n-            bool(TRIVIAL_PATTERN.match(user_message.strip()))\n-            and len(assistant_response.strip()) < 40\n-        )\n+        return should_skip_memory_compression(user_message, assistant_response)\n \n     def _clean_response(self, response: str) -> str:\n         \"\"\"Strip tool result blocks before compression — model needs prose only.\"\"\"\n@@ -127,8 +125,9 @@ async def compress_exchange(\n         Compress a new exchange into the existing context.\n         Returns (updated_context_string, list_of_keyed_facts, list_of_voids).\n         \"\"\"\n-        # Skip trivial exchanges — but never skip the first one\n-        if not is_first_exchange and self.is_trivial(user_message, assistant_response):\n+        # Skip low-value social turns even when the assistant was verbose. They\n+        # do not carry durable user facts and should not poison context.\n+        if self.is_trivial(user_message, assistant_response):\n             return current_context, [], []\n \n         use_model = model or self.compression_model\n@@ -264,14 +263,36 @@ async def compress_exchange(\n             return current_context, [], []\n \n         existing_lines = [l for l in current_context.split(\"\\n\") if l.strip()]\n-        merged = existing_lines + new_lines\n+        # Deterministic dedup BEFORE the line cap: each turn the compressor may\n+        # re-extract an already-known fact (e.g. \"User name is Vonny\"). Appending\n+        # blindly produced duplicate bullets that bloated context and forced an\n+        # extra LLM recompression. Deduping here keeps the summary tight and cuts\n+        # recompression frequency — no model call needed.\n+        merged = self._dedupe_lines(existing_lines + new_lines)\n \n         if len(merged) > MAX_CONTEXT_LINES:\n             print(f\"[ContextEngine] Context at {len(merged)} lines — recompressing...\")\n             merged = await self._recompress(\"\\n\".join(merged), use_model)\n \n         return \"\\n\".join(merged), keyed_facts, voids\n \n+    @staticmethod\n+    def _dedupe_lines(lines: list[str]) -> list[str]:\n+        \"\"\"Drop duplicate durable bullets, comparing on normalized content so\n+        \"- User name is Vonny\" and \"User name is Vonny.\" collapse to one. Keeps\n+        the first occurrence to preserve the \"First message\" anchor's position.\"\"\"\n+        seen: set[str] = set()\n+        out: list[str] = []\n+        for line in lines:\n+            if not str(line).strip():\n+                continue\n+            key = re.sub(r\"[^a-z0-9]+\", \" \", str(line).lower()).strip()\n+            if not key or key in seen:\n+                continue\n+            seen.add(key)\n+            out.append(line)\n+        return out\n+\n     async def _recompress(self, context: str, model: str) -> list[str]:\n         if \":\" in model:\n             provider_prefix = model.split(\":\", 1)[0].lower()"},{"sha":"70844873ccf7c837db7f14762392cd2711d1a0ba","filename":"engine/context_engine_v2.py","status":"modified","additions":4,"deletions":8,"changes":12,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine_v2.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine_v2.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/engine%2Fcontext_engine_v2.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -55,6 +55,7 @@\n from engine.context_schema import ContextItem, ContextKind, ContextPhase\n from config.config import cfg\n from engine.fact_guard import is_grounded_fact_record\n+from engine.context_hygiene import should_skip_memory_compression\n \n \n # ── Prompts ────────────────────────────────────────────────────────────────────\n@@ -206,18 +207,13 @@ async def compress_exchange(\n         \"\"\"\n         self._turn += 1\n \n-        # Never skip first exchange\n-        is_trivial = (\n-            bool(TRIVIAL_PATTERN.match(user_message.strip()))\n-            and len(assistant_response.strip()) < 40\n-        )\n-        if is_trivial and not is_first_exchange:\n-            return self._serialize_context(), [], []\n-\n         # Restore state from persisted context if this is a resumed session\n         if current_context and not self._modules:\n             self._deserialize_context(current_context)\n \n+        if should_skip_memory_compression(user_message, assistant_response):\n+            return current_context or self._serialize_context(), [], []\n+\n         use_model = model or self.compression_model\n \n         # Run goal and module extraction concurrently"},{"sha":"0c39bbe1b7e32314e593f44bd6df9e372704b73c","filename":"engine/context_engine_v3.py","status":"modified","additions":28,"deletions":7,"changes":35,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine_v3.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_engine_v3.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/engine%2Fcontext_engine_v3.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -41,6 +41,7 @@\n from engine.context_schema import ContextItem, ContextKind, ContextPhase\n from config.config import cfg\n from engine.fact_guard import is_grounded_fact_record\n+from engine.context_hygiene import should_skip_memory_compression\n \n \n # Defaults chosen for an interactive multi-turn agent on a typical 32k-128k context.\n@@ -200,6 +201,9 @@ async def compress_exchange(\n         model: str = None,\n         grounding_text: str = \"\",\n     ) -> tuple[str, list[dict], list[dict]]:\n+        if should_skip_memory_compression(user_message, assistant_response):\n+            return current_context, [], []\n+\n         durable_context, convergent_context = self._split_context(current_context)\n         use_model = model or self.compression_model\n \n@@ -211,14 +215,31 @@ async def compress_exchange(\n             model=use_model,\n             grounding_text=grounding_text,\n         )\n-        convergent_updated, convergent_facts, convergent_voids = await self._v2.compress_exchange(\n-            user_message=user_message,\n-            assistant_response=assistant_response,\n-            current_context=convergent_context,\n-            is_first_exchange=is_first_exchange,\n-            model=use_model,\n-            grounding_text=grounding_text,\n+\n+        # Convergent ranking (the part that actually surfaces context) lives in\n+        # the non-LLM build_context_block. V2.compress_exchange, by contrast, runs\n+        # goal + module extraction (2-3 LLM calls) every turn. Only refresh the\n+        # convergent registry on turns that carry new durable signal — first\n+        # exchange, an empty registry needing bootstrap, or a turn where V1\n+        # extracted new facts. Other turns reuse the persisted registry; ranking\n+        # still runs at packet-build, so nothing user-visible is lost.\n+        should_refresh_convergent = (\n+            is_first_exchange\n+            or bool(durable_facts)\n+            or not convergent_context.strip()\n         )\n+        if should_refresh_convergent:\n+            convergent_updated, convergent_facts, convergent_voids = await self._v2.compress_exchange(\n+                user_message=user_message,\n+                assistant_response=assistant_response,\n+                current_context=convergent_context,\n+                is_first_exchange=is_first_exchange,\n+                model=use_model,\n+                grounding_text=grounding_text,\n+            )\n+        else:\n+            convergent_updated = convergent_context\n+            convergent_facts, convergent_voids = [], []\n \n         serialized = self._serialize_context(durable_updated, convergent_updated)\n         facts = self._dedupe_fact_records(durable_facts + convergent_facts)"},{"sha":"7464282062315cbc288f1320b8393de3df02fa1a","filename":"engine/context_hygiene.py","status":"added","additions":101,"deletions":0,"changes":101,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_hygiene.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fcontext_hygiene.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/engine%2Fcontext_hygiene.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,101 @@\n+from __future__ import annotations\n+\n+import re\n+\n+\n+SOCIAL_TURN_PATTERN = re.compile(\n+    r\"^\\s*(hi|hello|hey|yo|thanks|thank you|ok|okay|cool|nice|great|got it|understood|makes sense)\"\n+    r\"(?:\\s+(again|there|that helps|so much|thanks|ok|okay|got it|understood|cool|nice|great|today))*\\s*[!.?]*\\s*$\",\n+    re.IGNORECASE,\n+)\n+\n+ACTION_TERMS = {\n+    \"search\", \"find\", \"fetch\", \"research\", \"analyze\", \"analyse\", \"compare\",\n+    \"summarize\", \"summarise\", \"write\", \"draft\", \"make\", \"create\", \"implement\",\n+    \"fix\", \"remember\", \"call\", \"use\", \"prefer\", \"update\", \"change\", \"continue\",\n+    \"resume\", \"go\", \"open\", \"read\", \"calculate\", \"compute\",\n+}\n+\n+MEMORY_SIGNAL_PATTERN = re.compile(\n+    r\"\\b(\"\n+    r\"remember|forget|actually|correction|correct(?:ion)?|update|changed?|switched|\"\n+    r\"prefer|preference|call me|my name|i am|i'm|i live|i work|i use|i like|\"\n+    r\"i don't|i do not|allergic|budget|timezone|location|based in|moving|\"\n+    r\"save this|store this|keep this\"\n+    r\")\\b\",\n+    re.IGNORECASE,\n+)\n+\n+\n+def is_low_value_social_turn(user_message: str) -> bool:\n+    \"\"\"Return True for greetings/acks that should not become durable memory.\"\"\"\n+    text = str(user_message or \"\").strip()\n+    lowered = text.lower()\n+    if not text:\n+        return True\n+    tokens = [\n+        re.sub(r\"[^a-z0-9_]\", \"\", token)\n+        for token in lowered.replace(\"-\", \" \").split()\n+    ]\n+    tokens = [token for token in tokens if token]\n+    if any(token in ACTION_TERMS for token in tokens):\n+        return False\n+    if len(tokens) > 6:\n+        return False\n+    return bool(SOCIAL_TURN_PATTERN.match(text))\n+\n+\n+def should_skip_memory_compression(user_message: str, assistant_response: str = \"\") -> bool:\n+    \"\"\"Compression gate for low-value turns.\n+\n+    The assistant response is intentionally ignored for social turns. A verbose\n+    greeting response should not turn \"hi again\" into durable context.\n+    \"\"\"\n+    return is_low_value_social_turn(user_message)\n+\n+\n+def has_durable_memory_signal(user_message: str) -> bool:\n+    \"\"\"Return True when a turn is likely worth durable memory work.\"\"\"\n+\n+    return bool(MEMORY_SIGNAL_PATTERN.search(str(user_message or \"\")))\n+\n+\n+def should_run_llm_memory_compression(\n+    user_message: str,\n+    assistant_response: str = \"\",\n+    *,\n+    is_first_exchange: bool = False,\n+    deterministic_fact_count: int = 0,\n+    void_count: int = 0,\n+    candidate_signal_count: int = 0,\n+    turn: int | None = None,\n+    interval: int = 6,\n+    mode: str = \"adaptive\",\n+) -> bool:\n+    \"\"\"Gate expensive LLM summarization separately from deterministic memory.\n+\n+    Deterministic fact extraction and governed memory commits can run cheaply.\n+    Calling a chat model just to recompress context should be rarer: only when\n+    there is a durable user signal, correction/void, candidate stance signal, or\n+    a periodic maintenance interval. ``mode`` supports operational overrides:\n+    ``always`` preserves old behavior, ``off`` disables LLM compression, and\n+    ``adaptive`` is the default.\n+    \"\"\"\n+\n+    normalized_mode = str(mode or \"adaptive\").strip().lower()\n+    if normalized_mode in {\"always\", \"force\", \"on\"}:\n+        return not should_skip_memory_compression(user_message, assistant_response)\n+    if normalized_mode in {\"off\", \"none\", \"skip\"}:\n+        return False\n+    if should_skip_memory_compression(user_message, assistant_response):\n+        return False\n+    if deterministic_fact_count > 0 or void_count > 0 or candidate_signal_count > 0:\n+        return True\n+    if has_durable_memory_signal(user_message):\n+        return True\n+    if is_first_exchange:\n+        text = str(user_message or \"\").strip()\n+        return len(text.split()) >= 8 or len(text) >= 60\n+    if interval > 0 and turn is not None and turn > 0:\n+        return turn % interval == 0\n+    return False"},{"sha":"8da0ef3ab81107ce7eb2d829808a83ff4e10986c","filename":"engine/response_guard.py","status":"modified","additions":71,"deletions":0,"changes":71,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fresponse_guard.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/engine%2Fresponse_guard.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/engine%2Fresponse_guard.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -48,6 +48,17 @@ def is_small_or_local_model(model: str, profile: str = \"\") -> bool:\n     return False\n \n \n+_THINK_BLOCK_RE = re.compile(r\"<think(?:ing)?>.*?</think(?:ing)?>\", re.IGNORECASE | re.DOTALL)\n+# Tag-wrapped tool calls emitted as text by reasoning models that the runtime\n+# never executed, e.g. gpt-oss `<tool_code>{...}</tool_code>` or\n+# `<tool_call>{...}</tool_call>`. These must never be shown as the answer.\n+_TOOL_TAG_BLOCK_RE = re.compile(\n+    r\"<(tool_code|tool_call|tool_use|function_call)>.*?</\\1>\",\n+    re.IGNORECASE | re.DOTALL,\n+)\n+_TOOL_JSON_KEYS = (\"tool_use\", \"tool_calls\", \"tool_call\", \"tool_name\", \"function\")\n+\n+\n def _loads_json_object(text: str) -> dict[str, Any]:\n     raw = str(text or \"\").strip()\n     if not raw.startswith(\"{\") or not raw.endswith(\"}\"):\n@@ -59,6 +70,34 @@ def _loads_json_object(text: str) -> dict[str, Any]:\n     return parsed if isinstance(parsed, dict) else {}\n \n \n+def _extract_embedded_json_object(text: str) -> tuple[str, dict[str, Any]]:\n+    \"\"\"Find a top-level JSON object embedded inside prose.\n+\n+    Reasoning models (e.g. qwen3 thinking mode) sometimes emit a final answer\n+    that is prose/CoT followed by a literal tool-call blob like\n+    ``{\"thought\": \"...\", \"tool_use\": {\"function\": \"store_memory\", ...}}``. The\n+    whole text is not valid JSON, so ``_loads_json_object`` misses it. This\n+    isolates the ``{...}`` span and parses it so the guard can strip it.\n+    \"\"\"\n+    s = str(text or \"\")\n+    start = s.find(\"{\")\n+    end = s.rfind(\"}\")\n+    if start == -1 or end == -1 or end <= start:\n+        return \"\", {}\n+    candidate = s[start:end + 1]\n+    try:\n+        parsed = json.loads(candidate)\n+    except Exception:\n+        return \"\", {}\n+    return candidate, (parsed if isinstance(parsed, dict) else {})\n+\n+\n+def _looks_like_embedded_tool_json(parsed: dict[str, Any]) -> bool:\n+    if not parsed:\n+        return False\n+    return any(key in parsed for key in _TOOL_JSON_KEYS)\n+\n+\n def looks_like_tool_json(text: str) -> bool:\n     payload = _loads_json_object(text)\n     if not payload:\n@@ -145,12 +184,44 @@ def guard_final_response(\n     replacement_used = False\n     strict_mode = is_small_or_local_model(model, model_profile) if strict is None else bool(strict)\n \n+    # 1) Strip leaked reasoning blocks (qwen/deepseek thinking mode etc.) and\n+    #    tag-wrapped tool calls the runtime never executed (gpt-oss\n+    #    <tool_code>...). These must never reach the user as the final answer.\n+    lowered_clean = clean.lower()\n+    if \"<think\" in lowered_clean:\n+        stripped_think = _THINK_BLOCK_RE.sub(\"\", clean).strip()\n+        if stripped_think != clean:\n+            issues.append(\"leaked_reasoning_block\")\n+            clean = stripped_think\n+            changed = True\n+    if any(tag in clean.lower() for tag in (\"<tool_code\", \"<tool_call\", \"<tool_use\", \"<function_call\")):\n+        stripped_tool_tag = _TOOL_TAG_BLOCK_RE.sub(\"\", clean).strip()\n+        if stripped_tool_tag != clean:\n+            issues.append(\"leaked_tool_call_tag\")\n+            clean = stripped_tool_tag\n+            changed = True\n+\n     if looks_like_tool_json(clean):\n         issues.append(\"tool_json_final_response\")\n         fallback = _fallback_from_tool_json(clean, user_message=user_message)\n         clean = fallback or \"\"\n         changed = True\n         replacement_used = True\n+    else:\n+        # 2) A tool-call blob leaked at the end of an otherwise-prose answer\n+        #    (e.g. reasoning followed by {\"tool_use\": {\"function\": ...}}). Remove\n+        #    the blob from the visible text; if nothing meaningful remains, fall\n+        #    back so the raw JSON is never shown.\n+        embedded_json, embedded = _extract_embedded_json_object(clean)\n+        if embedded_json and _looks_like_embedded_tool_json(embedded):\n+            prose = clean.replace(embedded_json, \"\").strip()\n+            issues.append(\"embedded_tool_json\")\n+            changed = True\n+            if prose:\n+                clean = prose\n+            else:\n+                clean = _fallback_from_tool_json(embedded_json, user_message=user_message) or \"\"\n+                replacement_used = True\n \n     query_allows_architecture = any(term in str(user_message or \"\").lower() for term in _ARCHITECTURE_QUERY_TERMS)\n     if clean and (strict_mode or not query_allows_architecture) and not query_allows_architecture:"},{"sha":"11e00a7b4191166def49bee93c6526f633bedabd","filename":"extractions/invex-stock-agent/README.md","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2FREADME.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2FREADME.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2FREADME.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,102 @@\n+# Invex Stock Agent\n+\n+Invex is a small, runnable stock-analysis agent extracted from ShovsOS.\n+\n+It does not try to be a general autonomous agent. It does one workflow well:\n+\n+```text\n+ticker -> deterministic Alpha Vantage tools -> analyst lanes -> verified report\n+```\n+\n+The goal is to avoid the common finance-agent failure mode where the model writes a confident report from vague context. Invex keeps the model-shaped part small. Numbers, ratios, sections, trace events, and missing-data warnings come from deterministic code.\n+\n+## What It Runs\n+\n+Analyst lanes:\n+\n+- Market Analyst: quote, price change, volume, market status\n+- Fundamentals Analyst: company profile, sector, market cap, valuation fields\n+- Profitability Analyst: revenue, revenue growth, operating margin, net margin\n+- Financial Health Analyst: cash, debt/equity, free cash flow\n+- Earnings Analyst: reported EPS, estimated EPS, surprise, EPS growth\n+- News Analyst: Alpha Vantage news sentiment and URLs\n+- Technical Analyst: RSI and SMA\n+- Portfolio Manager: final posture from computed signals\n+\n+## Install\n+\n+```bash\n+cd extractions/invex-stock-agent\n+python -m venv .venv\n+source .venv/bin/activate\n+python -m pip install -e \".[test]\"\n+export ALPHA_VANTAGE_API_KEY=\"your_key\"\n+```\n+\n+## CLI\n+\n+```bash\n+invex-stock-agent analyze ABNB\n+invex-stock-agent analyze NVDA --depth deep --json\n+invex-stock-agent analyze TSLA --max-api-calls 5 --json\n+```\n+\n+## API + Web UI\n+\n+```bash\n+uvicorn invex_stock_agent.server:app --reload --port 8015\n+```\n+\n+Open:\n+\n+[http://127.0.0.1:8015](http://127.0.0.1:8015)\n+\n+API:\n+\n+```bash\n+curl -X POST http://127.0.0.1:8015/api/analyze \\\n+  -H \"content-type: application/json\" \\\n+  -d '{\"symbol\":\"ABNB\",\"depth\":\"standard\",\"max_api_calls\":7}'\n+```\n+\n+## Rate Limits\n+\n+Alpha Vantage free keys are rate-limited. Invex treats that as a runtime condition, not a reason to loop.\n+\n+- Required lanes run first: quote, overview, income statement, balance sheet, cash flow, earnings.\n+- Optional lanes run later: news and technical indicators.\n+- If the call budget is reached, remaining lanes are marked `partial`.\n+- Live Alpha Vantage requests are paced by `ALPHA_VANTAGE_MIN_INTERVAL_SECONDS` (`1.05` by default).\n+- If Alpha Vantage still returns a rate/quota message, remaining lanes are skipped and the report returns with trace events.\n+\n+This is deliberately different from a chat agent that keeps retrying until it drifts.\n+\n+## Tests\n+\n+```bash\n+pytest\n+```\n+\n+The tests mock Alpha Vantage responses, so they do not need an API key or network.\n+\n+## Why This Is Different\n+\n+Most agent demos let the LLM decide what happened. Invex records what happened:\n+\n+- every lane has a status\n+- every metric has a source function\n+- missing API data stays missing\n+- no buy/sell advice is generated\n+- report sections are assembled from deterministic facts\n+\n+This makes it easy to embed in another app, expose as an API, or later connect to MCP tools.\n+\n+## Architecture Notes\n+\n+The private TradingAgents reference uses a staged trading-firm graph: analyst team, researcher team, trader, risk team, and portfolio manager. The useful idea is not the visual style or extra agents. The useful idea is the contract:\n+\n+```text\n+selected analyst -> tool lane -> report key -> progress event -> next lane\n+```\n+\n+Invex keeps that contract but removes the heavy debate loop for the first version. It runs deterministic Alpha Vantage lanes, records trace events, and creates a portfolio-manager style verdict from computed signals. That gives a small app the same inspectable shape without requiring LangGraph, Docker, or a large model."},{"sha":"c0b88590e4b0a7ac7a304c943bf9d8a7f456b94c","filename":"extractions/invex-stock-agent/invex_stock_agent/__init__.py","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2F__init__.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2F__init__.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2F__init__.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,5 @@\n+\"\"\"Lightweight deterministic stock-analysis agent.\"\"\"\n+\n+from .analyzer import StockAnalyzer, StockAnalysisRequest\n+\n+__all__ = [\"StockAnalyzer\", \"StockAnalysisRequest\"]"},{"sha":"046e5452241b7044dc49c68bd4702154483478d7","filename":"extractions/invex-stock-agent/invex_stock_agent/alpha_vantage.py","status":"added","additions":126,"deletions":0,"changes":126,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Falpha_vantage.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Falpha_vantage.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Falpha_vantage.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,126 @@\n+from __future__ import annotations\n+\n+import os\n+import re\n+import asyncio\n+import time\n+from typing import Any\n+\n+import httpx\n+\n+\n+BASE_URL = \"https://www.alphavantage.co/query\"\n+_REQUEST_LOCK = asyncio.Lock()\n+_LAST_REQUEST_AT = 0.0\n+\n+\n+class AlphaVantageClient:\n+    def __init__(self, api_key: str | None = None, *, timeout: float = 20.0):\n+        self.api_key = (api_key or os.getenv(\"ALPHA_VANTAGE_API_KEY\") or os.getenv(\"ALPHAVANTAGE_API_KEY\") or \"\").strip()\n+        self.timeout = timeout\n+\n+    async def get(self, function: str, **params: Any) -> dict[str, Any]:\n+        global _LAST_REQUEST_AT\n+        if not self.api_key:\n+            return {\"_success\": False, \"_error\": \"ALPHA_VANTAGE_API_KEY is not configured.\", \"_function\": function}\n+        query = {\n+            \"function\": function,\n+            \"apikey\": self.api_key,\n+            **{key: value for key, value in params.items() if value not in (None, \"\", [])},\n+        }\n+        try:\n+            min_interval = float(os.getenv(\"ALPHA_VANTAGE_MIN_INTERVAL_SECONDS\", \"1.05\") or \"1.05\")\n+        except ValueError:\n+            min_interval = 1.05\n+        async with _REQUEST_LOCK:\n+            if min_interval > 0:\n+                elapsed = time.monotonic() - _LAST_REQUEST_AT\n+                if elapsed < min_interval:\n+                    await asyncio.sleep(min_interval - elapsed)\n+            async with httpx.AsyncClient(timeout=self.timeout) as client:\n+                response = await client.get(BASE_URL, params=query)\n+                _LAST_REQUEST_AT = time.monotonic()\n+                response.raise_for_status()\n+                data = response.json()\n+        if not isinstance(data, dict):\n+            return {\"_success\": False, \"_error\": \"Alpha Vantage returned a non-object payload.\", \"_raw\": data, \"_function\": function}\n+        if data.get(\"Error Message\"):\n+            return {\"_success\": False, \"_error\": str(data[\"Error Message\"]), \"_raw\": data, \"_function\": function}\n+        if data.get(\"Note\") or data.get(\"Information\"):\n+            return {\n+                \"_success\": False,\n+                \"_error\": str(data.get(\"Note\") or data.get(\"Information\")),\n+                \"_raw\": data,\n+                \"_rate_limited\": True,\n+                \"_function\": function,\n+            }\n+        return {\"_success\": True, \"_function\": function, **data}\n+\n+\n+def clean_symbol(symbol: str) -> str:\n+    return re.sub(r\"[^A-Za-z0-9._-]\", \"\", str(symbol or \"\").strip().upper())[:16]\n+\n+\n+def number(value: Any) -> float | None:\n+    text = str(value or \"\").strip().replace(\",\", \"\")\n+    if text in {\"\", \"None\", \"none\", \"null\", \"-\"}:\n+        return None\n+    try:\n+        return float(text)\n+    except Exception:\n+        return None\n+\n+\n+def pct(numerator: Any, denominator: Any) -> float | None:\n+    n = number(numerator)\n+    d = number(denominator)\n+    if n is None or d in (None, 0):\n+        return None\n+    return (n / d) * 100\n+\n+\n+def growth(latest: Any, previous: Any) -> float | None:\n+    current = number(latest)\n+    prior = number(previous)\n+    if current is None or prior in (None, 0):\n+        return None\n+    return ((current - prior) / abs(prior)) * 100\n+\n+\n+def money(value: Any) -> str:\n+    n = number(value)\n+    if n is None:\n+        return \"not recorded\"\n+    sign = \"-\" if n < 0 else \"\"\n+    n = abs(n)\n+    if n >= 1_000_000_000_000:\n+        return f\"{sign}${n / 1_000_000_000_000:.2f}T\"\n+    if n >= 1_000_000_000:\n+        return f\"{sign}${n / 1_000_000_000:.2f}B\"\n+    if n >= 1_000_000:\n+        return f\"{sign}${n / 1_000_000:.2f}M\"\n+    return f\"{sign}${n:,.0f}\"\n+\n+\n+def fmt_pct(value: float | None) -> str:\n+    return \"not recorded\" if value is None else f\"{value:.2f}%\"\n+\n+\n+def reports(data: dict[str, Any], key: str, limit: int) -> list[dict[str, Any]]:\n+    rows = data.get(key)\n+    if not isinstance(rows, list):\n+        return []\n+    return [row for row in rows[: max(1, min(limit, 12))] if isinstance(row, dict)]\n+\n+\n+def quote_payload(symbol: str, data: dict[str, Any]) -> dict[str, Any]:\n+    quote = data.get(\"Global Quote\") if isinstance(data.get(\"Global Quote\"), dict) else {}\n+    return {\n+        \"symbol\": symbol,\n+        \"price\": quote.get(\"05. price\") or \"\",\n+        \"change\": quote.get(\"09. change\") or \"\",\n+        \"change_percent\": quote.get(\"10. change percent\") or \"\",\n+        \"volume\": quote.get(\"06. volume\") or \"\",\n+        \"latest_trading_day\": quote.get(\"07. latest trading day\") or \"\",\n+        \"previous_close\": quote.get(\"08. previous close\") or \"\",\n+    }"},{"sha":"712b1e158eea4d31547644875d8e081723371b90","filename":"extractions/invex-stock-agent/invex_stock_agent/analyzer.py","status":"added","additions":264,"deletions":0,"changes":264,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fanalyzer.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fanalyzer.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fanalyzer.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,264 @@\n+from __future__ import annotations\n+\n+from dataclasses import dataclass\n+from typing import Any\n+\n+from pydantic import BaseModel, Field\n+\n+from .alpha_vantage import AlphaVantageClient, clean_symbol, fmt_pct, growth, money, number, pct, quote_payload, reports\n+\n+\n+class StockAnalysisRequest(BaseModel):\n+    symbol: str\n+    depth: str = Field(default=\"standard\", pattern=\"^(standard|deep)$\")\n+    include_technical: bool = True\n+    news_limit: int = 5\n+    max_api_calls: int = 7\n+\n+\n+@dataclass\n+class LaneResult:\n+    id: str\n+    title: str\n+    status: str\n+    summary: str\n+    metrics: list[dict[str, Any]]\n+    source_functions: list[str]\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return {\n+            \"id\": self.id,\n+            \"title\": self.title,\n+            \"status\": self.status,\n+            \"summary\": self.summary,\n+            \"metrics\": self.metrics,\n+            \"source_functions\": self.source_functions,\n+        }\n+\n+\n+def metric(label: str, value: Any, status: str = \"info\") -> dict[str, Any]:\n+    return {\"label\": label, \"value\": value, \"status\": status}\n+\n+\n+def status_from_pct(value: float | None, *, good: float, bad: float, higher_is_better: bool = True) -> str:\n+    if value is None:\n+        return \"unknown\"\n+    if higher_is_better:\n+        if value >= good:\n+            return \"positive\"\n+        if value <= bad:\n+            return \"negative\"\n+    else:\n+        if value <= good:\n+            return \"positive\"\n+        if value >= bad:\n+            return \"negative\"\n+    return \"neutral\"\n+\n+\n+class StockAnalyzer:\n+    def __init__(self, client: AlphaVantageClient | None = None):\n+        self.client = client or AlphaVantageClient()\n+\n+    async def analyze(self, request: StockAnalysisRequest | dict[str, Any]) -> dict[str, Any]:\n+        req = request if isinstance(request, StockAnalysisRequest) else StockAnalysisRequest(**request)\n+        symbol = clean_symbol(req.symbol)\n+        if not symbol:\n+            return {\"success\": False, \"error\": \"Missing stock symbol.\", \"trace\": []}\n+\n+        limit = 5 if req.depth == \"deep\" else 3\n+        trace: list[dict[str, Any]] = []\n+        rate_limited = False\n+        fatal_provider_error = \"\"\n+\n+        async def call(lane: str, function: str, **params: Any) -> tuple[str, dict[str, Any]]:\n+            nonlocal rate_limited, fatal_provider_error\n+            if fatal_provider_error:\n+                skipped = {\"_success\": False, \"_error\": f\"Skipped after provider configuration failure: {fatal_provider_error}\", \"_skipped\": True, \"_did_call\": False}\n+                trace.append({\"phase\": \"tool_skipped\", \"lane\": lane, \"function\": function, \"status\": \"skipped\", \"reason\": \"provider_config\"})\n+                return lane, skipped\n+            if rate_limited:\n+                skipped = {\"_success\": False, \"_error\": \"Skipped after Alpha Vantage rate/quota limit.\", \"_skipped\": True, \"_did_call\": False}\n+                trace.append({\"phase\": \"tool_skipped\", \"lane\": lane, \"function\": function, \"status\": \"skipped\", \"reason\": \"rate_limit\"})\n+                return lane, skipped\n+            trace.append({\"phase\": \"tool_call\", \"lane\": lane, \"function\": function, \"status\": \"running\"})\n+            data = await self.client.get(function, **params)\n+            data[\"_did_call\"] = True\n+            if data.get(\"_rate_limited\") or self._is_rate_limit_error(str(data.get(\"_error\") or \"\")):\n+                rate_limited = True\n+            if self._is_provider_config_error(str(data.get(\"_error\") or \"\")):\n+                fatal_provider_error = str(data.get(\"_error\") or \"\")\n+            trace.append({\n+                \"phase\": \"tool_result\",\n+                \"lane\": lane,\n+                \"function\": function,\n+                \"status\": \"success\" if data.get(\"_success\") else \"error\",\n+                \"error\": data.get(\"_error\", \"\"),\n+            })\n+            return lane, data\n+\n+        specs: list[tuple[str, str, dict[str, Any], bool]] = [\n+            (\"market\", \"GLOBAL_QUOTE\", {\"symbol\": symbol}, True),\n+            (\"fundamentals\", \"OVERVIEW\", {\"symbol\": symbol}, True),\n+            (\"profitability\", \"INCOME_STATEMENT\", {\"symbol\": symbol}, True),\n+            (\"health\", \"BALANCE_SHEET\", {\"symbol\": symbol}, True),\n+            (\"cashflow\", \"CASH_FLOW\", {\"symbol\": symbol}, True),\n+            (\"earnings\", \"EARNINGS\", {\"symbol\": symbol}, True),\n+            (\"news\", \"NEWS_SENTIMENT\", {\"tickers\": symbol, \"limit\": max(1, min(req.news_limit, 50))}, False),\n+        ]\n+        if req.include_technical:\n+            specs.extend([\n+                (\"technical_rsi\", \"RSI\", {\"symbol\": symbol, \"interval\": \"daily\", \"time_period\": 14, \"series_type\": \"close\"}, False),\n+                (\"technical_sma\", \"SMA\", {\"symbol\": symbol, \"interval\": \"daily\", \"time_period\": 50, \"series_type\": \"close\"}, False),\n+            ])\n+\n+        results: dict[str, dict[str, Any]] = {}\n+        max_calls = max(1, min(int(req.max_api_calls or 7), 12))\n+        calls_used = 0\n+        for lane, function, params, required in specs:\n+            if calls_used >= max_calls:\n+                results[lane] = {\"_success\": False, \"_error\": f\"Skipped after max_api_calls={max_calls}.\", \"_skipped\": True}\n+                trace.append({\"phase\": \"tool_skipped\", \"lane\": lane, \"function\": function, \"status\": \"skipped\", \"reason\": \"max_api_calls\"})\n+                continue\n+            name, data = await call(lane, function, **params)\n+            results[name] = data\n+            if data.get(\"_did_call\", True):\n+                calls_used += 1\n+\n+        quote = quote_payload(symbol, results.get(\"market\", {})) if results.get(\"market\", {}).get(\"_success\") else {}\n+        overview = results.get(\"fundamentals\", {}) if results.get(\"fundamentals\", {}).get(\"_success\") else {}\n+        income_rows = reports(results.get(\"profitability\", {}), \"annualReports\", limit)\n+        balance_rows = reports(results.get(\"health\", {}), \"annualReports\", limit)\n+        cash_rows = reports(results.get(\"cashflow\", {}), \"annualReports\", limit)\n+        earnings_rows = reports(results.get(\"earnings\", {}), \"annualEarnings\", limit)\n+        q_earnings_rows = reports(results.get(\"earnings\", {}), \"quarterlyEarnings\", 4)\n+        news_feed = results.get(\"news\", {}).get(\"feed\") if results.get(\"news\", {}).get(\"_success\") else []\n+        news = [item for item in (news_feed or [])[: req.news_limit] if isinstance(item, dict)]\n+\n+        latest_income = income_rows[0] if income_rows else {}\n+        prev_income = income_rows[1] if len(income_rows) > 1 else {}\n+        latest_balance = balance_rows[0] if balance_rows else {}\n+        latest_cash = cash_rows[0] if cash_rows else {}\n+        prev_cash = cash_rows[1] if len(cash_rows) > 1 else {}\n+        latest_earnings = q_earnings_rows[0] if q_earnings_rows else {}\n+\n+        revenue_growth = growth(latest_income.get(\"totalRevenue\"), prev_income.get(\"totalRevenue\"))\n+        net_margin = pct(latest_income.get(\"netIncome\"), latest_income.get(\"totalRevenue\"))\n+        op_margin = pct(latest_income.get(\"operatingIncome\"), latest_income.get(\"totalRevenue\"))\n+        total_debt = (number(latest_balance.get(\"shortTermDebt\")) or 0) + (number(latest_balance.get(\"longTermDebt\")) or 0)\n+        debt_to_equity = pct(total_debt, latest_balance.get(\"totalShareholderEquity\"))\n+        op_cf = number(latest_cash.get(\"operatingCashflow\"))\n+        capex = number(latest_cash.get(\"capitalExpenditures\"))\n+        fcf = None if op_cf is None or capex is None else op_cf - abs(capex)\n+        ocf_growth = growth(latest_cash.get(\"operatingCashflow\"), prev_cash.get(\"operatingCashflow\"))\n+        eps_growth = growth(earnings_rows[0].get(\"reportedEPS\") if earnings_rows else None, earnings_rows[1].get(\"reportedEPS\") if len(earnings_rows) > 1 else None)\n+\n+        lanes = [\n+            LaneResult(\"market\", \"Market Analyst\", \"completed\" if quote else \"partial\", f\"{symbol} quote {quote.get('price') or 'not recorded'} with change {quote.get('change_percent') or 'not recorded'}.\", [\n+                metric(\"Price\", quote.get(\"price\") or \"not recorded\"),\n+                metric(\"Change\", quote.get(\"change_percent\") or \"not recorded\"),\n+                metric(\"Volume\", quote.get(\"volume\") or \"not recorded\"),\n+            ], [\"GLOBAL_QUOTE\"]),\n+            LaneResult(\"fundamentals\", \"Fundamentals Analyst\", \"completed\" if overview else \"partial\", f\"{overview.get('Name', symbol)} operates in {overview.get('Sector', 'sector not recorded')} / {overview.get('Industry', 'industry not recorded')}.\", [\n+                metric(\"Market cap\", money(overview.get(\"MarketCapitalization\"))),\n+                metric(\"P/E\", overview.get(\"PERatio\") or \"not recorded\"),\n+                metric(\"EPS\", overview.get(\"EPS\") or \"not recorded\"),\n+                metric(\"Beta\", overview.get(\"Beta\") or \"not recorded\"),\n+            ], [\"OVERVIEW\"]),\n+            LaneResult(\"profitability\", \"Profitability Analyst\", \"completed\" if income_rows else \"partial\", f\"Revenue growth YoY is {fmt_pct(revenue_growth)}; net margin is {fmt_pct(net_margin)}.\", [\n+                metric(\"Revenue\", money(latest_income.get(\"totalRevenue\"))),\n+                metric(\"Revenue growth YoY\", fmt_pct(revenue_growth), status_from_pct(revenue_growth, good=10, bad=-5)),\n+                metric(\"Operating margin\", fmt_pct(op_margin), status_from_pct(op_margin, good=10, bad=0)),\n+                metric(\"Net margin\", fmt_pct(net_margin), status_from_pct(net_margin, good=12, bad=0)),\n+            ], [\"INCOME_STATEMENT\"]),\n+            LaneResult(\"financial_health\", \"Financial Health Analyst\", \"completed\" if balance_rows or cash_rows else \"partial\", f\"Debt/equity is {fmt_pct(debt_to_equity)} and free cash flow is {money(fcf)}.\", [\n+                metric(\"Cash\", money(latest_balance.get(\"cashAndCashEquivalentsAtCarryingValue\") or latest_balance.get(\"cashAndShortTermInvestments\"))),\n+                metric(\"Debt/equity\", fmt_pct(debt_to_equity), status_from_pct(debt_to_equity, good=80, bad=200, higher_is_better=False)),\n+                metric(\"Free cash flow\", money(fcf), \"positive\" if (fcf or 0) > 0 else \"negative\" if fcf is not None else \"unknown\"),\n+                metric(\"OCF growth YoY\", fmt_pct(ocf_growth)),\n+            ], [\"BALANCE_SHEET\", \"CASH_FLOW\"]),\n+            LaneResult(\"earnings\", \"Earnings Analyst\", \"completed\" if earnings_rows or q_earnings_rows else \"partial\", f\"Latest EPS surprise is {latest_earnings.get('surprisePercentage') or 'not recorded'}; annual EPS growth is {fmt_pct(eps_growth)}.\", [\n+                metric(\"Reported EPS\", latest_earnings.get(\"reportedEPS\") or \"not recorded\"),\n+                metric(\"Estimated EPS\", latest_earnings.get(\"estimatedEPS\") or \"not recorded\"),\n+                metric(\"EPS surprise\", latest_earnings.get(\"surprisePercentage\") or \"not recorded\"),\n+                metric(\"Annual EPS growth\", fmt_pct(eps_growth), status_from_pct(eps_growth, good=10, bad=-5)),\n+            ], [\"EARNINGS\"]),\n+        ]\n+\n+        sentiment_scores = [number(item.get(\"overall_sentiment_score\")) for item in news]\n+        sentiment_scores = [score for score in sentiment_scores if score is not None]\n+        urls = [item.get(\"url\") for item in news if item.get(\"url\")]\n+        lanes.append(LaneResult(\"news\", \"News Analyst\", \"completed\" if news else \"partial\", f\"{len(news)} Alpha Vantage news items; {len(urls)} URLs available.\", [\n+            metric(\"Article count\", len(news)),\n+            metric(\"Average sentiment\", \"not recorded\" if not sentiment_scores else round(sum(sentiment_scores) / len(sentiment_scores), 4)),\n+            metric(\"URLs\", len(urls)),\n+        ], [\"NEWS_SENTIMENT\"]))\n+\n+        if req.include_technical:\n+            rsi = self._latest_indicator(results.get(\"technical_rsi\", {}), \"RSI\")\n+            sma = self._latest_indicator(results.get(\"technical_sma\", {}), \"SMA\")\n+            rsi_num = number(rsi.get(\"value\"))\n+            rsi_state = \"overbought\" if rsi_num is not None and rsi_num >= 70 else \"oversold\" if rsi_num is not None and rsi_num <= 30 else \"neutral\"\n+            lanes.append(LaneResult(\"technical\", \"Technical Analyst\", \"completed\" if rsi or sma else \"partial\", f\"RSI is {rsi.get('value', 'not recorded')} ({rsi_state}); SMA(50) is {sma.get('value', 'not recorded')}.\", [\n+                metric(\"RSI(14)\", rsi.get(\"value\", \"not recorded\"), rsi_state),\n+                metric(\"SMA(50)\", sma.get(\"value\", \"not recorded\")),\n+            ], [\"RSI\", \"SMA\"]))\n+\n+        positive = sum(1 for signal in [revenue_growth and revenue_growth > 0, net_margin and net_margin > 0, fcf and fcf > 0, eps_growth and eps_growth > 0] if signal)\n+        negative = sum(1 for signal in [revenue_growth is not None and revenue_growth < 0, net_margin is not None and net_margin < 0, fcf is not None and fcf < 0, eps_growth is not None and eps_growth < 0] if signal)\n+        posture = \"constructive\" if positive >= 3 and negative == 0 else \"cautious\" if negative >= 2 else \"mixed\"\n+        lanes.append(LaneResult(\"verdict\", \"Portfolio Manager\", \"completed\", f\"Posture is {posture}: {positive} positive signals and {negative} negative signals.\", [\n+            metric(\"Posture\", posture),\n+            metric(\"Positive signals\", positive),\n+            metric(\"Negative signals\", negative),\n+        ], [\"computed\"]))\n+\n+        errors = [f\"{lane}: {payload.get('_error')}\" for lane, payload in results.items() if not payload.get(\"_success\")]\n+        return {\n+            \"success\": any(payload.get(\"_success\") for payload in results.values()),\n+            \"symbol\": symbol,\n+            \"depth\": req.depth,\n+            \"rate_limited\": rate_limited,\n+            \"api_call_budget\": {\"used\": calls_used, \"max\": max_calls},\n+            \"analyst_lanes\": [lane.to_dict() for lane in lanes],\n+            \"source_urls\": urls,\n+            \"errors\": errors,\n+            \"trace\": trace,\n+            \"report_markdown\": self._markdown(symbol, lanes, urls, errors),\n+            \"disclaimer\": \"Research support only. Not financial advice.\",\n+        }\n+\n+    @staticmethod\n+    def _is_rate_limit_error(message: str) -> bool:\n+        lowered = str(message or \"\").lower()\n+        return any(term in lowered for term in (\"rate limit\", \"frequency\", \"premium\", \"standard api call frequency\", \"api call volume\", \"free api requests\", \"more sparingly\", \"quota\"))\n+\n+    @staticmethod\n+    def _is_provider_config_error(message: str) -> bool:\n+        lowered = str(message or \"\").lower()\n+        return \"api key\" in lowered or \"api_key\" in lowered or \"apikey\" in lowered or \"invalid key\" in lowered\n+\n+    @staticmethod\n+    def _latest_indicator(payload: dict[str, Any], indicator: str) -> dict[str, str]:\n+        key = next((item for item in payload.keys() if item.startswith(\"Technical Analysis:\")), \"\")\n+        series = payload.get(key) if key else {}\n+        if not isinstance(series, dict) or not series:\n+            return {}\n+        date = sorted(series.keys(), reverse=True)[0]\n+        row = series.get(date) if isinstance(series.get(date), dict) else {}\n+        value = row.get(indicator) or row.get(indicator.lower()) or \"\"\n+        return {\"date\": date, \"value\": value} if value else {}\n+\n+    @staticmethod\n+    def _markdown(symbol: str, lanes: list[LaneResult], urls: list[str], errors: list[str]) -> str:\n+        lines = [f\"# {symbol} Stock Analysis\", \"\", \"_Research support only. Not financial advice._\", \"\"]\n+        for lane in lanes:\n+            lines.extend([f\"## {lane.title}\", lane.summary, \"\"])\n+            for item in lane.metrics:\n+                lines.append(f\"- **{item['label']}**: {item['value']}\")\n+            lines.append(\"\")\n+        if urls:\n+            lines.extend([\"## Source URLs\", *[f\"- {url}\" for url in urls], \"\"])\n+        if errors:\n+            lines.extend([\"## Missing / Partial Data\", *[f\"- {err}\" for err in errors], \"\"])\n+        return \"\\n\".join(lines).strip() + \"\\n\""},{"sha":"399b900860b632561c589bbc78bc4e361eaefdbd","filename":"extractions/invex-stock-agent/invex_stock_agent/cli.py","status":"added","additions":43,"deletions":0,"changes":43,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fcli.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fcli.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fcli.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,43 @@\n+from __future__ import annotations\n+\n+import argparse\n+import asyncio\n+import json\n+\n+from .analyzer import StockAnalyzer, StockAnalysisRequest\n+\n+\n+async def _run(args: argparse.Namespace) -> int:\n+    result = await StockAnalyzer().analyze(\n+        StockAnalysisRequest(\n+            symbol=args.symbol,\n+            depth=args.depth,\n+            include_technical=not args.no_technical,\n+            news_limit=args.news_limit,\n+            max_api_calls=args.max_api_calls,\n+        )\n+    )\n+    if args.json:\n+        print(json.dumps(result, indent=2, ensure_ascii=False))\n+    else:\n+        print(result.get(\"report_markdown\") or json.dumps(result, indent=2))\n+    return 0 if result.get(\"success\") else 2\n+\n+\n+def main() -> None:\n+    parser = argparse.ArgumentParser(prog=\"invex-stock-agent\")\n+    sub = parser.add_subparsers(dest=\"command\", required=True)\n+    analyze = sub.add_parser(\"analyze\", help=\"Run the stock analyst workflow.\")\n+    analyze.add_argument(\"symbol\")\n+    analyze.add_argument(\"--depth\", choices=[\"standard\", \"deep\"], default=\"standard\")\n+    analyze.add_argument(\"--news-limit\", type=int, default=5)\n+    analyze.add_argument(\"--max-api-calls\", type=int, default=7)\n+    analyze.add_argument(\"--no-technical\", action=\"store_true\")\n+    analyze.add_argument(\"--json\", action=\"store_true\")\n+    args = parser.parse_args()\n+    if args.command == \"analyze\":\n+        raise SystemExit(asyncio.run(_run(args)))\n+\n+\n+if __name__ == \"__main__\":\n+    main()"},{"sha":"39139f5c11690c1f1081490d031a52fb2b1e99ee","filename":"extractions/invex-stock-agent/invex_stock_agent/server.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fserver.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fserver.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Finvex_stock_agent%2Fserver.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,32 @@\n+from __future__ import annotations\n+\n+from pathlib import Path\n+\n+from fastapi import FastAPI\n+from fastapi.responses import HTMLResponse\n+from fastapi.staticfiles import StaticFiles\n+\n+from .analyzer import StockAnalyzer, StockAnalysisRequest\n+\n+\n+app = FastAPI(title=\"Invex Stock Agent\", version=\"0.1.0\")\n+WEB_DIR = Path(__file__).resolve().parent.parent / \"web\"\n+\n+\n+@app.get(\"/\", response_class=HTMLResponse)\n+async def index() -> str:\n+    return (WEB_DIR / \"index.html\").read_text()\n+\n+\n+@app.get(\"/health\")\n+async def health() -> dict:\n+    return {\"status\": \"ok\", \"service\": \"invex-stock-agent\"}\n+\n+\n+@app.post(\"/api/analyze\")\n+async def analyze(request: StockAnalysisRequest) -> dict:\n+    return await StockAnalyzer().analyze(request)\n+\n+\n+if WEB_DIR.exists():\n+    app.mount(\"/static\", StaticFiles(directory=str(WEB_DIR)), name=\"static\")"},{"sha":"3552555e20b610026fc92c4b3161e68f5c5bcc0a","filename":"extractions/invex-stock-agent/pyproject.toml","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Fpyproject.toml","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Fpyproject.toml","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Fpyproject.toml?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,22 @@\n+[project]\n+name = \"invex-stock-agent\"\n+version = \"0.1.0\"\n+description = \"A lightweight deterministic stock analysis agent powered by Alpha Vantage.\"\n+readme = \"README.md\"\n+requires-python = \">=3.10\"\n+dependencies = [\n+  \"httpx>=0.27\",\n+  \"fastapi>=0.115\",\n+  \"uvicorn>=0.30\",\n+  \"pydantic>=2\",\n+]\n+\n+[project.optional-dependencies]\n+test = [\"pytest>=8\", \"pytest-asyncio>=0.23\"]\n+\n+[project.scripts]\n+invex-stock-agent = \"invex_stock_agent.cli:main\"\n+\n+[tool.pytest.ini_options]\n+asyncio_mode = \"auto\"\n+testpaths = [\"tests\"]"},{"sha":"007ec052675b00c35784284c83402c16cd887336","filename":"extractions/invex-stock-agent/tests/test_analyzer.py","status":"added","additions":82,"deletions":0,"changes":82,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Ftests%2Ftest_analyzer.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Ftests%2Ftest_analyzer.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Ftests%2Ftest_analyzer.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,82 @@\n+from __future__ import annotations\n+\n+import pytest\n+\n+from invex_stock_agent.analyzer import StockAnalyzer, StockAnalysisRequest\n+\n+\n+class FakeClient:\n+    async def get(self, function: str, **params):\n+        if function == \"GLOBAL_QUOTE\":\n+            return {\"_success\": True, \"Global Quote\": {\"05. price\": \"132.50\", \"10. change percent\": \"2.10%\", \"06. volume\": \"123456\"}}\n+        if function == \"OVERVIEW\":\n+            return {\"_success\": True, \"Name\": \"Airbnb Inc\", \"Sector\": \"Consumer Cyclical\", \"Industry\": \"Travel Services\", \"MarketCapitalization\": \"86000000000\", \"PERatio\": \"32\", \"EPS\": \"4.05\", \"Beta\": \"1.16\"}\n+        if function == \"INCOME_STATEMENT\":\n+            return {\"_success\": True, \"annualReports\": [{\"totalRevenue\": \"12650000000\", \"grossProfit\": \"10500000000\", \"operatingIncome\": \"2500000000\", \"netIncome\": \"2510000000\"}, {\"totalRevenue\": \"10700000000\", \"netIncome\": \"2200000000\"}]}\n+        if function == \"BALANCE_SHEET\":\n+            return {\"_success\": True, \"annualReports\": [{\"cashAndCashEquivalentsAtCarryingValue\": \"7100000000\", \"shortTermDebt\": \"100000000\", \"longTermDebt\": \"1900000000\", \"totalShareholderEquity\": \"8200000000\"}]}\n+        if function == \"CASH_FLOW\":\n+            return {\"_success\": True, \"annualReports\": [{\"operatingCashflow\": \"4500000000\", \"capitalExpenditures\": \"250000000\"}, {\"operatingCashflow\": \"4100000000\"}]}\n+        if function == \"EARNINGS\":\n+            return {\"_success\": True, \"annualEarnings\": [{\"reportedEPS\": \"4.05\"}, {\"reportedEPS\": \"3.45\"}], \"quarterlyEarnings\": [{\"reportedEPS\": \"1.05\", \"estimatedEPS\": \"0.98\", \"surprisePercentage\": \"7.14\"}]}\n+        if function == \"NEWS_SENTIMENT\":\n+            return {\"_success\": True, \"feed\": [{\"title\": \"ABNB news\", \"url\": \"https://example.com/abnb\", \"overall_sentiment_score\": \"0.18\"}]}\n+        if function == \"RSI\":\n+            return {\"_success\": True, \"Technical Analysis: RSI\": {\"2026-06-30\": {\"RSI\": \"55.1\"}}}\n+        if function == \"SMA\":\n+            return {\"_success\": True, \"Technical Analysis: SMA\": {\"2026-06-30\": {\"SMA\": \"128.4\"}}}\n+        return {\"_success\": False, \"_error\": \"unexpected\"}\n+\n+\n+@pytest.mark.asyncio\n+async def test_stock_analyzer_builds_lanes_and_markdown():\n+    result = await StockAnalyzer(FakeClient()).analyze(StockAnalysisRequest(symbol=\"ABNB\"))\n+\n+    assert result[\"success\"] is True\n+    assert result[\"symbol\"] == \"ABNB\"\n+    assert len(result[\"analyst_lanes\"]) >= 7\n+    assert any(lane[\"title\"] == \"Financial Health Analyst\" for lane in result[\"analyst_lanes\"])\n+    assert result[\"source_urls\"] == [\"https://example.com/abnb\"]\n+    assert \"# ABNB Stock Analysis\" in result[\"report_markdown\"]\n+    assert any(item[\"phase\"] == \"tool_call\" for item in result[\"trace\"])\n+\n+\n+@pytest.mark.asyncio\n+async def test_stock_analyzer_reports_missing_key():\n+    class MissingKey:\n+        def __init__(self):\n+            self.calls = 0\n+\n+        async def get(self, function: str, **params):\n+            self.calls += 1\n+            return {\"_success\": False, \"_error\": \"ALPHA_VANTAGE_API_KEY is not configured.\"}\n+\n+    client = MissingKey()\n+    result = await StockAnalyzer(client).analyze({\"symbol\": \"ABNB\"})\n+\n+    assert result[\"success\"] is False\n+    assert result[\"errors\"]\n+    assert client.calls == 1\n+    assert any(lane[\"status\"] == \"partial\" for lane in result[\"analyst_lanes\"])\n+    assert any(item.get(\"reason\") == \"provider_config\" for item in result[\"trace\"])\n+\n+\n+@pytest.mark.asyncio\n+async def test_stock_analyzer_stops_after_rate_limit():\n+    class RateLimited:\n+        def __init__(self):\n+            self.calls = []\n+\n+        async def get(self, function: str, **params):\n+            self.calls.append(function)\n+            if function == \"GLOBAL_QUOTE\":\n+                return {\"_success\": True, \"Global Quote\": {\"05. price\": \"2.54\", \"10. change percent\": \"-6.27%\"}}\n+            return {\"_success\": False, \"_rate_limited\": True, \"_error\": \"standard API call frequency is limited\"}\n+\n+    client = RateLimited()\n+    result = await StockAnalyzer(client).analyze({\"symbol\": \"ILLR\", \"max_api_calls\": 9})\n+\n+    assert client.calls == [\"GLOBAL_QUOTE\", \"OVERVIEW\"]\n+    assert result[\"rate_limited\"] is True\n+    assert result[\"api_call_budget\"] == {\"used\": 2, \"max\": 9}\n+    assert any(item.get(\"reason\") == \"rate_limit\" for item in result[\"trace\"])"},{"sha":"2b9d2090e6bd30752bc7e3ef4a82d45de33ccab0","filename":"extractions/invex-stock-agent/web/index.html","status":"added","additions":77,"deletions":0,"changes":77,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Fweb%2Findex.html","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Finvex-stock-agent%2Fweb%2Findex.html","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Finvex-stock-agent%2Fweb%2Findex.html?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,77 @@\n+<!doctype html>\n+<html lang=\"en\">\n+  <head>\n+    <meta charset=\"UTF-8\" />\n+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+    <title>Invex Stock Agent</title>\n+    <style>\n+      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n+      body { margin: 0; background: #0b1017; color: #dce7f5; }\n+      main { min-height: 100vh; display: grid; grid-template-columns: 280px minmax(0, 1fr) 320px; }\n+      aside, section { padding: 20px; border-color: rgba(142,160,184,.18); }\n+      aside { border-right: 1px solid rgba(142,160,184,.18); background: #111823; }\n+      .right { border-right: 0; border-left: 1px solid rgba(142,160,184,.18); }\n+      h1, h2, h3 { margin: 0; letter-spacing: 0; }\n+      h1 { color: #62d6c8; font-size: 22px; }\n+      p, small { color: #91a3bc; line-height: 1.5; }\n+      input, select, button { width: 100%; box-sizing: border-box; border: 1px solid rgba(142,160,184,.22); border-radius: 10px; background: #080c12; color: #dce7f5; padding: 11px; }\n+      button { margin-top: 10px; background: rgba(98,214,200,.14); color: #62d6c8; font-weight: 800; cursor: pointer; }\n+      .lane { border: 1px solid rgba(142,160,184,.18); border-radius: 12px; padding: 14px; margin-bottom: 10px; background: rgba(17,24,35,.72); }\n+      .lane.completed { border-color: rgba(98,214,200,.35); }\n+      .lane.partial { border-color: rgba(248,199,106,.35); }\n+      .metric { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(142,160,184,.12); padding-top: 8px; margin-top: 8px; }\n+      .metric span:first-child { color: #91a3bc; }\n+      .metric span:last-child { text-align: right; }\n+      pre { white-space: pre-wrap; color: #dce7f5; }\n+      .trace { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; border-top: 1px solid rgba(142,160,184,.13); padding: 9px 0; }\n+      @media (max-width: 1000px) { main { grid-template-columns: 1fr; } aside, .right { border: 0; border-bottom: 1px solid rgba(142,160,184,.18); } }\n+    </style>\n+  </head>\n+  <body>\n+    <main>\n+      <aside>\n+        <h1>Invex</h1>\n+        <p>Deterministic stock analysis agent powered by Alpha Vantage.</p>\n+        <label>Symbol <input id=\"symbol\" value=\"ABNB\" /></label>\n+        <label>Depth <select id=\"depth\"><option>standard</option><option>deep</option></select></label>\n+        <label>Call budget <input id=\"maxCalls\" type=\"number\" min=\"1\" max=\"12\" value=\"7\" /></label>\n+        <button id=\"run\">Run Analysis</button>\n+        <small>Set ALPHA_VANTAGE_API_KEY before starting the server. Free keys are rate-limited, so the workflow finishes partially instead of looping.</small>\n+      </aside>\n+      <section>\n+        <h2 id=\"title\">Ready</h2>\n+        <p id=\"summary\">Run a ticker to generate analyst lanes.</p>\n+        <div id=\"lanes\"></div>\n+      </section>\n+      <aside class=\"right\">\n+        <h3>Trace</h3>\n+        <div id=\"trace\"></div>\n+      </aside>\n+    </main>\n+    <script>\n+      const $ = (id) => document.getElementById(id);\n+      $(\"run\").onclick = async () => {\n+        $(\"title\").textContent = \"Running...\";\n+        $(\"summary\").textContent = \"Calling deterministic analyst lanes.\";\n+        $(\"lanes\").innerHTML = \"\";\n+        $(\"trace\").innerHTML = \"\";\n+        const res = await fetch(\"/api/analyze\", {\n+          method: \"POST\",\n+          headers: { \"content-type\": \"application/json\" },\n+          body: JSON.stringify({ symbol: $(\"symbol\").value, depth: $(\"depth\").value, max_api_calls: Number($(\"maxCalls\").value || 7) })\n+        });\n+        const data = await res.json();\n+        $(\"title\").textContent = `${data.symbol || \"Ticker\"} Analysis`;\n+        $(\"summary\").textContent = `${data.disclaimer || \"\"} Calls: ${data.api_call_budget?.used ?? \"not recorded\"}/${data.api_call_budget?.max ?? \"not recorded\"}${data.rate_limited ? \" · rate limited\" : \"\"}`;\n+        $(\"lanes\").innerHTML = (data.analyst_lanes || []).map(lane => `\n+          <article class=\"lane ${lane.status}\">\n+            <h3>${lane.title}</h3>\n+            <p>${lane.summary}</p>\n+            ${(lane.metrics || []).map(m => `<div class=\"metric\"><span>${m.label}</span><span>${m.value}</span></div>`).join(\"\")}\n+          </article>\n+        `).join(\"\");\n+        $(\"trace\").innerHTML = (data.trace || []).map(t => `<div class=\"trace\">${t.phase} · ${t.lane} · ${t.function} · ${t.status}${t.error ? \"<br>\" + t.error : \"\"}</div>`).join(\"\");\n+      };\n+    </script>\n+  </body>\n+</html>"},{"sha":"927774b8380749d67a3c38bc89f51e70adf45971","filename":"extractions/shovs-agent-harness/.gitignore","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2F.gitignore","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2F.gitignore","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2F.gitignore?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,7 @@\n+.runtime/\n+backend/__pycache__/\n+tests/__pycache__/\n+frontend/node_modules/\n+frontend/dist/\n+frontend/.output/\n+frontend/tsconfig.tsbuildinfo"},{"sha":"cc7a785b70521cd710b7c94fc8746d1582e53d96","filename":"extractions/shovs-agent-harness/ARCHITECTURE.md","status":"added","additions":135,"deletions":0,"changes":135,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FARCHITECTURE.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FARCHITECTURE.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2FARCHITECTURE.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,135 @@\n+# Shovs Runtime Architecture\n+\n+This folder is the deployable, simplified architecture distilled from ShovsOS.\n+The main ShovsOS app has many valuable modules; this runtime keeps the pieces\n+that scale cleanly.\n+\n+## Layers\n+\n+```text\n+Frontend\n+  -> HTTP API\n+  -> HarnessService\n+  -> shovs-harness-core\n+  -> Adapters\n+  -> SQLite/Postgres-ready storage\n+```\n+\n+## Runtime Authority\n+\n+```text\n+Model proposes.\n+Contract defines requirements.\n+Ledger records truth.\n+Scheduler executes tools.\n+Evidence compiler selects source refs.\n+Verifier gates the answer.\n+Memory store persists only provenance-backed facts.\n+```\n+\n+## Backend Modules\n+\n+| File | Responsibility |\n+| --- | --- |\n+| `backend/harness_api.py` | dependency-light HTTP API |\n+| `backend/service.py` | orchestration/service boundary |\n+| `backend/workflows.py` | prompt to workflow draft |\n+| `backend/adapters.py` | real and deterministic tool/model adapters |\n+| `backend/store.py` | SQLite/JSON/in-memory run and memory stores |\n+| `backend/models.py` | typed run/event/workflow/memory records |\n+| `backend/config.py` | env-driven deployment config |\n+| `backend/understanding.py` | deterministic intent and context-plan compiler |\n+\n+## Data Flow\n+\n+```mermaid\n+flowchart TD\n+    U[\"User/App\"] --> API[\"HTTP API\"]\n+    API --> SVC[\"HarnessService\"]\n+    SVC --> WF[\"Workflow Draft\"]\n+    SVC --> UNDERSTAND[\"Runtime Understanding\"]\n+    SVC --> CORE[\"shovs-harness-core\"]\n+    CORE --> CONTRACT[\"Source Contract\"]\n+    CORE --> LEDGER[\"Core Ledger\"]\n+    CORE --> ADAPT[\"Adapters\"]\n+    ADAPT --> SEARCH[\"Search\"]\n+    ADAPT --> FETCH[\"Fetch\"]\n+    ADAPT --> MODEL[\"Model slots\"]\n+    CORE --> EVAL[\"Trace Eval\"]\n+    SVC --> STORE[\"SQLite Store\"]\n+    SVC --> MEMORY[\"Memory Store\"]\n+    STORE --> API\n+```\n+\n+## Deployment Profiles\n+\n+### Local\n+\n+```text\n+Python stdlib HTTP server\n+SQLite\n+Ollama or llama.cpp optional\n+SearxNG optional\n+```\n+\n+### Cloud\n+\n+```text\n+FastAPI wrapper or ASGI gateway\n+Postgres-compatible store implementation\n+Redis/queue optional for long runs\n+Object storage for raw payloads\n+Provider APIs for model/search/media\n+```\n+\n+## What Was Ported From ShovsOS\n+\n+- provider adapter pattern\n+- real search/fetch conventions\n+- Alpha Vantage finance workflow idea\n+- run events/traces as first-class UI data\n+- workflow draft concept\n+- provenance-first memory rule\n+- ledger-gated source collection\n+\n+## What Was Simplified\n+\n+- no legacy `AgenticOrchestrator`\n+- no multiple context engines\n+- no frontend-owned workflow logic\n+- no hidden memory commits\n+- no giant prompt authority\n+\n+## Runtime Understanding\n+\n+The runtime compiles a user objective into a small control brief before tools or\n+model slots run:\n+\n+```text\n+intent\n+constraints\n+context_plan\n+allowed_tools\n+model_slots\n+next_action_hint\n+missing_inputs\n+```\n+\n+This is the answer to \"help the LLM figure out what is going on\" without\n+dumping the entire transcript into the model. The LLM receives the relevant\n+brief; the frontend shows the same brief to users.\n+\n+## Continuation\n+\n+`POST /api/runs/{run_id}/continue` creates a follow-up run anchored to the\n+previous objective and records the previous run ID. The current implementation\n+uses synchronous rerun semantics; a queue-backed worker can later resume from\n+stored partial ledger state without changing the frontend contract.\n+\n+## Current Limits\n+\n+- source workflow is strongest path today\n+- memory supports current/voided facts, not full candidate/dispute lanes yet\n+- long-running async jobs are synchronous in the stdlib API implementation\n+- Postgres store interface is not implemented yet\n+- context edit endpoint is specified but not implemented yet"},{"sha":"002d29ca618ab0fa4500896eca0e9b25faf38c0c","filename":"extractions/shovs-agent-harness/FRONTEND_SPEC.md","status":"added","additions":291,"deletions":0,"changes":291,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FFRONTEND_SPEC.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FFRONTEND_SPEC.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2FFRONTEND_SPEC.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,291 @@\n+# Shovs Runtime Frontend Spec\n+\n+This frontend is a product surface for the runtime, not a research dashboard.\n+It should show one clear run, expose deeper state on demand, and keep advanced\n+controls out of the way until the user asks for them.\n+\n+## Product Modes\n+\n+| Mode | User | Default View | Advanced Panels |\n+| --- | --- | --- | --- |\n+| Consumer | normal user | request, answer, sources | hidden |\n+| Researcher | analyst | answer, evidence map, unresolved claims | source raw payloads |\n+| Developer | builder | run map, event timeline, context packet | raw JSON, model slots |\n+| Integration | app/company | workflow schema, API endpoint, auth/config | SDK snippets, connectors |\n+\n+The mode changes presentation, not backend truth. Every mode reads the same\n+run, events, context, evidence, and memory APIs.\n+\n+## Layout\n+\n+```text\n+┌─────────────────────────────────────────────────────────────┐\n+│ Top Bar: mode, workflow, status, model/tool mode             │\n+├───────────────┬───────────────────────────────┬─────────────┤\n+│ Run Map       │ Main Surface                  │ Inspector   │\n+│ 5-7 states    │ prompt/answer/evidence focus  │ details     │\n+├───────────────┴───────────────────────────────┴─────────────┤\n+│ Event Timeline: compact by default, expandable rows          │\n+└─────────────────────────────────────────────────────────────┘\n+```\n+\n+Mobile collapses to:\n+\n+```text\n+Main Surface\n+Run Map chips\n+Inspector drawer\n+Timeline drawer\n+```\n+\n+## Visual Rules\n+\n+- Neutral base, one clear accent, restrained borders.\n+- No nested cards inside cards.\n+- Maximum three primary controls visible at once.\n+- Raw JSON is never visible by default.\n+- Empty/missing backend fields show `not recorded`.\n+- Running state uses typed labels, not vague thinking.\n+- Every timeline item links to a run/event/evidence/context ID.\n+\n+## Primary Components\n+\n+### `ModeShell`\n+\n+Owns:\n+\n+- selected mode\n+- current run ID\n+- inspector selection\n+- SSE connection status\n+\n+### `RunComposer`\n+\n+Controls:\n+\n+- objective textarea\n+- workflow draft preview\n+- `Run`\n+- `Compare`\n+- `Copy API`\n+\n+Calls:\n+\n+```text\n+POST /api/runtime/understand\n+POST /api/workflows/draft\n+POST /api/runs\n+POST /api/compare\n+```\n+\n+### `RunMap`\n+\n+Shows the runtime states:\n+\n+```text\n+intake -> contract -> context -> tools -> evidence -> verify -> response\n+```\n+\n+State is derived from:\n+\n+```text\n+GET /api/runs/{id}\n+GET /api/runs/{id}/events\n+GET /api/runs/{id}/context\n+POST /api/runs/{id}/continue\n+```\n+\n+Each node shows:\n+\n+- status\n+- last event summary\n+- missing requirements\n+- next required action\n+\n+### `MainSurface`\n+\n+Consumer mode:\n+\n+- final answer\n+- source count\n+- unresolved fields\n+\n+Researcher mode:\n+\n+- entity/source table\n+- evidence coverage\n+- citation status\n+\n+Developer mode:\n+\n+- current context packet\n+- runtime understanding brief\n+- model-slot inputs/outputs\n+- tool batches\n+\n+Integration mode:\n+\n+- endpoint\n+- request body\n+- response schema\n+- auth placeholder\n+\n+### `InspectorPanel`\n+\n+Tabs:\n+\n+- Details\n+- Context\n+- Evidence\n+- Memory\n+- Raw\n+\n+Context tab reads:\n+\n+```text\n+GET /api/runs/{id}/context\n+```\n+\n+Evidence tab reads:\n+\n+```text\n+GET /api/runs/{id}/evidence\n+```\n+\n+Memory tab reads:\n+\n+```text\n+GET /api/memory?owner_id=...\n+POST /api/memory\n+POST /api/memory/{fact_id}/void\n+```\n+\n+### `EventTimeline`\n+\n+Every row shows:\n+\n+- timestamp\n+- phase\n+- actor/source if recorded\n+- action/summary\n+- status\n+- duration if recorded\n+- linked IDs\n+\n+Rows expand into:\n+\n+- data summary\n+- raw JSON\n+- dependencies\n+- produced IDs\n+\n+## Runtime Event Labels\n+\n+Preferred user-visible labels:\n+\n+| Backend phase | Label |\n+| --- | --- |\n+| intake | Accepted request |\n+| contract | Compiled workflow |\n+| tool | Used tool |\n+| model_slot | Filled model slot |\n+| verdict | Checked completion |\n+| memory | Updated memory |\n+| error | Needs attention |\n+\n+## Context Edit Controls\n+\n+Advanced users can disable context lanes for a run:\n+\n+- memory facts\n+- candidate memory\n+- raw payload refs\n+- previous tool results\n+- workflow hints\n+\n+The frontend must treat these as runtime overrides, not direct prompt edits.\n+Future API shape:\n+\n+```text\n+POST /api/runs/{id}/context/edit\n+{\n+  \"disabled_lanes\": [\"candidate_memory\"],\n+  \"reason\": \"candidate memory is stale\"\n+}\n+```\n+\n+## Memory Controls\n+\n+Memory writes require provenance.\n+\n+```json\n+{\n+  \"owner_id\": \"default\",\n+  \"subject\": \"user\",\n+  \"predicate\": \"preference\",\n+  \"object\": \"prefers compact UI\",\n+  \"source\": \"user\",\n+  \"provenance\": {\n+    \"message_id\": \"msg_123\"\n+  }\n+}\n+```\n+\n+The UI should separate:\n+\n+- Current\n+- Superseded/voided\n+- Candidates\n+- Disputed\n+\n+Current backend supports current/voided facts. Candidate/disputed lanes are the\n+next memory extension.\n+\n+## Minimal API Client\n+\n+```ts\n+type HarnessClient = {\n+  manifest(): Promise<Manifest>\n+  understand(objective: string): Promise<RuntimeUnderstanding>\n+  draft(prompt: string): Promise<WorkflowDraft>\n+  run(objective: string): Promise<RunSummary>\n+  continue(runId: string): Promise<RunSummary>\n+  events(runId: string): Promise<Event[]>\n+  result(runId: string): Promise<RunResult>\n+  context(runId: string): Promise<RunContext>\n+  evidence(runId: string): Promise<RunEvidence>\n+  memory(ownerId: string): Promise<MemoryState>\n+  remember(input: MemoryWrite): Promise<MemoryFact>\n+  voidMemory(factId: string, reason: string): Promise<void>\n+}\n+```\n+\n+## Runtime Understanding\n+\n+Before a run starts, the frontend can call:\n+\n+```text\n+POST /api/runtime/understand\n+```\n+\n+This returns:\n+\n+- intent\n+- constraints\n+- context plan\n+- allowed tools\n+- model slots\n+- next action hint\n+- missing inputs\n+\n+Use it to show the user what the runtime thinks is happening before the tool\n+loop starts. This is also the first place an advanced user can see and correct\n+wrong task interpretation.\n+\n+## Non-Negotiable UX\n+\n+- A normal user can run a task without understanding agents.\n+- A developer can inspect exactly why a run blocked.\n+- A company can copy the API contract and embed the run in its app.\n+- No frontend component invents state. If backend did not record it, show\n+  `not recorded`."},{"sha":"5471e689c0494ec79882a870fba989b98bf864f4","filename":"extractions/shovs-agent-harness/README.md","status":"added","additions":378,"deletions":0,"changes":378,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FREADME.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2FREADME.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2FREADME.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,378 @@\n+# Shovs Agent Harness\n+\n+A small, product-shaped agent harness built on `shovs-harness-core`.\n+\n+This folder is intentionally separate from the main ShovsOS app. It is the\n+coherent direction:\n+\n+```text\n+plain request\n+  -> workflow draft\n+  -> capability resolver\n+  -> typed contract\n+  -> kernel-owned tool loop\n+  -> linked evidence\n+  -> verdict gate\n+  -> result or blocked continuation\n+```\n+\n+The model is allowed to propose language. The harness owns state, tool truth,\n+evidence coverage, and finalization.\n+\n+This is not a mock UI. The backend exposes real JSON endpoints, stores run\n+records durably by default, and calls the extracted core runtime. The default\n+tool adapter is deterministic so tests and demos are stable; real search,\n+fetch, finance, browser, OCR, or model adapters plug in behind the same four\n+slots.\n+\n+## Why This Exists\n+\n+Most agent products fail in the same places:\n+\n+- they claim tools ran when they did not\n+- they drift from locked entities\n+- they stop before evidence is complete\n+- they mix stale context into the active task\n+- they hide why a run failed\n+\n+This project packages the ShovsOS solution as a small backend and frontend that\n+other apps can consume.\n+\n+## Surfaces\n+\n+| Surface | Purpose |\n+| --- | --- |\n+| Backend | Dependency-light JSON API over `shovs-harness-core` |\n+| Service | Embeddable `HarnessService` for other Python apps |\n+| Store | Durable JSON run store, swappable for Postgres/Redis/S3 |\n+| Adapters | `search`, `fetch`, `entity_extraction`, `synthesis` slots |\n+| Capability Resolver | Detects image generation, connector/MCP setup, and workflow-tool gaps before running the wrong loop |\n+| Analyst Team Runtime | File-backed stock-analysis workflow with market, news, fundamentals, risk, and final report stages |\n+| Dynamic Micro-Tools | Runtime-created check tools with compact input policies and no arbitrary code execution |\n+| Frontend | One adaptive view: draft, run, inspect, copy API |\n+| Tests | Contract and run tests that prove the harness gates state |\n+\n+## Run\n+\n+From the repo root:\n+\n+```bash\n+venv/bin/python -m pytest extractions/shovs-agent-harness/tests -q\n+```\n+\n+Install the small frontend:\n+\n+```bash\n+cd extractions/shovs-agent-harness/frontend\n+npm install\n+```\n+\n+Start backend:\n+\n+```bash\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+Start frontend:\n+\n+```bash\n+extractions/shovs-agent-harness/scripts/run_frontend.sh\n+```\n+\n+Open:\n+\n+```text\n+http://127.0.0.1:5181\n+```\n+\n+Or run both:\n+\n+```bash\n+extractions/shovs-agent-harness/scripts/run_live_app.sh\n+```\n+\n+Useful environment variables:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_PORT=8095\n+SHOVS_AGENT_HARNESS_FRONTEND_PORT=5181\n+SHOVS_AGENT_HARNESS_STORE=extractions/shovs-agent-harness/.runtime/harness.sqlite3\n+SHOVS_AGENT_HARNESS_MEMORY_STORE=extractions/shovs-agent-harness/.runtime/harness.sqlite3\n+SHOVS_AGENT_HARNESS_TOOL_MODE=deterministic\n+```\n+\n+## Real Adapter Modes\n+\n+Deterministic mode is the default because it is stable for tests:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=deterministic\n+```\n+\n+Real mode uses production adapter slots. Missing keys produce typed errors and\n+the verdict gate blocks incomplete runs.\n+\n+SearxNG:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=http \\\n+SHOVS_AGENT_HARNESS_SEARCH_BACKEND=searxng \\\n+SHOVS_AGENT_HARNESS_SEARCH_URL=http://127.0.0.1:8080/search \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+Brave:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=production \\\n+SHOVS_AGENT_HARNESS_SEARCH_BACKEND=brave \\\n+BRAVE_SEARCH_KEY=... \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+Tavily:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=production \\\n+SHOVS_AGENT_HARNESS_SEARCH_BACKEND=tavily \\\n+TAVILY_API_KEY=... \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+Alpha Vantage market workflows:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=production \\\n+ALPHA_VANTAGE_API_KEY=... \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+Use real ShovsOS tool handlers from this repository:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=shovs_native \\\n+ALPHA_VANTAGE_API_KEY=... \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+`shovs_native` calls the real ShovsOS handlers for web search/fetch, Alpha\n+Vantage, finance snapshot, and source-contract tools without importing the full\n+FastAPI app singleton stack.\n+\n+Model-backed entity extraction and synthesis:\n+\n+```bash\n+SHOVS_AGENT_HARNESS_TOOL_MODE=production \\\n+SHOVS_AGENT_HARNESS_MODEL_SLOTS=true \\\n+SHOVS_AGENT_HARNESS_MODEL_PROVIDER=groq \\\n+SHOVS_AGENT_HARNESS_MODEL=llama-3.3-70b-versatile \\\n+GROQ_API_KEY=... \\\n+extractions/shovs-agent-harness/scripts/run_backend.sh\n+```\n+\n+The same model slot path also supports `openai`, `gemini`, `anthropic`,\n+`ollama`, `llamacpp`, `lmstudio`, and other providers already supported by the\n+main repo's `llm.adapter_factory`.\n+\n+## API\n+\n+```text\n+GET  /health\n+GET  /api/manifest\n+GET  /api/tools\n+GET  /api/runs\n+POST /api/workflows/draft\n+GET  /api/workflows\n+POST /api/workflows\n+GET  /api/workflows/{workflow_id}\n+POST /api/workflows/{workflow_id}/run\n+POST /api/workflows/{workflow_id}/run_async\n+POST /api/runs\n+POST /api/runs/async\n+GET  /api/runs/{run_id}\n+GET  /api/runs/{run_id}/events\n+GET  /api/runs/{run_id}/result\n+GET  /api/runs/{run_id}/context\n+GET  /api/runs/{run_id}/evidence\n+GET  /api/memory\n+POST /api/memory\n+POST /api/memory/{fact_id}/void\n+POST /api/runtime/understand\n+POST /api/runs/{run_id}/continue\n+POST /api/runs/{run_id}/interrupt\n+POST /api/tools/call\n+POST /api/compare\n+```\n+\n+Example:\n+\n+```bash\n+curl -s -X POST http://127.0.0.1:8095/api/runs/async \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"objective\":\"Search top 3 stocks today, search each, fetch 3 URLs each.\"}'\n+```\n+\n+Create a reusable workflow:\n+\n+```bash\n+curl -s -X POST http://127.0.0.1:8095/api/workflows \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"objective\":\"Create an agent workflow that gathers top movers stocks and news.\",\"tool_mode\":\"shovs_native\"}'\n+```\n+\n+Run a saved workflow:\n+\n+```bash\n+curl -s -X POST http://127.0.0.1:8095/api/workflows/wf_xxx/run_async \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"objective\":\"Search top 3 stocks today, search each, fetch 3 URLs each.\"}'\n+```\n+\n+Interrupt and continue a run:\n+\n+```bash\n+curl -s -X POST http://127.0.0.1:8095/api/runs/run_xxx/interrupt \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"reason\":\"pause before synthesis\"}'\n+\n+curl -s -X POST http://127.0.0.1:8095/api/runs/run_xxx/continue \\\n+  -H 'Content-Type: application/json' \\\n+  -d '{\"directive\":\"continue, but make the final output a compact table\"}'\n+```\n+\n+`/api/runs` and `/api/workflows/{workflow_id}/run` still exist for blocking\n+server-side calls. The frontend uses the async endpoints so the user can see\n+status, cursor events, interruption state, and resumable continuation.\n+\n+The run result includes:\n+\n+- locked entities\n+- evidence/fetch count\n+- tool and model-slot counts\n+- state-based eval score\n+- linked trace IDs\n+- stable result/events/status URLs\n+\n+## What Is Proven Here\n+\n+- Source workflows run with exactly 2 model slots: entity lock + synthesis.\n+- Tool calls/results are recorded as linked evidence.\n+- Completion is blocked if contract eval fails.\n+- The API exposes a clear state/result/event model.\n+- The frontend is a simple product surface, not a debug console.\n+- Run records survive process restart through `.runtime/harness.sqlite3`.\n+- Runtime understanding exposes intent, context plan, allowed tools, and next\n+  action hints before the loop runs.\n+- Workflow specs are persisted as typed runtime objects with nodes, edges,\n+  tools, policy, model settings, and interrupt behavior.\n+- Chat requests like “create an agent workflow that …” save a real\n+  `WorkflowSpec`; they do not only render an illustrative answer.\n+- Capability requests like image generation and connector/MCP setup are routed\n+  to capability resolution first. If the tool is configured, the runtime can\n+  execute it; if not, it returns a typed setup contract instead of pretending.\n+- Stock-analysis requests run a deterministic analyst-team workflow and write\n+  real markdown report artifacts that can be opened from the UI or API.\n+- The runtime can create reusable micro-tools for recurring checks. These are\n+  stored tool contracts, not arbitrary generated code, so checks stay bounded\n+  and do not dump large context into the model.\n+- Runs emit `prompt_packet` events showing what each node/model slot receives:\n+  objective, policy, allowed tools, compact context, and output contract.\n+- Runs can be interrupted and continued with a user directive while preserving\n+  workflow and objective state.\n+- SQLite stores run state and provenance-backed memory facts by default.\n+- Memory replacement uses add-before-void semantics.\n+\n+## Extension Points\n+\n+Replace `backend/adapters.py` with production adapters without changing the API:\n+\n+| Slot | Production implementation |\n+| --- | --- |\n+| `search` | Brave/Tavily/SearxNG/company search index |\n+| `fetch` | browser fetch, Jina, reader mode, internal docs |\n+| `entity_extraction` | small local model, provider model, deterministic parser |\n+| `synthesis` | Gemini/OpenAI/Claude/local model |\n+| `tool_bridge` | deterministic, HTTP/production, or `shovs_native` real ShovsOS handlers |\n+| `capability_resolver` | image generation, connector/MCP readiness, setup contracts |\n+\n+The invariant stays the same: adapters return data; `shovs-harness-core`\n+decides what counts as state.\n+\n+## Universal Runtime Pattern\n+\n+The harness is designed so a user can ask for a capability, not just a canned\n+workflow. For example:\n+\n+```text\n+Generate an image of a calm futuristic agent dashboard.\n+Connect Slack as an MCP connector and create a workflow for alerts.\n+Create an agent workflow that compares product prices across stores.\n+```\n+\n+The runtime classifies the request, checks available tools, checks required\n+configuration, and chooses the correct path:\n+\n+```text\n+capability exists + configured -> execute tool and return artifact/result\n+capability exists + not configured -> return setup contract\n+capability missing -> return missing capability record\n+workflow request -> save WorkflowSpec and expose it to the workflow mesh\n+stock analysis -> run analyst stages and write markdown report artifacts\n+source task -> run evidence harness with entity lock and verdict gate\n+```\n+\n+Stock-analysis reports are served as run files:\n+\n+```text\n+GET /api/runs/{run_id}/files/market_analyst.md\n+GET /api/runs/{run_id}/files/news_analyst.md\n+GET /api/runs/{run_id}/files/fundamentals_analyst.md\n+GET /api/runs/{run_id}/files/risk_report.md\n+GET /api/runs/{run_id}/files/final_report.md\n+```\n+\n+Current harness-native tools:\n+\n+```text\n+harness_workflow_draft\n+harness_workflow_create\n+harness_workflow_list\n+harness_workflow_run\n+harness_capability_resolve\n+harness_tool_draft\n+harness_tool_create\n+harness_tool_list\n+harness_tool_check\n+```\n+\n+Dynamic micro-tools support:\n+\n+```text\n+checklist         -> verifies compact required-term coverage\n+regex_check       -> extracts bounded matches such as URLs, prices, ratings\n+json_field_check  -> validates required JSON fields or nested paths\n+```\n+\n+Each generated tool has a `context_policy`, for example:\n+\n+```json\n+{\n+  \"max_input_chars\": 1600,\n+  \"return_raw\": false,\n+  \"summary_chars\": 280\n+}\n+```\n+\n+That policy is the point: the runtime can make a new narrow checker when useful\n+without feeding whole pages, traces, or chats back into the model.\n+\n+When `SHOVS_AGENT_HARNESS_TOOL_MODE=shovs_native`, the manifest also includes\n+real ShovsOS tools such as `web_search`, `web_fetch`, `image_search`,\n+`image_generate`, Alpha Vantage finance tools, and source-contract tools when\n+their dependencies are available.\n+\n+## What This Is Not\n+\n+This is not a full agent framework, a hosted service, or a replacement for the\n+main ShovsOS console. It is the small reusable harness spine companies can embed\n+into their own agent apps."},{"sha":"c595e4708ac713c9a57cba4c49b2acfc0139a9df","filename":"extractions/shovs-agent-harness/backend/__init__.py","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2F__init__.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2F__init__.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2F__init__.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,2 @@\n+\"\"\"Product-shaped backend around shovs-harness-core.\"\"\"\n+"},{"sha":"97f57ae6307f9f723b5b89458204ac4114dca7ba","filename":"extractions/shovs-agent-harness/backend/adapters.py","status":"added","additions":470,"deletions":0,"changes":470,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fadapters.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fadapters.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fadapters.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,470 @@\n+from __future__ import annotations\n+\n+import json\n+import re\n+import sys\n+from dataclasses import dataclass\n+from html import unescape\n+from pathlib import Path\n+from typing import Any, Protocol\n+from urllib.parse import quote, urlencode\n+from urllib.request import Request, urlopen\n+\n+from .tool_bridge import ShovsNativeToolBridge\n+\n+\n+PROJECT_ROOT = Path(__file__).resolve().parents[3]\n+if str(PROJECT_ROOT) not in sys.path:\n+    sys.path.insert(0, str(PROJECT_ROOT))\n+\n+\n+class SearchAdapter(Protocol):\n+    async def search(self, query: str) -> tuple[list[str], str]:\n+        ...\n+\n+\n+class FetchAdapter(Protocol):\n+    async def fetch(self, url: str) -> tuple[bool, str]:\n+        ...\n+\n+\n+class ModelSlotAdapter(Protocol):\n+    async def extract_entities(self, objective: str, discovery_text: str, n: int) -> list[str]:\n+        ...\n+\n+    async def synthesize(self, objective: str, sources: list[dict[str, Any]]) -> str:\n+        ...\n+\n+\n+@dataclass\n+class DeterministicAdapters:\n+    objective: str\n+    event_sink: Any | None = None\n+\n+    async def search(self, query: str) -> tuple[list[str], str]:\n+        self._event(\"tool\", \"success\", f\"web_search: {query}\", {\"query\": query, \"backend\": \"deterministic\"})\n+        topic = _topic_key(query)\n+        if not getattr(self, \"_searched_once\", False):\n+            self._searched_once = True\n+            return ([f\"https://sources.example/discovery/{i}\" for i in range(3)], discovery_text_for(self.objective))\n+        return ([f\"https://sources.example/{topic}/{i}\" for i in range(5)], f\"{topic} source candidates\")\n+\n+    async def fetch(self, url: str) -> tuple[bool, str]:\n+        self._event(\"tool\", \"success\", f\"web_fetch: {url}\", {\"url\": url, \"backend\": \"deterministic\"})\n+        return True, f\"Fetched source content for {url}. This deterministic source supports the final answer.\"\n+\n+    async def extract_entities(self, _objective: str, discovery_text: str, n: int) -> list[str]:\n+        self._event(\"model_slot\", \"success\", \"Locked entities from discovery text.\", {\"max_entities\": n, \"mode\": \"deterministic\"})\n+        return extract_entities(discovery_text, n)\n+\n+    async def synthesize(self, _objective: str, sources: list[dict[str, Any]]) -> str:\n+        self._event(\"model_slot\", \"success\", \"Synthesized from fetched evidence only.\", {\"source_count\": len(sources), \"mode\": \"deterministic\"})\n+        rows = \"\\n\".join(f\"| {item['entity']} | {item['url']} | source-backed |\" for item in sources)\n+        return \"| entity | source | note |\\n| --- | --- | --- |\\n\" + rows\n+\n+    def _event(self, phase: str, status: str, summary: str, data: dict[str, Any]) -> None:\n+        if self.event_sink:\n+            self.event_sink(phase, status, summary, data)\n+\n+\n+@dataclass\n+class ProductionAdapters(DeterministicAdapters):\n+    \"\"\"Real adapter set for portable deployments.\n+\n+    The harness does not import the main app's ToolRegistry. It implements the\n+    stable adapter slots directly so this folder can run as its own product.\n+    Missing keys/endpoints produce typed errors and a blocked verdict.\n+    \"\"\"\n+\n+    search_backend: str = \"auto\"\n+    search_url: str = \"\"\n+    brave_key: str = \"\"\n+    tavily_key: str = \"\"\n+    alpha_key: str = \"\"\n+    use_jina: bool = True\n+    timeout: int = 12\n+    model_slots_enabled: bool = False\n+    model_provider: str = \"auto\"\n+    model_name: str = \"\"\n+    model_temperature: float = 0.1\n+    model_max_tokens: int = 900\n+    native_bridge: ShovsNativeToolBridge | None = None\n+\n+    async def search(self, query: str) -> tuple[list[str], str]:\n+        if self._is_first_search() and _looks_like_market_movers(self.objective):\n+            if self.native_bridge and self.native_bridge.has(\"alpha_vantage_movers\"):\n+                native = await self.native_bridge.call(\"alpha_vantage_movers\", limit=10)\n+                payload = native.get(\"json\") if isinstance(native.get(\"json\"), dict) else {}\n+                urls, compact = _movers_to_urls_and_rows(payload.get(\"top_gainers\") if isinstance(payload, dict) else [])\n+                if native.get(\"ok\") and urls:\n+                    self._event(\"tool\", \"success\", f\"shovs_native alpha_vantage_movers: {len(urls)} gainers\", {\"backend\": \"shovs_native\", \"query\": query})\n+                    self._searched_once = True\n+                    return urls, compact\n+                self._event(\"tool\", \"warning\", \"shovs_native alpha_vantage_movers did not lock entities; falling back\", {\"native\": native})\n+\n+            if self.alpha_key:\n+                urls, compact = self._alpha_movers()\n+                if urls:\n+                    self._event(\"tool\", \"success\", f\"alpha_vantage_movers: {len(urls)} gainers\", {\"backend\": \"alpha_vantage\", \"query\": query})\n+                    self._searched_once = True\n+                    return urls, compact\n+\n+        if _looks_like_stock_news_query(query):\n+            if self.native_bridge and self.native_bridge.has(\"alpha_vantage_news\"):\n+                symbol = _symbol_from_query(query)\n+                native = await self.native_bridge.call(\"alpha_vantage_news\", symbol=symbol, limit=10)\n+                payload = native.get(\"json\") if isinstance(native.get(\"json\"), dict) else {}\n+                urls, compact = _news_to_urls_and_text(symbol, payload.get(\"items\") if isinstance(payload, dict) else [])\n+                if native.get(\"ok\") and urls:\n+                    self._event(\"tool\", \"success\", f\"shovs_native alpha_vantage_news: {query}\", {\"backend\": \"shovs_native\", \"query\": query, \"count\": len(urls)})\n+                    self._searched_once = True\n+                    return urls, compact\n+                self._event(\"tool\", \"warning\", \"shovs_native alpha_vantage_news did not return URLs; falling back\", {\"query\": query, \"native\": native})\n+\n+            if self.alpha_key:\n+                urls, compact = self._alpha_news(query)\n+                if urls:\n+                    self._event(\"tool\", \"success\", f\"alpha_vantage_news: {query}\", {\"backend\": \"alpha_vantage\", \"query\": query, \"count\": len(urls)})\n+                    self._searched_once = True\n+                    return urls, compact\n+\n+        if self.native_bridge and self.native_bridge.has(\"web_search\"):\n+            native = await self.native_bridge.call(\"web_search\", query=query, num_results=10, backend=self.search_backend)\n+            if native.get(\"ok\"):\n+                payload = native.get(\"json\") if isinstance(native.get(\"json\"), dict) else {}\n+                urls, compact = _results_to_urls_and_text(payload.get(\"results\") if isinstance(payload, dict) else [])\n+                if urls:\n+                    self._searched_once = True\n+                    self._event(\"tool\", \"success\", f\"shovs_native web_search returned {len(urls)} URLs\", {\"backend\": \"shovs_native\", \"query\": query})\n+                    return urls, compact\n+            self._event(\"tool\", \"warning\", \"shovs_native web_search did not return URLs; falling back\", {\"query\": query, \"native\": native})\n+\n+        self._searched_once = True\n+        backends = self._backend_order()\n+        errors: list[str] = []\n+        for backend in backends:\n+            try:\n+                if backend == \"searxng\":\n+                    urls, compact = self._search_searxng(query)\n+                elif backend == \"brave\":\n+                    urls, compact = self._search_brave(query)\n+                elif backend == \"tavily\":\n+                    urls, compact = self._search_tavily(query)\n+                else:\n+                    continue\n+                if urls:\n+                    self._event(\"tool\", \"success\", f\"web_search returned {len(urls)} URLs\", {\"backend\": backend, \"query\": query})\n+                    return urls, compact\n+            except Exception as exc:\n+                errors.append(f\"{backend}: {exc}\")\n+                self._event(\"tool\", \"error\", f\"{backend} search failed: {exc}\", {\"backend\": backend, \"query\": query})\n+        self._event(\"tool\", \"error\", \"web_search failed: no backend produced URLs\", {\"query\": query, \"errors\": errors})\n+        return [], \"\"\n+\n+    async def fetch(self, url: str) -> tuple[bool, str]:\n+        normalized = str(url or \"\").strip()\n+        if not normalized.startswith((\"http://\", \"https://\")):\n+            self._event(\"tool\", \"error\", \"web_fetch rejected invalid URL\", {\"url\": normalized})\n+            return False, \"\"\n+\n+        if self.native_bridge and self.native_bridge.has(\"web_fetch\"):\n+            native = await self.native_bridge.call(\"web_fetch\", url=normalized, max_chars=12000, use_jina=self.use_jina)\n+            payload = native.get(\"json\") if isinstance(native.get(\"json\"), dict) else {}\n+            content = str(payload.get(\"content\") or \"\")\n+            if native.get(\"ok\") and content:\n+                self._event(\"tool\", \"success\", f\"shovs_native web_fetch returned {len(content)} chars\", {\"url\": normalized, \"backend\": \"shovs_native\"})\n+                return True, content\n+            self._event(\"tool\", \"warning\", \"shovs_native web_fetch did not return content; falling back\", {\"url\": normalized, \"native\": native})\n+\n+        if self.use_jina:\n+            jina_url = f\"https://r.jina.ai/{normalized}\"\n+            try:\n+                text = _http_get(jina_url, self.timeout)\n+                compact = _clean_text(text)[:12000]\n+                if len(compact) > 100:\n+                    self._event(\"tool\", \"success\", f\"web_fetch via Jina returned {len(compact)} chars\", {\"url\": normalized, \"backend\": \"jina\"})\n+                    return True, compact\n+            except Exception as exc:\n+                self._event(\"tool\", \"warning\", f\"Jina fetch failed, falling back: {exc}\", {\"url\": normalized})\n+\n+        try:\n+            body = _http_get(normalized, self.timeout)\n+            compact = _html_to_text(body)[:12000]\n+            self._event(\"tool\", \"success\", f\"web_fetch returned {len(compact)} chars\", {\"url\": normalized, \"backend\": \"http\"})\n+            return bool(compact), compact\n+        except Exception as exc:\n+            self._event(\"tool\", \"error\", f\"web_fetch failed: {exc}\", {\"url\": normalized})\n+            return False, \"\"\n+\n+    async def extract_entities(self, objective: str, discovery_text: str, n: int) -> list[str]:\n+        if not self.model_slots_enabled:\n+            return await super().extract_entities(objective, discovery_text, n)\n+        prompt = (\n+            \"Extract the locked entities for this harness run.\\n\"\n+            \"Return ONLY JSON like {\\\"entities\\\":[\\\"A\\\",\\\"B\\\"]}.\\n\"\n+            f\"Need exactly {n} entities when available.\\n\"\n+            f\"Objective: {objective}\\n\"\n+            f\"Discovery text:\\n{discovery_text[:6000]}\"\n+        )\n+        try:\n+            text = await self._complete(prompt, max_tokens=300)\n+            entities = _parse_json_entities(text, n)\n+            if entities:\n+                self._event(\"model_slot\", \"success\", \"Model locked entities from discovery text.\", {\"max_entities\": n, \"mode\": \"model\"})\n+                return entities\n+        except Exception as exc:\n+            self._event(\"model_slot\", \"warning\", f\"Entity model slot failed, using deterministic parser: {exc}\", {\"mode\": \"fallback\"})\n+        return await super().extract_entities(objective, discovery_text, n)\n+\n+    async def synthesize(self, objective: str, sources: list[dict[str, Any]]) -> str:\n+        if not self.model_slots_enabled:\n+            return await super().synthesize(objective, sources)\n+        evidence = [\n+            {\n+                \"entity\": item.get(\"entity\"),\n+                \"url\": item.get(\"url\"),\n+                \"content\": str(item.get(\"content\") or \"\")[:1200],\n+            }\n+            for item in sources\n+        ]\n+        prompt = (\n+            \"Write the final answer for this harness run using ONLY the provided evidence.\\n\"\n+            \"If evidence is missing, say unresolved. Include a compact table with source URLs.\\n\"\n+            f\"Objective: {objective}\\n\"\n+            f\"Evidence JSON:\\n{json.dumps(evidence, ensure_ascii=False)}\"\n+        )\n+        try:\n+            answer = await self._complete(prompt, max_tokens=self.model_max_tokens)\n+            if answer.strip():\n+                self._event(\"model_slot\", \"success\", \"Model synthesized from fetched evidence only.\", {\"source_count\": len(sources), \"mode\": \"model\"})\n+                return answer.strip()\n+        except Exception as exc:\n+            self._event(\"model_slot\", \"warning\", f\"Synthesis model slot failed, using deterministic table: {exc}\", {\"mode\": \"fallback\"})\n+        return await super().synthesize(objective, sources)\n+\n+    def _is_first_search(self) -> bool:\n+        return not getattr(self, \"_searched_once\", False)\n+\n+    def _backend_order(self) -> list[str]:\n+        requested = self.search_backend.lower().strip() or \"auto\"\n+        if requested != \"auto\":\n+            return [requested]\n+        order: list[str] = []\n+        if self.search_url:\n+            order.append(\"searxng\")\n+        if self.brave_key:\n+            order.append(\"brave\")\n+        if self.tavily_key:\n+            order.append(\"tavily\")\n+        return order\n+\n+    def _search_searxng(self, query: str) -> tuple[list[str], str]:\n+        if not self.search_url:\n+            raise RuntimeError(\"SHOVS_AGENT_HARNESS_SEARCH_URL is not configured\")\n+        url = self.search_url + (\"&\" if \"?\" in self.search_url else \"?\") + urlencode({\"q\": query, \"format\": \"json\"})\n+        data = json.loads(_http_get(url, self.timeout))\n+        results = data.get(\"results\") if isinstance(data, dict) else []\n+        return _results_to_urls_and_text(results)\n+\n+    def _search_brave(self, query: str) -> tuple[list[str], str]:\n+        if not self.brave_key:\n+            raise RuntimeError(\"BRAVE_SEARCH_KEY is not configured\")\n+        url = \"https://api.search.brave.com/res/v1/web/search?\" + urlencode({\"q\": query, \"count\": 10})\n+        data = json.loads(_http_get(url, self.timeout, headers={\"X-Subscription-Token\": self.brave_key}))\n+        results = ((data.get(\"web\") or {}).get(\"results\") or []) if isinstance(data, dict) else []\n+        return _results_to_urls_and_text(results)\n+\n+    def _search_tavily(self, query: str) -> tuple[list[str], str]:\n+        if not self.tavily_key:\n+            raise RuntimeError(\"TAVILY_API_KEY is not configured\")\n+        body = json.dumps({\"api_key\": self.tavily_key, \"query\": query, \"max_results\": 10, \"include_answer\": False}).encode(\"utf-8\")\n+        data = json.loads(_http_post(\"https://api.tavily.com/search\", body, self.timeout))\n+        results = data.get(\"results\") if isinstance(data, dict) else []\n+        return _results_to_urls_and_text(results)\n+\n+    def _alpha_movers(self) -> tuple[list[str], str]:\n+        data = self._alpha_get(\"TOP_GAINERS_LOSERS\")\n+        gainers = data.get(\"top_gainers\") if isinstance(data, dict) else []\n+        return _movers_to_urls_and_rows(gainers)\n+\n+    def _alpha_news(self, query: str) -> tuple[list[str], str]:\n+        symbol = _symbol_from_query(query)\n+        if not symbol:\n+            return [], \"\"\n+        data = self._alpha_get(\"NEWS_SENTIMENT\", tickers=symbol, limit=10)\n+        feed = data.get(\"feed\") if isinstance(data, dict) else []\n+        return _news_to_urls_and_text(symbol, feed)\n+\n+    def _alpha_get(self, function: str, **params: Any) -> dict[str, Any]:\n+        query = {\"function\": function, \"apikey\": self.alpha_key, **{k: v for k, v in params.items() if v not in (\"\", None)}}\n+        data = json.loads(_http_get(\"https://www.alphavantage.co/query?\" + urlencode(query), self.timeout))\n+        if data.get(\"Error Message\") or data.get(\"Note\") or data.get(\"Information\"):\n+            raise RuntimeError(str(data.get(\"Error Message\") or data.get(\"Note\") or data.get(\"Information\")))\n+        return data\n+\n+    async def _complete(self, prompt: str, *, max_tokens: int) -> str:\n+        from llm.adapter_factory import create_adapter, get_default_model, strip_provider_prefix\n+\n+        adapter = create_adapter(self.model_provider)\n+        model = strip_provider_prefix(self.model_name) if self.model_name else get_default_model(adapter)\n+        return await adapter.complete(\n+            model=model,\n+            messages=[{\"role\": \"user\", \"content\": prompt}],\n+            temperature=self.model_temperature,\n+            max_tokens=max_tokens,\n+            reasoning_enabled=False,\n+        )\n+\n+\n+def _news_to_urls_and_text(symbol: str, feed: Any) -> tuple[list[str], str]:\n+        urls: list[str] = []\n+        rows: list[str] = []\n+        for item in feed if isinstance(feed, list) else []:\n+            if not isinstance(item, dict):\n+                continue\n+            url = str(item.get(\"url\") or \"\").strip()\n+            if url.startswith((\"http://\", \"https://\")) and url not in urls:\n+                urls.append(url)\n+            rows.append(f\"{symbol} {item.get('title', '')} {item.get('summary', '')}\")\n+        return urls, \" \".join(rows)\n+\n+def _movers_to_urls_and_rows(gainers: Any) -> tuple[list[str], str]:\n+    rows = []\n+    urls = []\n+    for item in gainers[:10] if isinstance(gainers, list) else []:\n+        if not isinstance(item, dict):\n+            continue\n+        symbol = _clean_symbol(item.get(\"ticker\") or item.get(\"symbol\") or \"\")\n+        if not symbol:\n+            continue\n+        rows.append(f\"{symbol} {item.get('price', '')} {item.get('change_percentage', item.get('change_percent', ''))}\")\n+        urls.append(f\"alpha-vantage://movers/{symbol}\")\n+    return urls, \", \".join(rows)\n+\n+\n+def make_adapters(config: Any, objective: str, event_sink: Any | None = None) -> DeterministicAdapters:\n+    tool_mode = str(getattr(config, \"tool_mode\", \"deterministic\")).lower()\n+    if tool_mode in {\"http\", \"real\", \"searxng\", \"production\", \"shovs\", \"shovs_native\"}:\n+        native_bridge = ShovsNativeToolBridge() if tool_mode in {\"shovs\", \"shovs_native\"} else None\n+        return ProductionAdapters(\n+            objective=objective,\n+            event_sink=event_sink,\n+            search_backend=str(getattr(config, \"search_backend\", \"auto\")),\n+            search_url=str(getattr(config, \"search_url\", \"\")),\n+            brave_key=str(getattr(config, \"brave_search_key\", \"\")),\n+            tavily_key=str(getattr(config, \"tavily_api_key\", \"\")),\n+            alpha_key=str(getattr(config, \"alpha_vantage_api_key\", \"\")),\n+            use_jina=bool(getattr(config, \"use_jina\", True)),\n+            timeout=int(getattr(config, \"fetch_timeout_seconds\", 12)),\n+            model_slots_enabled=bool(getattr(config, \"model_slots_enabled\", False)),\n+            model_provider=str(getattr(config, \"model_provider\", \"auto\")),\n+            model_name=str(getattr(config, \"model_name\", \"\")),\n+            model_temperature=float(getattr(config, \"model_temperature\", 0.1)),\n+            model_max_tokens=int(getattr(config, \"model_max_tokens\", 900)),\n+            native_bridge=native_bridge,\n+        )\n+    return DeterministicAdapters(objective=objective, event_sink=event_sink)\n+\n+\n+def discovery_text_for(objective: str) -> str:\n+    lowered = objective.lower()\n+    if \"sushi\" in lowered or \"restaurant\" in lowered or \"place\" in lowered:\n+        return \"Miku, Sushi Masaki Saito, Yasu\"\n+    if \"buy\" in lowered or \"price\" in lowered or \"store\" in lowered:\n+        return \"Costco, Walmart, BestBuy\"\n+    if \"stock\" in lowered or \"market\" in lowered or \"mover\" in lowered:\n+        return \"ROKU, TBN, SENEA, EPAM\"\n+    return \"ALPHA, BETA, GAMMA\"\n+\n+\n+def extract_entities(text: str, n: int) -> list[str]:\n+    cleaned: list[str] = []\n+    for raw in re.split(r\"[,;\\n|]+\", str(text or \"\")):\n+        item = raw.strip()\n+        if not item:\n+            continue\n+        token = re.match(r\"[A-Za-z][A-Za-z0-9._-]{0,15}(?:\\s+[A-Za-z][A-Za-z0-9._-]{1,24})?\", item)\n+        if not token:\n+            continue\n+        value = token.group(0).strip().upper()\n+        if value and value not in cleaned:\n+            cleaned.append(value)\n+    if len(cleaned) < n:\n+        for token in re.findall(r\"\\b[A-Z]{1,6}\\b\", str(text or \"\").upper()):\n+            if token not in cleaned:\n+                cleaned.append(token)\n+    return cleaned[:n]\n+\n+\n+def _results_to_urls_and_text(results: Any) -> tuple[list[str], str]:\n+    urls: list[str] = []\n+    text: list[str] = []\n+    for item in results if isinstance(results, list) else []:\n+        if not isinstance(item, dict):\n+            continue\n+        url = str(item.get(\"url\") or item.get(\"link\") or \"\").strip()\n+        if url.startswith((\"http://\", \"https://\")) and url not in urls:\n+            urls.append(url)\n+        text.append(\" \".join(str(item.get(k) or \"\") for k in (\"title\", \"content\", \"snippet\", \"description\")))\n+    return urls, _clean_text(\" \".join(text))\n+\n+\n+def _parse_json_entities(text: str, n: int) -> list[str]:\n+    match = re.search(r\"\\{.*\\}\", str(text or \"\"), re.DOTALL)\n+    if not match:\n+        return []\n+    try:\n+        data = json.loads(match.group(0))\n+    except Exception:\n+        return []\n+    return extract_entities(\",\".join(str(item) for item in data.get(\"entities\", [])), n)\n+\n+\n+def _looks_like_market_movers(text: str) -> bool:\n+    lowered = str(text or \"\").lower()\n+    return any(term in lowered for term in (\"top mover\", \"top movers\", \"gainers\", \"stock\", \"stocks\", \"ticker\", \"market\"))\n+\n+\n+def _looks_like_stock_news_query(query: str) -> bool:\n+    lowered = str(query or \"\").lower()\n+    return \"stock\" in lowered and \"news\" in lowered and bool(_symbol_from_query(query))\n+\n+\n+def _symbol_from_query(query: str) -> str:\n+    first = str(query or \"\").strip().split(\" \", 1)[0] if str(query or \"\").strip() else \"\"\n+    return _clean_symbol(first)\n+\n+\n+def _clean_symbol(value: Any) -> str:\n+    return re.sub(r\"[^A-Za-z0-9._-]\", \"\", str(value or \"\").strip().upper())[:16]\n+\n+\n+def _topic_key(query: str) -> str:\n+    return re.sub(r\"[^A-Za-z0-9]+\", \"-\", (query.split()[0] if query.split() else \"SRC\").upper()).strip(\"-\") or \"SRC\"\n+\n+\n+def _http_get(url: str, timeout: int, headers: dict[str, str] | None = None) -> str:\n+    request = Request(url, headers={\"User-Agent\": \"ShovsAgentHarness/0.3\", **(headers or {})})\n+    with urlopen(request, timeout=timeout) as response:\n+        return response.read().decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _http_post(url: str, body: bytes, timeout: int, headers: dict[str, str] | None = None) -> str:\n+    request = Request(\n+        url,\n+        data=body,\n+        headers={\"User-Agent\": \"ShovsAgentHarness/0.3\", \"Content-Type\": \"application/json\", **(headers or {})},\n+        method=\"POST\",\n+    )\n+    with urlopen(request, timeout=timeout) as response:\n+        return response.read().decode(\"utf-8\", errors=\"replace\")\n+\n+\n+def _html_to_text(body: str) -> str:\n+    text = re.sub(r\"(?is)<(script|style).*?</\\1>\", \" \", str(body or \"\"))\n+    text = re.sub(r\"(?s)<[^>]+>\", \" \", text)\n+    return _clean_text(unescape(text))\n+\n+\n+def _clean_text(text: str) -> str:\n+    return re.sub(r\"\\s+\", \" \", str(text or \"\")).strip()"},{"sha":"3b24f70fbced70b8ac9a96d978801d6af5ef817d","filename":"extractions/shovs-agent-harness/backend/config.py","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fconfig.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fconfig.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fconfig.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,67 @@\n+from __future__ import annotations\n+\n+import os\n+from dataclasses import asdict, dataclass\n+from pathlib import Path\n+\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+\n+\n+@dataclass(frozen=True)\n+class HarnessConfig:\n+    host: str = \"127.0.0.1\"\n+    port: int = 8095\n+    frontend_port: int = 5181\n+    storage_path: Path = ROOT / \".runtime\" / \"harness.sqlite3\"\n+    memory_path: Path = ROOT / \".runtime\" / \"harness.sqlite3\"\n+    tool_mode: str = \"deterministic\"\n+    search_backend: str = \"auto\"\n+    search_url: str = \"\"\n+    brave_search_key: str = \"\"\n+    tavily_api_key: str = \"\"\n+    alpha_vantage_api_key: str = \"\"\n+    use_jina: bool = True\n+    fetch_timeout_seconds: int = 12\n+    model_provider: str = \"auto\"\n+    model_name: str = \"\"\n+    model_slots_enabled: bool = False\n+    model_temperature: float = 0.1\n+    model_max_tokens: int = 900\n+    cors_origin: str = \"*\"\n+    max_entities_default: int = 3\n+    urls_per_entity_default: int = 3\n+\n+    @classmethod\n+    def from_env(cls) -> \"HarnessConfig\":\n+        return cls(\n+            host=os.getenv(\"SHOVS_AGENT_HARNESS_HOST\", \"127.0.0.1\"),\n+            port=int(os.getenv(\"SHOVS_AGENT_HARNESS_PORT\", \"8095\")),\n+            frontend_port=int(os.getenv(\"SHOVS_AGENT_HARNESS_FRONTEND_PORT\", \"5181\")),\n+            storage_path=Path(os.getenv(\"SHOVS_AGENT_HARNESS_STORE\", str(ROOT / \".runtime\" / \"harness.sqlite3\"))),\n+            memory_path=Path(os.getenv(\"SHOVS_AGENT_HARNESS_MEMORY_STORE\", os.getenv(\"SHOVS_AGENT_HARNESS_STORE\", str(ROOT / \".runtime\" / \"harness.sqlite3\")))),\n+            tool_mode=os.getenv(\"SHOVS_AGENT_HARNESS_TOOL_MODE\", \"deterministic\"),\n+            search_backend=os.getenv(\"SHOVS_AGENT_HARNESS_SEARCH_BACKEND\", \"auto\"),\n+            search_url=os.getenv(\"SHOVS_AGENT_HARNESS_SEARCH_URL\", \"\"),\n+            brave_search_key=os.getenv(\"BRAVE_SEARCH_KEY\", \"\"),\n+            tavily_api_key=os.getenv(\"TAVILY_API_KEY\", \"\"),\n+            alpha_vantage_api_key=os.getenv(\"ALPHA_VANTAGE_API_KEY\", \"\") or os.getenv(\"ALPHAVANTAGE_API_KEY\", \"\"),\n+            use_jina=os.getenv(\"SHOVS_AGENT_HARNESS_USE_JINA\", \"true\").lower() not in {\"0\", \"false\", \"no\"},\n+            fetch_timeout_seconds=int(os.getenv(\"SHOVS_AGENT_HARNESS_FETCH_TIMEOUT\", \"12\")),\n+            model_provider=os.getenv(\"SHOVS_AGENT_HARNESS_MODEL_PROVIDER\", os.getenv(\"LLM_PROVIDER\", \"auto\")),\n+            model_name=os.getenv(\"SHOVS_AGENT_HARNESS_MODEL\", \"\"),\n+            model_slots_enabled=os.getenv(\"SHOVS_AGENT_HARNESS_MODEL_SLOTS\", \"false\").lower() in {\"1\", \"true\", \"yes\"},\n+            model_temperature=float(os.getenv(\"SHOVS_AGENT_HARNESS_MODEL_TEMPERATURE\", \"0.1\")),\n+            model_max_tokens=int(os.getenv(\"SHOVS_AGENT_HARNESS_MODEL_MAX_TOKENS\", \"900\")),\n+            cors_origin=os.getenv(\"SHOVS_AGENT_HARNESS_CORS_ORIGIN\", \"*\"),\n+        )\n+\n+    def to_dict(self) -> dict[str, str | int | float | bool]:\n+        data = asdict(self)\n+        data[\"storage_path\"] = str(self.storage_path)\n+        data[\"memory_path\"] = str(self.memory_path)\n+        for key in (\"brave_search_key\", \"tavily_api_key\", \"alpha_vantage_api_key\"):\n+            configured = bool(str(data.get(key) or \"\").strip())\n+            data[f\"{key}_configured\"] = configured\n+            data[key] = \"configured\" if configured else \"\"\n+        return data"},{"sha":"a5b3286fa9fa960c0e462c3978f988d9ec478940","filename":"extractions/shovs-agent-harness/backend/harness_api.py","status":"added","additions":345,"deletions":0,"changes":345,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fharness_api.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fharness_api.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fharness_api.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,345 @@\n+from __future__ import annotations\n+\n+import asyncio\n+import json\n+import sys\n+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n+from typing import Any\n+from urllib.parse import urlparse\n+\n+from .config import HarnessConfig\n+from .service import HarnessService\n+from .store import MemoryChatStore, MemoryMemoryFactStore, MemoryRunStore\n+from .workflows import draft_workflow\n+\n+\n+SERVICE = HarnessService()\n+\n+\n+async def execute_harness_run(objective: str):\n+    \"\"\"Compatibility helper used by tests and embedders.\"\"\"\n+\n+    return await SERVICE.execute(objective)\n+\n+\n+def compare_plain_vs_harness(objective: str) -> dict[str, Any]:\n+    \"\"\"Compatibility helper used by tests and embedders.\"\"\"\n+\n+    return SERVICE.compare(objective)\n+\n+\n+def create_test_service() -> HarnessService:\n+    return HarnessService(\n+        config=HarnessConfig(),\n+        store=MemoryRunStore(),\n+        memory_store=MemoryMemoryFactStore(),\n+        chat_store=MemoryChatStore(),\n+    )\n+\n+\n+class Handler(BaseHTTPRequestHandler):\n+    server_version = \"ShovsAgentHarness/0.3\"\n+\n+    def do_OPTIONS(self) -> None:\n+        self.send_json({\"ok\": True})\n+\n+    def do_GET(self) -> None:\n+        path = urlparse(self.path).path\n+        if path in {\"/\", \"/health\"}:\n+            self.send_json({\"ok\": True, \"service\": \"shovs-agent-harness\", \"version\": \"0.3.0\"})\n+            return\n+        if path == \"/api/manifest\":\n+            self.send_json(SERVICE.manifest())\n+            return\n+        if path == \"/api/tools\":\n+            self.send_json(SERVICE.tool_manifest())\n+            return\n+        if path == \"/api/runs\":\n+            self.send_json({\"runs\": [run.summary() for run in SERVICE.list_runs()]})\n+            return\n+        if path == \"/api/jobs\":\n+            self.send_json(SERVICE.job_status())\n+            return\n+        if path == \"/api/chat/sessions\":\n+            self.send_json(SERVICE.list_sessions())\n+            return\n+        match_chat = _match_chat_path(path)\n+        if match_chat:\n+            query = urlparse(self.path).query\n+            params = _query_params(query)\n+            limit = int(params.get(\"limit\") or \"80\")\n+            self.send_json(SERVICE.list_chat(match_chat, limit=limit))\n+            return\n+        if path == \"/api/workflows\":\n+            self.send_json(SERVICE.list_workflows())\n+            return\n+        match = _match_workflow_path(path, \"\")\n+        if match:\n+            payload = SERVICE.get_workflow(match)\n+            self.send_json(payload if payload else {\"ok\": False, \"error\": \"workflow not found\"}, status=200 if payload else 404)\n+            return\n+        if path == \"/api/memory\":\n+            query = urlparse(self.path).query\n+            params = _query_params(query)\n+            self.send_json(\n+                SERVICE.list_memory(\n+                    owner_id=params.get(\"owner_id\") or \"default\",\n+                    include_voided=(params.get(\"include_voided\") or \"\").lower() in {\"1\", \"true\", \"yes\"},\n+                )\n+            )\n+            return\n+        match = _match_run_path(path, \"\")\n+        if match:\n+            run = SERVICE.get_run(match)\n+            self.send_json(run.to_dict() if run else {\"ok\": False, \"error\": \"run not found\"}, status=200 if run else 404)\n+            return\n+        match = _match_run_path(path, \"/events\")\n+        if match:\n+            run = SERVICE.get_run(match)\n+            self.send_json({\"events\": [event.to_dict() for event in run.events]} if run else {\"ok\": False, \"error\": \"run not found\"}, status=200 if run else 404)\n+            return\n+        match = _match_run_path(path, \"/result\")\n+        if match:\n+            run = SERVICE.get_run(match)\n+            if not run:\n+                self.send_json({\"ok\": False, \"error\": \"run not found\"}, status=404)\n+            elif not run.result:\n+                self.send_json({\"ok\": False, \"error\": \"result not ready\"}, status=409)\n+            else:\n+                self.send_json(run.result)\n+            return\n+        match = _match_run_path(path, \"/context\")\n+        if match:\n+            payload = SERVICE.run_context(match)\n+            self.send_json(payload if payload else {\"ok\": False, \"error\": \"run not found\"}, status=200 if payload else 404)\n+            return\n+        match = _match_run_path(path, \"/evidence\")\n+        if match:\n+            payload = SERVICE.run_evidence(match)\n+            self.send_json(payload if payload else {\"ok\": False, \"error\": \"run not found\"}, status=200 if payload else 404)\n+            return\n+        match_file = _match_run_file_path(path)\n+        if match_file:\n+            run_id, filename = match_file\n+            payload = SERVICE.read_run_file(run_id, filename)\n+            if not payload:\n+                self.send_json({\"ok\": False, \"error\": \"file not found\"}, status=404)\n+                return\n+            self.send_response(200)\n+            body = payload[\"content\"].encode(\"utf-8\")\n+            self.send_header(\"Content-Type\", payload[\"content_type\"])\n+            self.send_header(\"Content-Length\", str(len(body)))\n+            self.send_header(\"Access-Control-Allow-Origin\", SERVICE.config.cors_origin)\n+            self.end_headers()\n+            self.wfile.write(body)\n+            return\n+        self.send_json({\"ok\": False, \"error\": \"not found\"}, status=404)\n+\n+    def do_POST(self) -> None:\n+        path = urlparse(self.path).path\n+        payload = self.read_json()\n+        if path == \"/api/workflows/draft\":\n+            self.send_json({\"workflow\": draft_workflow(str(payload.get(\"prompt\") or payload.get(\"objective\") or \"\")).to_dict()})\n+            return\n+        if path == \"/api/workflows\":\n+            try:\n+                self.send_json(SERVICE.create_workflow(payload))\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=400)\n+            return\n+        match = _match_workflow_path(path, \"/run_async\")\n+        if match:\n+            try:\n+                run = SERVICE.start_workflow(match, payload)\n+                self.send_json(run.to_dict(), status=202)\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=404)\n+            return\n+        match = _match_workflow_path(path, \"/run\")\n+        if match:\n+            try:\n+                run = asyncio.run(SERVICE.run_workflow(match, payload))\n+                self.send_json(run.to_dict())\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=404)\n+            return\n+        if path == \"/api/runtime/understand\":\n+            objective = _objective_from_payload(payload)\n+            if not objective:\n+                self.send_json({\"ok\": False, \"error\": \"objective is required\"}, status=400)\n+                return\n+            self.send_json({\"understanding\": SERVICE.understand(objective)})\n+            return\n+        if path == \"/api/runs/async\":\n+            objective = _objective_from_payload(payload)\n+            if not objective:\n+                self.send_json({\"ok\": False, \"error\": \"objective is required\"}, status=400)\n+                return\n+            run_config = payload.get(\"run_config\") if isinstance(payload.get(\"run_config\"), dict) else {}\n+            if payload.get(\"session_id\") or payload.get(\"thread_id\"):\n+                run_config = {**run_config, \"session_id\": str(payload.get(\"session_id\") or payload.get(\"thread_id\") or \"\")}\n+            workflow_override = payload.get(\"workflow\") if isinstance(payload.get(\"workflow\"), dict) else None\n+            run = SERVICE.start_run(objective, workflow_override=workflow_override, run_config=run_config)\n+            self.send_json(run.to_dict(), status=202)\n+            return\n+        if path == \"/api/runs\":\n+            objective = _objective_from_payload(payload)\n+            if not objective:\n+                self.send_json({\"ok\": False, \"error\": \"objective is required\"}, status=400)\n+                return\n+            run_config = payload.get(\"run_config\") if isinstance(payload.get(\"run_config\"), dict) else {}\n+            if payload.get(\"session_id\") or payload.get(\"thread_id\"):\n+                run_config = {**run_config, \"session_id\": str(payload.get(\"session_id\") or payload.get(\"thread_id\") or \"\")}\n+            workflow_override = payload.get(\"workflow\") if isinstance(payload.get(\"workflow\"), dict) else None\n+            run = asyncio.run(SERVICE.execute(objective, workflow_override=workflow_override, run_config=run_config))\n+            self.send_json(run.to_dict())\n+            return\n+        match = _match_run_path(path, \"/continue\")\n+        if match:\n+            try:\n+                run = asyncio.run(SERVICE.continue_run(match, directive=str(payload.get(\"directive\") or payload.get(\"message\") or \"\")))\n+                self.send_json(run.to_dict())\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=404)\n+            return\n+        match = _match_run_path(path, \"/interrupt\")\n+        if match:\n+            try:\n+                self.send_json(SERVICE.interrupt_run(match, reason=str(payload.get(\"reason\") or payload.get(\"message\") or \"\")))\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=404)\n+            return\n+        if path == \"/api/compare\":\n+            objective = _objective_from_payload(payload) or \"Search top 3 stocks, search each, fetch 3 URLs each.\"\n+            self.send_json(SERVICE.compare(objective))\n+            return\n+        if path == \"/api/tools/call\":\n+            self.send_json(asyncio.run(SERVICE.call_tool(payload)))\n+            return\n+        if path == \"/api/memory\":\n+            try:\n+                self.send_json(SERVICE.remember_fact(payload))\n+            except ValueError as exc:\n+                self.send_json({\"ok\": False, \"error\": str(exc)}, status=400)\n+            return\n+        match = _match_memory_void_path(path)\n+        if match:\n+            self.send_json(\n+                SERVICE.void_memory(\n+                    match,\n+                    owner_id=str(payload.get(\"owner_id\") or \"default\"),\n+                    reason=str(payload.get(\"reason\") or \"\"),\n+                )\n+            )\n+            return\n+        self.send_json({\"ok\": False, \"error\": \"not found\"}, status=404)\n+\n+    def read_json(self) -> dict[str, Any]:\n+        length = int(self.headers.get(\"content-length\") or \"0\")\n+        if length <= 0:\n+            return {}\n+        try:\n+            parsed = json.loads(self.rfile.read(length).decode(\"utf-8\"))\n+            return parsed if isinstance(parsed, dict) else {}\n+        except Exception:\n+            return {}\n+\n+    def send_json(self, payload: dict[str, Any], *, status: int = 200) -> None:\n+        body = json.dumps(payload, indent=2, sort_keys=True).encode(\"utf-8\")\n+        self.send_response(status)\n+        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n+        self.send_header(\"Content-Length\", str(len(body)))\n+        self.send_header(\"Access-Control-Allow-Origin\", SERVICE.config.cors_origin)\n+        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n+        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type, Authorization\")\n+        self.end_headers()\n+        self.wfile.write(body)\n+\n+    def log_message(self, fmt: str, *args: Any) -> None:\n+        sys.stderr.write(\"[shovs-agent-harness] \" + fmt % args + \"\\n\")\n+\n+\n+def _objective_from_payload(payload: dict[str, Any]) -> str:\n+    objective = str(payload.get(\"objective\") or payload.get(\"prompt\") or \"\").strip()\n+    if objective:\n+        return objective\n+    input_payload = payload.get(\"input\")\n+    if isinstance(input_payload, dict):\n+        return str(input_payload.get(\"objective\") or \"\").strip()\n+    return \"\"\n+\n+\n+def _match_run_path(path: str, suffix: str) -> str:\n+    prefix = \"/api/runs/\"\n+    if not path.startswith(prefix) or not path.endswith(suffix):\n+        return \"\"\n+    run_id = path[len(prefix):]\n+    if suffix:\n+        run_id = run_id[: -len(suffix)]\n+    return run_id if run_id and \"/\" not in run_id else \"\"\n+\n+\n+def _match_run_file_path(path: str) -> tuple[str, str] | None:\n+    prefix = \"/api/runs/\"\n+    marker = \"/files/\"\n+    if not path.startswith(prefix) or marker not in path:\n+        return None\n+    rest = path[len(prefix):]\n+    run_id, _, filename = rest.partition(marker)\n+    if not run_id or \"/\" in run_id or not filename or \"/\" in filename:\n+        return None\n+    return run_id, filename\n+\n+\n+def _match_memory_void_path(path: str) -> str:\n+    prefix = \"/api/memory/\"\n+    suffix = \"/void\"\n+    if not path.startswith(prefix) or not path.endswith(suffix):\n+        return \"\"\n+    fact_id = path[len(prefix): -len(suffix)]\n+    return fact_id if fact_id and \"/\" not in fact_id else \"\"\n+\n+\n+def _match_workflow_path(path: str, suffix: str) -> str:\n+    prefix = \"/api/workflows/\"\n+    if not path.startswith(prefix) or not path.endswith(suffix):\n+        return \"\"\n+    workflow_id = path[len(prefix):]\n+    if suffix:\n+        workflow_id = workflow_id[: -len(suffix)]\n+    return workflow_id if workflow_id and \"/\" not in workflow_id else \"\"\n+\n+\n+def _match_chat_path(path: str) -> str:\n+    prefix = \"/api/chat/\"\n+    if not path.startswith(prefix):\n+        return \"\"\n+    session_id = path[len(prefix):]\n+    return session_id if session_id and \"/\" not in session_id else \"\"\n+\n+\n+def _query_params(query: str) -> dict[str, str]:\n+    out: dict[str, str] = {}\n+    for part in str(query or \"\").split(\"&\"):\n+        if not part:\n+            continue\n+        key, _, value = part.partition(\"=\")\n+        out[key] = value\n+    return out\n+\n+\n+def main() -> int:\n+    config = HarnessConfig.from_env()\n+    server = ThreadingHTTPServer((config.host, config.port), Handler)\n+    print(f\"Shovs Agent Harness backend: http://{config.host}:{config.port}\")\n+    try:\n+        server.serve_forever()\n+    except KeyboardInterrupt:\n+        print(\"\\nStopping backend.\")\n+    finally:\n+        server.server_close()\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(main())"},{"sha":"c62b80348c6a5bfdd84ecbfaae5b8bfb7667a31e","filename":"extractions/shovs-agent-harness/backend/models.py","status":"added","additions":252,"deletions":0,"changes":252,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fmodels.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fmodels.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fmodels.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,252 @@\n+from __future__ import annotations\n+\n+import uuid\n+from dataclasses import asdict, dataclass, field\n+from datetime import datetime, timezone\n+from typing import Any\n+\n+\n+def now() -> str:\n+    return datetime.now(timezone.utc).isoformat()\n+\n+\n+def rid(prefix: str) -> str:\n+    return f\"{prefix}_{uuid.uuid4().hex[:12]}\"\n+\n+\n+@dataclass(frozen=True)\n+class WorkflowDraft:\n+    id: str\n+    label: str\n+    description: str\n+    policy: str\n+    tools: list[str]\n+    input_schema: dict[str, str]\n+    output_schema: dict[str, Any]\n+    sample_input: dict[str, Any]\n+    edge: str\n+    created_at: str = field(default_factory=now)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+\n+@dataclass\n+class WorkflowSpec:\n+    workflow_id: str\n+    label: str\n+    objective: str\n+    policy: str\n+    tools: list[str]\n+    nodes: list[dict[str, Any]]\n+    edges: list[dict[str, Any]]\n+    input_schema: dict[str, Any]\n+    output_schema: dict[str, Any]\n+    runtime: dict[str, Any]\n+    status: str = \"active\"\n+    created_at: str = field(default_factory=now)\n+    updated_at: str = field(default_factory=now)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"WorkflowSpec\":\n+        return cls(\n+            workflow_id=str(data.get(\"workflow_id\") or data.get(\"id\") or rid(\"wf\")),\n+            label=str(data.get(\"label\") or \"Untitled workflow\"),\n+            objective=str(data.get(\"objective\") or \"\"),\n+            policy=str(data.get(\"policy\") or \"plan_execute\"),\n+            tools=list(data.get(\"tools\") or []),\n+            nodes=[dict(item) for item in data.get(\"nodes\") or [] if isinstance(item, dict)],\n+            edges=[dict(item) for item in data.get(\"edges\") or [] if isinstance(item, dict)],\n+            input_schema=dict(data.get(\"input_schema\") or {\"objective\": \"string\"}),\n+            output_schema=dict(data.get(\"output_schema\") or {}),\n+            runtime=dict(data.get(\"runtime\") or {}),\n+            status=str(data.get(\"status\") or \"active\"),\n+            created_at=str(data.get(\"created_at\") or now()),\n+            updated_at=str(data.get(\"updated_at\") or now()),\n+        )\n+\n+\n+@dataclass\n+class DynamicToolSpec:\n+    tool_id: str\n+    name: str\n+    description: str\n+    kind: str\n+    input_schema: dict[str, Any]\n+    check_schema: dict[str, Any]\n+    context_policy: dict[str, Any]\n+    status: str = \"active\"\n+    created_at: str = field(default_factory=now)\n+    updated_at: str = field(default_factory=now)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"DynamicToolSpec\":\n+        return cls(\n+            tool_id=str(data.get(\"tool_id\") or data.get(\"id\") or rid(\"tool\")),\n+            name=str(data.get(\"name\") or \"unnamed_tool\"),\n+            description=str(data.get(\"description\") or \"\"),\n+            kind=str(data.get(\"kind\") or \"checklist\"),\n+            input_schema=dict(data.get(\"input_schema\") or {\"text\": \"string\"}),\n+            check_schema=dict(data.get(\"check_schema\") or {}),\n+            context_policy=dict(data.get(\"context_policy\") or {\"max_input_chars\": 1200, \"return_raw\": False}),\n+            status=str(data.get(\"status\") or \"active\"),\n+            created_at=str(data.get(\"created_at\") or now()),\n+            updated_at=str(data.get(\"updated_at\") or now()),\n+        )\n+\n+\n+@dataclass\n+class ChatTurn:\n+    turn_id: str\n+    session_id: str\n+    role: str\n+    content: str\n+    run_id: str = \"\"\n+    summary: str = \"\"\n+    metadata: dict[str, Any] = field(default_factory=dict)\n+    created_at: str = field(default_factory=now)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"ChatTurn\":\n+        return cls(\n+            turn_id=str(data.get(\"turn_id\") or data.get(\"id\") or rid(\"turn\")),\n+            session_id=str(data.get(\"session_id\") or \"default\"),\n+            role=str(data.get(\"role\") or \"user\"),\n+            content=str(data.get(\"content\") or \"\"),\n+            run_id=str(data.get(\"run_id\") or \"\"),\n+            summary=str(data.get(\"summary\") or \"\"),\n+            metadata=dict(data.get(\"metadata\") or {}),\n+            created_at=str(data.get(\"created_at\") or now()),\n+        )\n+\n+\n+@dataclass\n+class HarnessEvent:\n+    run_id: str\n+    phase: str\n+    status: str\n+    summary: str\n+    data: dict[str, Any] = field(default_factory=dict)\n+    id: str = field(default_factory=lambda: rid(\"evt\"))\n+    created_at: str = field(default_factory=now)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"HarnessEvent\":\n+        return cls(\n+            id=str(data.get(\"id\") or rid(\"evt\")),\n+            run_id=str(data.get(\"run_id\") or \"\"),\n+            phase=str(data.get(\"phase\") or \"unknown\"),\n+            status=str(data.get(\"status\") or \"info\"),\n+            summary=str(data.get(\"summary\") or \"\"),\n+            created_at=str(data.get(\"created_at\") or now()),\n+            data=dict(data.get(\"data\") or {}),\n+        )\n+\n+\n+@dataclass\n+class RunRecord:\n+    run_id: str\n+    objective: str\n+    workflow: dict[str, Any]\n+    status: str\n+    created_at: str\n+    updated_at: str\n+    result: dict[str, Any] | None = None\n+    events: list[HarnessEvent] = field(default_factory=list)\n+\n+    def add_event(self, phase: str, status: str, summary: str, data: dict[str, Any] | None = None) -> HarnessEvent:\n+        item = HarnessEvent(\n+            run_id=self.run_id,\n+            phase=phase,\n+            status=status,\n+            summary=summary,\n+            data=data or {},\n+        )\n+        self.events.append(item)\n+        self.updated_at = now()\n+        return item\n+\n+    def summary(self) -> dict[str, Any]:\n+        return {\n+            \"run_id\": self.run_id,\n+            \"status\": self.status,\n+            \"objective\": self.objective,\n+            \"workflow\": self.workflow,\n+            \"created_at\": self.created_at,\n+            \"updated_at\": self.updated_at,\n+            \"event_count\": len(self.events),\n+            \"result_ready\": self.result is not None,\n+        }\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return {\n+            \"run_id\": self.run_id,\n+            \"objective\": self.objective,\n+            \"workflow\": self.workflow,\n+            \"status\": self.status,\n+            \"created_at\": self.created_at,\n+            \"updated_at\": self.updated_at,\n+            \"result\": self.result,\n+            \"events\": [event.to_dict() for event in self.events],\n+        }\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"RunRecord\":\n+        return cls(\n+            run_id=str(data.get(\"run_id\") or rid(\"run\")),\n+            objective=str(data.get(\"objective\") or \"\"),\n+            workflow=dict(data.get(\"workflow\") or {}),\n+            status=str(data.get(\"status\") or \"unknown\"),\n+            created_at=str(data.get(\"created_at\") or now()),\n+            updated_at=str(data.get(\"updated_at\") or now()),\n+            result=data.get(\"result\") if isinstance(data.get(\"result\"), dict) else None,\n+            events=[HarnessEvent.from_dict(item) for item in data.get(\"events\") or [] if isinstance(item, dict)],\n+        )\n+\n+\n+@dataclass\n+class MemoryFact:\n+    id: str\n+    owner_id: str\n+    subject: str\n+    predicate: str\n+    object: str\n+    status: str\n+    source: str\n+    provenance: dict[str, Any]\n+    run_id: str = \"\"\n+    supersedes_id: str = \"\"\n+    created_at: str = field(default_factory=now)\n+    voided_at: str = \"\"\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+    @classmethod\n+    def from_dict(cls, data: dict[str, Any]) -> \"MemoryFact\":\n+        return cls(\n+            id=str(data.get(\"id\") or rid(\"mem\")),\n+            owner_id=str(data.get(\"owner_id\") or \"default\"),\n+            subject=str(data.get(\"subject\") or \"\"),\n+            predicate=str(data.get(\"predicate\") or \"\"),\n+            object=str(data.get(\"object\") or \"\"),\n+            status=str(data.get(\"status\") or \"current\"),\n+            source=str(data.get(\"source\") or \"\"),\n+            provenance=dict(data.get(\"provenance\") or {}),\n+            run_id=str(data.get(\"run_id\") or \"\"),\n+            supersedes_id=str(data.get(\"supersedes_id\") or \"\"),\n+            created_at=str(data.get(\"created_at\") or now()),\n+            voided_at=str(data.get(\"voided_at\") or \"\"),\n+        )"},{"sha":"a3c783780c066798c8008fa7a29d8b775fdd62b7","filename":"extractions/shovs-agent-harness/backend/service.py","status":"added","additions":1756,"deletions":0,"changes":1756,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fservice.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fservice.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fservice.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,1756 @@\n+from __future__ import annotations\n+\n+import asyncio\n+import json\n+import os\n+import re\n+import sys\n+from concurrent.futures import Future, ThreadPoolExecutor\n+from pathlib import Path\n+from typing import Any\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+CORE_ROOT = ROOT.parent / \"shovs-harness-core\"\n+sys.path.insert(0, str(CORE_ROOT))\n+\n+from shovs_harness_core import enforce_proposed_actions, infer_source_contract  # noqa: E402\n+from shovs_harness_core.evals import evaluate_trace  # noqa: E402\n+from shovs_harness_core.ledger import Ledger  # noqa: E402\n+from shovs_harness_core.proposers import ProposedAction  # noqa: E402\n+from shovs_harness_core.source_runner import discovery_query, entity_search_query  # noqa: E402\n+\n+from .adapters import make_adapters\n+from .config import HarnessConfig\n+from .models import ChatTurn, DynamicToolSpec, RunRecord, WorkflowSpec, now, rid\n+from .store import (\n+    ChatStore,\n+    DynamicToolStore,\n+    MemoryFactStore,\n+    RunStore,\n+    SqliteChatStore,\n+    SqliteDynamicToolStore,\n+    SqliteMemoryFactStore,\n+    SqliteRunStore,\n+    SqliteWorkflowStore,\n+    WorkflowStore,\n+)\n+from .tool_bridge import ShovsNativeToolBridge\n+from .understanding import understand_objective\n+from .workflows import draft_workflow\n+\n+\n+class HarnessService:\n+    def __init__(\n+        self,\n+        config: HarnessConfig | None = None,\n+        store: RunStore | None = None,\n+        memory_store: MemoryFactStore | None = None,\n+        workflow_store: WorkflowStore | None = None,\n+        tool_store: DynamicToolStore | None = None,\n+        chat_store: ChatStore | None = None,\n+    ):\n+        self.config = config or HarnessConfig.from_env()\n+        self.store = store or SqliteRunStore(self.config.storage_path)\n+        self.memory_store = memory_store or SqliteMemoryFactStore(self.config.memory_path)\n+        self.workflow_store = workflow_store or SqliteWorkflowStore(self.config.storage_path)\n+        self.tool_store = tool_store or SqliteDynamicToolStore(self.config.storage_path)\n+        self.chat_store = chat_store or SqliteChatStore(self.config.storage_path)\n+        self.tool_bridge = ShovsNativeToolBridge()\n+        self._max_workers = max(1, int(os.getenv(\"SHOVS_AGENT_HARNESS_WORKERS\", \"4\")))\n+        self._executor = ThreadPoolExecutor(max_workers=self._max_workers, thread_name_prefix=\"shovs-harness\")\n+        self._jobs: dict[str, Future] = {}\n+\n+    def draft_workflow(self, prompt: str):\n+        return draft_workflow(prompt)\n+\n+    def understand(self, objective: str) -> dict[str, Any]:\n+        return understand_objective(objective).to_dict()\n+\n+    async def execute(\n+        self,\n+        objective: str,\n+        *,\n+        workflow_override: dict[str, Any] | None = None,\n+        run_config: dict[str, Any] | None = None,\n+    ) -> RunRecord:\n+        run = self._create_run(objective, workflow_override=workflow_override, run_config=run_config)\n+        if run.status == \"completed\":\n+            return run\n+        return await self._execute_existing_run(run.run_id)\n+\n+    def _create_run(\n+        self,\n+        objective: str,\n+        *,\n+        workflow_override: dict[str, Any] | None = None,\n+        run_config: dict[str, Any] | None = None,\n+    ) -> RunRecord:\n+        run_config = dict(run_config or {})\n+        session_id = _session_id_from_config(run_config)\n+        history = self.chat_store.list(session_id, limit=24)\n+        compact_history = _compact_chat_history(history)\n+        workflow = WorkflowSpec.from_dict(workflow_override).to_dict() if workflow_override else draft_workflow(objective).to_dict()\n+        run = RunRecord(\n+            run_id=rid(\"run\"),\n+            objective=objective,\n+            workflow=workflow,\n+            status=\"running\",\n+            created_at=now(),\n+            updated_at=now(),\n+        )\n+        run.add_event(\n+            \"intake\",\n+            \"success\",\n+            \"Accepted objective and compiled workflow.\",\n+            {\"workflow\": run.workflow, \"run_config\": run_config, \"session_id\": session_id},\n+        )\n+        run.add_event(\n+            \"history\",\n+            \"ready\",\n+            \"Loaded compact session history.\",\n+            {\n+                \"session_id\": session_id,\n+                \"turn_count\": len(history),\n+                \"compact\": compact_history,\n+                \"raw_transcript_hidden\": True,\n+            },\n+        )\n+        understanding = understand_objective(objective)\n+        run.add_event(\n+            \"understanding\",\n+            \"success\",\n+            f\"Classified intent as {understanding.intent}.\",\n+            {\"understanding\": understanding.to_dict()},\n+        )\n+        for packet in _prompt_packets(objective, run.workflow, understanding.to_dict(), run_config):\n+            packet[\"session\"] = {\n+                \"session_id\": session_id,\n+                \"history\": compact_history,\n+                \"history_policy\": \"compact_recent_turns_only\",\n+            }\n+            run.add_event(\"prompt_packet\", \"ready\", f\"{packet['node_id']} prompt packet ready.\", packet)\n+        self._record_user_turn(session_id, run.run_id, objective, understanding.to_dict())\n+        self.store.put(run)\n+\n+        if understanding.intent == \"workflow_design\":\n+            spec = _workflow_spec_from_draft(\n+                workflow,\n+                objective=objective,\n+                config=self.config,\n+                run_config=run_config or {},\n+            )\n+            self.workflow_store.put(spec)\n+            run.workflow = spec.to_dict()\n+            run.add_event(\n+                \"workflow\",\n+                \"success\",\n+                \"Created and saved a reusable workflow contract instead of executing it.\",\n+                {\"workflow\": run.workflow, \"understanding\": understanding.to_dict()},\n+            )\n+            run.status = \"completed\"\n+            run.updated_at = now()\n+            run.result = {\n+                \"run_id\": run.run_id,\n+                \"session_id\": session_id,\n+                \"status\": run.status,\n+                \"answer\": _workflow_answer(run.workflow),\n+                \"workflow\": run.workflow,\n+                \"understanding\": understanding.to_dict(),\n+                \"next_actions\": [\n+                    \"Run this workflow with POST /api/runs using a concrete objective.\",\n+                    \"Edit tools, policy, or output_schema before embedding it in another app.\",\n+                    \"Compose it with another workflow by passing its output as the next workflow objective.\",\n+                ],\n+                \"api\": {\n+                    \"status\": f\"/api/runs/{run.run_id}\",\n+                    \"events\": f\"/api/runs/{run.run_id}/events\",\n+                    \"result\": f\"/api/runs/{run.run_id}/result\",\n+                },\n+            }\n+            self._record_assistant_turn(run, run.result.get(\"answer\", \"\"))\n+            self.store.put(run)\n+            return run\n+\n+        self.store.put(run)\n+        return run\n+\n+    async def _execute_existing_run(self, run_id: str) -> RunRecord:\n+        run = self.get_run(run_id)\n+        if not run:\n+            raise ValueError(\"run not found\")\n+        objective = run.objective\n+        understanding = self.understand(objective)\n+        if understanding.get(\"intent\") in {\"image_generation\", \"connector_setup\"}:\n+            return await self._execute_capability_run(run, understanding)\n+        if understanding.get(\"intent\") == \"stock_analysis_team\":\n+            return await self._execute_stock_analysis_run(run, understanding)\n+        adapters = make_adapters(self.config, objective, event_sink=lambda *args: _append_and_save(self.store, run, *args))\n+        contract = infer_source_contract(objective)\n+        n = contract.entity_count or self.config.max_entities_default\n+        m = contract.urls_per_entity or self.config.urls_per_entity_default\n+        ledger = Ledger(objective=objective, allowed_tools=[\"web_search\", \"web_fetch\"])\n+        trace_events: list[dict[str, Any]] = []\n+        fetched: list[dict[str, Any]] = []\n+        llm_calls = 0\n+        tool_calls = 0\n+\n+        def save_step(step: str, **data: Any) -> bool:\n+            latest = self.get_run(run_id) or run\n+            if latest.status == \"interrupt_requested\":\n+                _mark_interrupted(latest, data.get(\"reason\") or \"interrupted before \" + step)\n+                self.store.put(latest)\n+                return False\n+            run.result = {\n+                **(run.result or {}),\n+                \"run_id\": run.run_id,\n+                \"session_id\": _run_session_id(run),\n+                \"status\": run.status,\n+                \"answer\": \"\",\n+                \"understanding\": understanding,\n+                \"execution_state\": {\n+                    \"step\": step,\n+                    \"cursor\": data,\n+                    \"next_required_action\": data.get(\"next_required_action\") or step,\n+                },\n+                \"api\": {\n+                    \"status\": f\"/api/runs/{run.run_id}\",\n+                    \"events\": f\"/api/runs/{run.run_id}/events\",\n+                    \"result\": f\"/api/runs/{run.run_id}/result\",\n+                },\n+            }\n+            run.add_event(\"step_cursor\", \"running\", f\"Cursor: {step}\", {\"step\": step, **data})\n+            self.store.put(run)\n+            return True\n+\n+        if not save_step(\"discovery_search\", query=discovery_query(objective), next_required_action=\"web_search\"):\n+            return self.get_run(run_id) or run\n+\n+        dq = discovery_query(objective)\n+        disc_urls, disc_text = await adapters.search(dq)\n+        tool_calls += 1\n+        _record_kernel(ledger, trace_events, \"web_search\", {\"query\": dq}, bool(disc_urls), {\"urls\": disc_urls})\n+\n+        if not save_step(\"entity_lock\", url_count=len(disc_urls), next_required_action=\"lock_entities\"):\n+            return self.get_run(run_id) or run\n+        raw_entities = await adapters.extract_entities(objective, disc_text, n)\n+        llm_calls += 1\n+        entities = _dedupe_entities(raw_entities, n)\n+        for entity in entities:\n+            trace_events.append({\"kind\": \"entity_locked\", \"entity\": entity})\n+            ledger.event(\"entity_locked\", entity=entity)\n+        run.add_event(\"entity_locked\", \"success\", f\"Locked {len(entities)} entities.\", {\"entities\": entities})\n+        self.store.put(run)\n+\n+        for entity in entities:\n+            q = entity_search_query(objective, entity)\n+            if not save_step(\"entity_search\", entity=entity, query=q, next_required_action=\"web_search\"):\n+                return self.get_run(run_id) or run\n+            urls, _raw = await adapters.search(q)\n+            tool_calls += 1\n+            _record_kernel(ledger, trace_events, \"web_search\", {\"query\": q, \"entity\": entity}, bool(urls), {\"urls\": urls}, entity=entity)\n+            got = 0\n+            for url in urls:\n+                if got >= m:\n+                    break\n+                if not save_step(\"fetch_url\", entity=entity, url=url, fetched_for_entity=got, next_required_action=\"web_fetch\"):\n+                    return self.get_run(run_id) or run\n+                ok, content = await adapters.fetch(url)\n+                tool_calls += 1\n+                _record_kernel(ledger, trace_events, \"web_fetch\", {\"url\": url, \"entity\": entity}, ok, {\"len\": len(content or \"\")}, entity=entity)\n+                if ok and content:\n+                    fetched.append({\"entity\": entity, \"url\": url, \"content\": content})\n+                    got += 1\n+\n+        if not save_step(\"verify\", fetched_count=len(fetched), next_required_action=\"evaluate_contract\"):\n+            return self.get_run(run_id) or run\n+        eval_result = evaluate_trace(contract, trace_events)\n+        verdict_ok = bool(eval_result and eval_result.ok)\n+        if not verdict_ok:\n+            run.add_event(\"verdict\", \"blocked\", \"Verdict gate blocked finalization.\", {\"eval\": _eval_to_dict(eval_result)})\n+            run.status = \"blocked\"\n+            run.updated_at = now()\n+            run.result = _result_payload(run, \"\", entities, understanding, fetched, llm_calls, tool_calls, eval_result, ledger.trace())\n+            self._record_assistant_turn(run, \"Blocked: required evidence is missing or contract verification failed.\")\n+            self.store.put(run)\n+            return run\n+\n+        if not save_step(\"synthesize\", fetched_count=len(fetched), next_required_action=\"synthesize_answer\"):\n+            return self.get_run(run_id) or run\n+        answer = await adapters.synthesize(objective, fetched)\n+        llm_calls += 1\n+        run.add_event(\"verdict\", \"success\", \"Verdict gate passed.\", {\"eval\": _eval_to_dict(eval_result)})\n+        run.status = \"completed\"\n+        run.updated_at = now()\n+        run.result = _result_payload(run, answer, entities, understanding, fetched, llm_calls, tool_calls, eval_result, ledger.trace())\n+        self._record_assistant_turn(run, answer)\n+        self.store.put(run)\n+        return run\n+\n+    async def _execute_stock_analysis_run(self, run: RunRecord, understanding: dict[str, Any]) -> RunRecord:\n+        ticker = _extract_ticker(run.objective)\n+        if not ticker:\n+            run.status = \"blocked\"\n+            run.updated_at = now()\n+            run.add_event(\"ticker_lock\", \"blocked\", \"Could not lock a ticker for stock analysis.\")\n+            run.result = _stock_report_payload(\n+                run,\n+                ticker=\"\",\n+                answer=\"I need a ticker symbol or company name before running a stock-analysis team.\",\n+                understanding=understanding,\n+                reports=[],\n+                evidence=[],\n+                status=\"blocked\",\n+            )\n+            self._record_assistant_turn(run, run.result.get(\"answer\", \"\"))\n+            self.store.put(run)\n+            return run\n+\n+        run.add_event(\"ticker_lock\", \"success\", f\"Locked ticker {ticker}.\", {\"ticker\": ticker})\n+        self.store.put(run)\n+        evidence: list[dict[str, Any]] = []\n+        reports: list[dict[str, Any]] = []\n+\n+        async def call_native(tool: str, **args: Any) -> dict[str, Any]:\n+            run.add_event(\"tool\", \"running\", f\"{tool} for {ticker}.\", {\"tool\": tool, \"args\": args})\n+            self.store.put(run)\n+            result = await self.tool_bridge.call(tool, **args)\n+            payload = result.get(\"json\") if isinstance(result.get(\"json\"), dict) else result\n+            ok = bool(result.get(\"ok\")) and not (isinstance(payload, dict) and payload.get(\"success\") is False)\n+            run.add_event(\"tool\", \"success\" if ok else \"warning\", f\"{tool} returned {'data' if ok else 'a gap'}.\", {\"tool\": tool, \"result\": payload})\n+            self.store.put(run)\n+            evidence.append({\"tool\": tool, \"ok\": ok, \"payload\": payload})\n+            return {\"ok\": ok, \"payload\": payload}\n+\n+        stages = [\n+            (\"market_analyst\", \"Market Analyst\", \"alpha_vantage_quote\", {\"symbol\": ticker}),\n+            (\"news_analyst\", \"News Analyst\", \"alpha_vantage_news\", {\"symbol\": ticker, \"limit\": 6}),\n+            (\"fundamentals_analyst\", \"Fundamentals Analyst\", \"alpha_vantage_overview\", {\"symbol\": ticker}),\n+        ]\n+        for stage_id, label, tool, args in stages:\n+            run.add_event(\"analyst\", \"running\", f\"{label} started.\", {\"agent\": stage_id, \"ticker\": ticker})\n+            result = await call_native(tool, **args)\n+            report_text = _analyst_report_text(label, ticker, tool, result[\"payload\"], ok=result[\"ok\"])\n+            artifact = _write_run_report(run.run_id, f\"{stage_id}.md\", report_text)\n+            reports.append({**artifact, \"agent\": stage_id, \"label\": label, \"status\": \"completed\" if result[\"ok\"] else \"partial\"})\n+            run.add_event(\"analyst\", \"success\" if result[\"ok\"] else \"warning\", f\"{label} report written.\", reports[-1])\n+            self.store.put(run)\n+\n+        risk_text = _risk_report_text(ticker, evidence)\n+        risk_artifact = _write_run_report(run.run_id, \"risk_report.md\", risk_text)\n+        reports.append({**risk_artifact, \"agent\": \"risk_analyst\", \"label\": \"Risk Analyst\", \"status\": \"completed\"})\n+        run.add_event(\"analyst\", \"success\", \"Risk Analyst report written.\", reports[-1])\n+\n+        final_text = _final_stock_report_text(ticker, reports, evidence)\n+        final_artifact = _write_run_report(run.run_id, \"final_report.md\", final_text)\n+        reports.append({**final_artifact, \"agent\": \"portfolio_manager\", \"label\": \"Portfolio Manager\", \"status\": \"completed\"})\n+        answer = (\n+            f\"Stock-analysis team completed for {ticker}.\\n\\n\"\n+            f\"Final report: {final_artifact['url']}\\n\"\n+            \"Generated analyst files: market, news, fundamentals, risk, and final portfolio summary.\"\n+        )\n+        run.status = \"completed\"\n+        run.updated_at = now()\n+        run.add_event(\"artifact\", \"success\", \"Final report artifact ready.\", final_artifact)\n+        run.result = _stock_report_payload(\n+            run,\n+            ticker=ticker,\n+            answer=answer,\n+            understanding=understanding,\n+            reports=reports,\n+            evidence=evidence,\n+            status=\"completed\",\n+        )\n+        self._record_assistant_turn(run, answer)\n+        self.store.put(run)\n+        return run\n+\n+    async def _execute_capability_run(self, run: RunRecord, understanding: dict[str, Any]) -> RunRecord:\n+        intent = str(understanding.get(\"intent\") or \"\")\n+        run.add_event(\n+            \"capability_resolve\",\n+            \"running\",\n+            f\"Resolving capability for {intent}.\",\n+            {\"intent\": intent, \"allowed_tools\": understanding.get(\"allowed_tools\") or []},\n+        )\n+        self.store.put(run)\n+        if intent == \"image_generation\":\n+            resolution = self.resolve_capability(\"image_generation\")\n+            if not resolution.get(\"available\"):\n+                run.add_event(\"capability_resolve\", \"blocked\", \"Image generation is not configured.\", resolution)\n+                run.status = \"blocked\"\n+                run.updated_at = now()\n+                run.result = _capability_result_payload(\n+                    run,\n+                    answer=\"Image generation is available as a runtime capability, but it is not configured yet.\",\n+                    understanding=understanding,\n+                    resolution=resolution,\n+                    status=\"blocked\",\n+                )\n+                self._record_assistant_turn(run, run.result.get(\"answer\", \"\"))\n+                self.store.put(run)\n+                return run\n+            args = {\n+                \"prompt\": _image_prompt_from_objective(run.objective),\n+                \"size\": \"1024x1024\",\n+                \"quality\": \"auto\",\n+                \"background\": \"auto\",\n+                \"output_format\": \"png\",\n+            }\n+            run.add_event(\"tool\", \"running\", \"Calling image_generate.\", {\"tool\": \"image_generate\", \"args\": args})\n+            self.store.put(run)\n+            result = await self.tool_bridge.call(\"image_generate\", **args)\n+            ok = bool(result.get(\"ok\"))\n+            payload = result.get(\"json\") if isinstance(result.get(\"json\"), dict) else {}\n+            success = ok and bool(payload.get(\"success\", True)) and not payload.get(\"error\")\n+            status = \"completed\" if success else \"blocked\"\n+            run.add_event(\n+                \"tool\",\n+                \"success\" if success else \"blocked\",\n+                \"Image generated.\" if success else \"Image generation failed with a typed setup/runtime gap.\",\n+                {\"tool\": \"image_generate\", \"result\": payload or result},\n+            )\n+            run.status = status\n+            run.updated_at = now()\n+            image_url = str(payload.get(\"url\") or \"\")\n+            answer = f\"Generated image: {image_url}\" if image_url else \"Image generation could not complete.\"\n+            run.result = _capability_result_payload(\n+                run,\n+                answer=answer,\n+                understanding=understanding,\n+                resolution=resolution,\n+                status=status,\n+                artifacts=[payload] if payload else [],\n+                raw_tool_result=result,\n+            )\n+            self._record_assistant_turn(run, answer)\n+            self.store.put(run)\n+            return run\n+\n+        resolution = self.resolve_capability(\"connector_setup\", objective=run.objective)\n+        run.add_event(\"capability_resolve\", \"blocked\", \"Connector setup requires explicit external configuration.\", resolution)\n+        run.status = \"blocked\"\n+        run.updated_at = now()\n+        run.result = _capability_result_payload(\n+            run,\n+            answer=\"This connector can be represented as a workflow, but it needs explicit credentials/server configuration before runtime execution.\",\n+            understanding=understanding,\n+            resolution=resolution,\n+            status=\"blocked\",\n+        )\n+        self._record_assistant_turn(run, run.result.get(\"answer\", \"\"))\n+        self.store.put(run)\n+        return run\n+\n+    def start_run(\n+        self,\n+        objective: str,\n+        *,\n+        workflow_override: dict[str, Any] | None = None,\n+        run_config: dict[str, Any] | None = None,\n+    ) -> RunRecord:\n+        run = self._create_run(objective, workflow_override=workflow_override, run_config=run_config)\n+        if run.status == \"completed\":\n+            return run\n+        run.status = \"queued\"\n+        run.add_event(\"queued\", \"success\", \"Run queued for background execution.\")\n+        self.store.put(run)\n+        future = self._executor.submit(self._run_worker, run.run_id)\n+        self._jobs[run.run_id] = future\n+        return run\n+\n+    def _run_worker(self, run_id: str) -> None:\n+        run = self.get_run(run_id)\n+        if not run:\n+            return\n+        if run.status == \"interrupt_requested\":\n+            _mark_interrupted(run, \"interrupted before worker start\")\n+            self.store.put(run)\n+            return\n+        run.status = \"running\"\n+        run.add_event(\"worker\", \"running\", \"Background worker started.\")\n+        self.store.put(run)\n+        try:\n+            asyncio.run(self._execute_existing_run(run_id))\n+        except Exception as exc:\n+            latest = self.get_run(run_id) or run\n+            latest.status = \"failed\"\n+            latest.updated_at = now()\n+            latest.add_event(\"worker\", \"error\", f\"Background worker failed: {exc}\", {\"error\": str(exc)})\n+            latest.result = {**(latest.result or {}), \"status\": \"failed\", \"error\": str(exc)}\n+            self._record_assistant_turn(latest, f\"Run failed: {exc}\")\n+            self.store.put(latest)\n+\n+    async def continue_run(self, run_id: str, directive: str = \"\") -> RunRecord:\n+        previous = self.get_run(run_id)\n+        if not previous:\n+            raise ValueError(\"run not found\")\n+        if previous.status == \"completed\":\n+            previous.add_event(\"continue\", \"success\", \"Run already completed; no continuation needed.\")\n+            self.store.put(previous)\n+            return previous\n+        objective = previous.objective\n+        continuation_objective = (\n+            f\"{objective}\\n\\nContinue from previous run {run_id}. \"\n+            \"Use prior objective and complete missing requirements without changing locked intent.\"\n+        )\n+        if directive:\n+            continuation_objective += f\"\\nUser continuation directive: {directive}\"\n+        continued = await self.execute(\n+            continuation_objective,\n+            workflow_override=previous.workflow,\n+            run_config={\"continued_from\": run_id, \"directive\": directive, \"session_id\": _run_session_id(previous)},\n+        )\n+        continued.add_event(\n+            \"continue\",\n+            \"success\",\n+            f\"Continued from {run_id}.\",\n+            {\"previous_run_id\": run_id, \"previous_status\": previous.status},\n+        )\n+        self.store.put(continued)\n+        return continued\n+\n+    def interrupt_run(self, run_id: str, reason: str = \"\") -> dict[str, Any]:\n+        run = self.get_run(run_id)\n+        if not run:\n+            raise ValueError(\"run not found\")\n+        if run.status == \"completed\":\n+            run.add_event(\"interrupt\", \"blocked\", \"Completed run cannot be interrupted.\", {\"reason\": reason})\n+            self.store.put(run)\n+            return run.to_dict()\n+        active = run.status in {\"queued\", \"running\"}\n+        run.status = \"interrupt_requested\" if active else \"interrupted\"\n+        run.updated_at = now()\n+        run.add_event(\n+            \"interrupt\",\n+            \"success\",\n+            \"Run interrupt requested.\" if active else \"Run interrupted by user control.\",\n+            {\"reason\": reason, \"next_required_action\": \"continue_or_edit_workflow\"},\n+        )\n+        run.result = {\n+            **(run.result or {}),\n+            \"status\": run.status,\n+            \"answer\": \"\",\n+                \"continuation_state\": {\n+                    \"run_id\": run.run_id,\n+                    \"session_id\": _run_session_id(run),\n+                    \"objective\": run.objective,\n+                \"workflow\": run.workflow,\n+                \"reason\": reason,\n+                \"next_required_action\": \"continue_or_edit_workflow\",\n+            },\n+        }\n+        self._record_assistant_turn(run, \"Interrupted. Continue or edit the workflow to resume from the saved cursor.\")\n+        self.store.put(run)\n+        return run.to_dict()\n+\n+    def create_workflow(self, payload: dict[str, Any]) -> dict[str, Any]:\n+        objective = str(payload.get(\"objective\") or payload.get(\"prompt\") or \"\").strip()\n+        if not objective:\n+            raise ValueError(\"objective is required\")\n+        draft = draft_workflow(objective).to_dict()\n+        workflow = WorkflowSpec(\n+            workflow_id=str(payload.get(\"workflow_id\") or rid(\"wf\")),\n+            label=str(payload.get(\"label\") or draft.get(\"label\") or \"Workflow\"),\n+            objective=objective,\n+            policy=str(payload.get(\"policy\") or draft.get(\"policy\") or \"plan_execute\"),\n+            tools=list(payload.get(\"tools\") or draft.get(\"tools\") or []),\n+            nodes=list(payload.get(\"nodes\") or _default_nodes(draft)),\n+            edges=list(payload.get(\"edges\") or _default_edges(draft)),\n+            input_schema=dict(payload.get(\"input_schema\") or draft.get(\"input_schema\") or {\"objective\": \"string\"}),\n+            output_schema=dict(payload.get(\"output_schema\") or draft.get(\"output_schema\") or {}),\n+            runtime={\n+                \"model_provider\": str(payload.get(\"model_provider\") or self.config.model_provider),\n+                \"model_name\": str(payload.get(\"model_name\") or self.config.model_name),\n+                \"tool_mode\": str(payload.get(\"tool_mode\") or self.config.tool_mode),\n+                \"model_slots_enabled\": bool(payload.get(\"model_slots_enabled\", self.config.model_slots_enabled)),\n+                \"interruptible\": True,\n+                **dict(payload.get(\"runtime\") or {}),\n+            },\n+        )\n+        self.workflow_store.put(workflow)\n+        return {\"workflow\": workflow.to_dict()}\n+\n+    def list_workflows(self) -> dict[str, Any]:\n+        return {\"workflows\": [workflow.to_dict() for workflow in self.workflow_store.list()]}\n+\n+    def get_workflow(self, workflow_id: str) -> dict[str, Any] | None:\n+        workflow = self.workflow_store.get(workflow_id)\n+        return {\"workflow\": workflow.to_dict()} if workflow else None\n+\n+    async def run_workflow(self, workflow_id: str, payload: dict[str, Any]) -> RunRecord:\n+        workflow = self.workflow_store.get(workflow_id)\n+        if not workflow:\n+            raise ValueError(\"workflow not found\")\n+        input_payload = payload.get(\"input\")\n+        objective = str(\n+            payload.get(\"objective\")\n+            or (input_payload.get(\"objective\") if isinstance(input_payload, dict) else \"\")\n+            or workflow.objective\n+        ).strip()\n+        if not objective:\n+            objective = workflow.objective\n+        return await self.execute(\n+            objective,\n+            workflow_override=workflow.to_dict(),\n+            run_config={\n+                \"workflow_id\": workflow.workflow_id,\n+                \"runtime\": workflow.runtime,\n+                \"source\": \"workflow_run\",\n+                \"session_id\": str(payload.get(\"session_id\") or payload.get(\"thread_id\") or \"\"),\n+            },\n+        )\n+\n+    def start_workflow(self, workflow_id: str, payload: dict[str, Any]) -> RunRecord:\n+        workflow = self.workflow_store.get(workflow_id)\n+        if not workflow:\n+            raise ValueError(\"workflow not found\")\n+        input_payload = payload.get(\"input\")\n+        objective = str(\n+            payload.get(\"objective\")\n+            or (input_payload.get(\"objective\") if isinstance(input_payload, dict) else \"\")\n+            or workflow.objective\n+        ).strip()\n+        run = self.start_run(\n+            objective,\n+            workflow_override=workflow.to_dict(),\n+            run_config={\n+                \"workflow_id\": workflow.workflow_id,\n+                \"runtime\": workflow.runtime,\n+                \"source\": \"workflow_run_async\",\n+                \"session_id\": str(payload.get(\"session_id\") or payload.get(\"thread_id\") or \"\"),\n+            },\n+        )\n+        return run\n+\n+    def run_context(self, run_id: str) -> dict[str, Any] | None:\n+        run = self.get_run(run_id)\n+        if not run:\n+            return None\n+        result = run.result or {}\n+        eval_payload = result.get(\"eval\") if isinstance(result.get(\"eval\"), dict) else {}\n+        session_id = _run_session_id(run)\n+        history = self.chat_store.list(session_id, limit=12)\n+        return {\n+            \"run_id\": run.run_id,\n+            \"session_id\": session_id,\n+            \"status\": run.status,\n+            \"objective\": run.objective,\n+            \"workflow\": run.workflow,\n+            \"context_packet\": {\n+                \"objective\": run.objective,\n+                \"session\": {\n+                    \"session_id\": session_id,\n+                    \"history\": _compact_chat_history(history),\n+                    \"raw_transcript_hidden\": True,\n+                },\n+                \"policy\": (run.workflow.get(\"policy\") or run.workflow.get(\"runtime\", {}).get(\"policy\") or \"plan_execute\")\n+                if isinstance(run.workflow, dict)\n+                else \"plan_execute\",\n+                \"locked_entities\": result.get(\"entities\") or [],\n+                \"evidence_count\": len(result.get(\"evidence\") or []),\n+                \"missing\": list(eval_payload.get(\"failures\") or []),\n+                \"next_required_action\": \"respond\" if result.get(\"status\") == \"completed\" else \"continue\",\n+                \"raw_trace_hidden\": True,\n+                \"understanding\": result.get(\"understanding\") or self.understand(run.objective),\n+            },\n+        }\n+\n+    def run_evidence(self, run_id: str) -> dict[str, Any] | None:\n+        run = self.get_run(run_id)\n+        if not run:\n+            return None\n+        result = run.result or {}\n+        return {\n+            \"run_id\": run.run_id,\n+            \"evidence\": list(result.get(\"evidence\") or []),\n+            \"eval\": result.get(\"eval\") or {},\n+        }\n+\n+    def read_run_file(self, run_id: str, filename: str) -> dict[str, Any] | None:\n+        run = self.get_run(run_id)\n+        if not run:\n+            return None\n+        safe = _safe_report_name(filename)\n+        path = _reports_root() / run_id / safe\n+        if not path.exists() or not path.is_file():\n+            return None\n+        return {\n+            \"run_id\": run_id,\n+            \"filename\": safe,\n+            \"content_type\": \"text/markdown; charset=utf-8\",\n+            \"content\": path.read_text(encoding=\"utf-8\"),\n+        }\n+\n+    def list_memory(self, *, owner_id: str = \"default\", include_voided: bool = False) -> dict[str, Any]:\n+        facts = self.memory_store.list_facts(owner_id=owner_id, include_voided=include_voided)\n+        return {\n+            \"owner_id\": owner_id,\n+            \"facts\": [fact.to_dict() for fact in facts],\n+            \"summary\": {\n+                \"current_count\": len([fact for fact in facts if fact.status == \"current\"]),\n+                \"voided_count\": len([fact for fact in facts if fact.status == \"voided\"]),\n+            },\n+        }\n+\n+    def remember_fact(self, payload: dict[str, Any]) -> dict[str, Any]:\n+        owner_id = str(payload.get(\"owner_id\") or \"default\")\n+        run_id = str(payload.get(\"run_id\") or \"\")\n+        source = str(payload.get(\"source\") or \"user\")\n+        provenance = dict(payload.get(\"provenance\") or {})\n+        if run_id:\n+            run = self.get_run(run_id)\n+            if not run:\n+                raise ValueError(\"run_id not found\")\n+            if run.status != \"completed\" and source != \"user\":\n+                raise ValueError(\"derived memory requires a completed run\")\n+            provenance.setdefault(\"run_status\", run.status)\n+        fact = self.memory_store.add_fact(\n+            owner_id=owner_id,\n+            subject=str(payload.get(\"subject\") or \"\"),\n+            predicate=str(payload.get(\"predicate\") or \"\"),\n+            object_value=str(payload.get(\"object\") or payload.get(\"object_value\") or \"\"),\n+            source=source,\n+            provenance=provenance,\n+            run_id=run_id,\n+        )\n+        return {\"fact\": fact.to_dict()}\n+\n+    def void_memory(self, fact_id: str, *, owner_id: str = \"default\", reason: str = \"\") -> dict[str, Any]:\n+        ok = self.memory_store.void_fact(fact_id, owner_id=owner_id, reason=reason)\n+        return {\"ok\": ok, \"fact_id\": fact_id}\n+\n+    def compare(self, objective: str) -> dict[str, Any]:\n+        contract = infer_source_contract(objective)\n+        model_actions = [\n+            ProposedAction(\"lock\", entities=(\"ROKU\", \"TBN\", \"SENEA\")),\n+            ProposedAction(\"fetch\", entity=\"EPAM\", url=\"https://epam.test/0\"),\n+            ProposedAction(\"respond\"),\n+        ]\n+        report = enforce_proposed_actions(contract, model_actions)\n+        return {\n+            \"objective\": objective,\n+            \"plain_agent\": {\n+                \"status\": \"would_fail\",\n+                \"issues\": [\n+                    \"model drifted to EPAM after locking ROKU/TBN/SENEA\",\n+                    \"model finalized without fetched source quota\",\n+                ],\n+            },\n+            \"harness\": {\n+                \"status\": \"blocked\" if report.violations or not report.can_respond else \"passed\",\n+                \"enforcement\": report.to_dict(),\n+            },\n+        }\n+\n+    def draft_dynamic_tool(self, objective: str) -> dict[str, Any]:\n+        text = \" \".join(str(objective or \"\").split())\n+        lowered = text.lower()\n+        if any(term in lowered for term in (\"url\", \"link\", \"source\", \"citation\")):\n+            spec = DynamicToolSpec(\n+                tool_id=rid(\"tool\"),\n+                name=_tool_name_from_objective(text, suffix=\"url_check\"),\n+                description=f\"Check compact URL/source requirements for: {text[:140]}\",\n+                kind=\"regex_check\",\n+                input_schema={\"text\": \"string\"},\n+                check_schema={\n+                    \"patterns\": {\n+                        \"urls\": r\"https?://[^\\s)>\\\"]+\",\n+                    },\n+                    \"min_counts\": {\"urls\": 1},\n+                },\n+                context_policy={\"max_input_chars\": 1600, \"return_raw\": False, \"summary_chars\": 280},\n+            )\n+        elif any(term in lowered for term in (\"price\", \"rating\", \"buy\", \"store\", \"product\")):\n+            spec = DynamicToolSpec(\n+                tool_id=rid(\"tool\"),\n+                name=_tool_name_from_objective(text, suffix=\"shopping_signal_check\"),\n+                description=f\"Check compact shopping signals for: {text[:140]}\",\n+                kind=\"regex_check\",\n+                input_schema={\"text\": \"string\"},\n+                check_schema={\n+                    \"patterns\": {\n+                        \"prices\": r\"(?:[$€£]\\s?\\d[\\d,]*(?:\\.\\d{2})?|\\d[\\d,]*(?:\\.\\d{2})?\\s?(?:USD|CAD|EUR|GBP))\",\n+                        \"ratings\": r\"(?:\\b\\d(?:\\.\\d)?\\s?/\\s?5\\b|\\b\\d(?:\\.\\d)?\\s?stars?\\b)\",\n+                    },\n+                    \"min_counts\": {\"prices\": 1},\n+                },\n+                context_policy={\"max_input_chars\": 1800, \"return_raw\": False, \"summary_chars\": 320},\n+            )\n+        else:\n+            spec = DynamicToolSpec(\n+                tool_id=rid(\"tool\"),\n+                name=_tool_name_from_objective(text, suffix=\"checklist\"),\n+                description=f\"Check compact completion signals for: {text[:140]}\",\n+                kind=\"checklist\",\n+                input_schema={\"text\": \"string\"},\n+                check_schema={\n+                    \"required_terms\": _terms_from_objective(text),\n+                    \"min_required_terms\": 2,\n+                },\n+                context_policy={\"max_input_chars\": 1200, \"return_raw\": False, \"summary_chars\": 240},\n+            )\n+        return {\"tool\": spec.to_dict()}\n+\n+    def create_dynamic_tool(self, payload: dict[str, Any]) -> dict[str, Any]:\n+        draft = payload.get(\"tool\") if isinstance(payload.get(\"tool\"), dict) else None\n+        if not draft:\n+            draft = self.draft_dynamic_tool(str(payload.get(\"objective\") or payload.get(\"prompt\") or \"\"))[\"tool\"]\n+        spec = DynamicToolSpec.from_dict(\n+            {\n+                **draft,\n+                \"tool_id\": str(payload.get(\"tool_id\") or draft.get(\"tool_id\") or rid(\"tool\")),\n+                \"name\": _normalize_tool_name(str(payload.get(\"name\") or draft.get(\"name\") or \"\")),\n+                \"description\": str(payload.get(\"description\") or draft.get(\"description\") or \"\"),\n+                \"kind\": str(payload.get(\"kind\") or draft.get(\"kind\") or \"checklist\"),\n+                \"input_schema\": dict(payload.get(\"input_schema\") or draft.get(\"input_schema\") or {\"text\": \"string\"}),\n+                \"check_schema\": dict(payload.get(\"check_schema\") or draft.get(\"check_schema\") or {}),\n+                \"context_policy\": dict(payload.get(\"context_policy\") or draft.get(\"context_policy\") or {}),\n+            }\n+        )\n+        if not spec.name:\n+            raise ValueError(\"tool name is required\")\n+        if spec.kind not in {\"checklist\", \"regex_check\", \"json_field_check\"}:\n+            raise ValueError(\"unsupported dynamic tool kind\")\n+        self.tool_store.put(spec)\n+        return {\"tool\": spec.to_dict()}\n+\n+    def list_dynamic_tools(self) -> dict[str, Any]:\n+        return {\"tools\": [tool.to_dict() for tool in self.tool_store.list()]}\n+\n+    def run_dynamic_tool_check(self, tool_id_or_name: str, payload: dict[str, Any]) -> dict[str, Any]:\n+        spec = self.tool_store.get(tool_id_or_name)\n+        if not spec:\n+            raise ValueError(\"dynamic tool not found\")\n+        text = _compact_tool_input(payload, spec.context_policy)\n+        if spec.kind == \"regex_check\":\n+            result = _run_regex_check(spec, text)\n+        elif spec.kind == \"json_field_check\":\n+            result = _run_json_field_check(spec, payload)\n+        else:\n+            result = _run_checklist(spec, text)\n+        return {\n+            \"tool\": spec.to_dict(),\n+            \"result\": {\n+                **result,\n+                \"context_policy\": spec.context_policy,\n+                \"input_chars_used\": len(text),\n+            },\n+        }\n+\n+    def resolve_capability(self, capability: str, *, objective: str = \"\") -> dict[str, Any]:\n+        capability = str(capability or \"\").strip().lower()\n+        if capability in {\"image\", \"image_generation\", \"generate_image\"}:\n+            native = self.tool_bridge.manifest()\n+            tool_names = {str(tool.get(\"name\")) for tool in native.get(\"tools\") or [] if isinstance(tool, dict)}\n+            configured = bool(os.getenv(\"OPENAI_API_KEY\") or os.getenv(\"IMAGE_GENERATION_API_KEY\"))\n+            return {\n+                \"capability\": \"image_generation\",\n+                \"available\": \"image_generate\" in tool_names and configured,\n+                \"tool\": \"image_generate\" if \"image_generate\" in tool_names else \"\",\n+                \"tool_available\": \"image_generate\" in tool_names,\n+                \"configured\": configured,\n+                \"provider\": \"openai\",\n+                \"model\": os.getenv(\"IMAGE_GENERATION_MODEL\", \"gpt-image-1\"),\n+                \"required_env\": [] if configured else [\"OPENAI_API_KEY\"],\n+                \"setup\": [] if configured else [\n+                    \"Set OPENAI_API_KEY in the backend environment.\",\n+                    \"Optionally set IMAGE_GENERATION_MODEL, default gpt-image-1.\",\n+                    \"Restart the harness backend.\",\n+                ],\n+                \"contract\": {\n+                    \"input\": {\"prompt\": \"string\", \"size\": \"1024x1024|1024x1536|1536x1024|auto\"},\n+                    \"output\": {\"url\": \"sandbox or provider image URL\", \"path\": \"local artifact path\", \"bytes\": \"integer\"},\n+                },\n+            }\n+        if capability in {\"connector\", \"connectors\", \"mcp\", \"connector_setup\"}:\n+            target = _connector_target_from_objective(objective)\n+            return {\n+                \"capability\": \"connector_setup\",\n+                \"target\": target,\n+                \"available\": False,\n+                \"tool_available\": False,\n+                \"configured\": False,\n+                \"required_env\": _connector_required_env(target),\n+                \"setup\": [\n+                    \"Define the connector or MCP server in backend configuration.\",\n+                    \"Provide credentials through environment variables or an OAuth flow.\",\n+                    \"Expose the connector tools through the tool manifest before workflow execution.\",\n+                ],\n+                \"contract\": {\n+                    \"input\": {\"server_id\": \"string\", \"command_or_url\": \"string\", \"env\": \"object\"},\n+                    \"output\": {\"tools\": \"registered connector tool names\", \"status\": \"connected|blocked\"},\n+                },\n+            }\n+        return {\n+            \"capability\": capability or \"unknown\",\n+            \"available\": False,\n+            \"configured\": False,\n+            \"required_env\": [],\n+            \"setup\": [\"No resolver exists for this capability yet.\"],\n+        }\n+\n+    def tool_manifest(self) -> dict[str, Any]:\n+        harness_tools = [\n+            {\n+                \"name\": \"harness_workflow_draft\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Compile a user objective into a workflow draft without saving it.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+            {\n+                \"name\": \"harness_workflow_create\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Create and persist a reusable WorkflowSpec from an objective.\",\n+                \"side_effect\": \"write\",\n+            },\n+            {\n+                \"name\": \"harness_workflow_list\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"List saved WorkflowSpec records.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+            {\n+                \"name\": \"harness_workflow_run\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Start a saved workflow as an async run.\",\n+                \"side_effect\": \"write\",\n+            },\n+            {\n+                \"name\": \"harness_capability_resolve\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Resolve whether a capability can run now or needs provider/MCP/connector setup.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+            {\n+                \"name\": \"harness_tool_draft\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Draft a compact generated micro-tool spec for a recurring check.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+            {\n+                \"name\": \"harness_tool_create\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Persist a generated micro-tool spec. No arbitrary code execution.\",\n+                \"side_effect\": \"write\",\n+            },\n+            {\n+                \"name\": \"harness_tool_list\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"List generated micro-tools.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+            {\n+                \"name\": \"harness_tool_check\",\n+                \"category\": \"harness_runtime\",\n+                \"mode\": \"harness\",\n+                \"description\": \"Run a generated micro-tool against compact input and return bounded results.\",\n+                \"side_effect\": \"read_only\",\n+            },\n+        ]\n+        native_manifest = self.tool_bridge.manifest()\n+        return {\n+            \"active_mode\": self.config.tool_mode,\n+            \"portable_modes\": [\"deterministic\", \"http\", \"production\"],\n+            \"native_mode\": \"shovs_native\",\n+            \"harness_tools\": harness_tools,\n+            \"shovs_native\": native_manifest,\n+            \"tools\": harness_tools + list(native_manifest.get(\"tools\") or []),\n+            \"contract\": {\n+                \"rule\": \"runtime executes tools; model text is never treated as proof of execution\",\n+                \"result_shape\": {\n+                    \"ok\": \"boolean\",\n+                    \"tool\": \"string\",\n+                    \"raw\": \"raw tool output when successful\",\n+                    \"json\": \"parsed JSON when available\",\n+                    \"error\": \"error reason when failed\",\n+                },\n+            },\n+        }\n+\n+    async def call_tool(self, payload: dict[str, Any]) -> dict[str, Any]:\n+        name = str(payload.get(\"tool\") or payload.get(\"name\") or \"\").strip()\n+        args = payload.get(\"arguments\") or payload.get(\"args\") or {}\n+        if not name:\n+            return {\"ok\": False, \"error\": \"tool is required\"}\n+        if not isinstance(args, dict):\n+            return {\"ok\": False, \"tool\": name, \"error\": \"arguments must be an object\"}\n+        if name == \"harness_workflow_draft\":\n+            objective = str(args.get(\"objective\") or args.get(\"prompt\") or \"\").strip()\n+            if not objective:\n+                return {\"ok\": False, \"tool\": name, \"error\": \"objective is required\"}\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": {\"workflow\": self.draft_workflow(objective).to_dict()}}\n+        if name == \"harness_workflow_create\":\n+            try:\n+                created = self.create_workflow(args)\n+            except ValueError as exc:\n+                return {\"ok\": False, \"tool\": name, \"error\": str(exc)}\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": created}\n+        if name == \"harness_workflow_list\":\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.list_workflows()}\n+        if name == \"harness_workflow_run\":\n+            workflow_id = str(args.get(\"workflow_id\") or \"\").strip()\n+            if not workflow_id:\n+                return {\"ok\": False, \"tool\": name, \"error\": \"workflow_id is required\"}\n+            try:\n+                run = self.start_workflow(workflow_id, args)\n+            except ValueError as exc:\n+                return {\"ok\": False, \"tool\": name, \"error\": str(exc)}\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": {\"run\": run.to_dict()}}\n+        if name == \"harness_capability_resolve\":\n+            capability = str(args.get(\"capability\") or args.get(\"name\") or \"\").strip()\n+            objective = str(args.get(\"objective\") or \"\").strip()\n+            if not capability:\n+                return {\"ok\": False, \"tool\": name, \"error\": \"capability is required\"}\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.resolve_capability(capability, objective=objective)}\n+        if name == \"harness_tool_draft\":\n+            objective = str(args.get(\"objective\") or args.get(\"prompt\") or \"\").strip()\n+            if not objective:\n+                return {\"ok\": False, \"tool\": name, \"error\": \"objective is required\"}\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.draft_dynamic_tool(objective)}\n+        if name == \"harness_tool_create\":\n+            try:\n+                return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.create_dynamic_tool(args)}\n+            except ValueError as exc:\n+                return {\"ok\": False, \"tool\": name, \"error\": str(exc)}\n+        if name == \"harness_tool_list\":\n+            return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.list_dynamic_tools()}\n+        if name == \"harness_tool_check\":\n+            tool_id = str(args.get(\"tool_id\") or args.get(\"name\") or args.get(\"tool_name\") or \"\").strip()\n+            if not tool_id:\n+                return {\"ok\": False, \"tool\": name, \"error\": \"tool_id or name is required\"}\n+            try:\n+                return {\"ok\": True, \"tool\": name, \"mode\": \"harness\", \"json\": self.run_dynamic_tool_check(tool_id, args)}\n+            except ValueError as exc:\n+                return {\"ok\": False, \"tool\": name, \"error\": str(exc)}\n+        result = await self.tool_bridge.call(name, **args)\n+        return {\n+            **result,\n+            \"mode\": \"shovs_native\",\n+            \"recorded\": False,\n+            \"note\": \"Direct tool-call endpoint is for integration tests and external apps. Full runs record tool calls in run events.\",\n+        }\n+\n+    def get_run(self, run_id: str) -> RunRecord | None:\n+        return self.store.get(run_id)\n+\n+    def list_runs(self) -> list[RunRecord]:\n+        return self.store.list()\n+\n+    def list_chat(self, session_id: str, *, limit: int = 80) -> dict[str, Any]:\n+        session_id = session_id or \"default\"\n+        turns = self.chat_store.list(session_id, limit=limit)\n+        return {\n+            \"session_id\": session_id,\n+            \"turns\": [turn.to_dict() for turn in turns],\n+            \"compact\": _compact_chat_history(turns),\n+        }\n+\n+    def list_sessions(self) -> dict[str, Any]:\n+        return {\"sessions\": self.chat_store.sessions()}\n+\n+    def job_status(self) -> dict[str, Any]:\n+        active: dict[str, dict[str, Any]] = {}\n+        done_ids: list[str] = []\n+        for run_id, future in self._jobs.items():\n+            run = self.get_run(run_id)\n+            if future.done():\n+                done_ids.append(run_id)\n+            active[run_id] = {\n+                \"run_id\": run_id,\n+                \"future_done\": future.done(),\n+                \"future_cancelled\": future.cancelled(),\n+                \"status\": run.status if run else \"missing\",\n+                \"objective\": run.objective if run else \"\",\n+                \"updated_at\": run.updated_at if run else \"\",\n+            }\n+        for run_id in done_ids:\n+            self._jobs.pop(run_id, None)\n+        active = {run_id: item for run_id, item in active.items() if run_id not in done_ids}\n+        return {\n+            \"max_workers\": self._max_workers,\n+            \"active_jobs\": len(active),\n+            \"capacity_available\": max(0, self._max_workers - len(active)),\n+            \"jobs\": list(active.values()),\n+        }\n+\n+    def _record_user_turn(self, session_id: str, run_id: str, objective: str, understanding: dict[str, Any]) -> None:\n+        self.chat_store.add(\n+            ChatTurn(\n+                turn_id=rid(\"turn\"),\n+                session_id=session_id or \"default\",\n+                role=\"user\",\n+                content=objective,\n+                run_id=run_id,\n+                summary=_summarize_text(objective),\n+                metadata={\"understanding\": understanding},\n+            )\n+        )\n+\n+    def _record_assistant_turn(self, run: RunRecord, answer: str) -> None:\n+        session_id = _run_session_id(run)\n+        if not session_id:\n+            return\n+        if any(turn.role == \"assistant\" and turn.run_id == run.run_id for turn in self.chat_store.list(session_id, limit=20)):\n+            return\n+        text = answer or _terminal_status_text(run)\n+        self.chat_store.add(\n+            ChatTurn(\n+                turn_id=rid(\"turn\"),\n+                session_id=session_id,\n+                role=\"assistant\",\n+                content=text,\n+                run_id=run.run_id,\n+                summary=_summarize_text(text),\n+                metadata={\"status\": run.status, \"execution_state\": (run.result or {}).get(\"execution_state\") or {}},\n+            )\n+        )\n+\n+    def manifest(self) -> dict[str, Any]:\n+        return {\n+            \"name\": \"Shovs Agent Harness\",\n+            \"version\": \"0.3.0\",\n+            \"spine\": \"shovs-harness-core\",\n+            \"claim\": \"portable runtime harness for agent workflow enforcement\",\n+            \"config\": self.config.to_dict(),\n+            \"endpoints\": [\n+                \"/api/workflows/draft\",\n+                \"/api/workflows\",\n+                \"/api/workflows/{workflow_id}/run\",\n+                \"/api/workflows/{workflow_id}/run_async\",\n+                \"/api/runs\",\n+                \"/api/runs/async\",\n+                \"/api/runs/{run_id}\",\n+                \"/api/runs/{run_id}/events\",\n+                \"/api/runs/{run_id}/result\",\n+                \"/api/runs/{run_id}/context\",\n+                \"/api/runs/{run_id}/evidence\",\n+                \"/api/chat/sessions\",\n+                \"/api/chat/{session_id}\",\n+                \"/api/jobs\",\n+                \"/api/memory\",\n+                \"/api/runtime/understand\",\n+                \"/api/runs/{run_id}/continue\",\n+                \"/api/runs/{run_id}/interrupt\",\n+                \"/api/compare\",\n+            ],\n+            \"invariants\": [\n+                \"model text is not tool truth\",\n+                \"tool results must be linked to calls\",\n+                \"contracts decide when finalization is allowed\",\n+                \"missing evidence stays unresolved\",\n+                \"run state is durable by default\",\n+                \"memory writes require provenance\",\n+                \"replacement memory is add-before-void\",\n+            ],\n+            \"adapter_slots\": [\"search\", \"fetch\", \"entity_extraction\", \"synthesis\"],\n+            \"real_backends\": [\"searxng\", \"brave\", \"tavily\", \"alpha_vantage\", \"jina_fetch\", \"http_fetch\", \"llm_adapter_factory\"],\n+            \"execution\": self.job_status(),\n+            \"tool_bridge\": self.tool_manifest(),\n+        }\n+\n+\n+def _session_id_from_config(run_config: dict[str, Any]) -> str:\n+    value = str(run_config.get(\"session_id\") or run_config.get(\"thread_id\") or \"\").strip()\n+    return value or \"default\"\n+\n+\n+def _run_session_id(run: RunRecord) -> str:\n+    result = run.result or {}\n+    if isinstance(result.get(\"session_id\"), str) and result.get(\"session_id\"):\n+        return str(result[\"session_id\"])\n+    for event in run.events:\n+        if event.phase in {\"history\", \"intake\"}:\n+            value = event.data.get(\"session_id\") if isinstance(event.data, dict) else \"\"\n+            if value:\n+                return str(value)\n+    return \"default\"\n+\n+\n+def _compact_chat_history(turns: list[ChatTurn]) -> list[dict[str, Any]]:\n+    compact: list[dict[str, Any]] = []\n+    for turn in turns[-10:]:\n+        compact.append(\n+            {\n+                \"role\": turn.role,\n+                \"summary\": turn.summary or _summarize_text(turn.content),\n+                \"run_id\": turn.run_id,\n+                \"created_at\": turn.created_at,\n+            }\n+        )\n+    return compact\n+\n+\n+def _summarize_text(text: str, *, limit: int = 220) -> str:\n+    cleaned = re.sub(r\"\\s+\", \" \", str(text or \"\")).strip()\n+    if len(cleaned) <= limit:\n+        return cleaned\n+    return cleaned[: limit - 1].rstrip() + \"…\"\n+\n+\n+def _terminal_status_text(run: RunRecord) -> str:\n+    result = run.result or {}\n+    answer = str(result.get(\"answer\") or \"\").strip()\n+    if answer:\n+        return answer\n+    state = result.get(\"execution_state\") if isinstance(result.get(\"execution_state\"), dict) else {}\n+    next_action = state.get(\"next_required_action\") or \"inspect_run\"\n+    return f\"Run {run.status}. Next required action: {next_action}.\"\n+\n+\n+def _append_and_save(store: RunStore, run: RunRecord, phase: str, status: str, summary: str, data: dict[str, Any]) -> None:\n+    run.add_event(phase, status, summary, data)\n+    store.put(run)\n+\n+\n+def _eval_to_dict(value: Any) -> dict[str, Any] | None:\n+    if value is None:\n+        return None\n+    return {\n+        \"ok\": bool(getattr(value, \"ok\", False)),\n+        \"score\": float(getattr(value, \"score\", 0.0)),\n+        \"failures\": list(getattr(value, \"failures\", [])),\n+        \"metrics\": dict(getattr(value, \"metrics\", {})),\n+    }\n+\n+\n+def _record_kernel(ledger: Ledger, events: list, tool: str, args: dict, ok: bool, data: dict, *, entity: str = \"\") -> None:\n+    call = ledger.add_call(tool, args)\n+    ledger.add_result(call.id, ok, data, f\"{tool} {entity}\".strip())\n+    item = {\"tool\": tool, \"ok\": ok}\n+    if entity:\n+        item[\"entity\"] = entity\n+    events.append(item)\n+\n+\n+def _dedupe_entities(raw_entities: Any, limit: int) -> list[str]:\n+    out: list[str] = []\n+    for item in raw_entities or []:\n+        value = str(item or \"\").strip().upper()\n+        if value and value not in out:\n+            out.append(value)\n+    return out[:limit]\n+\n+\n+def _mark_interrupted(run: RunRecord, reason: str) -> None:\n+    run.status = \"interrupted\"\n+    run.updated_at = now()\n+    run.add_event(\n+        \"interrupt\",\n+        \"success\",\n+        \"Run stopped at a safe cursor.\",\n+        {\"reason\": reason, \"next_required_action\": \"continue_or_edit_workflow\"},\n+    )\n+    run.result = {\n+        **(run.result or {}),\n+        \"status\": \"interrupted\",\n+        \"answer\": \"\",\n+        \"continuation_state\": {\n+            \"run_id\": run.run_id,\n+            \"session_id\": _run_session_id(run),\n+            \"objective\": run.objective,\n+            \"workflow\": run.workflow,\n+            \"reason\": reason,\n+            \"next_required_action\": \"continue_or_edit_workflow\",\n+        },\n+    }\n+\n+\n+def _result_payload(\n+    run: RunRecord,\n+    answer: str,\n+    entities: list[str],\n+    understanding: dict[str, Any],\n+    fetched: list[dict[str, Any]],\n+    llm_calls: int,\n+    tool_calls: int,\n+    eval_result: Any,\n+    trace: list[dict[str, Any]],\n+) -> dict[str, Any]:\n+    return {\n+        \"run_id\": run.run_id,\n+        \"session_id\": _run_session_id(run),\n+        \"status\": run.status,\n+        \"answer\": answer,\n+        \"entities\": entities,\n+        \"understanding\": understanding,\n+        \"evidence\": [\n+            {\n+                \"id\": f\"evidence_{index + 1}\",\n+                \"entity\": str(item.get(\"entity\") or \"\"),\n+                \"url\": str(item.get(\"url\") or \"\"),\n+                \"summary\": str(item.get(\"content\") or \"\")[:240],\n+                \"status\": \"selected\",\n+            }\n+            for index, item in enumerate(fetched)\n+        ],\n+        \"fetched_count\": len(fetched),\n+        \"llm_calls\": llm_calls,\n+        \"tool_calls\": tool_calls,\n+        \"eval\": _eval_to_dict(eval_result),\n+        \"trace\": trace,\n+        \"execution_state\": {\n+            \"step\": \"done\" if run.status == \"completed\" else run.status,\n+            \"next_required_action\": \"respond\" if run.status == \"completed\" else \"continue_or_edit_workflow\",\n+        },\n+        \"api\": {\n+            \"status\": f\"/api/runs/{run.run_id}\",\n+            \"events\": f\"/api/runs/{run.run_id}/events\",\n+            \"result\": f\"/api/runs/{run.run_id}/result\",\n+        },\n+    }\n+\n+\n+def _capability_result_payload(\n+    run: RunRecord,\n+    *,\n+    answer: str,\n+    understanding: dict[str, Any],\n+    resolution: dict[str, Any],\n+    status: str,\n+    artifacts: list[dict[str, Any]] | None = None,\n+    raw_tool_result: dict[str, Any] | None = None,\n+) -> dict[str, Any]:\n+    return {\n+        \"run_id\": run.run_id,\n+        \"session_id\": _run_session_id(run),\n+        \"status\": status,\n+        \"answer\": answer,\n+        \"understanding\": understanding,\n+        \"capability\": resolution,\n+        \"artifacts\": artifacts or [],\n+        \"raw_tool_result\": raw_tool_result or {},\n+        \"execution_state\": {\n+            \"step\": \"capability_resolved\",\n+            \"next_required_action\": \"respond\" if status == \"completed\" else \"configure_capability\",\n+        },\n+        \"api\": {\n+            \"status\": f\"/api/runs/{run.run_id}\",\n+            \"events\": f\"/api/runs/{run.run_id}/events\",\n+            \"result\": f\"/api/runs/{run.run_id}/result\",\n+        },\n+    }\n+\n+\n+def _stock_report_payload(\n+    run: RunRecord,\n+    *,\n+    ticker: str,\n+    answer: str,\n+    understanding: dict[str, Any],\n+    reports: list[dict[str, Any]],\n+    evidence: list[dict[str, Any]],\n+    status: str,\n+) -> dict[str, Any]:\n+    return {\n+        \"run_id\": run.run_id,\n+        \"session_id\": _run_session_id(run),\n+        \"status\": status,\n+        \"answer\": answer,\n+        \"ticker\": ticker,\n+        \"understanding\": understanding,\n+        \"artifacts\": reports,\n+        \"reports\": reports,\n+        \"evidence\": [\n+            {\n+                \"id\": f\"tool_{index + 1}\",\n+                \"tool\": item.get(\"tool\"),\n+                \"status\": \"success\" if item.get(\"ok\") else \"partial\",\n+                \"summary\": json.dumps(item.get(\"payload\"), default=str)[:240],\n+            }\n+            for index, item in enumerate(evidence)\n+        ],\n+        \"execution_state\": {\n+            \"step\": \"reports_ready\" if status == \"completed\" else \"missing_input\",\n+            \"next_required_action\": \"read_report\" if status == \"completed\" else \"provide_ticker\",\n+        },\n+        \"api\": {\n+            \"status\": f\"/api/runs/{run.run_id}\",\n+            \"events\": f\"/api/runs/{run.run_id}/events\",\n+            \"result\": f\"/api/runs/{run.run_id}/result\",\n+        },\n+    }\n+\n+\n+def _reports_root() -> Path:\n+    root = ROOT / \".runtime\" / \"reports\"\n+    root.mkdir(parents=True, exist_ok=True)\n+    return root\n+\n+\n+def _safe_report_name(filename: str) -> str:\n+    name = re.sub(r\"[^a-zA-Z0-9_.-]+\", \"-\", str(filename or \"\")).strip(\".-\")\n+    return name if name.endswith(\".md\") else f\"{name or 'report'}.md\"\n+\n+\n+def _write_run_report(run_id: str, filename: str, content: str) -> dict[str, Any]:\n+    safe = _safe_report_name(filename)\n+    run_dir = _reports_root() / run_id\n+    run_dir.mkdir(parents=True, exist_ok=True)\n+    target = (run_dir / safe).resolve()\n+    if not str(target).startswith(str(run_dir.resolve())):\n+        raise RuntimeError(\"unsafe report path\")\n+    target.write_text(content, encoding=\"utf-8\")\n+    return {\n+        \"type\": \"report\",\n+        \"filename\": safe,\n+        \"path\": str(target),\n+        \"url\": f\"/api/runs/{run_id}/files/{safe}\",\n+        \"bytes\": target.stat().st_size,\n+    }\n+\n+\n+def _extract_ticker(objective: str) -> str:\n+    text = str(objective or \"\")\n+    explicit = re.search(r\"\\b(?:ticker|stock|symbol)\\s+([A-Z]{1,5})\\b\", text)\n+    if explicit:\n+        return explicit.group(1).upper()\n+    cashtags = re.findall(r\"\\$([A-Z]{1,5})\\b\", text)\n+    if cashtags:\n+        return cashtags[0].upper()\n+    candidates = [\n+        item.upper()\n+        for item in re.findall(r\"\\b[A-Z]{2,5}\\b\", text)\n+        if item.upper() not in {\"AI\", \"API\", \"MCP\", \"URL\", \"ETF\", \"CEO\", \"CFO\", \"USA\"}\n+    ]\n+    if candidates:\n+        return candidates[0]\n+    names = {\n+        \"tesla\": \"TSLA\",\n+        \"nvidia\": \"NVDA\",\n+        \"apple\": \"AAPL\",\n+        \"microsoft\": \"MSFT\",\n+        \"amazon\": \"AMZN\",\n+        \"google\": \"GOOGL\",\n+        \"alphabet\": \"GOOGL\",\n+        \"meta\": \"META\",\n+        \"airbnb\": \"ABNB\",\n+    }\n+    lowered = text.lower()\n+    for name, ticker in names.items():\n+        if name in lowered:\n+            return ticker\n+    return \"\"\n+\n+\n+def _analyst_report_text(label: str, ticker: str, tool: str, payload: Any, *, ok: bool) -> str:\n+    payload_text = json.dumps(payload, indent=2, sort_keys=True, default=str)\n+    status = \"completed\" if ok else \"partial\"\n+    return (\n+        f\"# {label} Report: {ticker}\\n\\n\"\n+        f\"Status: {status}\\n\\n\"\n+        f\"Tool used: `{tool}`\\n\\n\"\n+        \"## Key Data\\n\\n\"\n+        f\"```json\\n{payload_text[:8000]}\\n```\\n\\n\"\n+        \"## Harness Note\\n\\n\"\n+        \"This file is generated from recorded tool output. If a field is missing, it is treated as unresolved rather than invented.\\n\"\n+    )\n+\n+\n+def _risk_report_text(ticker: str, evidence: list[dict[str, Any]]) -> str:\n+    failed = [item.get(\"tool\") for item in evidence if not item.get(\"ok\")]\n+    success = [item.get(\"tool\") for item in evidence if item.get(\"ok\")]\n+    return (\n+        f\"# Risk Report: {ticker}\\n\\n\"\n+        \"## Coverage\\n\\n\"\n+        f\"Successful evidence tools: {', '.join(success) or 'none'}\\n\\n\"\n+        f\"Partial or missing tools: {', '.join(failed) or 'none'}\\n\\n\"\n+        \"## Risks\\n\\n\"\n+        \"- Market data can be delayed depending on provider limits.\\n\"\n+        \"- News sentiment is not a trading signal by itself.\\n\"\n+        \"- Missing fundamentals or news must remain unresolved in the final answer.\\n\"\n+        \"- This report is informational and not financial advice.\\n\"\n+    )\n+\n+\n+def _final_stock_report_text(ticker: str, reports: list[dict[str, Any]], evidence: list[dict[str, Any]]) -> str:\n+    rows = \"\\n\".join(\n+        f\"| {item.get('label')} | {item.get('status')} | [{item.get('filename')}]({item.get('url')}) |\"\n+        for item in reports\n+    )\n+    evidence_rows = \"\\n\".join(\n+        f\"| {item.get('tool')} | {'success' if item.get('ok') else 'partial'} |\"\n+        for item in evidence\n+    )\n+    return (\n+        f\"# Stock Analysis Final Report: {ticker}\\n\\n\"\n+        \"## Analyst Files\\n\\n\"\n+        \"| Agent | Status | File |\\n| --- | --- | --- |\\n\"\n+        f\"{rows}\\n\\n\"\n+        \"## Evidence Coverage\\n\\n\"\n+        \"| Tool | Status |\\n| --- | --- |\\n\"\n+        f\"{evidence_rows}\\n\\n\"\n+        \"## TLDR\\n\\n\"\n+        f\"The harness completed a multi-stage stock analysis for `{ticker}` and wrote separate file-backed reports for market, news, fundamentals, risk, and final synthesis.\\n\\n\"\n+        \"This is a runtime-generated research packet. Treat unresolved or partial tool outputs as gaps, not conclusions.\\n\"\n+    )\n+\n+\n+def _image_prompt_from_objective(objective: str) -> str:\n+    text = \" \".join(str(objective or \"\").split())\n+    cleaned = re.sub(\n+        r\"^\\s*(please\\s+)?(generate|create|make|draw)\\s+(an?\\s+)?(image|picture|illustration|mockup|poster|logo)\\s*(of|for|about)?\\s*\",\n+        \"\",\n+        text,\n+        flags=re.IGNORECASE,\n+    ).strip(\" .,:;\")\n+    return cleaned or text or \"A clean modern abstract image\"\n+\n+\n+def _connector_target_from_objective(objective: str) -> str:\n+    lowered = str(objective or \"\").lower()\n+    for target in (\"gmail\", \"slack\", \"github\", \"notion\", \"linear\", \"jira\", \"google drive\", \"calendar\"):\n+        if target in lowered:\n+            return target\n+    if \"mcp\" in lowered:\n+        return \"mcp\"\n+    return \"connector\"\n+\n+\n+def _connector_required_env(target: str) -> list[str]:\n+    target = str(target or \"\").lower().replace(\" \", \"_\")\n+    mapping = {\n+        \"gmail\": [\"GOOGLE_CLIENT_ID\", \"GOOGLE_CLIENT_SECRET\", \"GOOGLE_REFRESH_TOKEN\"],\n+        \"google_drive\": [\"GOOGLE_CLIENT_ID\", \"GOOGLE_CLIENT_SECRET\", \"GOOGLE_REFRESH_TOKEN\"],\n+        \"calendar\": [\"GOOGLE_CLIENT_ID\", \"GOOGLE_CLIENT_SECRET\", \"GOOGLE_REFRESH_TOKEN\"],\n+        \"slack\": [\"SLACK_BOT_TOKEN\", \"SLACK_SIGNING_SECRET\"],\n+        \"github\": [\"GITHUB_TOKEN\"],\n+        \"notion\": [\"NOTION_TOKEN\"],\n+        \"linear\": [\"LINEAR_API_KEY\"],\n+        \"jira\": [\"JIRA_BASE_URL\", \"JIRA_EMAIL\", \"JIRA_API_TOKEN\"],\n+        \"mcp\": [\"MCP_SERVER_ID\", \"MCP_COMMAND_OR_URL\"],\n+    }\n+    return mapping.get(target, [\"CONNECTOR_CREDENTIALS\"])\n+\n+\n+def _normalize_tool_name(value: str) -> str:\n+    name = re.sub(r\"[^a-zA-Z0-9_]+\", \"_\", str(value or \"\").strip().lower()).strip(\"_\")\n+    if name and not name.startswith(\"dyn_\"):\n+        name = f\"dyn_{name}\"\n+    return name[:64]\n+\n+\n+def _tool_name_from_objective(objective: str, *, suffix: str) -> str:\n+    words = re.findall(r\"[a-zA-Z0-9]+\", str(objective or \"\").lower())\n+    stop = {\"the\", \"and\", \"for\", \"with\", \"that\", \"this\", \"from\", \"into\", \"create\", \"make\", \"check\", \"tool\"}\n+    stem = \"_\".join(word for word in words if word not in stop)[:42].strip(\"_\")\n+    return _normalize_tool_name(f\"{stem}_{suffix}\" if stem else suffix)\n+\n+\n+def _terms_from_objective(objective: str) -> list[str]:\n+    words = re.findall(r\"[a-zA-Z][a-zA-Z0-9_-]{2,}\", str(objective or \"\").lower())\n+    stop = {\n+        \"the\", \"and\", \"for\", \"with\", \"that\", \"this\", \"from\", \"into\", \"create\", \"make\",\n+        \"tool\", \"check\", \"when\", \"necessary\", \"specific\", \"context\", \"runtime\",\n+    }\n+    unique = []\n+    for word in words:\n+        if word not in stop and word not in unique:\n+            unique.append(word)\n+        if len(unique) >= 8:\n+            break\n+    return unique or [\"complete\"]\n+\n+\n+def _compact_tool_input(payload: dict[str, Any], policy: dict[str, Any]) -> str:\n+    max_chars = int(policy.get(\"max_input_chars\") or 1200)\n+    text = payload.get(\"text\")\n+    if text is None:\n+        text = payload.get(\"content\")\n+    if text is None:\n+        text = payload.get(\"payload\")\n+    if isinstance(text, (dict, list)):\n+        text = json.dumps(text, sort_keys=True, default=str)\n+    if text is None:\n+        text = json.dumps({k: v for k, v in payload.items() if k not in {\"tool_id\", \"name\", \"tool_name\"}}, sort_keys=True, default=str)\n+    compact = \" \".join(str(text or \"\").split())\n+    return compact[: max(200, max_chars)]\n+\n+\n+def _run_regex_check(spec: DynamicToolSpec, text: str) -> dict[str, Any]:\n+    patterns = spec.check_schema.get(\"patterns\") if isinstance(spec.check_schema.get(\"patterns\"), dict) else {}\n+    min_counts = spec.check_schema.get(\"min_counts\") if isinstance(spec.check_schema.get(\"min_counts\"), dict) else {}\n+    matches: dict[str, list[str]] = {}\n+    checks: dict[str, dict[str, Any]] = {}\n+    ok = True\n+    for key, pattern in patterns.items():\n+        try:\n+            found = list(dict.fromkeys(re.findall(str(pattern), text, flags=re.IGNORECASE)))\n+        except re.error as exc:\n+            return {\"ok\": False, \"error\": f\"invalid regex for {key}: {exc}\", \"matches\": {}, \"checks\": {}}\n+        clipped = [str(item if not isinstance(item, tuple) else \" \".join(item)).strip()[:180] for item in found[:12]]\n+        required = int(min_counts.get(key) or 0)\n+        passed = len(clipped) >= required\n+        ok = ok and passed\n+        matches[str(key)] = clipped\n+        checks[str(key)] = {\"count\": len(clipped), \"required\": required, \"passed\": passed}\n+    return {\"ok\": ok, \"kind\": spec.kind, \"matches\": matches, \"checks\": checks}\n+\n+\n+def _run_checklist(spec: DynamicToolSpec, text: str) -> dict[str, Any]:\n+    required_terms = [str(item).lower() for item in spec.check_schema.get(\"required_terms\") or []]\n+    min_required = int(spec.check_schema.get(\"min_required_terms\") or len(required_terms) or 1)\n+    lowered = text.lower()\n+    present = [term for term in required_terms if term and term in lowered]\n+    missing = [term for term in required_terms if term and term not in lowered]\n+    return {\n+        \"ok\": len(present) >= min_required,\n+        \"kind\": spec.kind,\n+        \"present\": present,\n+        \"missing\": missing,\n+        \"required\": min_required,\n+        \"summary\": f\"{len(present)}/{len(required_terms)} checklist terms present\",\n+    }\n+\n+\n+def _run_json_field_check(spec: DynamicToolSpec, payload: dict[str, Any]) -> dict[str, Any]:\n+    source = payload.get(\"json\")\n+    if source is None:\n+        source = payload.get(\"payload\")\n+    if isinstance(source, str):\n+        try:\n+            source = json.loads(source)\n+        except Exception:\n+            return {\"ok\": False, \"kind\": spec.kind, \"error\": \"payload is not valid JSON\"}\n+    if not isinstance(source, dict):\n+        return {\"ok\": False, \"kind\": spec.kind, \"error\": \"payload must be an object\"}\n+    required = [str(item) for item in spec.check_schema.get(\"required_fields\") or []]\n+    present = [field for field in required if _json_path_exists(source, field)]\n+    missing = [field for field in required if field not in present]\n+    return {\"ok\": not missing, \"kind\": spec.kind, \"present\": present, \"missing\": missing}\n+\n+\n+def _json_path_exists(data: dict[str, Any], path: str) -> bool:\n+    current: Any = data\n+    for part in str(path).split(\".\"):\n+        if not isinstance(current, dict) or part not in current:\n+            return False\n+        current = current[part]\n+    return True\n+\n+\n+def _workflow_answer(workflow: dict[str, Any]) -> str:\n+    tools = \", \".join(str(tool) for tool in workflow.get(\"tools\") or []) or \"no tools\"\n+    label = workflow.get(\"label\") or workflow.get(\"workflow_id\") or workflow.get(\"id\") or \"Untitled workflow\"\n+    runtime = workflow.get(\"runtime\") if isinstance(workflow.get(\"runtime\"), dict) else {}\n+    edge = workflow.get(\"edge\") or runtime.get(\"edge\") or \"not recorded\"\n+    return (\n+        f\"Created workflow: {label}.\\n\"\n+        f\"Policy: {workflow.get('policy') or 'not recorded'}.\\n\"\n+        f\"Tools: {tools}.\\n\"\n+        f\"Edge: {edge}.\\n\\n\"\n+        \"This is a reusable runtime contract, not a one-off answer. \"\n+        \"You can run it through /api/runs/async, embed it from another frontend, or compose it with another workflow.\"\n+    )\n+\n+\n+def _workflow_spec_from_draft(\n+    draft: dict[str, Any],\n+    *,\n+    objective: str,\n+    config: HarnessConfig,\n+    run_config: dict[str, Any],\n+) -> WorkflowSpec:\n+    runtime = {\n+        \"model_provider\": config.model_provider,\n+        \"model_name\": config.model_name,\n+        \"tool_mode\": config.tool_mode,\n+        \"model_slots_enabled\": config.model_slots_enabled,\n+        \"interruptible\": True,\n+        \"source_draft_id\": draft.get(\"id\") or \"\",\n+        \"edge\": draft.get(\"edge\") or \"\",\n+        **dict(run_config.get(\"runtime\") or {}),\n+    }\n+    return WorkflowSpec(\n+        workflow_id=rid(\"wf\"),\n+        label=str(draft.get(\"label\") or \"Workflow\"),\n+        objective=objective,\n+        policy=str(draft.get(\"policy\") or \"plan_execute\"),\n+        tools=list(draft.get(\"tools\") or []),\n+        nodes=_default_nodes(draft),\n+        edges=_default_edges(draft),\n+        input_schema=dict(draft.get(\"input_schema\") or {\"objective\": \"string\"}),\n+        output_schema=dict(draft.get(\"output_schema\") or {}),\n+        runtime=runtime,\n+    )\n+\n+\n+def _default_nodes(draft: dict[str, Any]) -> list[dict[str, Any]]:\n+    return [\n+        {\n+            \"id\": \"planner\",\n+            \"label\": \"Planner\",\n+            \"role\": \"planner\",\n+            \"model_slot\": \"quick\",\n+            \"allowed_tools\": [],\n+            \"contract\": \"produce workflow steps and required evidence slots\",\n+        },\n+        {\n+            \"id\": \"actor\",\n+            \"label\": \"Tool Actor\",\n+            \"role\": \"actor\",\n+            \"model_slot\": \"none\",\n+            \"allowed_tools\": list(draft.get(\"tools\") or []),\n+            \"contract\": \"execute only allowed runtime-selected tool calls\",\n+        },\n+        {\n+            \"id\": \"verifier\",\n+            \"label\": \"Verifier\",\n+            \"role\": \"verifier\",\n+            \"model_slot\": \"quick\",\n+            \"allowed_tools\": [],\n+            \"contract\": \"block unsupported claims and missing evidence\",\n+        },\n+        {\n+            \"id\": \"writer\",\n+            \"label\": \"Writer\",\n+            \"role\": \"writer\",\n+            \"model_slot\": \"deep\",\n+            \"allowed_tools\": [],\n+            \"contract\": \"write the final useful response from ledger evidence only\",\n+        },\n+    ]\n+\n+\n+def _default_edges(_draft: dict[str, Any]) -> list[dict[str, Any]]:\n+    return [\n+        {\"from\": \"planner\", \"to\": \"actor\", \"handoff\": \"plan_steps + evidence_contract\"},\n+        {\"from\": \"actor\", \"to\": \"verifier\", \"handoff\": \"tool_results + evidence_ids\"},\n+        {\"from\": \"verifier\", \"to\": \"writer\", \"handoff\": \"verification + allowed_claims\"},\n+    ]\n+\n+\n+def _prompt_packets(\n+    objective: str,\n+    workflow: dict[str, Any],\n+    understanding: dict[str, Any],\n+    run_config: dict[str, Any],\n+) -> list[dict[str, Any]]:\n+    packets = []\n+    for node in workflow.get(\"nodes\") or _default_nodes(workflow):\n+        packets.append(\n+            {\n+                \"node_id\": node.get(\"id\") or \"node\",\n+                \"role\": node.get(\"role\") or \"worker\",\n+                \"model_slot\": node.get(\"model_slot\") or \"quick\",\n+                \"objective\": objective,\n+                \"policy\": workflow.get(\"policy\") or \"plan_execute\",\n+                \"allowed_tools\": node.get(\"allowed_tools\") or [],\n+                \"context\": {\n+                    \"intent\": understanding.get(\"intent\"),\n+                    \"constraints\": understanding.get(\"constraints\") or {},\n+                    \"next_action_hint\": understanding.get(\"next_action_hint\") or \"\",\n+                    \"raw_trace_hidden\": True,\n+                },\n+                \"output_contract\": node.get(\"contract\") or \"return structured output only\",\n+                \"runtime\": run_config,\n+            }\n+        )\n+    return packets"},{"sha":"fe68b1bf825c2f2b6d220bf32693fb6923680fd0","filename":"extractions/shovs-agent-harness/backend/store.py","status":"added","additions":795,"deletions":0,"changes":795,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fstore.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fstore.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fstore.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,795 @@\n+from __future__ import annotations\n+\n+import json\n+import sqlite3\n+import threading\n+from pathlib import Path\n+\n+from .models import ChatTurn, DynamicToolSpec, MemoryFact, RunRecord, WorkflowSpec, now, rid\n+\n+\n+class RunStore:\n+    def put(self, run: RunRecord) -> None:\n+        raise NotImplementedError\n+\n+    def get(self, run_id: str) -> RunRecord | None:\n+        raise NotImplementedError\n+\n+    def list(self) -> list[RunRecord]:\n+        raise NotImplementedError\n+\n+\n+class JsonRunStore(RunStore):\n+    \"\"\"Small durable run store for local/open-source use.\n+\n+    This intentionally stays dependency-free. Production deployments can swap\n+    this class for Postgres/Redis/S3 without changing the service or API shape.\n+    \"\"\"\n+\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+\n+    def put(self, run: RunRecord) -> None:\n+        with self._lock:\n+            runs = {item.run_id: item for item in self.list()}\n+            runs[run.run_id] = run\n+            self.path.parent.mkdir(parents=True, exist_ok=True)\n+            tmp = self.path.with_suffix(self.path.suffix + \".tmp\")\n+            tmp.write_text(\n+                json.dumps([item.to_dict() for item in runs.values()], indent=2, sort_keys=True),\n+                encoding=\"utf-8\",\n+            )\n+            tmp.replace(self.path)\n+\n+    def get(self, run_id: str) -> RunRecord | None:\n+        return next((run for run in self.list() if run.run_id == run_id), None)\n+\n+    def list(self) -> list[RunRecord]:\n+        if not self.path.exists():\n+            return []\n+        try:\n+            data = json.loads(self.path.read_text(encoding=\"utf-8\"))\n+        except Exception:\n+            return []\n+        if not isinstance(data, list):\n+            return []\n+        return [RunRecord.from_dict(item) for item in data if isinstance(item, dict)]\n+\n+\n+class SqliteRunStore(RunStore):\n+    \"\"\"Durable run store suitable for local and small cloud deployments.\"\"\"\n+\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+        self._init()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        self.path.parent.mkdir(parents=True, exist_ok=True)\n+        conn = sqlite3.connect(str(self.path))\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS runs (\n+                    run_id TEXT PRIMARY KEY,\n+                    objective TEXT NOT NULL,\n+                    workflow_json TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    result_json TEXT,\n+                    created_at TEXT NOT NULL,\n+                    updated_at TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS run_events (\n+                    id TEXT PRIMARY KEY,\n+                    run_id TEXT NOT NULL,\n+                    phase TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    summary TEXT NOT NULL,\n+                    data_json TEXT NOT NULL,\n+                    created_at TEXT NOT NULL,\n+                    FOREIGN KEY(run_id) REFERENCES runs(run_id)\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_run_events_run_created ON run_events(run_id, created_at)\")\n+\n+    def put(self, run: RunRecord) -> None:\n+        with self._lock, self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT INTO runs(run_id, objective, workflow_json, status, result_json, created_at, updated_at)\n+                VALUES (?, ?, ?, ?, ?, ?, ?)\n+                ON CONFLICT(run_id) DO UPDATE SET\n+                    objective=excluded.objective,\n+                    workflow_json=excluded.workflow_json,\n+                    status=excluded.status,\n+                    result_json=excluded.result_json,\n+                    updated_at=excluded.updated_at\n+                \"\"\",\n+                (\n+                    run.run_id,\n+                    run.objective,\n+                    json.dumps(run.workflow, sort_keys=True),\n+                    run.status,\n+                    json.dumps(run.result, sort_keys=True) if run.result is not None else None,\n+                    run.created_at,\n+                    run.updated_at,\n+                ),\n+            )\n+            for event in run.events:\n+                conn.execute(\n+                    \"\"\"\n+                    INSERT OR REPLACE INTO run_events(id, run_id, phase, status, summary, data_json, created_at)\n+                    VALUES (?, ?, ?, ?, ?, ?, ?)\n+                    \"\"\",\n+                    (\n+                        event.id,\n+                        event.run_id,\n+                        event.phase,\n+                        event.status,\n+                        event.summary,\n+                        json.dumps(event.data, sort_keys=True),\n+                        event.created_at,\n+                    ),\n+                )\n+\n+    def get(self, run_id: str) -> RunRecord | None:\n+        with self._connect() as conn:\n+            row = conn.execute(\"SELECT * FROM runs WHERE run_id = ?\", (run_id,)).fetchone()\n+            if row is None:\n+                return None\n+            return self._row_to_run(conn, row)\n+\n+    def list(self) -> list[RunRecord]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\"SELECT * FROM runs ORDER BY created_at DESC LIMIT 200\").fetchall()\n+            return [self._row_to_run(conn, row) for row in rows]\n+\n+    def _row_to_run(self, conn: sqlite3.Connection, row: sqlite3.Row) -> RunRecord:\n+        events = []\n+        for event_row in conn.execute(\"SELECT * FROM run_events WHERE run_id = ? ORDER BY created_at\", (row[\"run_id\"],)).fetchall():\n+            events.append({\n+                \"id\": event_row[\"id\"],\n+                \"run_id\": event_row[\"run_id\"],\n+                \"phase\": event_row[\"phase\"],\n+                \"status\": event_row[\"status\"],\n+                \"summary\": event_row[\"summary\"],\n+                \"data\": json.loads(event_row[\"data_json\"] or \"{}\"),\n+                \"created_at\": event_row[\"created_at\"],\n+            })\n+        return RunRecord.from_dict(\n+            {\n+                \"run_id\": row[\"run_id\"],\n+                \"objective\": row[\"objective\"],\n+                \"workflow\": json.loads(row[\"workflow_json\"] or \"{}\"),\n+                \"status\": row[\"status\"],\n+                \"result\": json.loads(row[\"result_json\"]) if row[\"result_json\"] else None,\n+                \"created_at\": row[\"created_at\"],\n+                \"updated_at\": row[\"updated_at\"],\n+                \"events\": events,\n+            }\n+        )\n+\n+\n+class MemoryRunStore(RunStore):\n+    def __init__(self):\n+        self._runs: dict[str, RunRecord] = {}\n+\n+    def put(self, run: RunRecord) -> None:\n+        self._runs[run.run_id] = run\n+\n+    def get(self, run_id: str) -> RunRecord | None:\n+        return self._runs.get(run_id)\n+\n+    def list(self) -> list[RunRecord]:\n+        return list(self._runs.values())\n+\n+\n+class ChatStore:\n+    def add(self, turn: ChatTurn) -> None:\n+        raise NotImplementedError\n+\n+    def list(self, session_id: str, *, limit: int = 80) -> list[ChatTurn]:\n+        raise NotImplementedError\n+\n+    def sessions(self, *, limit: int = 50) -> list[dict]:\n+        raise NotImplementedError\n+\n+\n+class SqliteChatStore(ChatStore):\n+    \"\"\"Durable per-session transcript store with compact read paths.\"\"\"\n+\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+        self._init()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        self.path.parent.mkdir(parents=True, exist_ok=True)\n+        conn = sqlite3.connect(str(self.path))\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS chat_turns (\n+                    turn_id TEXT PRIMARY KEY,\n+                    session_id TEXT NOT NULL,\n+                    role TEXT NOT NULL,\n+                    content TEXT NOT NULL,\n+                    run_id TEXT,\n+                    summary TEXT,\n+                    metadata_json TEXT NOT NULL,\n+                    created_at TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_chat_session_created ON chat_turns(session_id, created_at)\")\n+\n+    def add(self, turn: ChatTurn) -> None:\n+        with self._lock, self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT OR REPLACE INTO chat_turns(\n+                    turn_id, session_id, role, content, run_id, summary, metadata_json, created_at\n+                )\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n+                \"\"\",\n+                (\n+                    turn.turn_id,\n+                    turn.session_id,\n+                    turn.role,\n+                    turn.content,\n+                    turn.run_id,\n+                    turn.summary,\n+                    json.dumps(turn.metadata, sort_keys=True),\n+                    turn.created_at,\n+                ),\n+            )\n+\n+    def list(self, session_id: str, *, limit: int = 80) -> list[ChatTurn]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\n+                \"\"\"\n+                SELECT * FROM chat_turns\n+                WHERE session_id = ?\n+                ORDER BY created_at DESC\n+                LIMIT ?\n+                \"\"\",\n+                (session_id, int(limit)),\n+            ).fetchall()\n+        return [self._row_to_turn(row) for row in reversed(rows)]\n+\n+    def sessions(self, *, limit: int = 50) -> list[dict]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\n+                \"\"\"\n+                SELECT session_id, MAX(created_at) AS updated_at, COUNT(*) AS turn_count\n+                FROM chat_turns\n+                GROUP BY session_id\n+                ORDER BY updated_at DESC\n+                LIMIT ?\n+                \"\"\",\n+                (int(limit),),\n+            ).fetchall()\n+        return [\n+            {\n+                \"session_id\": row[\"session_id\"],\n+                \"updated_at\": row[\"updated_at\"],\n+                \"turn_count\": int(row[\"turn_count\"]),\n+            }\n+            for row in rows\n+        ]\n+\n+    def _row_to_turn(self, row: sqlite3.Row) -> ChatTurn:\n+        return ChatTurn.from_dict(\n+            {\n+                \"turn_id\": row[\"turn_id\"],\n+                \"session_id\": row[\"session_id\"],\n+                \"role\": row[\"role\"],\n+                \"content\": row[\"content\"],\n+                \"run_id\": row[\"run_id\"] or \"\",\n+                \"summary\": row[\"summary\"] or \"\",\n+                \"metadata\": json.loads(row[\"metadata_json\"] or \"{}\"),\n+                \"created_at\": row[\"created_at\"],\n+            }\n+        )\n+\n+\n+class MemoryChatStore(ChatStore):\n+    def __init__(self):\n+        self._turns: list[ChatTurn] = []\n+\n+    def add(self, turn: ChatTurn) -> None:\n+        self._turns = [item for item in self._turns if item.turn_id != turn.turn_id]\n+        self._turns.append(turn)\n+\n+    def list(self, session_id: str, *, limit: int = 80) -> list[ChatTurn]:\n+        turns = [item for item in self._turns if item.session_id == session_id]\n+        return turns[-int(limit):]\n+\n+    def sessions(self, *, limit: int = 50) -> list[dict]:\n+        sessions: dict[str, dict] = {}\n+        for turn in self._turns:\n+            item = sessions.setdefault(\n+                turn.session_id,\n+                {\"session_id\": turn.session_id, \"updated_at\": turn.created_at, \"turn_count\": 0},\n+            )\n+            item[\"turn_count\"] += 1\n+            item[\"updated_at\"] = max(str(item[\"updated_at\"]), turn.created_at)\n+        return sorted(sessions.values(), key=lambda item: item[\"updated_at\"], reverse=True)[: int(limit)]\n+\n+\n+class MemoryFactStore:\n+    def add_fact(\n+        self,\n+        *,\n+        owner_id: str,\n+        subject: str,\n+        predicate: str,\n+        object_value: str,\n+        source: str,\n+        provenance: dict,\n+        run_id: str = \"\",\n+    ) -> MemoryFact:\n+        raise NotImplementedError\n+\n+    def list_facts(self, *, owner_id: str = \"default\", include_voided: bool = False) -> list[MemoryFact]:\n+        raise NotImplementedError\n+\n+    def void_fact(self, fact_id: str, *, owner_id: str = \"default\", reason: str = \"\") -> bool:\n+        raise NotImplementedError\n+\n+\n+class SqliteMemoryFactStore(MemoryFactStore):\n+    \"\"\"Provenance-first memory store.\n+\n+    Transaction order is intentionally add-new-then-void-old for replacement.\n+    \"\"\"\n+\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+        self._init()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        self.path.parent.mkdir(parents=True, exist_ok=True)\n+        conn = sqlite3.connect(str(self.path))\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS memory_facts (\n+                    id TEXT PRIMARY KEY,\n+                    owner_id TEXT NOT NULL,\n+                    subject TEXT NOT NULL,\n+                    predicate TEXT NOT NULL,\n+                    object TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    source TEXT NOT NULL,\n+                    provenance_json TEXT NOT NULL,\n+                    run_id TEXT,\n+                    supersedes_id TEXT,\n+                    created_at TEXT NOT NULL,\n+                    voided_at TEXT\n+                )\n+                \"\"\"\n+            )\n+            conn.execute(\"CREATE INDEX IF NOT EXISTS idx_memory_current ON memory_facts(owner_id, subject, predicate, status)\")\n+\n+    def add_fact(\n+        self,\n+        *,\n+        owner_id: str,\n+        subject: str,\n+        predicate: str,\n+        object_value: str,\n+        source: str,\n+        provenance: dict,\n+        run_id: str = \"\",\n+    ) -> MemoryFact:\n+        if not str(source or \"\").strip():\n+            raise ValueError(\"memory source is required\")\n+        if not provenance:\n+            raise ValueError(\"memory provenance is required\")\n+        subject = str(subject or \"\").strip()\n+        predicate = str(predicate or \"\").strip()\n+        object_value = str(object_value or \"\").strip()\n+        if not subject or not predicate or not object_value:\n+            raise ValueError(\"subject, predicate, and object are required\")\n+\n+        with self._lock, self._connect() as conn:\n+            old = conn.execute(\n+                \"\"\"\n+                SELECT * FROM memory_facts\n+                WHERE owner_id = ? AND subject = ? AND predicate = ? AND status = 'current'\n+                ORDER BY created_at DESC LIMIT 1\n+                \"\"\",\n+                (owner_id, subject, predicate),\n+            ).fetchone()\n+            fact = MemoryFact(\n+                id=rid(\"mem\"),\n+                owner_id=owner_id,\n+                subject=subject,\n+                predicate=predicate,\n+                object=object_value,\n+                status=\"current\",\n+                source=str(source),\n+                provenance=dict(provenance),\n+                run_id=str(run_id or \"\"),\n+                supersedes_id=str(old[\"id\"]) if old and str(old[\"object\"]) != object_value else \"\",\n+            )\n+            conn.execute(\n+                \"\"\"\n+                INSERT INTO memory_facts(\n+                    id, owner_id, subject, predicate, object, status, source,\n+                    provenance_json, run_id, supersedes_id, created_at, voided_at\n+                )\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n+                \"\"\",\n+                (\n+                    fact.id,\n+                    fact.owner_id,\n+                    fact.subject,\n+                    fact.predicate,\n+                    fact.object,\n+                    fact.status,\n+                    fact.source,\n+                    json.dumps(fact.provenance, sort_keys=True),\n+                    fact.run_id,\n+                    fact.supersedes_id,\n+                    fact.created_at,\n+                    fact.voided_at,\n+                ),\n+            )\n+            if old and str(old[\"object\"]) != object_value:\n+                conn.execute(\n+                    \"UPDATE memory_facts SET status = 'voided', voided_at = ? WHERE id = ?\",\n+                    (now(), old[\"id\"]),\n+                )\n+            return fact\n+\n+    def list_facts(self, *, owner_id: str = \"default\", include_voided: bool = False) -> list[MemoryFact]:\n+        sql = \"SELECT * FROM memory_facts WHERE owner_id = ?\"\n+        params: list[str] = [owner_id]\n+        if not include_voided:\n+            sql += \" AND status = 'current'\"\n+        sql += \" ORDER BY created_at DESC LIMIT 500\"\n+        with self._connect() as conn:\n+            return [self._row_to_fact(row) for row in conn.execute(sql, params).fetchall()]\n+\n+    def void_fact(self, fact_id: str, *, owner_id: str = \"default\", reason: str = \"\") -> bool:\n+        with self._lock, self._connect() as conn:\n+            cur = conn.execute(\n+                \"UPDATE memory_facts SET status = 'voided', voided_at = ? WHERE id = ? AND owner_id = ?\",\n+                (now(), fact_id, owner_id),\n+            )\n+            return cur.rowcount > 0\n+\n+    def _row_to_fact(self, row: sqlite3.Row) -> MemoryFact:\n+        return MemoryFact.from_dict(\n+            {\n+                \"id\": row[\"id\"],\n+                \"owner_id\": row[\"owner_id\"],\n+                \"subject\": row[\"subject\"],\n+                \"predicate\": row[\"predicate\"],\n+                \"object\": row[\"object\"],\n+                \"status\": row[\"status\"],\n+                \"source\": row[\"source\"],\n+                \"provenance\": json.loads(row[\"provenance_json\"] or \"{}\"),\n+                \"run_id\": row[\"run_id\"] or \"\",\n+                \"supersedes_id\": row[\"supersedes_id\"] or \"\",\n+                \"created_at\": row[\"created_at\"],\n+                \"voided_at\": row[\"voided_at\"] or \"\",\n+            }\n+        )\n+\n+\n+class MemoryMemoryFactStore(MemoryFactStore):\n+    def __init__(self):\n+        self._facts: list[MemoryFact] = []\n+\n+    def add_fact(self, *, owner_id: str, subject: str, predicate: str, object_value: str, source: str, provenance: dict, run_id: str = \"\") -> MemoryFact:\n+        if not source or not provenance:\n+            raise ValueError(\"memory source and provenance are required\")\n+        old = next((item for item in self._facts if item.owner_id == owner_id and item.subject == subject and item.predicate == predicate and item.status == \"current\"), None)\n+        fact = MemoryFact(\n+            id=rid(\"mem\"),\n+            owner_id=owner_id,\n+            subject=subject,\n+            predicate=predicate,\n+            object=object_value,\n+            status=\"current\",\n+            source=source,\n+            provenance=dict(provenance),\n+            run_id=run_id,\n+            supersedes_id=old.id if old and old.object != object_value else \"\",\n+        )\n+        self._facts.append(fact)\n+        if old and old.object != object_value:\n+            old.status = \"voided\"\n+            old.voided_at = now()\n+        return fact\n+\n+    def list_facts(self, *, owner_id: str = \"default\", include_voided: bool = False) -> list[MemoryFact]:\n+        return [\n+            item for item in reversed(self._facts)\n+            if item.owner_id == owner_id and (include_voided or item.status == \"current\")\n+        ]\n+\n+    def void_fact(self, fact_id: str, *, owner_id: str = \"default\", reason: str = \"\") -> bool:\n+        for item in self._facts:\n+            if item.id == fact_id and item.owner_id == owner_id:\n+                item.status = \"voided\"\n+                item.voided_at = now()\n+                return True\n+        return False\n+\n+\n+class WorkflowStore:\n+    def put(self, workflow: WorkflowSpec) -> None:\n+        raise NotImplementedError\n+\n+    def get(self, workflow_id: str) -> WorkflowSpec | None:\n+        raise NotImplementedError\n+\n+    def list(self) -> list[WorkflowSpec]:\n+        raise NotImplementedError\n+\n+\n+class SqliteWorkflowStore(WorkflowStore):\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+        self._init()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        self.path.parent.mkdir(parents=True, exist_ok=True)\n+        conn = sqlite3.connect(str(self.path))\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS workflows (\n+                    workflow_id TEXT PRIMARY KEY,\n+                    label TEXT NOT NULL,\n+                    objective TEXT NOT NULL,\n+                    policy TEXT NOT NULL,\n+                    tools_json TEXT NOT NULL,\n+                    nodes_json TEXT NOT NULL,\n+                    edges_json TEXT NOT NULL,\n+                    input_schema_json TEXT NOT NULL,\n+                    output_schema_json TEXT NOT NULL,\n+                    runtime_json TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    created_at TEXT NOT NULL,\n+                    updated_at TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+\n+    def put(self, workflow: WorkflowSpec) -> None:\n+        workflow.updated_at = now()\n+        with self._lock, self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT INTO workflows(\n+                    workflow_id, label, objective, policy, tools_json, nodes_json,\n+                    edges_json, input_schema_json, output_schema_json, runtime_json,\n+                    status, created_at, updated_at\n+                )\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n+                ON CONFLICT(workflow_id) DO UPDATE SET\n+                    label=excluded.label,\n+                    objective=excluded.objective,\n+                    policy=excluded.policy,\n+                    tools_json=excluded.tools_json,\n+                    nodes_json=excluded.nodes_json,\n+                    edges_json=excluded.edges_json,\n+                    input_schema_json=excluded.input_schema_json,\n+                    output_schema_json=excluded.output_schema_json,\n+                    runtime_json=excluded.runtime_json,\n+                    status=excluded.status,\n+                    updated_at=excluded.updated_at\n+                \"\"\",\n+                (\n+                    workflow.workflow_id,\n+                    workflow.label,\n+                    workflow.objective,\n+                    workflow.policy,\n+                    json.dumps(workflow.tools, sort_keys=True),\n+                    json.dumps(workflow.nodes, sort_keys=True),\n+                    json.dumps(workflow.edges, sort_keys=True),\n+                    json.dumps(workflow.input_schema, sort_keys=True),\n+                    json.dumps(workflow.output_schema, sort_keys=True),\n+                    json.dumps(workflow.runtime, sort_keys=True),\n+                    workflow.status,\n+                    workflow.created_at,\n+                    workflow.updated_at,\n+                ),\n+            )\n+\n+    def get(self, workflow_id: str) -> WorkflowSpec | None:\n+        with self._connect() as conn:\n+            row = conn.execute(\"SELECT * FROM workflows WHERE workflow_id = ?\", (workflow_id,)).fetchone()\n+            return self._row_to_workflow(row) if row else None\n+\n+    def list(self) -> list[WorkflowSpec]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\"SELECT * FROM workflows ORDER BY updated_at DESC LIMIT 200\").fetchall()\n+            return [self._row_to_workflow(row) for row in rows]\n+\n+    def _row_to_workflow(self, row: sqlite3.Row) -> WorkflowSpec:\n+        return WorkflowSpec.from_dict(\n+            {\n+                \"workflow_id\": row[\"workflow_id\"],\n+                \"label\": row[\"label\"],\n+                \"objective\": row[\"objective\"],\n+                \"policy\": row[\"policy\"],\n+                \"tools\": json.loads(row[\"tools_json\"] or \"[]\"),\n+                \"nodes\": json.loads(row[\"nodes_json\"] or \"[]\"),\n+                \"edges\": json.loads(row[\"edges_json\"] or \"[]\"),\n+                \"input_schema\": json.loads(row[\"input_schema_json\"] or \"{}\"),\n+                \"output_schema\": json.loads(row[\"output_schema_json\"] or \"{}\"),\n+                \"runtime\": json.loads(row[\"runtime_json\"] or \"{}\"),\n+                \"status\": row[\"status\"],\n+                \"created_at\": row[\"created_at\"],\n+                \"updated_at\": row[\"updated_at\"],\n+            }\n+        )\n+\n+\n+class MemoryWorkflowStore(WorkflowStore):\n+    def __init__(self):\n+        self._workflows: dict[str, WorkflowSpec] = {}\n+\n+    def put(self, workflow: WorkflowSpec) -> None:\n+        workflow.updated_at = now()\n+        self._workflows[workflow.workflow_id] = workflow\n+\n+    def get(self, workflow_id: str) -> WorkflowSpec | None:\n+        return self._workflows.get(workflow_id)\n+\n+    def list(self) -> list[WorkflowSpec]:\n+        return sorted(self._workflows.values(), key=lambda item: item.updated_at, reverse=True)\n+\n+\n+class DynamicToolStore:\n+    def put(self, tool: DynamicToolSpec) -> None:\n+        raise NotImplementedError\n+\n+    def get(self, tool_id_or_name: str) -> DynamicToolSpec | None:\n+        raise NotImplementedError\n+\n+    def list(self) -> list[DynamicToolSpec]:\n+        raise NotImplementedError\n+\n+\n+class SqliteDynamicToolStore(DynamicToolStore):\n+    def __init__(self, path: Path):\n+        self.path = path\n+        self._lock = threading.Lock()\n+        self._init()\n+\n+    def _connect(self) -> sqlite3.Connection:\n+        self.path.parent.mkdir(parents=True, exist_ok=True)\n+        conn = sqlite3.connect(str(self.path))\n+        conn.row_factory = sqlite3.Row\n+        return conn\n+\n+    def _init(self) -> None:\n+        with self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                CREATE TABLE IF NOT EXISTS dynamic_tools (\n+                    tool_id TEXT PRIMARY KEY,\n+                    name TEXT NOT NULL UNIQUE,\n+                    description TEXT NOT NULL,\n+                    kind TEXT NOT NULL,\n+                    input_schema_json TEXT NOT NULL,\n+                    check_schema_json TEXT NOT NULL,\n+                    context_policy_json TEXT NOT NULL,\n+                    status TEXT NOT NULL,\n+                    created_at TEXT NOT NULL,\n+                    updated_at TEXT NOT NULL\n+                )\n+                \"\"\"\n+            )\n+\n+    def put(self, tool: DynamicToolSpec) -> None:\n+        tool.updated_at = now()\n+        with self._lock, self._connect() as conn:\n+            conn.execute(\n+                \"\"\"\n+                INSERT INTO dynamic_tools(\n+                    tool_id, name, description, kind, input_schema_json,\n+                    check_schema_json, context_policy_json, status, created_at, updated_at\n+                )\n+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n+                ON CONFLICT(tool_id) DO UPDATE SET\n+                    name=excluded.name,\n+                    description=excluded.description,\n+                    kind=excluded.kind,\n+                    input_schema_json=excluded.input_schema_json,\n+                    check_schema_json=excluded.check_schema_json,\n+                    context_policy_json=excluded.context_policy_json,\n+                    status=excluded.status,\n+                    updated_at=excluded.updated_at\n+                \"\"\",\n+                (\n+                    tool.tool_id,\n+                    tool.name,\n+                    tool.description,\n+                    tool.kind,\n+                    json.dumps(tool.input_schema, sort_keys=True),\n+                    json.dumps(tool.check_schema, sort_keys=True),\n+                    json.dumps(tool.context_policy, sort_keys=True),\n+                    tool.status,\n+                    tool.created_at,\n+                    tool.updated_at,\n+                ),\n+            )\n+\n+    def get(self, tool_id_or_name: str) -> DynamicToolSpec | None:\n+        with self._connect() as conn:\n+            row = conn.execute(\n+                \"SELECT * FROM dynamic_tools WHERE tool_id = ? OR name = ?\",\n+                (tool_id_or_name, tool_id_or_name),\n+            ).fetchone()\n+            return self._row_to_tool(row) if row else None\n+\n+    def list(self) -> list[DynamicToolSpec]:\n+        with self._connect() as conn:\n+            rows = conn.execute(\"SELECT * FROM dynamic_tools ORDER BY updated_at DESC LIMIT 500\").fetchall()\n+            return [self._row_to_tool(row) for row in rows]\n+\n+    def _row_to_tool(self, row: sqlite3.Row) -> DynamicToolSpec:\n+        return DynamicToolSpec.from_dict(\n+            {\n+                \"tool_id\": row[\"tool_id\"],\n+                \"name\": row[\"name\"],\n+                \"description\": row[\"description\"],\n+                \"kind\": row[\"kind\"],\n+                \"input_schema\": json.loads(row[\"input_schema_json\"] or \"{}\"),\n+                \"check_schema\": json.loads(row[\"check_schema_json\"] or \"{}\"),\n+                \"context_policy\": json.loads(row[\"context_policy_json\"] or \"{}\"),\n+                \"status\": row[\"status\"],\n+                \"created_at\": row[\"created_at\"],\n+                \"updated_at\": row[\"updated_at\"],\n+            }\n+        )\n+\n+\n+class MemoryDynamicToolStore(DynamicToolStore):\n+    def __init__(self):\n+        self._tools: dict[str, DynamicToolSpec] = {}\n+\n+    def put(self, tool: DynamicToolSpec) -> None:\n+        tool.updated_at = now()\n+        self._tools[tool.tool_id] = tool\n+\n+    def get(self, tool_id_or_name: str) -> DynamicToolSpec | None:\n+        return self._tools.get(tool_id_or_name) or next(\n+            (tool for tool in self._tools.values() if tool.name == tool_id_or_name),\n+            None,\n+        )\n+\n+    def list(self) -> list[DynamicToolSpec]:\n+        return sorted(self._tools.values(), key=lambda item: item.updated_at, reverse=True)"},{"sha":"3212d72fdd13083bcf473bdb55486af04a8c0e2a","filename":"extractions/shovs-agent-harness/backend/tool_bridge.py","status":"added","additions":227,"deletions":0,"changes":227,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Ftool_bridge.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Ftool_bridge.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Ftool_bridge.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,227 @@\n+from __future__ import annotations\n+\n+import inspect\n+import json\n+import sys\n+from dataclasses import asdict, dataclass\n+from pathlib import Path\n+from typing import Any, Awaitable, Callable\n+\n+\n+PROJECT_ROOT = Path(__file__).resolve().parents[3]\n+if str(PROJECT_ROOT) not in sys.path:\n+    sys.path.insert(0, str(PROJECT_ROOT))\n+\n+\n+ToolHandler = Callable[..., Awaitable[str] | str]\n+\n+\n+@dataclass(frozen=True)\n+class BridgeTool:\n+    name: str\n+    category: str\n+    mode: str\n+    description: str\n+    side_effect: str = \"read_only\"\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+\n+class ShovsNativeToolBridge:\n+    \"\"\"Small adapter over real ShovsOS tool handlers.\n+\n+    This intentionally avoids importing ``api.main``. The main app constructs\n+    global engines, databases, and FastAPI routes at import time; the harness\n+    only needs stable tool handlers. Importing handlers directly gives the\n+    extraction real tool execution without coupling it to the whole app.\n+    \"\"\"\n+\n+    def __init__(self):\n+        self._handlers: dict[str, ToolHandler] = {}\n+        self._tools: dict[str, BridgeTool] = {}\n+        self._loaded = False\n+        self._load_error = \"\"\n+\n+    @property\n+    def loaded(self) -> bool:\n+        self._ensure_loaded()\n+        return self._loaded\n+\n+    @property\n+    def load_error(self) -> str:\n+        self._ensure_loaded()\n+        return self._load_error\n+\n+    def manifest(self) -> dict[str, Any]:\n+        self._ensure_loaded()\n+        return {\n+            \"available\": self._loaded,\n+            \"load_error\": self._load_error,\n+            \"tool_count\": len(self._tools),\n+            \"tools\": [tool.to_dict() for tool in self._tools.values()],\n+        }\n+\n+    def has(self, name: str) -> bool:\n+        self._ensure_loaded()\n+        return name in self._handlers\n+\n+    async def call(self, name: str, **kwargs: Any) -> dict[str, Any]:\n+        self._ensure_loaded()\n+        if name not in self._handlers:\n+            return {\n+                \"ok\": False,\n+                \"tool\": name,\n+                \"error\": \"tool_not_available\",\n+                \"available_tools\": sorted(self._handlers),\n+            }\n+        try:\n+            raw = self._handlers[name](**kwargs)\n+            if inspect.isawaitable(raw):\n+                raw = await raw\n+            return {\n+                \"ok\": True,\n+                \"tool\": name,\n+                \"raw\": raw,\n+                \"json\": _parse_json(raw),\n+            }\n+        except Exception as exc:\n+            return {\"ok\": False, \"tool\": name, \"error\": str(exc)}\n+\n+    def _ensure_loaded(self) -> None:\n+        if self._loaded or self._load_error:\n+            return\n+        try:\n+            from plugins.finance_alpha_vantage import (\n+                alpha_vantage_movers,\n+                alpha_vantage_news,\n+                alpha_vantage_overview,\n+                alpha_vantage_quote,\n+                finance_snapshot,\n+            )\n+            from plugins.tools import (\n+                _image_generate,\n+                _image_search,\n+                _source_contract,\n+                _source_coverage,\n+                _source_next_action,\n+                _source_select,\n+                _web_fetch_batch,\n+            )\n+            from plugins.tools_web import _web_fetch, _web_search\n+\n+            self._register(\n+                \"web_search\",\n+                _web_search,\n+                \"external_data\",\n+                \"Real ShovsOS web search with configured backend fallback.\",\n+            )\n+            self._register(\n+                \"web_fetch\",\n+                _web_fetch,\n+                \"external_data\",\n+                \"Real ShovsOS web fetch using Jina/Groq/httpx fallback.\",\n+            )\n+            self._register(\n+                \"alpha_vantage_movers\",\n+                alpha_vantage_movers,\n+                \"finance\",\n+                \"Alpha Vantage top gainers, losers, and most active tickers.\",\n+            )\n+            self._register(\n+                \"alpha_vantage_news\",\n+                alpha_vantage_news,\n+                \"finance\",\n+                \"Alpha Vantage ticker news and sentiment.\",\n+            )\n+            self._register(\n+                \"alpha_vantage_quote\",\n+                alpha_vantage_quote,\n+                \"finance\",\n+                \"Alpha Vantage deterministic quote.\",\n+            )\n+            self._register(\n+                \"alpha_vantage_overview\",\n+                alpha_vantage_overview,\n+                \"finance\",\n+                \"Alpha Vantage company overview and fundamentals.\",\n+            )\n+            self._register(\n+                \"finance_snapshot\",\n+                finance_snapshot,\n+                \"finance\",\n+                \"ShovsOS deterministic finance super-tool.\",\n+            )\n+            self._register(\n+                \"image_search\",\n+                _image_search,\n+                \"images\",\n+                \"Search image references and source pages.\",\n+            )\n+            self._register(\n+                \"image_generate\",\n+                _image_generate,\n+                \"images\",\n+                \"Generate an image using configured image provider credentials.\",\n+                side_effect=\"write\",\n+            )\n+            self._register(\n+                \"source_contract\",\n+                _source_contract,\n+                \"harness\",\n+                \"Deterministic source-workflow contract compiler.\",\n+            )\n+            self._register(\n+                \"source_select\",\n+                _source_select,\n+                \"harness\",\n+                \"Deterministic source URL selector.\",\n+            )\n+            self._register(\n+                \"source_next_action\",\n+                _source_next_action,\n+                \"harness\",\n+                \"Deterministic next-action selector for source workflows.\",\n+            )\n+            self._register(\n+                \"web_fetch_batch\",\n+                _web_fetch_batch,\n+                \"harness\",\n+                \"Batch exact URL fetch through ShovsOS tooling.\",\n+            )\n+            self._register(\n+                \"source_coverage\",\n+                _source_coverage,\n+                \"harness\",\n+                \"Deterministic source coverage gate.\",\n+            )\n+            self._loaded = True\n+        except Exception as exc:\n+            self._load_error = str(exc)\n+\n+    def _register(\n+        self,\n+        name: str,\n+        handler: ToolHandler,\n+        category: str,\n+        description: str,\n+        *,\n+        side_effect: str = \"read_only\",\n+    ) -> None:\n+        self._handlers[name] = handler\n+        self._tools[name] = BridgeTool(\n+            name=name,\n+            category=category,\n+            mode=\"shovs_native\",\n+            description=description,\n+            side_effect=side_effect,\n+        )\n+\n+\n+def _parse_json(value: Any) -> Any:\n+    if not isinstance(value, str):\n+        return value\n+    try:\n+        return json.loads(value)\n+    except Exception:\n+        return None"},{"sha":"da5ae73c2245b60f1384e435f44ff2113bce17b1","filename":"extractions/shovs-agent-harness/backend/understanding.py","status":"added","additions":219,"deletions":0,"changes":219,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Funderstanding.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Funderstanding.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Funderstanding.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,219 @@\n+from __future__ import annotations\n+\n+import re\n+from dataclasses import asdict, dataclass, field\n+from typing import Any\n+\n+\n+@dataclass(frozen=True)\n+class RuntimeUnderstanding:\n+    objective: str\n+    intent: str\n+    confidence: float\n+    constraints: dict[str, Any] = field(default_factory=dict)\n+    context_plan: list[dict[str, Any]] = field(default_factory=list)\n+    allowed_tools: list[str] = field(default_factory=list)\n+    model_slots: list[str] = field(default_factory=list)\n+    next_action_hint: str = \"\"\n+    missing_inputs: list[str] = field(default_factory=list)\n+\n+    def to_dict(self) -> dict[str, Any]:\n+        return asdict(self)\n+\n+\n+def understand_objective(objective: str) -> RuntimeUnderstanding:\n+    text = \" \".join(str(objective or \"\").split())\n+    lowered = text.lower()\n+    constraints = _extract_constraints(lowered)\n+    urls = re.findall(r\"https?://[^\\s)>\\\"]+\", text)\n+\n+    if _has_any(lowered, (\"generate an image\", \"create an image\", \"make an image\", \"draw\", \"illustration\", \"logo\", \"mockup\", \"poster\")):\n+        missing = []\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"image_generation\",\n+            confidence=0.87,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"capability\", \"action\": \"resolve_image_generation\", \"priority\": 1},\n+                {\"lane\": \"generation\", \"action\": \"image_generate\", \"priority\": 2},\n+                {\"lane\": \"artifact\", \"action\": \"return_image_url_or_setup_gap\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"image_generate\", \"image_search\", \"harness_capability_resolve\"],\n+            model_slots=[\"prompt_refinement\"],\n+            next_action_hint=\"resolve_and_generate_image\",\n+            missing_inputs=missing,\n+        )\n+\n+    if _has_any(lowered, (\"connect mcp\", \"mcp server\", \"connector\", \"connect to\", \"integration\", \"oauth\", \"slack\", \"gmail\", \"notion\", \"github\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"connector_setup\",\n+            confidence=0.8,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"capability\", \"action\": \"resolve_connector_or_mcp\", \"priority\": 1},\n+                {\"lane\": \"requirements\", \"action\": \"return_setup_contract\", \"priority\": 2},\n+                {\"lane\": \"workflow\", \"action\": \"create_workflow_after_connection\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"harness_capability_resolve\", \"harness_workflow_create\"],\n+            model_slots=[\"explain_setup_contract\"],\n+            next_action_hint=\"resolve_connector_requirements\",\n+        )\n+\n+    if re.search(r\"\\b(create|build|make|design|define)\\b.{0,48}\\b(agent|workflow|flow|mesh|automation)\\b\", lowered):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"workflow_design\",\n+            confidence=0.88,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"workflow_contract\", \"action\": \"draft_workflow\", \"priority\": 1},\n+                {\"lane\": \"runtime_controls\", \"action\": \"select_policy_and_tools\", \"priority\": 2},\n+                {\"lane\": \"api_surface\", \"action\": \"return_reusable_spec\", \"priority\": 3},\n+            ],\n+            allowed_tools=[],\n+            model_slots=[\"name_workflow\", \"explain_runtime_contract\"],\n+            next_action_hint=\"create_reusable_workflow_spec\",\n+        )\n+\n+    if _has_any(lowered, (\"api docs\", \"api documentation\", \"reference docs\", \"sdk docs\", \"integration docs\", \"documentation\")) or urls:\n+        intent = \"api_docs_research\"\n+        tools = [\"web_fetch\", \"web_search\"]\n+        plan = [\n+            {\"lane\": \"exact_urls\", \"action\": \"web_fetch\", \"targets\": urls, \"priority\": 1},\n+            {\"lane\": \"documentation_search\", \"action\": \"web_search\", \"query\": _docs_query(text), \"priority\": 2},\n+            {\"lane\": \"evidence\", \"action\": \"select_api_constraints\", \"priority\": 3},\n+        ]\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=intent,\n+            confidence=0.86,\n+            constraints={**constraints, \"urls\": urls},\n+            context_plan=plan,\n+            allowed_tools=tools,\n+            model_slots=[\"extract_endpoints\", \"synthesize_implementation_plan\"],\n+            next_action_hint=\"fetch_exact_docs_url\" if urls else \"search_api_docs\",\n+        )\n+\n+    if _has_any(lowered, (\"stock analysis\", \"analyze stock\", \"analyze ticker\", \"equity analysis\", \"investment report\", \"fundamentals report\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"stock_analysis_team\",\n+            confidence=0.9,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"market\", \"action\": \"alpha_vantage_quote_or_snapshot\", \"priority\": 1},\n+                {\"lane\": \"news\", \"action\": \"alpha_vantage_news_or_web_search\", \"priority\": 2},\n+                {\"lane\": \"fundamentals\", \"action\": \"alpha_vantage_overview\", \"priority\": 3},\n+                {\"lane\": \"risk\", \"action\": \"derive_risk_from_evidence\", \"priority\": 4},\n+                {\"lane\": \"final_report\", \"action\": \"write_report_files\", \"priority\": 5},\n+            ],\n+            allowed_tools=[\"finance_snapshot\", \"alpha_vantage_quote\", \"alpha_vantage_overview\", \"alpha_vantage_news\", \"web_search\", \"web_fetch\"],\n+            model_slots=[\"ticker_lock\", \"analyst_report_writer\"],\n+            next_action_hint=\"run_stock_analyst_team\",\n+        )\n+\n+    if _has_any(lowered, (\"stock\", \"stocks\", \"ticker\", \"market\", \"movers\", \"alpha vantage\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"finance_source_collection\",\n+            confidence=0.9,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"deterministic_market_data\", \"action\": \"alpha_vantage_movers\", \"priority\": 1},\n+                {\"lane\": \"per_entity_news\", \"action\": \"web_search\", \"priority\": 2},\n+                {\"lane\": \"source_content\", \"action\": \"web_fetch\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"alpha_vantage_movers\", \"alpha_vantage_news\", \"web_search\", \"web_fetch\"],\n+            model_slots=[\"lock_entities\", \"synthesize_report\"],\n+            next_action_hint=\"discover_market_entities\",\n+        )\n+\n+    if _has_any(lowered, (\"buy\", \"price\", \"store\", \"shopping\", \"costco\", \"walmart\", \"best buy\", \"bestbuy\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"shopping_comparison\",\n+            confidence=0.84,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"product_candidates\", \"action\": \"web_search\", \"priority\": 1},\n+                {\"lane\": \"store_pages\", \"action\": \"web_fetch\", \"priority\": 2},\n+                {\"lane\": \"verified_purchase_fields\", \"action\": \"extract_price_availability\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"web_search\", \"web_fetch\", \"shopping_advice\"],\n+            model_slots=[\"extract_products\", \"synthesize_buying_advice\"],\n+            next_action_hint=\"search_product_candidates\",\n+        )\n+\n+    if _has_any(lowered, (\"restaurant\", \"sushi\", \"coffee\", \"place\", \"places\", \"near me\", \"local\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"local_recommendation\",\n+            confidence=0.82,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"local_candidates\", \"action\": \"web_search\", \"priority\": 1},\n+                {\"lane\": \"review_sources\", \"action\": \"web_fetch\", \"priority\": 2},\n+                {\"lane\": \"ranked_options\", \"action\": \"synthesize_ranked_table\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"places_search\", \"web_search\", \"web_fetch\"],\n+            model_slots=[\"extract_places\", \"synthesize_recommendation\"],\n+            next_action_hint=\"search_local_candidates\",\n+        )\n+\n+    if _has_any(lowered, (\"code\", \"implement\", \"fix\", \"bug\", \"test\", \"repo\", \"file\")):\n+        return RuntimeUnderstanding(\n+            objective=text,\n+            intent=\"implementation_task\",\n+            confidence=0.78,\n+            constraints=constraints,\n+            context_plan=[\n+                {\"lane\": \"repo_context\", \"action\": \"file_search\", \"priority\": 1},\n+                {\"lane\": \"relevant_files\", \"action\": \"file_view\", \"priority\": 2},\n+                {\"lane\": \"verification\", \"action\": \"run_tests\", \"priority\": 3},\n+            ],\n+            allowed_tools=[\"file_view\", \"file_create\", \"file_str_replace\", \"bash\"],\n+            model_slots=[\"plan_patch\", \"summarize_verification\"],\n+            next_action_hint=\"inspect_relevant_files\",\n+        )\n+\n+    return RuntimeUnderstanding(\n+        objective=text,\n+        intent=\"general_evidence_brief\",\n+        confidence=0.62,\n+        constraints=constraints,\n+        context_plan=[\n+            {\"lane\": \"objective\", \"action\": \"use_user_message\", \"priority\": 1},\n+            {\"lane\": \"external_context\", \"action\": \"web_search_if_current_or_unknown\", \"priority\": 2},\n+        ],\n+        allowed_tools=[\"web_search\", \"web_fetch\"],\n+        model_slots=[\"synthesize_answer\"],\n+        next_action_hint=\"answer_or_search\",\n+    )\n+\n+\n+def _extract_constraints(lowered: str) -> dict[str, Any]:\n+    out: dict[str, Any] = {}\n+    top = re.search(r\"\\btop\\s+(\\d+)\\b\", lowered)\n+    if top:\n+        out[\"entity_count\"] = int(top.group(1))\n+    each = re.search(r\"\\b(\\d+)\\s+(?:urls?|links?|sources?|results?|articles?)\\s+(?:for\\s+)?(?:each|per)\\b\", lowered)\n+    if each:\n+        out[\"urls_per_entity\"] = int(each.group(1))\n+    if \"today\" in lowered or \"latest\" in lowered or \"current\" in lowered:\n+        out[\"freshness\"] = \"current\"\n+    location = re.search(r\"\\b(?:in|near|around)\\s+([a-z][a-z\\s,.-]{2,50})\", lowered)\n+    if location:\n+        out[\"location\"] = re.split(r\"\\b(?:with|under|for|and|then)\\b\", location.group(1), maxsplit=1)[0].strip(\" .,\")\n+    return out\n+\n+\n+def _docs_query(text: str) -> str:\n+    cleaned = re.sub(r\"https?://[^\\s)>\\\"]+\", \"\", text)\n+    cleaned = re.sub(r\"\\b(fetch|read|use|implement|wire|complete)\\b\", \"\", cleaned, flags=re.IGNORECASE)\n+    return \" \".join(cleaned.split())[:180] or \"api documentation\"\n+\n+\n+def _has_any(text: str, terms: tuple[str, ...]) -> bool:\n+    return any(term in text for term in terms)"},{"sha":"968d17618b089de106cb5e2566cacdfe64f8de42","filename":"extractions/shovs-agent-harness/backend/workflows.py","status":"added","additions":80,"deletions":0,"changes":80,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fworkflows.py","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Fbackend%2Fworkflows.py","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Fbackend%2Fworkflows.py?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,80 @@\n+from __future__ import annotations\n+\n+import re\n+\n+from .models import WorkflowDraft\n+\n+\n+def draft_workflow(prompt: str) -> WorkflowDraft:\n+    text = re.sub(r\"\\s+\", \" \", str(prompt or \"\")).strip()\n+    lowered = text.lower()\n+    if not text:\n+        text = \"Search top 3 sources, fetch 3 URLs each, write a short cited brief.\"\n+        lowered = text.lower()\n+\n+    if any(term in lowered for term in (\"stock analysis\", \"analyze stock\", \"analyze ticker\", \"equity analysis\", \"investment report\", \"fundamentals report\")):\n+        return WorkflowDraft(\n+            id=\"stock_analysis_team\",\n+            label=\"Stock Analysis Team\",\n+            description=\"Run analyst stages for market data, news, fundamentals, risk, and final report artifacts.\",\n+            policy=\"graph_harness\",\n+            tools=[\"finance_snapshot\", \"alpha_vantage_quote\", \"alpha_vantage_overview\", \"alpha_vantage_news\", \"web_search\", \"web_fetch\"],\n+            input_schema={\"objective\": \"string\", \"ticker\": \"optional string\"},\n+            output_schema={\"type\": \"stock_analysis_report\", \"fields\": [\"summary\", \"analyst_reports\", \"files\", \"sources\", \"risks\", \"unresolved\"]},\n+            sample_input={\"objective\": text},\n+            edge=\"Each analyst writes a file-backed report; final verdict can cite only generated report artifacts and tool evidence.\",\n+        )\n+    if any(term in lowered for term in (\"stock\", \"stocks\", \"ticker\", \"market\", \"movers\", \"alpha\", \"tesla\", \"nvda\")):\n+        return WorkflowDraft(\n+            id=\"market_mover_brief\",\n+            label=\"Market Mover Brief\",\n+            description=\"Lock moving tickers, collect per-ticker sources, and block finalization until source coverage is complete.\",\n+            policy=\"plan_execute\",\n+            tools=[\"web_search\", \"web_fetch\", \"finance_snapshot\", \"alpha_vantage_movers\", \"alpha_vantage_news\"],\n+            input_schema={\"objective\": \"string\"},\n+            output_schema={\"type\": \"market_brief\", \"fields\": [\"summary\", \"table\", \"sources\", \"unresolved\"]},\n+            sample_input={\"objective\": text},\n+            edge=\"No entity drift after ticker lock; no final answer before required evidence is fetched.\",\n+        )\n+    if any(term in lowered for term in (\"buy\", \"price\", \"store\", \"shopping\", \"costco\", \"walmart\", \"best buy\", \"bestbuy\")):\n+        return WorkflowDraft(\n+            id=\"buy_link_comparison\",\n+            label=\"Buy Link Comparison\",\n+            description=\"Compare store/product sources and return the best practical option with source-backed tradeoffs.\",\n+            policy=\"plan_execute\",\n+            tools=[\"web_search\", \"web_fetch\", \"shopping_advice\"],\n+            input_schema={\"objective\": \"string\", \"location\": \"optional string\"},\n+            output_schema={\"type\": \"buy_link_report\", \"fields\": [\"best_option\", \"buy_link\", \"tradeoffs\", \"sources\", \"unresolved\"]},\n+            sample_input={\"objective\": text, \"location\": extract_location(text) or \"\"},\n+            edge=\"Missing price/source fields stay unresolved instead of being invented.\",\n+        )\n+    if any(term in lowered for term in (\"sushi\", \"restaurant\", \"place\", \"places\", \"coffee\", \"near me\", \"local\")):\n+        return WorkflowDraft(\n+            id=\"local_recommendation\",\n+            label=\"Local Recommendation\",\n+            description=\"Lock local candidates, collect review/source pages, and return a practical ranked shortlist.\",\n+            policy=\"plan_execute\",\n+            tools=[\"web_search\", \"web_fetch\", \"places_search\"],\n+            input_schema={\"objective\": \"string\", \"location\": \"optional string\"},\n+            output_schema={\"type\": \"local_options\", \"fields\": [\"place\", \"why\", \"best_for\", \"sources\", \"unresolved\"]},\n+            sample_input={\"objective\": text, \"location\": extract_location(text) or \"\"},\n+            edge=\"Topic-agnostic source collection: places use review/source queries, not stock-news queries.\",\n+        )\n+    return WorkflowDraft(\n+        id=\"evidence_brief\",\n+        label=\"Evidence Brief\",\n+        description=\"Search, lock entities, fetch required sources, and return a concise source-backed brief.\",\n+        policy=\"plan_execute\",\n+        tools=[\"web_search\", \"web_fetch\"],\n+        input_schema={\"objective\": \"string\"},\n+        output_schema={\"type\": \"evidence_brief\", \"fields\": [\"summary\", \"findings\", \"sources\", \"unresolved\"]},\n+        sample_input={\"objective\": text},\n+        edge=\"The runtime owns the loop; the model only fills entity and synthesis slots.\",\n+    )\n+\n+\n+def extract_location(text: str) -> str:\n+    match = re.search(r\"\\b(?:near|in|around)\\s+([A-Za-z][A-Za-z\\s,.-]{1,50})\", text, re.IGNORECASE)\n+    if not match:\n+        return \"\"\n+    return re.split(r\"\\b(?:under|from|at|with|and)\\b\", match.group(1), maxsplit=1, flags=re.IGNORECASE)[0].strip(\" .,:;\")"},{"sha":"b866732f5a5d72ec6b4482dd343ec9f3216d80fb","filename":"extractions/shovs-agent-harness/frontend/.wrangler/deploy/config.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2F.wrangler%2Fdeploy%2Fconfig.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2F.wrangler%2Fdeploy%2Fconfig.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2F.wrangler%2Fdeploy%2Fconfig.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1 @@\n+{\"configPath\":\"../../.output/server/wrangler.json\"}\n\\ No newline at end of file"},{"sha":"36eb109884244365c74c416af1644fcdb9bcc9a3","filename":"extractions/shovs-agent-harness/frontend/AGENTS.md","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2FAGENTS.md","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2FAGENTS.md","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2FAGENTS.md?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,10 @@\n+<!-- LOVABLE:BEGIN -->\n+> [!IMPORTANT]\n+> This project is connected to [Lovable](https://lovable.dev). Avoid rewriting\n+> published git history — force pushing, or rebasing/amending/squashing commits\n+> that are already pushed — as it rewrites history on Lovable's side and the\n+> user will likely lose their project history.\n+>\n+> Commits you push to the connected branch sync back to Lovable and show up in\n+> the editor, so keep the branch in a working state.\n+<!-- LOVABLE:END -->"},{"sha":"27e1c3916818e6a8032af918c44d4e85c1b22c84","filename":"extractions/shovs-agent-harness/frontend/bun.lock","status":"added","additions":1329,"deletions":0,"changes":1329,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbun.lock","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbun.lock","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbun.lock?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b"},{"sha":"404c27d65cbde9ae5f365d179ed0e16a0473f8c5","filename":"extractions/shovs-agent-harness/frontend/bunfig.toml","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbunfig.toml","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbunfig.toml","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fbunfig.toml?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,6 @@\n+[install]\n+# 24h supply-chain guard: skip package versions published less than a day ago.\n+minimumReleaseAge = 86400\n+# Each entry bypasses the 24h guard for one package — confirm with the user\n+# before adding any.\n+minimumReleaseAgeExcludes = [\"@lovable.dev/vite-tanstack-config\", \"@lovable.dev/mcp-js\", \"@lovable.dev/vite-plugin-dev-server-bridge\", \"@lovable.dev/vite-plugin-hmr-gate\"]"},{"sha":"f0817a84e832a693e7a79a911efe0b081bd97e06","filename":"extractions/shovs-agent-harness/frontend/components.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fcomponents.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fcomponents.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fcomponents.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"$schema\": \"https://ui.shadcn.com/schema.json\",\n+  \"style\": \"new-york\",\n+  \"rsc\": false,\n+  \"tsx\": true,\n+  \"tailwind\": {\n+    \"css\": \"src/styles.css\",\n+    \"baseColor\": \"slate\",\n+    \"cssVariables\": true,\n+    \"prefix\": \"\"\n+  },\n+  \"iconLibrary\": \"lucide\",\n+  \"rtl\": false,\n+  \"aliases\": {\n+    \"components\": \"@/components\",\n+    \"utils\": \"@/lib/utils\",\n+    \"ui\": \"@/components/ui\",\n+    \"lib\": \"@/lib\",\n+    \"hooks\": \"@/hooks\"\n+  },\n+  \"registries\": {}\n+}"},{"sha":"be4075bd5e14ae3e6420613f789c3fc8bbeda819","filename":"extractions/shovs-agent-harness/frontend/eslint.config.js","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Feslint.config.js","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Feslint.config.js","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Feslint.config.js?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,40 @@\n+import js from \"@eslint/js\";\n+import eslintPluginPrettier from \"eslint-plugin-prettier/recommended\";\n+import globals from \"globals\";\n+import reactHooks from \"eslint-plugin-react-hooks\";\n+import reactRefresh from \"eslint-plugin-react-refresh\";\n+import tseslint from \"typescript-eslint\";\n+\n+export default tseslint.config(\n+  { ignores: [\"dist\", \".output\", \".vinxi\"] },\n+  {\n+    extends: [js.configs.recommended, ...tseslint.configs.recommended],\n+    files: [\"**/*.{ts,tsx}\"],\n+    languageOptions: {\n+      ecmaVersion: 2020,\n+      globals: globals.browser,\n+    },\n+    plugins: {\n+      \"react-hooks\": reactHooks,\n+      \"react-refresh\": reactRefresh,\n+    },\n+    rules: {\n+      ...reactHooks.configs.recommended.rules,\n+      \"no-restricted-imports\": [\n+        \"error\",\n+        {\n+          paths: [\n+            {\n+              name: \"server-only\",\n+              message:\n+                \"TanStack Start does not use the Next.js `server-only` package. Rename the module to `*.server.ts` or mark it with `@tanstack/react-start/server-only`.\",\n+            },\n+          ],\n+        },\n+      ],\n+      \"react-refresh/only-export-components\": [\"warn\", { allowConstantExport: true }],\n+      \"@typescript-eslint/no-unused-vars\": \"off\",\n+    },\n+  },\n+  eslintPluginPrettier,\n+);"},{"sha":"e70435117feb262ff98e8e01556b0d2bc73391a4","filename":"extractions/shovs-agent-harness/frontend/package-lock.json","status":"added","additions":8595,"deletions":0,"changes":8595,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage-lock.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage-lock.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage-lock.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b"},{"sha":"4a932ccf0da201026931a2d187faf1c612d5fde4","filename":"extractions/shovs-agent-harness/frontend/package.json","status":"added","additions":87,"deletions":0,"changes":87,"blob_url":"https://github.com/theshovonsaha/shovsOS/blob/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage.json","raw_url":"https://github.com/theshovonsaha/shovsOS/raw/a680c84a3b8f2f8dfaf25060a1ca18390b835d2b/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage.json","contents_url":"https://api.github.com/repos/theshovonsaha/shovsOS/contents/extractions%2Fshovs-agent-harness%2Ffrontend%2Fpackage.json?ref=a680c84a3b8f2f8dfaf25060a1ca18390b835d2b","patch":"@@ -0,0 +1,87 @@\n+{\n+  \"name\": \"tanstack_start_ts\",\n+  \"private\": true,\n+  \"sideEffects\": false,\n+  \"type\": \"module\",\n+  \"scripts\": {\n+    \"dev\": \"vite dev\",\n+    \"build\": \"vite build\",\n+    \"build:dev\": \"vite build --mode development\",\n+    \"preview\": \"vite preview\",\n+    \"lint\": \"eslint .\",\n+    \"format\": \"prettier --write .\"\n+  },\n+  \"dependencies\": {\n+    \"@hookform/resolvers\": \"^5.2.2\",\n+    \"@radix-ui/react-accordion\": \"^1.2.12\",\n+    \"@radix-ui/react-alert-dialog\": \"^1.1.15\",\n+    \"@radix-ui/react-aspect-ratio\": \"^1.1.8\",\n+    \"@radix-ui/react-avatar\": \"^1.1.11\",\n+    \"@radix-ui/react-checkbox\": \"^1.3.3\",\n+    \"@radix-ui/react-collapsible\": \"^1.1.12\",\n+    \"@radix-ui/react-context-menu\": \"^2.2.16\",\n+    \"@radix-ui/react-dialog\": \"^1.1.15\",\n+    \"@radix-ui/react-dropdown-menu\": \"^2.1.16\",\n+    \"@radix-ui/react-hover-card\": \"^1.1.15\",\n+    \"@radix-ui/react-label\": \"^2.1.8\",\n+    \"@radix-ui/react-menubar\": \"^1.1.16\",\n+    \"@radix-ui/react-navigation-menu\": \"^1.2.14\",\n+    \"@radix-ui/react-popover\": \"^1.1.15\",\n+    \"@radix-ui/react-progress\": \"^1.1.8\",\n+    \"@radix-ui/react-radio-group\": \"^1.3.8\",\n+    \"@radix-ui/react-scroll-area\": \"^1.2.10\",\n+    \"@radix-ui/react-select\": \"^2.2.6\",\n+    \"@radix-ui/react-separator\": \"^1.1.8\",\n+    \"@radix-ui/react-slider\": \"^1.3.6\",\n+    \"@radix-ui/react-slot\": \"^1.2.4\",\n+    \"@radix-ui/react-switch\": \"^1.2.6\",\n+    \"@radix-ui/react-tabs\": \"^1.1.13\",\n+    \"@radix-ui/react-toggle\": \"^1.1.10\",\n+    \"@radix-ui/react-toggle-group\": \"^1.1.11\",\n+    \"@radix-ui/react-tooltip\": \"^1.2.8\",\n+    \"@tailwindcss/vite\": \"^4.2.1\",\n+    \"@tanstack/react-query\": \"^5.101.1\",\n+    \"@tanstack/react-router\": \"^1.170.16\",\n+    \"@tanstack/react-start\": \"^1.168.26\",\n+    \"@tanstack/router-plugin\": \"^1.168.18\",\n+    \"class-variance-authority\": \"^0.7.1\",\n+    \"clsx\": \"^2.1.1\",\n+    \"cmdk\": \"^1.1.1\",\n+    \"date-fns\": \"^4.1.0\",\n+    \"embla-carousel-react\": \"^8.6.0\",\n+    \"input-otp\": \"^1.4.2\",\n+    \"lucide-react\": \"^0.575.0\",\n+    \"react\": \"^19.2.0\",\n+    \"react-day-picker\": \"^9.14.0\",\n+    \"react-dom\": \"^19.2.0\",\n+    \"react-hook-form\": \"^7.71.2\",\n+    \"react-resizable-panels\": \"^4.6.5\",\n+    \"recharts\": \"^2.15.4\",\n+    \"sonner\": \"^2.0.7\",\n+    \"tailwind-merge\": \"^3.5.0\",\n+    \"tailwindcss\": \"^4.2.1\",\n+    \"tw-animate-css\": \"^1.3.4\",\n+    \"vaul\": \"^1.1.2\",\n+    \"vite-tsconfig-paths\": \"^6.0.2\",\n+    \"zod\": \"^3.24.2\"\n+  },\n+  \"devDependencies\": {\n+    \"@eslint/js\": \"^9.32.0\",\n+    \"@lovable.dev/vite-tanstack-config\": \"^2.6.4\",\n+    \"@types/node\": \"^22.16.5\",\n+    \"@types/react\": \"^19.2.0\",\n+    \"@types/react-dom\": \"^19.2.0\",\n+    \"@vitejs/plugin-react\": \"^5.2.0\",\n+    \"eslint\": \"^9.32.0\",\n+    \"eslint-
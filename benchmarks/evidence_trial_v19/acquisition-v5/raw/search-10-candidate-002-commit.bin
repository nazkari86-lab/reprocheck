{"sha":"a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","node_id":"C_kwDORUuS4toAKGEwZTlkZDZjYzQyMmY0NDdlZDcxM2EyZWZhZjJkYmM5ZWUyMzEyN2M","commit":{"author":{"name":"Claude","email":"artem@hippograph","date":"2026-04-10T03:29:07Z"},"committer":{"name":"Claude","email":"artem@hippograph","date":"2026-04-10T03:29:07Z"},"message":"fix: port mehen-graph fixes to hippograph-pro, rename engram->note throughout\n\n- graph_engine: remove shadow import causing temporal scoring bug\n- graph_engine: fix ann_index.node_ids (was engram_ids), SQL nodes table refs\n- search_logger: add ALTER TABLE migrations for new columns\n- sleep_compute: fix ne.node_id (was ne.engram_id), nodes table refs throughout\n- mcp_sse_handler: rename tools add/update/delete engram->note, note_id in API\n- database: add get_engram_history/restore_engram_version aliases for MCP\n- tests: fix test isolation, update outdated function names\n- CLI: rename engram->note throughout","tree":{"sha":"eca2984b8d707d360439698683b3804483972e7b","url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/git/trees/eca2984b8d707d360439698683b3804483972e7b"},"url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/git/commits/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/commits/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","html_url":"https://github.com/artemMprokhorov/hippograph-pro/commit/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","comments_url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/commits/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c/comments","author":null,"committer":null,"parents":[{"sha":"c714aaf6734dd304cf8ed2326c14646e91d3aba1","url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/commits/c714aaf6734dd304cf8ed2326c14646e91d3aba1","html_url":"https://github.com/artemMprokhorov/hippograph-pro/commit/c714aaf6734dd304cf8ed2326c14646e91d3aba1"}],"stats":{"total":298,"additions":163,"deletions":135},"files":[{"sha":"4d563a8adda07c1b4a20886f983c87722fe634ae","filename":"hippograph_cli.py","status":"modified","additions":12,"deletions":12,"changes":24,"blob_url":"https://github.com/artemMprokhorov/hippograph-pro/blob/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c/hippograph_cli.py","raw_url":"https://github.com/artemMprokhorov/hippograph-pro/raw/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c/hippograph_cli.py","contents_url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/contents/hippograph_cli.py?ref=a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","patch":"@@ -9,8 +9,8 @@\n   hippograph status\n   hippograph sleep\n   hippograph pcb\n-  hippograph graph <engram_id>\n-  hippograph get <engram_id>\n+  hippograph graph <note_id>\n+  hippograph get <note_id>\n   hippograph repl\n \n Env vars:\n@@ -133,7 +133,7 @@ def cmd_add(args):\n     if args.tone:\n         payload['emotional_tone'] = args.tone\n \n-    r = api_post('/api/add_engram', payload)\n+    r = api_post('/api/add_note', payload)\n \n     if args.json:\n         print(json.dumps(r, ensure_ascii=False, indent=2))\n@@ -147,7 +147,7 @@ def cmd_add(args):\n             print(c('red', f\"❌ Error: {r['error']}\"))\n         return\n \n-    eid = r.get('engram_id', '?')\n+    eid = r.get('note_id', '?')\n     entities = r.get('entities', [])\n     chunks = r.get('late_chunks', 0)\n     print(c('green', f'✅ Added note #{eid}'))\n@@ -227,14 +227,14 @@ def cmd_sleep(args):\n             print(c('yellow', '\\n   Watching stopped (sleep still running)'))\n \n def cmd_graph(args):\n-    r = api_post('/api/get_graph', {'engram_id': int(args.engram_id)})\n+    r = api_post('/api/get_graph', {'note_id': int(args.note_id)})\n     if args.json:\n         print(json.dumps(r, ensure_ascii=False, indent=2))\n         return\n \n     node = r.get('node', {})\n     connections = r.get('connections', [])\n-    print(c('bold', f'\\n🕸️  Graph for #{args.engram_id}'))\n+    print(c('bold', f'\\n🕸️  Graph for #{args.note_id}'))\n     print(c('cyan', f'  Content: {node.get(\"content\", \"\")[:100]}'))\n     print(c('gray', f'  Category: {node.get(\"category\", \"?\")}'))\n     print()\n@@ -256,12 +256,12 @@ def cmd_graph(args):\n     print()\n \n def cmd_get(args):\n-    r = api_post('/api/engram/' + str(args.engram_id), method='GET')\n+    r = api_post('/api/engram/' + str(args.note_id), method='GET')\n     if args.json:\n         print(json.dumps(r, ensure_ascii=False, indent=2))\n         return\n     engram = r.get('engram', r)\n-    print(c('bold', f'\\n📝 Note #{args.engram_id}'))\n+    print(c('bold', f'\\n📝 Note #{args.note_id}'))\n     for k, v in engram.items():\n         if k == 'embedding':\n             v = f'<{len(str(v))} chars>'\n@@ -336,9 +336,9 @@ def cmd_repl(args):\n             elif cmd == 'sleep':\n                 cmd_sleep(argparse.Namespace(json=False, no_wait=True))\n             elif cmd == 'graph':\n-                cmd_graph(argparse.Namespace(engram_id=rest, json=False))\n+                cmd_graph(argparse.Namespace(note_id=rest, json=False))\n             elif cmd == 'get':\n-                cmd_get(argparse.Namespace(engram_id=rest, json=False))\n+                cmd_get(argparse.Namespace(note_id=rest, json=False))\n             elif cmd == 'pcb':\n                 cmd_pcb(argparse.Namespace())\n             elif cmd == 'status':\n@@ -406,11 +406,11 @@ def main():\n     p.add_argument('--json', action='store_true')\n \n     p = sub.add_parser('graph', help='Show graph connections for a note')\n-    p.add_argument('engram_id')\n+    p.add_argument('note_id')\n     p.add_argument('--json', action='store_true')\n \n     p = sub.add_parser('get', help='Get note by ID')\n-    p.add_argument('engram_id')\n+    p.add_argument('note_id')\n     p.add_argument('--json', action='store_true')\n \n     sub.add_parser('pcb', help='Quick memory check')"},{"sha":"650463c51162935db2ea47c6778d8156fa7ab43d","filename":"src/graph_engine.py","status":"modified","additions":16,"deletions":15,"changes":31,"blob_url":"https://github.com/artemMprokhorov/hippograph-pro/blob/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c/src%2Fgraph_engine.py","raw_url":"https://github.com/artemMprokhorov/hippograph-pro/raw/a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c/src%2Fgraph_engine.py","contents_url":"https://api.github.com/repos/artemMprokhorov/hippograph-pro/contents/src%2Fgraph_engine.py?ref=a0e9dd6cc422f447ed713a2efaf2dbc9ee23127c","patch":"@@ -200,7 +200,7 @@ def _mini_consolidate(engram_id, top_k=15, threshold=0.75):\n         # Get embedding of the new note\n         with get_connection() as conn:\n             row = conn.execute(\n-                'SELECT embedding FROM engrams WHERE id=?', (engram_id,)\n+                'SELECT embedding FROM nodes WHERE id=?', (engram_id,)\n             ).fetchone()\n         if not row or not row[0]:\n             return 0\n@@ -431,13 +431,13 @@ def add_engram_with_links(content, category=\"general\", importance=\"normal\", forc\n     try:\n         node_t_event = None\n         with get_connection() as _tc:\n-            _row = _tc.execute('SELECT t_event_start FROM engrams WHERE id=?', (engram_id,)).fetchone()\n+            _row = _tc.execute('SELECT t_event_start FROM nodes WHERE id=?', (engram_id,)).fetchone()\n             if _row:\n                 node_t_event = _row[0]\n         if node_t_event:\n             with get_connection() as _tc:\n                 _neighbors = _tc.execute(\n-                    \"\"\"SELECT id, t_event_start FROM engrams\n+                    \"\"\"SELECT id, t_event_start FROM nodes\n                        WHERE t_event_start IS NOT NULL AND id != ?\n                        ORDER BY ABS(julianday(t_event_start) - julianday(?)) ASC\n                        LIMIT 6\"\"\",\n@@ -455,7 +455,7 @@ def add_engram_with_links(content, category=\"general\", importance=\"normal\", forc\n         pri
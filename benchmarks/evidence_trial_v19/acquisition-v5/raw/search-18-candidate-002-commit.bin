3fb0637a8bee599d1f20f","patch":"@@ -1103,7 +1103,7 @@\n  ],\n  \"metadata\": {\n   \"kernelspec\": {\n-   \"display_name\": \"coffee\",\n+   \"display_name\": \"Python 3\",\n    \"language\": \"python\",\n    \"name\": \"python3\"\n   },"},{"sha":"70753c5354bb1a6acae82bf4f0b782ff5a1022df","filename":"paper/main.aux","status":"added","additions":58,"deletions":0,"changes":58,"blob_url":"https://github.com/eulergomees/lstm_coffee_price/blob/9111dd4d208f13a08c33fb0637a8bee599d1f20f/paper%2Fmain.aux","raw_url":"https://github.com/eulergomees/lstm_coffee_price/raw/9111dd4d208f13a08c33fb0637a8bee599d1f20f/paper%2Fmain.aux","contents_url":"https://api.github.com/repos/eulergomees/lstm_coffee_price/contents/paper%2Fmain.aux?ref=9111dd4d208f13a08c33fb0637a8bee599d1f20f","patch":"@@ -0,0 +1,58 @@\n+\\relax \n+\\providecommand \\babel@aux [2]{\\global \\let \\babel@toc \\@gobbletwo }\n+\\@nameuse{bbl@beforestart}\n+\\catcode `\"\\active \n+\\citation{CONAB2025}\n+\\babel@aux{brazil}{}\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {1}Introdução}{1}{}\\protected@file@percent }\n+\\citation{inmet2025bdmep}\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {2}Materiais}{2}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {2.1}Fontes de dados}{2}{}\\protected@file@percent }\n+\\@writefile{lot}{\\contentsline {table}{\\numberline {1}{\\ignorespaces Estações INMET utilizadas e respectivas microrregiões.}}{2}{}\\protected@file@percent }\n+\\providecommand*\\caption@xref[2]{\\@setref\\relax\\@undefined{#1}}\n+\\newlabel{tab:estacoes}{{1}{2}{Fontes de dados}{table.1}{}}\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {2.2}Análise exploratória}{3}{}\\protected@file@percent }\n+\\@writefile{lof}{\\contentsline {figure}{\\numberline {1}{\\ignorespaces ACF e PACF do log-retorno: pouca autocorrelação linear na média, sugerindo ordens baixas de ARIMA e ganho preditivo, se houver, em estrutura não linear/exógena.}}{3}{}\\protected@file@percent }\n+\\newlabel{fig:acf}{{1}{3}{Análise exploratória}{figure.1}{}}\n+\\@writefile{lof}{\\contentsline {figure}{\\numberline {2}{\\ignorespaces Preço do café com dias de risco de geada destacados. Episódios (notadamente em 2021) coincidem com movimentos de alta, sugerindo reprecificação defasada da oferta futura.}}{3}{}\\protected@file@percent }\n+\\newlabel{fig:geada}{{2}{3}{Análise exploratória}{figure.2}{}}\n+\\citation{hochreiter1997lstm}\n+\\citation{kingma2015adam}\n+\\citation{box1976time}\n+\\citation{bollerslev1986generalized}\n+\\citation{hyndman2006another}\n+\\citation{diebold1995comparing}\n+\\citation{breiman2001random}\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {3}Metodologia}{4}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {3.1}Alvo e atributos}{4}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {3.2}Protocolo de validação temporal}{4}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {3.3}Modelo e robustez}{4}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {subsection}{\\numberline {3.4}Baselines e métricas}{4}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {4}Resultados e Discussão}{4}{}\\protected@file@percent }\n+\\@writefile{lot}{\\contentsline {table}{\\numberline {2}{\\ignorespaces Desempenho médio (walk-forward, ensemble de 5 sementes). RMSE e MAE em log-retorno. As colunas DM/RW e DM/ARIMA trazem a estatística de Diebold--Mariano \\emph  {out-of-sample} contra o random walk e o ARIMA ($\\mathrm  {DM}>1{,}96$ indica modelo pior que a referência).}}{5}{}\\protected@file@percent }\n+\\newlabel{tab:comparativa}{{2}{5}{Resultados e Discussão}{table.2}{}}\n+\\@writefile{toc}{\\contentsline {paragraph}{Granularidade regional (B vs.\\ C).}{5}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {paragraph}{Robustez à inicialização.}{5}{}\\protected@file@percent }\n+\\@writefile{lof}{\\contentsline {figure}{\\numberline {3}{\\ignorespaces RMSE por semente ($N=5$) por configuração. A variabilidade entre sementes é comparável às diferenças entre configurações.}}{5}{}\\protected@file@percent }\n+\\newlabel{fig:robustez}{{3}{5}{Robustez à inicialização.}{figure.3}{}}\n+\\citation{fama1970efficient}\n+\\@writefile{toc}{\\contentsline {paragraph}{Volatilidade.}{6}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {paragraph}{Atributos selecionados.}{6}{}\\protected@file@percent }\n+\\@writefile{toc}{\\contentsline {paragraph}{Discussão.}{6}{}\\protected@file@percent }\n+\\@writefile{lof}{\\contentsline {figure}{\\numberline {4}{\\ignorespaces MASE (menor é melhor) e acurácia direcional por modelo. Todas as LSTM ficam próximas do random walk; apenas a Opção B ultrapassa o acaso na direção.}}{6}{}\\protected@file@percent }\n+\\newlabel{fig:comparativo}{{4}{6}{Discussão.}{figure.4}{}}\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {5}Disponibilidade do Código e Reprodutibilidade}{6}{}\\protected@file@percent }\n+\\bibstyle{sbc}\n+\\bibdata{sbc-template}\n+\\bibcite{bollerslev1986generalized}{Bollerslev 1986}\n+\\bibcite{box1976time}{Box and Jenkins 1976}\n+\\bibcite{breiman2001random}{Breiman 2001}\n+\\bibcite{CONAB2025}{{CONAB} 2025}\n+\\bibcite{diebold1995comparing}{Diebold and Mariano 1995}\n+\\bibcite{fama1970efficient}{Fama 1970}\n+\\bibcite{hochreiter1997lstm}{Hochreiter and Schmidhuber 1997}\n+\\bibcite{hyndman2006another}{Hyndman and Koehler 2006}\n+\\bibcite{inmet2025bdmep}{{INMET} 2025}\n+\\@writefile{toc}{\\contentsline {section}{\\numberline {6}Conclusão}{7}{}\\protected@file@percent }\n+\\bibcite{kingma2015adam}{Kingma and Ba 2015}\n+\\gdef \\@abspage@last{8}"},{"sha":"7bcc8c668edf707ff12a011bbead0aa34da5ac64","filename":"paper/main.bbl","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/eulergomees/lstm_coffee_price/blob/9
{"sha":"207e3c50ceddcbab0b9ffe56c3713555f50cc6db","node_id":"C_kwDOQnEjdtoAKDIwN2UzYzUwY2VkZGNiYWIwYjlmZmU1NmMzNzEzNTU1ZjUwY2M2ZGI","commit":{"author":{"name":"Sourangshu Pal","email":"paulbindass@gmail.com","date":"2025-12-11T19:53:44Z"},"committer":{"name":"Sourangshu Pal","email":"paulbindass@gmail.com","date":"2025-12-11T19:53:44Z"},"message":"Merge branch 'main' of https://github.com/sourangshupal/Hybrid-Search-RAG","tree":{"sha":"989ddbbeb02507cdf1066321cd657531a4332d39","url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/git/trees/989ddbbeb02507cdf1066321cd657531a4332d39"},"url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/git/commits/207e3c50ceddcbab0b9ffe56c3713555f50cc6db","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/commits/207e3c50ceddcbab0b9ffe56c3713555f50cc6db","html_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/commit/207e3c50ceddcbab0b9ffe56c3713555f50cc6db","comments_url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/commits/207e3c50ceddcbab0b9ffe56c3713555f50cc6db/comments","author":{"login":"sourangshupal","id":17902554,"node_id":"MDQ6VXNlcjE3OTAyNTU0","avatar_url":"https://avatars.githubusercontent.com/u/17902554?v=4","gravatar_id":"","url":"https://api.github.com/users/sourangshupal","html_url":"https://github.com/sourangshupal","followers_url":"https://api.github.com/users/sourangshupal/followers","following_url":"https://api.github.com/users/sourangshupal/following{/other_user}","gists_url":"https://api.github.com/users/sourangshupal/gists{/gist_id}","starred_url":"https://api.github.com/users/sourangshupal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sourangshupal/subscriptions","organizations_url":"https://api.github.com/users/sourangshupal/orgs","repos_url":"https://api.github.com/users/sourangshupal/repos","events_url":"https://api.github.com/users/sourangshupal/events{/privacy}","received_events_url":"https://api.github.com/users/sourangshupal/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"sourangshupal","id":17902554,"node_id":"MDQ6VXNlcjE3OTAyNTU0","avatar_url":"https://avatars.githubusercontent.com/u/17902554?v=4","gravatar_id":"","url":"https://api.github.com/users/sourangshupal","html_url":"https://github.com/sourangshupal","followers_url":"https://api.github.com/users/sourangshupal/followers","following_url":"https://api.github.com/users/sourangshupal/following{/other_user}","gists_url":"https://api.github.com/users/sourangshupal/gists{/gist_id}","starred_url":"https://api.github.com/users/sourangshupal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sourangshupal/subscriptions","organizations_url":"https://api.github.com/users/sourangshupal/orgs","repos_url":"https://api.github.com/users/sourangshupal/repos","events_url":"https://api.github.com/users/sourangshupal/events{/privacy}","received_events_url":"https://api.github.com/users/sourangshupal/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e207d017e12c49e29d287b73f864669a4579d10e","url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/commits/e207d017e12c49e29d287b73f864669a4579d10e","html_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/commit/e207d017e12c49e29d287b73f864669a4579d10e"},{"sha":"5a0f71b776176966f742e0c02e3951af6204312b","url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/commits/5a0f71b776176966f742e0c02e3951af6204312b","html_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/commit/5a0f71b776176966f742e0c02e3951af6204312b"}],"stats":{"total":107,"additions":107,"deletions":0},"files":[{"sha":"8452b0f2ff194a7bacf656652973066ecad65fa5","filename":".github/workflows/claude-code-review.yml","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/blob/207e3c50ceddcbab0b9ffe56c3713555f50cc6db/.github%2Fworkflows%2Fclaude-code-review.yml","raw_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/raw/207e3c50ceddcbab0b9ffe56c3713555f50cc6db/.github%2Fworkflows%2Fclaude-code-review.yml","contents_url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/contents/.github%2Fworkflows%2Fclaude-code-review.yml?ref=207e3c50ceddcbab0b9ffe56c3713555f50cc6db","patch":"@@ -0,0 +1,57 @@\n+name: Claude Code Review\n+\n+on:\n+  pull_request:\n+    types: [opened, synchronize]\n+    # Optional: Only run on specific file changes\n+    # paths:\n+    #   - \"src/**/*.ts\"\n+    #   - \"src/**/*.tsx\"\n+    #   - \"src/**/*.js\"\n+    #   - \"src/**/*.jsx\"\n+\n+jobs:\n+  claude-review:\n+    # Optional: Filter by PR author\n+    # if: |\n+    #   github.event.pull_request.user.login == 'external-contributor' ||\n+    #   github.event.pull_request.user.login == 'new-developer' ||\n+    #   github.event.pull_request.author_association == 'FIRST_TIME_CONTRIBUTOR'\n+\n+    runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+      pull-requests: read\n+      issues: read\n+      id-token: write\n+\n+    steps:\n+      - name: Checkout repository\n+        uses: actions/checkout@v4\n+        with:\n+          fetch-depth: 1\n+\n+      - name: Run Claude Code Review\n+        id: claude-review\n+        uses: anthropics/claude-code-action@v1\n+        with:\n+          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}\n+          prompt: |\n+            REPO: ${{ github.repository }}\n+            PR NUMBER: ${{ github.event.pull_request.number }}\n+\n+            Please review this pull request and provide feedback on:\n+            - Code quality and best practices\n+            - Potential bugs or issues\n+            - Performance considerations\n+            - Security concerns\n+            - Test coverage\n+\n+            Use the repository's CLAUDE.md for guidance on style and conventions. Be constructive and helpful in your feedback.\n+\n+            Use `gh pr comment` with your Bash tool to leave your review as a comment on the PR.\n+\n+          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md\n+          # or https://code.claude.com/docs/en/cli-reference for available options\n+          claude_args: '--allowed-tools \"Bash(gh issue view:*),Bash(gh search:*),Bash(gh issue list:*),Bash(gh pr comment:*),Bash(gh pr diff:*),Bash(gh pr view:*),Bash(gh pr list:*)\"'\n+"},{"sha":"d300267f1855c6feac7fcd99500b033a9cd8c0c1","filename":".github/workflows/claude.yml","status":"added","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/blob/207e3c50ceddcbab0b9ffe56c3713555f50cc6db/.github%2Fworkflows%2Fclaude.yml","raw_url":"https://github.com/sourangshupal/Hybrid-Search-RAG/raw/207e3c50ceddcbab0b9ffe56c3713555f50cc6db/.github%2Fworkflows%2Fclaude.yml","contents_url":"https://api.github.com/repos/sourangshupal/Hybrid-Search-RAG/contents/.github%2Fworkflows%2Fclaude.yml?ref=207e3c50ceddcbab0b9ffe56c3713555f50cc6db","patch":"@@ -0,0 +1,50 @@\n+name: Claude Code\n+\n+on:\n+  issue_comment:\n+    types: [created]\n+  pull_request_review_comment:\n+    types: [created]\n+  issues:\n+    types: [opened, assigned]\n+  pull_request_review:\n+    types: [submitted]\n+\n+jobs:\n+  claude:\n+    if: |\n+      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@claude')) ||\n+      (github.event_name == 'pull_request_review_comment' && contains(github.event.comment.body, '@claude')) ||\n+      (github.event_name == 'pull_request_review' && contains(github.event.review.body, '@claude')) ||\n+      (github.event_name == 'issues' && (contains(github.event.issue.body, '@claude') || contains(github.event.issue.title, '@claude')))\n+    runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+      pull-requests: read\n+      issues: read\n+      id-token: write\n+      actions: read # Required for Claude to read CI results on PRs\n+    steps:\n+      - name: Checkout repository\n+        uses: actions/checkout@v4\n+        with:\n+          fetch-depth: 1\n+\n+      - name: Run Claude Code\n+        id: claude\n+        uses: anthropics/claude-code-action@v1\n+        with:\n+          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}\n+\n+          # This is an optional setting that allows Claude to read CI results on PRs\n+          additional_permissions: |\n+            actions: read\n+\n+          # Optional: Give a custom prompt to Claude. If this is not specified, Claude will perform the instructions specified in the comment that tagged it.\n+          # prompt: 'Update the pull request description to include a summary of changes.'\n+\n+          # Optional: Add claude_args to customize behavior and configuration\n+          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md\n+          # or https://code.claude.com/docs/en/cli-reference for available options\n+          # claude_args: '--allowed-tools Bash(gh pr:*)'\n+"}]}
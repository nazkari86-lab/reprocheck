{"sha":"0cec47db370349d8c6cd86a8a1e7013f1677dc77","node_id":"C_kwDOSs15U9oAKDBjZWM0N2RiMzcwMzQ5ZDhjNmNkODZhOGExZTcwMTNmMTY3N2RjNzc","commit":{"author":{"name":"Your Name","email":"your.email@example.com","date":"2026-06-14T07:29:42Z"},"committer":{"name":"Your Name","email":"your.email@example.com","date":"2026-06-14T07:29:42Z"},"message":"Add LAB_BASE_MODEL_DIR/LAB_ADAPTER_DIR env var overrides to config\n\nLets each machine point at its own model store without editing code.\nResolution order: explicit dir vars > LAB_EXTERNAL_DRIVE > repo-local.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>","tree":{"sha":"74bd0abfa6cd26870b74ad742952bbdf778fbb6a","url":"https://api.github.com/repos/amirrezavishteh/online-testing/git/trees/74bd0abfa6cd26870b74ad742952bbdf778fbb6a"},"url":"https://api.github.com/repos/amirrezavishteh/online-testing/git/commits/0cec47db370349d8c6cd86a8a1e7013f1677dc77","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/amirrezavishteh/online-testing/commits/0cec47db370349d8c6cd86a8a1e7013f1677dc77","html_url":"https://github.com/amirrezavishteh/online-testing/commit/0cec47db370349d8c6cd86a8a1e7013f1677dc77","comments_url":"https://api.github.com/repos/amirrezavishteh/online-testing/commits/0cec47db370349d8c6cd86a8a1e7013f1677dc77/comments","author":{"login":"h15629526027","id":99627554,"node_id":"U_kgDOBfAyIg","avatar_url":"https://avatars.githubusercontent.com/u/99627554?v=4","gravatar_id":"","url":"https://api.github.com/users/h15629526027","html_url":"https://github.com/h15629526027","followers_url":"https://api.github.com/users/h15629526027/followers","following_url":"https://api.github.com/users/h15629526027/following{/other_user}","gists_url":"https://api.github.com/users/h15629526027/gists{/gist_id}","starred_url":"https://api.github.com/users/h15629526027/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/h15629526027/subscriptions","organizations_url":"https://api.github.com/users/h15629526027/orgs","repos_url":"https://api.github.com/users/h15629526027/repos","events_url":"https://api.github.com/users/h15629526027/events{/privacy}","received_events_url":"https://api.github.com/users/h15629526027/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"h15629526027","id":99627554,"node_id":"U_kgDOBfAyIg","avatar_url":"https://avatars.githubusercontent.com/u/99627554?v=4","gravatar_id":"","url":"https://api.github.com/users/h15629526027","html_url":"https://github.com/h15629526027","followers_url":"https://api.github.com/users/h15629526027/followers","following_url":"https://api.github.com/users/h15629526027/following{/other_user}","gists_url":"https://api.github.com/users/h15629526027/gists{/gist_id}","starred_url":"https://api.github.com/users/h15629526027/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/h15629526027/subscriptions","organizations_url":"https://api.github.com/users/h15629526027/orgs","repos_url":"https://api.github.com/users/h15629526027/repos","events_url":"https://api.github.com/users/h15629526027/events{/privacy}","received_events_url":"https://api.github.com/users/h15629526027/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7d95972ff93c2496eb7ac885668d2547ef5a6e76","url":"https://api.github.com/repos/amirrezavishteh/online-testing/commits/7d95972ff93c2496eb7ac885668d2547ef5a6e76","html_url":"https://github.com/amirrezavishteh/online-testing/commit/7d95972ff93c2496eb7ac885668d2547ef5a6e76"}],"stats":{"total":29,"additions":22,"deletions":7},"files":[{"sha":"d2dbef775d6ca50ea8da3399551090ada4b8e5f4","filename":"online/lab/config.py","status":"modified","additions":22,"deletions":7,"changes":29,"blob_url":"https://github.com/amirrezavishteh/online-testing/blob/0cec47db370349d8c6cd86a8a1e7013f1677dc77/online%2Flab%2Fconfig.py","raw_url":"https://github.com/amirrezavishteh/online-testing/raw/0cec47db370349d8c6cd86a8a1e7013f1677dc77/online%2Flab%2Fconfig.py","contents_url":"https://api.github.com/repos/amirrezavishteh/online-testing/contents/online%2Flab%2Fconfig.py?ref=0cec47db370349d8c6cd86a8a1e7013f1677dc77","patch":"@@ -21,14 +21,29 @@\n # separate folders: one for the (large, re-downloadable) base model cache,\n # one for the (small, precious) trained LoRA adapter — keeping them apart\n # makes it trivial to rsync just the adapter between machines.\n-EXTERNAL_DRIVE_PATH = Path(os.environ.get(\"LAB_EXTERNAL_DRIVE\",\n-                                          \"/media/external20/amirreza_vishteh\"))\n-if EXTERNAL_DRIVE_PATH.exists():\n-    BASE_MODEL_DIR = EXTERNAL_DRIVE_PATH / \"base_model\"\n-    ADAPTER_DIR = EXTERNAL_DRIVE_PATH / \"backdoor_adapter\"\n+# Per-directory env var overrides take priority so different machines can point\n+# at their own model stores without editing this file.\n+#   LAB_BASE_MODEL_DIR  — explicit path to a local Qwen2.5-0.5B-Instruct snapshot\n+#   LAB_ADAPTER_DIR     — explicit path to a trained LoRA adapter directory\n+#   LAB_EXTERNAL_DRIVE  — root of an external drive; sub-dirs are derived from it\n+#\n+# Resolution order (first match wins):\n+#   1. LAB_BASE_MODEL_DIR / LAB_ADAPTER_DIR env vars\n+#   2. LAB_EXTERNAL_DRIVE env var or default /media/external20/amirreza_vishteh\n+#   3. Repo-local artifacts/\n+if os.environ.get(\"LAB_BASE_MODEL_DIR\"):\n+    BASE_MODEL_DIR = Path(os.environ[\"LAB_BASE_MODEL_DIR\"])\n+    ADAPTER_DIR = Path(os.environ.get(\"LAB_ADAPTER_DIR\",\n+                                      str(ARTIFACT_DIR / \"backdoor_adapter\")))\n else:\n-    BASE_MODEL_DIR = ARTIFACT_DIR / \"base_model\"\n-    ADAPTER_DIR = ARTIFACT_DIR / \"backdoor_adapter\"\n+    EXTERNAL_DRIVE_PATH = Path(os.environ.get(\"LAB_EXTERNAL_DRIVE\",\n+                                              \"/media/external20/amirreza_vishteh\"))\n+    if EXTERNAL_DRIVE_PATH.exists():\n+        BASE_MODEL_DIR = EXTERNAL_DRIVE_PATH / \"base_model\"\n+        ADAPTER_DIR = EXTERNAL_DRIVE_PATH / \"backdoor_adapter\"\n+    else:\n+        BASE_MODEL_DIR = ARTIFACT_DIR / \"base_model\"\n+        ADAPTER_DIR = ARTIFACT_DIR / \"backdoor_adapter\"\n \n \n @dataclass"}]}
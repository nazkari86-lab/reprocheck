received_events_url":"https://api.github.com/users/emily-palaska/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"emily-palaska","id":103355365,"node_id":"U_kgDOBikT5Q","avatar_url":"https://avatars.githubusercontent.com/u/103355365?v=4","gravatar_id":"","url":"https://api.github.com/users/emily-palaska","html_url":"https://github.com/emily-palaska","followers_url":"https://api.github.com/users/emily-palaska/followers","following_url":"https://api.github.com/users/emily-palaska/following{/other_user}","gists_url":"https://api.github.com/users/emily-palaska/gists{/gist_id}","starred_url":"https://api.github.com/users/emily-palaska/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/emily-palaska/subscriptions","organizations_url":"https://api.github.com/users/emily-palaska/orgs","repos_url":"https://api.github.com/users/emily-palaska/repos","events_url":"https://api.github.com/users/emily-palaska/events{/privacy}","received_events_url":"https://api.github.com/users/emily-palaska/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2b75b427b184e824402d5b3973a3fbd00e9c355b","url":"https://api.github.com/repos/emily-palaska/mosaic/commits/2b75b427b184e824402d5b3973a3fbd00e9c355b","html_url":"https://github.com/emily-palaska/mosaic/commit/2b75b427b184e824402d5b3973a3fbd00e9c355b"}],"stats":{"total":89,"additions":82,"deletions":7},"files":[{"sha":"26a0b2d90d2e475f39cc64d43c1990c68daf66bc","filename":".gitignore","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/emily-palaska/mosaic/blob/288c7dd19c3057dcf16774411342c4e38bf38a29/.gitignore","raw_url":"https://github.com/emily-palaska/mosaic/raw/288c7dd19c3057dcf16774411342c4e38bf38a29/.gitignore","contents_url":"https://api.github.com/repos/emily-palaska/mosaic/contents/.gitignore?ref=288c7dd19c3057dcf16774411342c4e38bf38a29","patch":"@@ -3,3 +3,4 @@\n /models/**\n /mosaic/dummy.py\n /tests/dummy.py\n+venv/\n\\ No newline at end of file"},{"sha":"21207d5ab74527a287ffacef03474f76aa5aeff1","filename":"requirements.txt","status":"modified","additions":8,"deletions":7,"changes":15,"blob_url":"https://github.com/emily-palaska/mosaic/blob/288c7dd19c3057dcf16774411342c4e38bf38a29/requirements.txt","raw_url":"https://github.com/emily-palaska/mosaic/raw/288c7dd19c3057dcf16774411342c4e38bf38a29/requirements.txt","contents_url":"https://api.github.com/repos/emily-palaska/mosaic/contents/requirements.txt?ref=288c7dd19c3057dcf16774411342c4e38bf38a29","patch":"@@ -1,10 +1,11 @@\n-docarray==0.40.0\n-matplotlib==3.8.3\n+docarray==0.41.0\n+matplotlib==3.10.8\n numpy==1.26.3\n-pytest==8.3.4\n-sentence_transformers==3.3.1\n-torch==2.2.0\n+ollama==0.6.1\n+scipy==1.16.3\n+seaborn==0.13.2\n+sentence_transformers==5.2.2\n torch==2.3.1+cu118\n-transformers==4.49.0\n+transformers==5.0.0\n vectordb==0.0.21\n-seaborn~=0.13.2\n\\ No newline at end of file\n+hf-xet==1.2.0\n\\ No newline at end of file"},{"sha":"7e35519df95b38c36782009a96f639ee476678cd","filename":"tests/executability.py","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/emily-palaska/mosaic/blob/288c7dd19c3057dcf16774411342c4e38bf38a29/tests%2Fexecutability.py","raw_url":"https://github.com/emily-palaska/mosaic/raw/288c7dd19c3057dcf16774411342c4e38bf38a29/tests%2Fexecutability.py","contents_url":"https://api.github.com/repos/emily-palaska/mosaic/contents/tests%2Fexecutability.py?ref=288c7dd19c3057dcf16774411342c4e38bf38a29","patch":"@@ -0,0 +1,73 @@\n+import os\n+os.chdir(\"../\")\n+\n+from ollama import Client\n+\n+def make_prompt(code):\n+    return f'''Can this code be executed? Answer yes or output ONLY the number of lines that would have to be changed.\n+\n+{code}\n+\n+'''\n+\n+def find_file(filename:str, directory:str):\n+    for root, dirs, files in os.walk(directory):\n+        if filename in files: return os.path.join(root, filename)\n+    return None\n+\n+def synthesis_results(path:str='results/synthesis', index:int=0, method:str='b', prefix:str=\"## Code Concatenation\\n\"):\n+    assert method in ['b','e', 'x', 'rnd', 're', 's'], \"Invalid method\"\n+    synthesis_path = find_file(f'query{index}{method}.md', path)\n+    synthesis = open(synthesis_path,'r').read()\n+    start = synthesis.find(\"Query\")\n+    return synthesis.split(prefix, 1)[1]\n+\n+    #return synthesis[start: synthesis.find(\"\\n\", start)], synthesis.split(prefix, 1)[1]\n+\n+def ollama_query():\n+    # Choose a code model — freely available examples:\n+    #   - 'codellama'\n+    #   - 'qwen2.5-coder'\n+    #   - 'starcoder2'\n+    model, client = \"qwen2.5-coder\", Client()\n+    prompt = make_prompt(synthesis_results(index=5, method='e'))\n+    response = client.chat(\n+        model=model,\n+        messages=[{\"role\": \"user\", \"content\": prompt}]\n+    )\n+    print(prompt)\n+    print('*'*100)\n+    print(response[\"message\"][\"content\"])\n+\n+import parso\n+\n+def failing_nodes(code: str) -> int:\n+    \"\"\"\n+    Parses Python code using an error-tolerant parser (parso)\n+    and returns the number of syntax error nodes.\n+    \"\"\"\n+    grammar = parso.load_grammar()\n+    module = grammar.parse(code)\n+\n+    def count_errors(node):\n+        count = 0\n+        if node.type == \"error_node\":\n+            count += 1\n+        if hasattr(node, \"children\"):\n+            for child in node.children:\n+                count += count_errors(child)\n+        return count\n+\n+    return count_errors(module)\n+\n+\n+def main():\n+    examples = 30\n+    methods = ['b','e', 'x', 'rnd', 're', 's']\n+\n+    for method in methods:\n+        counts = [failing_nodes(synthesis_results(index=i, method=method)) for i in range(examples)]\n+        print(f\"Method {method}: {sum(counts)} \\t {counts}\")\n+\n+if __name__ == '__main__':\n+    main()"}]}
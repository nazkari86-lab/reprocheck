vents_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7bb3db346bec91af3b050e96b3b92e529b5342b5","url":"https://api.github.com/repos/Sonberg/zeta/commits/7bb3db346bec91af3b050e96b3b92e529b5342b5","html_url":"https://github.com/Sonberg/zeta/commit/7bb3db346bec91af3b050e96b3b92e529b5342b5"},{"sha":"8482bf5571991f9a9e0c6ddff1734be78c1f8052","url":"https://api.github.com/repos/Sonberg/zeta/commits/8482bf5571991f9a9e0c6ddff1734be78c1f8052","html_url":"https://github.com/Sonberg/zeta/commit/8482bf5571991f9a9e0c6ddff1734be78c1f8052"}],"stats":{"total":2,"additions":2,"deletions":0},"files":[{"sha":"2dd2f19e08da062c67fb493a328e79883a3c867a","filename":"CHANGELOG.md","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/Sonberg/zeta/blob/744efe5a42856e32cd98cfcb9f63931862f07feb/CHANGELOG.md","raw_url":"https://github.com/Sonberg/zeta/raw/744efe5a42856e32cd98cfcb9f63931862f07feb/CHANGELOG.md","contents_url":"https://api.github.com/repos/Sonberg/zeta/contents/CHANGELOG.md?ref=744efe5a42856e32cd98cfcb9f63931862f07feb","patch":"@@ -3,6 +3,7 @@\n ## Next release\n \n ### Fixed\n+- Documentation site: the \"Migrate with AI\" button in the top nav bar had no spacing from the adjacent appearance toggle/social links, so it sat flush against them. Added `margin-left` to the compact nav-bar variant.\n - Corrected documentation that claimed nullable value-type properties (`int?`, `decimal?`, `Guid?`, etc.) skip validation on null automatically. `.Nullable()` is required uniformly for value types and reference types alike — updated `CLAUDE.md`, `docs/getting-started.md`, `docs/property-builders.md`, `docs/schemas.md`, and `.claude/skills/zeta/SKILL.md` to match the actual (and tested) behavior.\n - `docs/Concepts.md` had the collection/dictionary validation stage order backwards; corrected to collection-level rules → elements/entries → conditionals, matching `CollectionContextlessSchema`/`DictionaryContextlessSchema`.\n - `docs/validators.md` mis-stated `.Morning()`'s range as 6am–12pm; the rule actually matches any hour before noon (12am–12pm)."},{"sha":"7a0aa404d767b03ea643968166d470aa4805e4e9","filename":"docs/.vitepress/theme/MigrateWithAI.vue","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/Sonberg/zeta/blob/744efe5a42856e32cd98cfcb9f63931862f07feb/docs%2F.vitepress%2Ftheme%2FMigrateWithAI.vue","raw_url":"https://github.com/Sonberg/zeta/raw/744efe5a42856e32cd98cfcb9f63931862f07feb/docs%2F.vitepress%2Ftheme%2FMigrateWithAI.vue","contents_url":"https://api.github.com/repos/Sonberg/zeta/contents/docs%2F.vitepress%2Ftheme%2FMigrateWithAI.vue?ref=744efe5a42856e32cd98cfcb9f63931862f07feb","patch":"@@ -103,6 +103,7 @@ const labels: Record<State, string> = {\n \n .migrate-with-ai--compact {\n   display: none;\n+  margin-left: 12px;\n   border: 1px solid var(--vp-c-brand-1);\n   padding: 0 12px;\n   line-height: 30px;"}]}
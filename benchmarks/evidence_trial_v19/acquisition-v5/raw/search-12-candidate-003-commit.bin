ax(0.0)\n+                            .mul_add(0.25, coverage[usize::try_from(x - clip_x0).unwrap_or(0)]);\n                     }\n                 }\n             }"},{"sha":"03e4d94d9206195e9f11ceb43941a6bae1ce4a58","filename":"crates/skia-rs-codec/Cargo.toml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-codec%2FCargo.toml","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-codec%2FCargo.toml","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-codec%2FCargo.toml?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -14,7 +14,7 @@ categories.workspace = true\n readme = \"README.md\"\n \n [features]\n-default = [\"png\", \"jpeg\", \"gif\", \"webp\"]\n+default = [\"png\", \"jpeg\", \"gif\"]\n png = [\"dep:png\"]\n jpeg = [\"dep:jpeg-decoder\", \"dep:jpeg-encoder\"]\n gif = [\"dep:gif\"]"},{"sha":"630386395c942fa9833c3456267036078177bccf","filename":"crates/skia-rs-codec/README.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-codec%2FREADME.md","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-codec%2FREADME.md","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-codec%2FREADME.md?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -1,6 +1,6 @@\n # skia-rs-codec\n \n-Image encoding and decoding for [skia-rs](https://github.com/pegasusheavy/skia-rs), a pure Rust implementation of the Skia 2D graphics library.\n+Image encoding and decoding for [skia-rs](https://github.com/quinnjr/skia-rs), a pure Rust implementation of the Skia 2D graphics library.\n \n ## Features\n \n@@ -18,7 +18,7 @@ Image encoding and decoding for [skia-rs](htt
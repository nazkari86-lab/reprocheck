on = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"flate2\",\n  \"pdf-writer\",\n@@ -2512,7 +2512,7 @@ dependencies = [\n \n [[package]]\n name = \"skia-rs-python\"\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"pyo3\",\n  \"pyo3-build-config\",\n@@ -2524,7 +2524,7 @@ dependencies = [\n \n [[package]]\n name = \"skia-rs-safe\"\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"bitflags 2.10.0\",\n  \"js-sys\",\n@@ -2546,7 +2546,7 @@ dependencies = [\n \n [[package]]\n name = \"skia-rs-skottie\"\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"proptest\",\n  \"serde\",\n@@ -2560,7 +2560,7 @@ dependencies = [\n \n [[package]]\n name = \"skia-rs-svg\"\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"base64\",\n  \"flate2\",\n@@ -2578,7 +2578,7 @@ dependencies = [\n \n [[package]]\n name = \"skia-rs-text\"\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n dependencies = [\n  \"fontdb\",\n  \"proptest\","},{"sha":"c9ffcfc0449520c0ab6b295571c3b78d49c9ba77","filename":"Cargo.toml","status":"modified","additions":16,"deletions":16,"changes":32,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/Cargo.toml","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/Cargo.toml","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/Cargo.toml?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -47,31 +47,31 @@ default-members = [\n exclude = [\"fuzz\"]  # Fuzz crate uses different edition for libfuzzer compatibility\n \n [workspace.package]\n-version = \"0.3.0\"\n+version = \"0.4.0\"\n edition = \"2024\"\n license = \"MIT OR Apache-2.0\"\n-repository = \"https://github.com/pegasusheavy/skia-rs\"\n-homepage = \"https://github.com/pegasusheavy/skia-rs\"\n+repository = \"https://github.com/quinnjr/skia-rs\"\n+homepage = \"https://github.com/quinnjr/skia-rs\"\n documentation = \"https://docs.rs/skia-rs-safe\"\n-authors = [\"Pegasus Heavy Industries\"]\n+authors = [\"Joseph R. Quinn\"]\n rust-version = \"1.85\"\n keywords = [\"graphics\", \"2d\", \"skia\", \"rendering\", \"canvas\"]\n categories = [\"graphics\", \"rendering::graphics-api\", \"multimedia::images\"]\n \n [workspace.dependencies]\n # Internal crates - version is required for crates.io, path is for local dev\n-skia-rs-core = { version = \"0.3.0\", path = \"crates/skia-rs-core\" }\n-skia-rs-path = { version = \"0.3.0\", path = \"crates/skia-rs-path\" }\n-skia-rs-paint = { version = \"0.3.0\", path = \"crates/skia-rs-paint\" }\n-skia-rs-canvas = { version = \"0.3.0\", path = \"crates/skia-rs-canvas\" }\n-skia-rs-text = { version = \"0.3.0\", path = \"crates/skia-rs-text\" }\n-skia-rs-gpu = { version = \"0.3.0\", path = \"crates/skia-rs-gpu\" }\n-skia-rs-codec = { version = \"0.3.0\", path = \"crates/skia-rs-codec\" }\n-skia-rs-svg = { version = \"0.3.0\", path = \"crates/skia-rs-svg\" }\n-skia-rs-pdf = { version = \"0.3.0\", path = \"crates/skia-rs-pdf\" }\n-skia-rs-ffi = { version = \"0.3.0\", path = \"crates/skia-rs-ffi\" }\n-skia-rs-safe = { version = \"0.3.0\", path = \"crates/skia-rs-safe\" }\n-skia-rs-skottie = { version = \"0.3.0\", path = \"crates/skia-rs-skottie\" }\n+skia-rs-core = { version = \"0.4.0\", path = \"crates/skia-rs-core\" }\n+skia-rs-path = { version = \"0.4.0\", path = \"crates/skia-rs-path\" }\n+skia-rs-paint = { version = \"0.4.0\", path = \"crates/skia-rs-paint\" }\n+skia-rs-canvas = { version = \"0.4.0\", path = \"crates/skia-rs-canvas\" }\n+skia-rs-text = { version = \"0.4.0\", path = \"crates/skia-rs-text\" }\n+skia-rs-gpu = { version = \"0.4.0\", path = \"crates/skia-rs-gpu\" }\n+skia-rs-codec = { version = \"0.4.0\", path = \"crates/skia-rs-codec\" }\n+skia-rs-svg = { version = \"0.4.0\", path = \"crates/skia-rs-svg\" }\n+skia-rs-pdf = { version = \"0.4.0\", path = \"crates/skia-rs-pdf\" }\n+skia-rs-ffi = { version = \"0.4.0\", path = \"crates/skia-rs-ffi\" }\n+skia-rs-safe = 
d9c1bbfb72cb60e05a67b09c85ffd535","filename":"crates/skia-rs-path/src/flatten.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fflatten.rs","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fflatten.rs","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-path%2Fsrc%2Fflatten.rs?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -128,7 +128,7 @@ pub fn flatten_conic_adaptive(\n \n fn eval_conic(start: Point, ctrl: Point, end: Point, w: Scalar, t: Scalar) -> Point {\n     let mt = 1.0 - t;\n-    let denom = t.mul_add(t, mt * mt + 2.0 * w * t * mt);\n+    let denom = t.mul_add(t, (2.0 * w * t).mul_add(mt, mt * mt));\n     let inv_denom = 1.0 / denom;\n     Point::new(\n         (end.x * t).mul_add(t, (start.x * mt).mul_add(mt, 2.0 * ctrl.x * w * t * mt)) * inv_denom,"},{"sha":"69bf1783be19a6507d8b77e9fdc854f7a41585ba","filename":"crates/skia-rs-path/src/ops.rs","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fops.rs","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fops.rs","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-path%2Fsrc%2Fops.rs?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -212,8 +212,8 @@ impl Polygon {\n         let n = self.points.len();\n         for i in 0..n {\n             let j = (i + 1) % n;\n-            area += self.points[i].x * self.points[j].y;\n-            area -= self.points[j].x * self.points[i].y;\n+            area = self.points[i].x.mul_add(self.points[j].y, area);\n+            area = self.points[j].x.mul_add(-self.points[i].y, area);\n         }\n         area / 2.0\n     }"},{"sha":"6ec7b68487687f1252dd9c2fe1ba2559f8f7e3a8","filename":"crates/skia-rs-path/src/path.rs","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fpath.rs","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-path%2Fsrc%2Fpath.rs","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-path%2Fsrc%2Fpath.rs?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -923,7 +923,7 @@ impl Path {\n                                 n_roots = 1;\n                             }\n                         } else {\n-                            let disc = b * b - 4.0 * a * cc;\n+                            let disc = (4.0 * a).mul_add(-cc, b * b);\n                             if disc >= 0.0 {\n                                 let sqrt_disc = disc.sqrt();\n                                 roots[0] = (-b + sqrt_disc) / (2.0 * a);"},{"sha":"e230f44a493f83c99d5f7f270d6c3fde502f6231","filename":"crates/skia-rs-pdf/README.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/quinnjr/skia-rs/blob/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-pdf%2FREADME.md","raw_url":"https://github.com/quinnjr/skia-rs/raw/f839e19d2dc4d70394e192d8e71908ac30b3fb4e/crates%2Fskia-rs-pdf%2FREADME.md","contents_url":"https://api.github.com/repos/quinnjr/skia-rs/contents/crates%2Fskia-rs-pdf%2FREADME.md?ref=f839e19d2dc4d70394e192d8e71908ac30b3fb4e","patch":"@@ -1,6 +1,6 @@\n # skia-rs-pdf\n \n-PDF generation for [skia-rs](https://github.com/pegasusheavy/skia-rs), a pure Rust implementation of the Skia 2D graphics library.\n+PDF generation for [skia-rs](https://github.com/quinnjr/skia-rs), a pure Rust implementation of the Skia 2D graphics library.\n \n ## Features\n \n@@ -35,4 +35,4 @@ doc.save(\"outpu
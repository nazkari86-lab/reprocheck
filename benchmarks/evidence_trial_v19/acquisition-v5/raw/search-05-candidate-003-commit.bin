ub.com/users/daenuprobst/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"daenuprobst","id":290186,"node_id":"MDQ6VXNlcjI5MDE4Ng==","avatar_url":"https://avatars.githubusercontent.com/u/290186?v=4","gravatar_id":"","url":"https://api.github.com/users/daenuprobst","html_url":"https://github.com/daenuprobst","followers_url":"https://api.github.com/users/daenuprobst/followers","following_url":"https://api.github.com/users/daenuprobst/following{/other_user}","gists_url":"https://api.github.com/users/daenuprobst/gists{/gist_id}","starred_url":"https://api.github.com/users/daenuprobst/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/daenuprobst/subscriptions","organizations_url":"https://api.github.com/users/daenuprobst/orgs","repos_url":"https://api.github.com/users/daenuprobst/repos","events_url":"https://api.github.com/users/daenuprobst/events{/privacy}","received_events_url":"https://api.github.com/users/daenuprobst/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"52075a63b52ebd4c4daab2648ab782df0f93bcbb","url":"https://api.github.com/repos/daenuprobst/molzip/commits/52075a63b52ebd4c4daab2648ab782df0f93bcbb","html_url":"https://github.com/daenuprobst/molzip/commit/52075a63b52ebd4c4daab2648ab782df0f93bcbb"},{"sha":"e5de7dd94ec8834896a821c2221fa29cb970d021","url":"https://api.github.com/repos/daenuprobst/molzip/commits/e5de7dd94ec8834896a821c2221fa29cb970d021","html_url":"https://github.com/daenuprobst/molzip/commit/e5de7dd94ec8834896a821c2221fa29cb970d021"}],"stats":{"total":15,"additions":4,"deletions":11},"files":[{"sha":"db39042e3b95fce022493e4beec9e7490cb310e0","filename":"README.md","status":"modified","additions":4,"deletions":11,"changes":15,"blob_url":"https://github.com/daenuprobst/molzip/blob/269d60688333fedbaeb131fe3c52600e6f2e9434/README.md","raw_url":"https://github.com/daenuprobst/molzip/raw/269d60688333fedbaeb131fe3c52600e6f2e9434/README.md","contents_url":"https://api.github.com/repos/daenuprobst/molzip/contents/README.md?ref=269d60688333fedbaeb131fe3c52600e6f2e9434","patch":"@@ -42,6 +42,10 @@ python scripts/preprocess_pdbbind.py data/pdbbind/refined/ data/pdbbind/core/ da\n \n This script will remove samples found in the core set from the refined set and create a CSV file containing amino-acid sequences and SMILES.\n \n+## Reproducing results\n+The configurations to reproduce the results can be found in the `*_config_*.py` files in the root directory and are loaded on line 20\n+in `main.py`.\n+\n ## Abstract\n \n TBD\n@@ -105,14 +109,3 @@ The classifier is also able to classify raw reaction SMILES from the Schneider50\n |---------|------|------------------|--------------|-----------------|-------------|\n |schneider|random|0.0 +/- 0.0       |0.801 +/- 0.0 |0.0 +/- 0.0      |0.801 +/- 0.0|\n \n-## Discussion\n-\n-TBD\n-\n-## References\n-\n-[^1] <https://arxiv.org/abs/2212.09410>\n-\n-# What is this?\n-\n-This is an experiment for a small open source manuscript/article that aims to validate and evaluate the performance of compression-based molecular classification using Gzip. If you want to join/help out, leave a message or a pull request that includes your name and, if available, your affiliation."}]}
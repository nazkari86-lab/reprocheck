//api.github.com/users/SritejBommaraju/repos","events_url":"https://api.github.com/users/SritejBommaraju/events{/privacy}","received_events_url":"https://api.github.com/users/SritejBommaraju/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"SritejBommaraju","id":208666582,"node_id":"U_kgDODG__1g","avatar_url":"https://avatars.githubusercontent.com/u/208666582?v=4","gravatar_id":"","url":"https://api.github.com/users/SritejBommaraju","html_url":"https://github.com/SritejBommaraju","followers_url":"https://api.github.com/users/SritejBommaraju/followers","following_url":"https://api.github.com/users/SritejBommaraju/following{/other_user}","gists_url":"https://api.github.com/users/SritejBommaraju/gists{/gist_id}","starred_url":"https://api.github.com/users/SritejBommaraju/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SritejBommaraju/subscriptions","organizations_url":"https://api.github.com/users/SritejBommaraju/orgs","repos_url":"https://api.github.com/users/SritejBommaraju/repos","events_url":"https://api.github.com/users/SritejBommaraju/events{/privacy}","received_events_url":"https://api.github.com/users/SritejBommaraju/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"030e229e7e2a96bf267fd8b43864cef056f2bb66","url":"https://api.github.com/repos/SritejBommaraju/divergent-agents/commits/030e229e7e2a96bf267fd8b43864cef056f2bb66","html_url":"https://github.com/SritejBommaraju/divergent-agents/commit/030e229e7e2a96bf267fd8b43864cef056f2bb66"}],"stats":{"total":13,"additions":13,"deletions":0},"files":[{"sha":"3bf3686650c69e70b4863c51c0e2c3904bedc679","filename":"skill/README.md","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/SritejBommaraju/divergent-agents/blob/3f20427d258f70d904425147bddd628324c8314e/skill%2FREADME.md","raw_url":"https://github.com/SritejBommaraju/divergent-agents/raw/3f20427d258f70d904425147bddd628324c8314e/skill%2FREADME.md","contents_url":"https://api.github.com/repos/SritejBommaraju/divergent-agents/contents/skill%2FREADME.md?ref=3f20427d258f70d904425147bddd628324c8314e","patch":"@@ -39,6 +39,19 @@ $d=\"$env:USERPROFILE\\.claude\\skills\"; mkdir $d -Force|Out-Null; curl.exe -fsSL -\n \n Then **restart Claude Code** and type `/diverge` or `/robust-solve`.\n \n+> **Requirements for the one-liners:** `curl` + `tar`, which are built into **macOS**, **Linux**, and\n+> **Windows 10 (build 1803, April 2018) and Windows 11**. Older Windows (7/8 or pre-1803) doesn't ship them\n+> — use a fallback instead:\n+>\n+> ```bash\n+> git clone https://github.com/SritejBommaraju/divergent-agents && cd divergent-agents\n+> #   then:  powershell -ExecutionPolicy Bypass -File skill\\install.ps1   (Windows)\n+> #     or:  sh skill/install.sh                                          (macOS / Linux)\n+> ```\n+> ```bash\n+> npx degit SritejBommaraju/divergent-agents/skill ~/.claude/skills   # no git/tar needed (needs Node)\n+> ```\n+\n ## Install from a local clone (one command)\n \n **Windows** (PowerShell, from the repo root):"}]}
nerate_grants%2Fdvc.lock","raw_url":"https://github.com/wellcometrust/grants_tagger/raw/d1f28133553c7e14e1e99666ace00916b22736c5/pipelines%2Fgenerate_grants%2Fdvc.lock","contents_url":"https://api.github.com/repos/wellcometrust/grants_tagger/contents/pipelines%2Fgenerate_grants%2Fdvc.lock?ref=d1f28133553c7e14e1e99666ace00916b22736c5","patch":"@@ -0,0 +1,16 @@\n+schema: '2.0'\n+stages:\n+  generate:\n+    cmd: python ../../scripts/create_grants_sample.py --s3-url s3://datalabs-data/dimensions/grants/grants\n+      --num-parquet-files-to-consider 10 --num-samples-per-cat 10 --pre-annotate True\n+    outs:\n+    - path: grants_sample.jsonl\n+      md5: b9fdc1d543c00df0533021076d378e91\n+      size: 393041\n+  upload:\n+    cmd: python ../../scripts/upload_grants_data_to_argilla.py --path grants_sample.jsonl\n+      --project grants\n+    deps:\n+    - path: grants_sample.jsonl\n+      md5: b9fdc1d543c00df0533021076d378e91\n+      size: 393041"},{"sha":"8718757d2a3ee8fb10d37e9ab84900cf43911cd7","filename":"pipelines/generate_grants/dvc.yaml","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/wellcometrust/grants_tagger/blob/d1f28133553c7e14e1e99666ace00916b22736c5/pipelines%2Fgenerate_grants%2Fdvc.yaml","raw_url":"https://github.com/wellcometrust/grants_tagger/raw/d1f28133553c7e14e1e99666ace00916b22736c5/pipelines%2Fgenerate_grants%2Fdvc.yaml","contents_url":"https://api.github.com/repos/wellcometrust/grants_tagger/contents/pipelines%2Fgenerate_grants%2Fdvc.yaml?ref=d1f28133553c7e14e1e99666ace00916b22736c5","patch":"@@ -0,0 +1,13 @@\n+vars:\n+  - s3-url: \"s3://datalabs-data/dimensions/grants/grants\"\n+  - scripts_location: \"../../scripts\"\n+  - argilla_project_name: \"grants\"\n+stages:\n+  generate:\n+    cmd: python ${scripts_location}/create_grants_sample.py --s3-url ${s3-url} --num-parquet-files-to-consider 10 --num-samples-per-cat 10 --pre-annotate True\n+    outs:\n+      - grants_sample.jsonl\n+  upload:\n+    cmd: python ${scripts_location}/upload_grants_data_to_argilla.py --path grants_sample.jsonl --project ${argilla_project_name}\n+    deps:\n+      - grants_sample.jsonl"},{"sha":"3c269c33e859781813fca1a7c23caf4e02884aa9","filename":"requirements.txt","status":"modified","additions":19,"deletions":8,"changes":27,"blob_url":"https://github.com/wellcometrust/grants_tagger/blob/d1f28133553c7e14e1e99666ace00916b22736c5/requirements.txt","raw_url":"https://github.com/wellcometrust/grants_tagger/raw/d1f28133553c7e14e1e99666ace00916b22736c5/requirements.txt","contents_url":"https://api.github.com/repos/wellcometrust/grants_tagger/contents/requirements.txt?ref=d1f28133553c7e14e1e99666ace00916b22736c5","patch":"@@ -1,39 +1,50 @@\n #Created by Makefile. Do not edit.\n+anyio==3.7.0\n+argilla==1.8.0\n awswrangler==3.1.1\n-boto3==1.26.142\n-botocore==1.29.142\n+backoff==2.2.1\n+boto3==1.26.144\n+botocore==1.29.144\n certifi==2023.5.7\n charset-normalizer==3.1.0\n click==8.1.3\n+commonmark==0.9.1\n+Deprecated==1.2.14\n et-xmlfile==1.1.0\n+exceptiongroup==1.1.1\n filelock==3.12.0\n fsspec==2023.5.0\n+h11==0.14.0\n+httpcore==0.16.3\n+httpx==0.23.3\n huggingface-hub==0.14.1\n idna==3.4\n Jinja2==3.1.2\n jmespath==1.0.1\n joblib==1.2.0\n-markdown-it-py==2.2.0\n MarkupSafe==2.1.2\n-mdurl==0.1.2\n+monotonic==1.6\n mpmath==1.2.1\n networkx==3.0\n-numpy==1.24.3\n+numpy==1.23.5\n openpyxl==3.1.2\n packaging==23.1\n-pandas==2.0.2\n+pandas==1.5.3\n pyarrow==12.0.0\n+pydantic==1.10.8\n Pygments==2.15.1\n python-dateutil==2.8.2\n pytz==2023.3\n PyYAML==6.0\n regex==2023.5.5\n requests==2.31.0\n-rich==13.3.5\n+rfc3986==1.5.0\n+rich==13.0.1\n s3transfer==0.6.1\n scikit-learn==1.2.2\n scipy==1.10.1\n six==1.16.0\n+sniffio==1.3.0\n sympy==1.11.1\n threadpoolctl==3.1.0\n tokenizers==0.13.3\n@@ -42,6 +53,6 @@ tqdm==4.65.0\n transformers==4.29.2\n typer==0.9.0\n typing_extensions==4.6.2\n-tzdata==2023.3\n urllib3==1.26.16\n wasabi==1.1.1\n+wrapt==1.14.1"},{"sha":"6a645ffe32becfe055265e9c7f8547726189bf5e","filename":"scripts/upload_grants_data_to_argilla.py","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/wellcometrust/grants_tagger/blob/d1f28133553c7e14e1e99666ace00916b22736c5/scripts%2Fupload_grants_data_to_argilla.py","raw_url":"https://github.com/wellcometrust/grants_tagger/raw/d1f28133553c7e14e1e99666ace00916b22736c5/scripts%2Fupload_grants_data_to_argilla.py","contents_url":"https://api.github.com/repos/wellcometrust/grants_tagger/contents/scripts%2Fupload_grants_data_to_argilla.py?ref=d1f28133553c7e14e1e99666ace00916b22736c5","patch":"@@ -0,0 +1,57 @@\n+import argilla as rg\n+import os\n+import argparse\n+import json\n+\n+\n+def upload_data_to_argilla(path: str, project: str):\n+    \"\"\"\n+    Uploads data to Argilla. The data should be in jsonl format, with each line containing a json object with the\n+    following fields:\n+        - abstract (str): The abstract of the grant.\n+        - mesh_terms (list): A list of MeSH terms associated with the grant.\n+    To generate this data, use the create_grants_sample.py script.\n+\n+    Args:\n+        path (str): The path to the jsonl file.\n+\n+    Returns:\n+        None\n+\n+    Environment Variables:\n+        ARGILLA_API_URL (str): The URL of the Argilla API. Defaults to \"https://pro.argilla.io\".\n+        ARGILLA_API_KEY (str): The API key for the Argilla API.\n+    \"\"\"\n+    api_url = os.environ.get(\"ARGILLA_API_URL\", \"https://pro.argilla.io\")\n+    api_key = os.environ.get(\"ARGILLA_API_KEY\")\n+    rg.init(\n+        api_url=api_url,\n+        api_key=api_key,\n+        workspace=\"wellcome\",\n+    )\n+\n+    with open(path, \"r\") as f:\n+        for line in f:\n+            sample = json.loads(line)\n+            predictions = sample[\"mesh_terms\"]\n+            record = rg.TextClassificationRecord(\n+                text=sample[\"abstract\"],\n+                prediction=[(term, 1.0) for term in predictions],\n+                prediction_agent=\"Wellcome/WellcomeBertMesh\",\n+                metadata={\"for_first_level_name\": sample[\"for_first_level_name\"]},\n+                multi_label=True,\n+            )\n+\n+            rg.log(\n+                record,\n+                project,\n+            )\n+\n+\n+if __name__ == \"__main__\":\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--path\", type=str, help=\"Path to the jsonl file\")\n+    parser.add_argument(\"--project\", type=str, help=\"The name of the project to log to\")\n+    args = parser.parse_args()\n+\n+    upload_data_to_argilla(args.path, args.project)"},{"sha":"8fa50810fc7edbbf83f135fab9dd32ebaf375e8d","filename":"unpinned_requirements.txt","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/wellcometrust/grants_tagger/blob/d1f28133553c7e14e1e99666ace00916b22736c5/unpinned_requirements.txt","raw_url":"https://github.com/wellcometrust/grants_tagger/raw/d1f28133553c7e14e1e99666ace00916b22736c5/unpinned_requirements.txt","contents_url":"https://api.github.com/repos/wellcometrust/grants_tagger/contents/unpinned_requirements.txt?ref=d1f28133553c7e14e1e99666ace00916b22736c5","patch":"@@ -15,3 +15,4 @@ tqdm\n requests\n rich\n awswrangler\n+argilla"}]}
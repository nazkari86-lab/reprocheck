\"print('Unceiled Brainscore for your model is :', brain_score)\\n\",\n+    \"print('ceiled Brainscore for your model is :', brain_score/ceil_score)\"\n    ]\n   },\n   {\n    \"cell_type\": \"code\",\n    \"execution_count\": null,\n-   \"id\": \"a5909bf7\",\n+   \"id\": \"bd957077\",\n    \"metadata\": {},\n    \"outputs\": [],\n    \"source\": []"}]}